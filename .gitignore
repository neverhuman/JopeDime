/target/
**/target/
*.env
*.pat
*.pem
*.key
__pycache__/
*.pyc
.ruff_cache/
.venv/
python/.venv/
python/dist/
/runs/
/logs/
/artifacts/
/.jope-state/
.bundles/
*.log
!docs/parity/*.json
metadata.err
check-*.log

# Shared agent worktree root (owner ruling 2026-09-21). .claude/worktrees is a symlink here.
.agent/

# Local agent configuration, shared-root symlink and append locks stay local.
/.claude/
*.md.lock

# deploy/ci/lambda.sh inflates train-jobs.json.gz here before building (deploy/lambda/SNAPSHOT.json).
/deploy/lambda/csv/gp/corpus/train-jobs.json

# JopeDime training observatory
/web/training-dashboard/node_modules/
/web/training-dashboard/dist/
/web/training-dashboard/coverage/

# Editor, OS, profiler and tool caches: never part of the tree.
.DS_Store
*.swp
*~
*.orig
*.rej
.idea/
.vscode/
.envrc
.direnv/
.pytest_cache/
.mypy_cache/
*.egg-info/
.ipynb_checkpoints/
venv/
node_modules/
.coverage
htmlcov/
*.profraw
perf.data*
nohup.out

# Ignore newly generated rlfw analytics outputs. Existing tracked evidence remains committed
# with its source manifest and custody records; reclamation requires a separate verified review.
/deploy/dl-flywheel/pipelines/rlfw/analytics/**/*.parquet
/deploy/dl-flywheel/pipelines/rlfw/analytics/*.html

# python/prime.toml writes artifacts, runs, cache, checkpoints and models under python/prime/.
/python/prime/
# test_trace_recovery_v2.py creates its TemporaryDirectory under this fixtures/ directory.
/deploy/dl-flywheel/pipelines/telemetry/trace_recovery_v2/fixtures/

# Local fitted model object store; models can retain training data.
/models/sha256-*/
/models/.import-*/

# Copied package payloads belong in external custody, not Git. This only ignores
# new files; the existing tracked receipts and package copies remain tracked.
/research/flywheel_selfplay/custody/files/

/models/sessions/

# The TypeScript qualification SDK may be a local cache symlink or an npm directory.
/deploy/ci/typescript/node_modules

# H-wave output belongs in research/flywheel_selfplay/hNN/, never the repo root
/H[0-9]*/
/H[0-9]*_*/
