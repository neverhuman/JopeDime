    "split": "quota stratified by target distribution plus high-variance feature quantile bins",
    "time_column": "lpep_pickup_datetime"
  },
  "business_question": "Which fare model is most accurate while quoting a single trip within a p99 latency budget?",
  "constraint": "row_latency_p99_us max",
  "objective_kind": "constrained",
  "objective": "objective.json",
  "baseline": "baseline.json",
  "seeds": {
    "file": "seeds.dl.json",
    "provenance": "seeds.provenance.json",
    "limit": 11
  },
  "budget": {
    "evaluations": 96,
    "seconds": 3600,
    "smoke_evaluations": 28
  },
  "calibration": {
    "rng_seed": 1,
    "arm": "D",
    "status": "pending"
  },
  "rng_seeds": [
    7,
    11,
    13
  ],
  "arms": {
    "A": {
      "seeds": true,
      "fitness": "objective"
    },
    "B": {
      "seeds": false,
      "fitness": "objective"
    },
    "C": {
      "seeds": true,
      "fitness": "baseline"
    },
    "D": {
      "seeds": false,
      "fitness": "baseline"
    }
  },
  "readout": [
    "row_latency_p99_us",
    "row_latency_p50_us"
  ],
  "accuracy": {
    "metric": "rmse"
