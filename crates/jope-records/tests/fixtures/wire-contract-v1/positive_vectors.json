{
  "schema": "jope.wire-contract-conformance-vectors/v1",
  "formula": "sha256(schema_utf8||0x00||u64_be(len)||canonical_payload_bytes)",
  "vectors": [
    {
      "id": "V01_REORDERED_NESTED_KEYS_AND_ESCAPES",
      "description": "Reordered top-level and nested keys, quote/backslash/slash escapes, U+0000/tab/newline control chars, safe integer bounds (+-9007199254740991), and fixed-width 16-hex u64 seed.",
      "schema_id": "jope.selfplay.draw-request/v1",
      "raw_input_json": "{\n  \"step_index\": 42,\n  \"seed_u64_hex\": \"ffffffffffffffff\",\n  \"schema\": \"jope.selfplay.draw-request/v1\",\n  \"min_safe_int\": -9007199254740991,\n  \"max_safe_int\": 9007199254740991,\n  \"nested\": {\n    \"z\": 0,\n    \"a\": \"quote:\\\" slash:\\/ backslash:\\\\ tab:\\t nl:\\n nul:\\u0000\"\n  }\n}",
      "expected_canonical_payload": "{\"max_safe_int\":9007199254740991,\"min_safe_int\":-9007199254740991,\"nested\":{\"a\":\"quote:\\\" slash:/ backslash:\\\\ tab:\\u0009 nl:\\u000a nul:\\u0000\",\"z\":0},\"schema\":\"jope.selfplay.draw-request/v1\",\"seed_u64_hex\":\"ffffffffffffffff\",\"step_index\":42}",
      "expected_payload_byte_len": 242,
      "expected_domain_separated_sha256": "1a5085a2fa9b41d46ebcb5569e8a663d7714c14c5eab1c40fb44fac6a6ef92fb"
    },
    {
      "id": "V02_UNICODE_PRECOMPOSED_E_ACUTE",
      "description": "Precomposed U+00E9 and surrogate-pair U+1F680 emitted as literal UTF-8 without Unicode normalization.",
      "schema_id": "jope.selfplay.unicode-test/v1",
      "raw_input_json": "{ \"schema\": \"jope.selfplay.unicode-test/v1\", \"label\": \"caf\\u00e9 \\ud83d\\ude80\" }",
      "expected_canonical_payload": "{\"label\":\"café 🚀\",\"schema\":\"jope.selfplay.unicode-test/v1\"}",
      "expected_payload_byte_len": 63,
      "expected_domain_separated_sha256": "a3259f9cf9be28d1dfffeef3b1e3dff7ef9bb39749dff011a8255f259fbdfaea"
    },
    {
      "id": "V03_UNICODE_COMBINING_E_ACUTE",
      "description": "Combining U+0065 U+0301 sequence remains distinct from precomposed U+00E9 (no NFC/NFD normalization).",
      "schema_id": "jope.selfplay.unicode-test/v1",
