#!/usr/bin/env python3
"""Negative controls for the release executable acceptance check."""

import copy
from importlib.machinery import SourceFileLoader
import importlib.util
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest.mock import patch

loader = SourceFileLoader(
    "release_cli_check", str(Path(__file__).with_name("release_cli_check"))
)
spec = importlib.util.spec_from_loader(loader.name, loader)
check = importlib.util.module_from_spec(spec)
loader.exec_module(check)


class ReleaseCliCheckTests(unittest.TestCase):
    def setUp(self):
        self.messages = [
            {
                "reason": "compiler-artifact",
                "target": {"name": "jopedime", "kind": ["bin"]},
                "profile": {"test": False, "debug_assertions": False, "opt_level": "3"},
                "features": ["client", "default", "engine", "mcp"],
                "executable": "/unused/jopedime",
            },
            {"reason": "build-finished", "success": True},
        ]

    def test_only_ordinary_release_artifact_is_accepted(self):
        self.assertEqual(check.release_artifact(self.messages), self.messages[0])
        for field, value in [
            ("test", True),
            ("debug_assertions", True),
            ("opt_level", "0"),
        ]:
            with self.subTest(field=field):
                rows = copy.deepcopy(self.messages)
                rows[0]["profile"][field] = value
                with self.assertRaises(ValueError):
                    check.release_artifact(rows)
        for features in [
            ["research", "default"],
            ["engine"],
            ["default"],
            ["embedded", "engine", "client"],
            ["client", "engine", "mcp"],
            ["client", "default", "engine", "mcp", "research"],
            ["client", "default", "engine", "mcp", "dev-keys"],
            None,
            "default",
        ]:
            rows = copy.deepcopy(self.messages)
            rows[0]["features"] = features
            with self.assertRaises(ValueError):
                check.release_artifact(rows)

    def test_full_dist_artifact_accepts_explicit_production_components(self):
        for optimization in ["3", "s"]:
            with self.subTest(optimization=optimization):
                rows = copy.deepcopy(self.messages)
                rows[0]["profile"]["opt_level"] = optimization
                rows[0]["features"] = ["client", "embedded", "engine", "mcp"]
                self.assertEqual(check.release_artifact(rows), rows[0])

    def test_failed_missing_and_ambiguous_builds_are_refused(self):
        for rows in [
            [],
            self.messages[:-1],
            [*self.messages[:-1], {"reason": "build-finished", "success": False}],
            [self.messages[0], *self.messages],
        ]:
            with self.subTest(rows=rows), self.assertRaises(ValueError):
                check.release_artifact(rows)

    def test_help_and_dispatch_are_both_checked(self):
        ok = subprocess.CompletedProcess([], 0, "Usage: jopedime <COMMAND>\n", "")
        unknown = subprocess.CompletedProcess(
            [], 2, "", "error: unrecognized subcommand 'research'\n"
        )
        with (
            tempfile.TemporaryDirectory() as scratch,
            patch.object(
                check.subprocess, "run", side_effect=[ok, ok, unknown, unknown]
            ) as run,
        ):
            result = check.check_commands(Path("/unused/jopedime"), Path(scratch))
        self.assertEqual(len(result), 4)
        self.assertEqual(run.call_count, 4)

    def test_visible_command_and_non_parser_refusals_cannot_pass(self):
        help_ok = subprocess.CompletedProcess([], 0, "Usage: jopedime <COMMAND>\n", "")
        bad_cases = [
            [subprocess.CompletedProcess([], 0, "Usage: jopedime research\n", "")],
            [subprocess.CompletedProcess([], 0, "", "")],
            [
                help_ok,
                help_ok,
                subprocess.CompletedProcess([], 0, "Usage: research\n", ""),
            ],
            [
                help_ok,
                help_ok,
                subprocess.CompletedProcess([], 3, "", "integrity failure"),
            ],
            [
                help_ok,
                help_ok,
                subprocess.CompletedProcess([], 2, "", "bad record argument"),
            ],
        ]
        for results in bad_cases:
            with (
                self.subTest(results=results),
                tempfile.TemporaryDirectory() as scratch,
                patch.object(check.subprocess, "run", side_effect=results),
                self.assertRaises(ValueError),
            ):
                check.check_commands(Path("/unused/jopedime"), Path(scratch))

    def test_record_side_effect_is_refused(self):
        ok = subprocess.CompletedProcess([], 0, "Usage: jopedime <COMMAND>\n", "")
        with tempfile.TemporaryDirectory() as scratch:
            (Path(scratch) / "must-not-exist.jsonl").touch()
            with (
                patch.object(check.subprocess, "run", return_value=ok),
                self.assertRaises(ValueError),
            ):
                check.check_commands(Path("/unused/jopedime"), Path(scratch))


if __name__ == "__main__":
    unittest.main()
