from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable

ADMIT, REFUSE = "ADMIT", "REFUSE"
CONTINUE, PAUSE, YIELD, STOP, ABORT_GATE = "CONTINUE", "PAUSE", "YIELD", "STOP", "ABORT_GATE"
ADMISSION_DECISIONS = (ADMIT, REFUSE)
CONTINUATION_DECISIONS = (CONTINUE, PAUSE, YIELD, STOP, ABORT_GATE)
DECISIONS = ADMISSION_DECISIONS + CONTINUATION_DECISIONS
EXIT_DECISIONS = frozenset({YIELD, STOP, ABORT_GATE})
VERDICT_SCHEMA = "jope.dl-gpu-gate-verdict/v1"
QUEUE_SCHEMA = "jope.incoming-queue-status/v1"

KNOWN_STATES = frozenset({"benchmarked", "benchmarking", "complete", "evolving", "frozen", "gp_recovery_required", "queued",
                          "rejected", "retired", "benchmark_recovery_required", "discovered", "validated"})
BLOCKING_STATES = frozenset({"queued", "discovered", "validated", "benchmarking", "benchmark_recovery_required"})

Q_MAX_AGE_NS = 45 * 10**9                 # Q age must be < 45 s
POLL_MAX_AGE_NS = 30 * 60 * 10**9         # registry.poll.utc_ns must be < 30 min old
C_MAX_AGE_S = 45.0                        # C stale when older than 45 s
C_MAX_FUTURE_S = 5.0
ROLLING_REFUSE = 75.0
ROLLING_RESUME = 70.0
RESUME_COOL_NS = 60 * 10**9
PAUSE_YIELD_NS = 600 * 10**9
MIN_FREE_MIB = 20480.0
MAX_UTIL_PERCENT = 5.0                    # util >= 5 refuses
TEMP_PAUSE_C = 80.0
TEMP_STOP_C = 85.0
DISK_FLOOR_BYTES = 300_000_000_000        # DL-D7 host floor
CMD_TIMEOUT_S = 15.0
MAX_INTERVAL_S = 15.0
MAX_HARD_EXIT_S = 60.0
HARD_EXIT_CODE = 75

INTAKE_ROOT = Path("/home/ubuntu/scratch/jopedime-regression-research-2k-incoming-intake-v1")
QUEUE_STATUS = INTAKE_ROOT / "queue-status.json"
CPU_ADMISSION = Path("/home/ubuntu/scratch/jopedime-regression-research-2k-per-fold-hwm-20261001/gp/cpu-admission.json")
TABPFN_LOCK = INTAKE_ROOT / "tabpfn-gpu.lock"
UNIT_GLOB = "jopedime-incoming-gpu-*"
UNIT_STATES = "active,activating,deactivating,reloading"

GPU_QUERY = ["nvidia-smi", "--query-gpu=index,memory.total,memory.used,memory.free,utilization.gpu,temperature.gpu",
             "--format=csv,noheader,nounits"]
APPS_QUERY = ["nvidia-smi", "--query-compute-apps=pid,process_name,used_memory", "--format=csv,noheader,nounits"]

GATE_SHA256 = hashlib.sha256(Path(__file__).read_bytes()).hexdigest()   # binds every verdict to this exact source

_LOCK_ID = re.compile(r"([0-9a-fA-F]+):([0-9a-fA-F]+):([0-9]+)")
_NS_TEXT = re.compile(r"[0-9]{1,30}")
_NO_APPS = re.compile(r"no running (compute )?processes found\.?", re.IGNORECASE)


class CommandFailed(RuntimeError):
    pass


def _default_run_cmd(argv: list[str]) -> str:
    env = {**os.environ, "LC_ALL": "C", "SYSTEMD_PAGER": "", "SYSTEMD_COLORS": "0"}
    r = subprocess.run(argv, capture_output=True, text=True, timeout=CMD_TIMEOUT_S, check=False,
                       stdin=subprocess.DEVNULL, env=env)
    if r.returncode != 0:
        raise CommandFailed(f"{argv[0]} exited {r.returncode}: {r.stderr.strip()[:200]}")
    return r.stdout


@dataclass(frozen=True)
class GateSources:
    queue_status: Path
    cpu_admission: Path
    lock_path: Path
    proc_locks: Path = Path("/proc/locks")
    unit_glob: str = UNIT_GLOB
    host: str | None = None
    disk_path: Path = Path("/")
    disk_floor_bytes: int = DISK_FLOOR_BYTES
    run_cmd: Callable[[list[str]], str] | None = None   # injectable for fixtures; default subprocess, timeout 15 s


DEFAULT_SOURCES = GateSources(queue_status=QUEUE_STATUS, cpu_admission=CPU_ADMISSION, lock_path=TABPFN_LOCK)


@dataclass(frozen=True)
class Verdict:
    mode: str
    decision: str
    reasons: tuple[str, ...]
    observations: dict = field(compare=False)
    utc_us: int

    @property
    def ok(self) -> bool:
        return self.decision in (ADMIT, CONTINUE)

    def to_dict(self) -> dict:
        return {"schema": VERDICT_SCHEMA, "mode": self.mode, "decision": self.decision, "reasons": list(self.reasons),
                "observations": self.observations, "utc_us": self.utc_us}

    def to_json(self) -> str:
        return json.dumps(self.to_dict(), sort_keys=True, separators=(",", ":"), allow_nan=False)


class _Bad(Exception):
    def __init__(self, reason: str):
        super().__init__(reason)
        self.reason = reason


def _sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def _reject_constant(name):
    raise ValueError(f"non-finite JSON constant {name}")


def _req(obj, key, prefix, path, kind=None):
    if not isinstance(obj, dict) or key not in obj:
        raise _Bad(f"{prefix}_missing:{path}")
    v = obj[key]
    if kind is not None and (not isinstance(v, kind) or isinstance(v, bool)):
        raise _Bad(f"{prefix}_malformed:{path}")
    return v


def _int_ns(v, prefix, path) -> int:
    if isinstance(v, int) and not isinstance(v, bool) and v >= 0:
        return v
    if isinstance(v, str) and _NS_TEXT.fullmatch(v):
        return int(v)
    raise _Bad(f"{prefix}_malformed:{path}")


def _finite(v, prefix, path) -> float:
    if isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v):
        return float(v)
    raise _Bad(f"{prefix}_malformed:{path}")


def _read_json(path, prefix, o) -> dict:
    try:
        raw = Path(path).read_bytes()
    except OSError as e:
        raise _Bad(f"{prefix}_unreadable:{type(e).__name__}")
    o.update(sha256=_sha(raw), bytes=len(raw))
    try:
        doc = json.loads(raw, parse_constant=_reject_constant)
    except ValueError:
        raise _Bad(f"{prefix}_unreadable:json")
    if not isinstance(doc, dict):
        raise _Bad(f"{prefix}_malformed:root")
    return doc


def _run(src: GateSources, key: str, argv: list[str], obs: dict) -> str:
    o = obs["commands"][key] = {"argv": list(argv)}
    try:
        out = (src.run_cmd or _default_run_cmd)(list(argv))
        if not isinstance(out, str):
            raise TypeError("run_cmd must return str")
    except Exception as e:
        o["error"] = f"{type(e).__name__}: {str(e)[:200]}"
        raise
    b = out.encode("utf-8", "surrogateescape")
    o.update(stdout_sha256=_sha(b), stdout_bytes=len(b))
    return out


def _queue_signals(src: GateSources, now_ns: int, obs: dict) -> list[str]:
    P = "queue_status"
    o = obs["sources"][P] = {"path": str(src.queue_status)}
    try:
        doc = _read_json(src.queue_status, P, o)
    except _Bad as e:
        return [e.reason]
    sig = []
    try:
        schema = _req(doc, "schema", P, "schema")
        if schema != QUEUE_SCHEMA:
            sig.append(f"queue_status_schema:{str(schema)[:64]}")
    except _Bad as e:
        sig.append(e.reason)
    try:
        t = _int_ns(_req(doc, "utc_ns_text", P, "utc_ns_text"), P, "utc_ns_text")
        age = now_ns - t
        o.update(utc_ns_text=str(t), age_s=round(age / 1e9, 3))
        if age < 0:
            sig.append(f"queue_status_future:{-age / 1e9:.3f}s")
        elif age >= Q_MAX_AGE_NS:
            sig.append(f"queue_status_stale:{age / 1e9:.3f}s")
    except _Bad as e:
        sig.append(e.reason)
    try:
        reg = _req(doc, "registry", P, "registry", dict)
    except _Bad as e:
        return sig + [e.reason]
    try:
        states = _req(reg, "states", P, "registry.states", dict)
        o["states"] = {str(k)[:64]: v for k, v in sorted(states.items())}
        for k, v in sorted(states.items()):
            if k not in KNOWN_STATES:
                sig.append(f"unknown_state_key:{str(k)[:64]}")
                continue
            if not isinstance(v, int) or isinstance(v, bool) or v < 0:
                sig.append(f"queue_status_malformed:registry.states.{k}")
            elif k in BLOCKING_STATES and v > 0:
                sig.append(f"intake_state:{k}={v}")
    except _Bad as e:
        sig.append(e.reason)
    try:
        poll = _req(reg, "poll", P, "registry.poll", dict)
        pu = _int_ns(_req(poll, "utc_ns", P, "registry.poll.utc_ns"), P, "registry.poll.utc_ns")
        page = now_ns - pu
        o.update(poll_utc_ns=str(pu), poll_age_s=round(page / 1e9, 3))
        if page < 0:
            sig.append(f"registry_poll_future:{-page / 1e9:.3f}s")
        elif page >= POLL_MAX_AGE_NS:
            sig.append(f"registry_poll_stale:{page / 1e9:.3f}s")
    except _Bad as e:
        sig.append(e.reason)
    try:
        items = _req(reg, "items", P, "registry.items", list)
        blocking, unknown, bad, bench_ids = {}, set(), 0, []
        for it in items:
            s = it.get("state") if isinstance(it, dict) else None
            if not isinstance(s, str):
                bad += 1
                continue
            if s not in KNOWN_STATES:
                unknown.add(s[:64])
            elif s in BLOCKING_STATES:
                blocking[s] = blocking.get(s, 0) + 1
                if s == "benchmarking" and len(bench_ids) < 20:
                    bench_ids.append(str(it.get("id", ""))[:16])
        o.update(items=len(items), blocking_items=dict(sorted(blocking.items())), benchmarking_item_ids=bench_ids)
        if bad:
            sig.append(f"queue_status_malformed:registry.items.state:{bad}")
        sig.extend(f"unknown_item_state:{s}" for s in sorted(unknown))
        if blocking.get("benchmarking"):
            sig.append(f"benchmarking_items:{blocking['benchmarking']}")
        sig.extend(f"blocking_items:{s}={n}" for s, n in sorted(blocking.items()) if s != "benchmarking")
    except _Bad as e:
        sig.append(e.reason)
    return sig


def _lock_signals(src: GateSources, obs: dict) -> list[str]:
    o = obs["sources"]["tabpfn_lock"] = {"path": str(src.lock_path)}
    try:
        st = os.stat(src.lock_path)          # stat only: the lock is never opened or acquired
    except OSError as e:
        return [f"lock_path_unreadable:{type(e).__name__}"]
    key = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
    o["id"] = f"{key[0]:02x}:{key[1]:02x}:{key[2]}"
    p = obs["sources"]["proc_locks"] = {"path": str(src.proc_locks)}
    try:
        raw = Path(src.proc_locks).read_bytes()
    except OSError as e:
        return [f"proc_locks_unreadable:{type(e).__name__}"]
    p.update(sha256=_sha(raw), bytes=len(raw))
    try:
        text = raw.decode("ascii")
    except UnicodeDecodeError:
        return ["proc_locks_unparsable:encoding"]
    held, bad, n = [], 0, 0
    for line in text.splitlines():
        if not line.strip():
            continue
        n += 1
        ident = next((m for m in map(_LOCK_ID.fullmatch, line.split()) if m), None)
        if ident is None:
            bad += 1
        elif (int(ident[1], 16), int(ident[2], 16), int(ident[3])) == key:
            held.append(" ".join(line.split())[:200])
    p["lines"] = n
    o.update(held=bool(held), matching_lines=held[:16])
    sig = [f"proc_locks_unparsable:{bad}"] if bad else []
    if held:
        sig.append(f"tabpfn_lock_held:{len(held)}")
    return sig


def unit_argv(glob: str) -> list[str]:
    return ["systemctl", "--user", "list-units", glob, f"--state={UNIT_STATES}", "--no-legend", "--plain", "--no-pager"]


def _unit_signals(src: GateSources, obs: dict) -> list[str]:
    try:
        out = _run(src, "units", unit_argv(src.unit_glob), obs)
    except Exception as e:
        return [f"unit_query_failed:{type(e).__name__}"]
    units = []
    for line in out.splitlines():
        toks = [t for t in line.split() if t not in ("●", "*")]
        if toks:
            units.append(toks[0][:128])
    obs["commands"]["units"]["units"] = units
    return [f"intake_unit_active:{u}" for u in units]


def _intake(src: GateSources, now_ns: int, obs: dict) -> list[str]:
    return _lock_signals(src, obs) + _unit_signals(src, obs) + _queue_signals(src, now_ns, obs)


def _gpu(src: GateSources, obs: dict):
    """Return (gpus or None, apps or None, reasons)."""
    reasons, gpus, apps = [], None, None
    try:
        out = _run(src, "gpu", GPU_QUERY, obs)
        parsed = []
        for line in out.splitlines():
            if not line.strip():
                continue
            parts = [x.strip() for x in line.split(",")]
            if len(parts) != 6 or not parts[0].isdigit():
                raise _Bad("gpu_query_unparsable")
            vals = [_finite(_num(x), "gpu_query", "value") for x in parts[1:]]
            parsed.append(dict(zip(("index", "total_mib", "used_mib", "free_mib", "util_percent", "temp_c"),
                                   [int(parts[0]), *vals])))
        if not parsed:
            raise _Bad("no_gpu")
        gpus = parsed
        obs["commands"]["gpu"]["gpus"] = gpus
    except _Bad as e:
        reasons.append("gpu_query_unparsable" if e.reason.startswith("gpu_query") else e.reason)
    except Exception as e:
        reasons.append(f"gpu_query_failed:{type(e).__name__}")
    try:
        out = _run(src, "compute_apps", APPS_QUERY, obs)
        parsed = []
        for line in out.splitlines():
            s = line.strip()
            if not s or _NO_APPS.fullmatch(s):
                continue
            parts = [x.strip() for x in s.split(",")]
            if len(parts) < 3 or not parts[0].isdigit() or int(parts[0]) <= 0:
                raise _Bad("compute_apps_unparsable")
            parsed.append({"pid": int(parts[0]), "process_name": ",".join(parts[1:-1])[:256], "used_mib": parts[-1][:32]})
        apps = parsed
    except _Bad as e:
        reasons.append(e.reason)
    except Exception as e:
        reasons.append(f"compute_apps_query_failed:{type(e).__name__}")
    return gpus, apps, reasons


def _num(text: str):
    try:
        return float(text)
    except ValueError:
        return None


def _foreign(apps, own: set[int], obs: dict) -> list[str]:
    foreign = [a for a in apps if a["pid"] not in own]
    obs["commands"]["compute_apps"].update(apps=apps, self_pids=sorted(own), foreign_pids=[a["pid"] for a in foreign])
    return [f"foreign_compute_app:{a['pid']}" for a in foreign]


def _cpu(src: GateSources, now_ns: int, host: str, obs: dict):
    """Return (reasons, rolling or None). Reasons include rolling >= 75."""
    P = "cpu_admission"
    o = obs["sources"][P] = {"path": str(src.cpu_admission), "host": host}
    try:
        doc = _read_json(src.cpu_admission, P, o)
    except _Bad as e:
        return [e.reason], None
    reasons, rolling = [], None
    try:
        admit = _req(doc, "admit", P, "admit")
        o["admit"] = admit if admit is None or isinstance(admit, (bool, int, float, str)) else type(admit).__name__
        if admit is not True:
            reasons.append("cpu_admit_false")
    except _Bad as e:
        reasons.append(e.reason)
    try:
        sampled = _finite(_req(doc, "sampled_unix_seconds", P, "sampled_unix_seconds"), P, "sampled_unix_seconds")
        age = now_ns / 1e9 - sampled
        o.update(sampled_unix_seconds=sampled, age_s=round(age, 3))
        if age > C_MAX_AGE_S:
            reasons.append(f"cpu_admission_stale:{age:.3f}s")
        elif age < -C_MAX_FUTURE_S:
            reasons.append(f"cpu_admission_future:{-age:.3f}s")
    except _Bad as e:
        reasons.append(e.reason)
    try:
        nodes = _req(doc, "nodes", P, "nodes", dict)
        node = _req(nodes, host, P, f"nodes.{host}", dict)
        rolling = _finite(_req(node, "cpu_rolling_percent", P, f"nodes.{host}.cpu_rolling_percent"), P,
                          f"nodes.{host}.cpu_rolling_percent")
        o["cpu_rolling_percent"] = rolling
        if rolling >= ROLLING_REFUSE:
            reasons.append(f"cpu_rolling_high:{rolling:.2f}")
    except _Bad as e:
        reasons.append(e.reason)
    return reasons, rolling


def _disk(src: GateSources, obs: dict) -> list[str]:
    o = obs["disk"] = {"path": str(src.disk_path), "floor_bytes": int(src.disk_floor_bytes)}
    try:
        st = os.statvfs(src.disk_path)
    except OSError as e:
        return [f"disk_unreadable:{type(e).__name__}"]
    free = st.f_bavail * st.f_frsize
    o["free_bytes"] = free
    return [f"disk_below_floor:{free}"] if free < src.disk_floor_bytes else []


def _now(now_ns) -> int:
    return time.time_ns() if now_ns is None else int(now_ns)


def _base_obs(src: GateSources, mode: str, now_ns: int, host: str) -> dict:
    return {"mode": mode, "now_ns_text": str(now_ns), "host": host, "gate_sha256": GATE_SHA256, "sources": {}, "commands": {},
            "thresholds": {"q_max_age_s": Q_MAX_AGE_NS / 1e9, "poll_max_age_s": POLL_MAX_AGE_NS / 1e9,
                           "c_max_age_s": C_MAX_AGE_S, "rolling_refuse": ROLLING_REFUSE, "rolling_resume": ROLLING_RESUME,
                           "resume_cool_s": RESUME_COOL_NS / 1e9, "pause_yield_s": PAUSE_YIELD_NS / 1e9,
                           "min_free_mib": MIN_FREE_MIB, "max_util_percent": MAX_UTIL_PERCENT, "temp_pause_c": TEMP_PAUSE_C,
                           "temp_stop_c": TEMP_STOP_C, "disk_floor_bytes": int(src.disk_floor_bytes)},
            "unit_glob": src.unit_glob, "blocking_states": sorted(BLOCKING_STATES)}


def intake_signals(src: GateSources = DEFAULT_SOURCES, now_ns: int | None = None) -> list[str]:
    """Lock held, active intake GPU unit, benchmarking/blocking item, blocking state > 0, unknown state, stale/missing Q.
    Empty list means no intake signal. Every failure to check is itself a signal (fail closed)."""
    now_ns = _now(now_ns)
    return _intake(src, now_ns, _base_obs(src, "intake", now_ns, src.host or socket.gethostname()))


def admission_probe(src: GateSources = DEFAULT_SOURCES, *, self_pids=(), now_ns: int | None = None) -> Verdict:
    now_ns = _now(now_ns)
    host = src.host or socket.gethostname()
    obs = _base_obs(src, "admit", now_ns, host)
    reasons = _intake(src, now_ns, obs)
    obs["intake_signals"] = list(reasons)
    gpus, apps, gerr = _gpu(src, obs)
    reasons += gerr
    if apps is not None:
        reasons += _foreign(apps, {int(p) for p in self_pids}, obs)
    for g in gpus or ():
        if g["free_mib"] < MIN_FREE_MIB:
            reasons.append(f"gpu_free_low:{g['index']}={g['free_mib']:g}MiB")
        if g["util_percent"] >= MAX_UTIL_PERCENT:
            reasons.append(f"gpu_util_high:{g['index']}={g['util_percent']:g}%")
        if g["temp_c"] >= TEMP_PAUSE_C:
            reasons.append(f"gpu_temp_high:{g['index']}={g['temp_c']:g}C")
    reasons += _cpu(src, now_ns, host, obs)[0]
    reasons += _disk(src, obs)
    return Verdict("admit", REFUSE if reasons else ADMIT, tuple(reasons), obs, now_ns // 1000)


class ContinuationState:
    """Pause bookkeeping shared by the trainer loop and the Watchdog (thread-safe).

    paused_since_ns: when the current pause began (None while not paused);
    cool_since_ns: since when C has been fresh, admitted and rolling < 70 at every probe (None otherwise);
    cpu_hold: a CPU-caused pause is waiting for 60 s of continuous rolling < 70."""

    def __init__(self):
        self.paused_since_ns: int | None = None
        self.cool_since_ns: int | None = None
        self.cpu_hold = False
        self.lock = threading.Lock()

    def snapshot(self) -> dict:
        return {"paused_since_ns_text": None if self.paused_since_ns is None else str(self.paused_since_ns),
                "cool_since_ns_text": None if self.cool_since_ns is None else str(self.cool_since_ns),
                "cpu_hold": self.cpu_hold}


def continuation_probe(self_pid: int, src: GateSources = DEFAULT_SOURCES, *, state: ContinuationState,
                       extra_self_pids=(), now_ns: int | None = None) -> Verdict:
    now_ns = _now(now_ns)
    host = src.host or socket.gethostname()
    obs = _base_obs(src, "continue", now_ns, host)
    intake = _intake(src, now_ns, obs)
    obs["intake_signals"] = list(intake)
    yield_r = list(intake)
    gpus, apps, gerr = _gpu(src, obs)
    yield_r += gerr
    if apps is not None:
        yield_r += _foreign(apps, {int(self_pid), *(int(p) for p in extra_self_pids)}, obs)
    stop_r, thermal_r = [], []
    for g in gpus or ():
        if g["temp_c"] >= TEMP_STOP_C:
            stop_r.append(f"gpu_temp_stop:{g['index']}={g['temp_c']:g}C")
        elif g["temp_c"] >= TEMP_PAUSE_C:
            thermal_r.append(f"gpu_temp_pause:{g['index']}={g['temp_c']:g}C")
    cpu_r, rolling = _cpu(src, now_ns, host, obs)
    abort_r = _disk(src, obs)
    with state.lock:
        cool = not cpu_r and rolling is not None and rolling < ROLLING_RESUME
        if not cool:
            state.cool_since_ns = None
        elif state.cool_since_ns is None or now_ns < state.cool_since_ns:
            state.cool_since_ns = now_ns
        if cpu_r:
            state.cpu_hold = True
        elif state.cpu_hold and state.cool_since_ns is not None and now_ns - state.cool_since_ns >= RESUME_COOL_NS:
            state.cpu_hold = False
        pause_r = list(cpu_r) + thermal_r
        if state.cpu_hold and not cpu_r:
            cool_s = 0.0 if state.cool_since_ns is None else (now_ns - state.cool_since_ns) / 1e9
            pause_r.append(f"cpu_resume_hold:rolling={rolling}:cool_for={cool_s:.1f}s")
        paused_ns = 0
        if pause_r:
            if state.paused_since_ns is None or now_ns < state.paused_since_ns:
                state.paused_since_ns = now_ns
            paused_ns = now_ns - state.paused_since_ns
        else:
            state.paused_since_ns = None
        obs["continuation_state"] = {**state.snapshot(), "paused_s": round(paused_ns / 1e9, 3)}
    if pause_r and paused_ns > PAUSE_YIELD_NS:
        yield_r.append(f"paused_too_long:{paused_ns / 1e9:.1f}s")
    if stop_r:
        decision = STOP
    elif abort_r:
        decision = ABORT_GATE
    elif yield_r:
        decision = YIELD
    elif pause_r:
        decision = PAUSE
    else:
        decision = CONTINUE
    return Verdict("continue", decision, tuple(stop_r + abort_r + yield_r + pause_r), obs, now_ns // 1000)


def _default_hard_exit(code: int) -> None:
    try:
        sys.stderr.write(f"dltrain.gpu_gate watchdog: intake signal not released in time; hard exit {code}\n")
        sys.stderr.flush()
    finally:
        os._exit(code)


class Watchdog(threading.Thread):
    """In-process watchdog (PLAN §6.8). Start it right after CUDA initialisation; call `disarm()` immediately before a
    normal exit. `probe` (a zero-argument callable returning a Verdict) replaces continuation_probe in tests."""

    def __init__(self, self_pid: int | None = None, src: GateSources = DEFAULT_SOURCES, *,
                 state: ContinuationState | None = None, extra_self_pids=(), interval_s: float = 15.0,
                 hard_exit_s: float = 60.0, hard_exit: Callable[[int], None] | None = None,
                 probe: Callable[[], Verdict] | None = None, monotonic: Callable[[], float] = time.monotonic):
        if not (0 < interval_s <= MAX_INTERVAL_S):
            raise ValueError(f"interval_s must be in (0, {MAX_INTERVAL_S:g}]")
        if not (0 < hard_exit_s <= MAX_HARD_EXIT_S):
            raise ValueError(f"hard_exit_s must be in (0, {MAX_HARD_EXIT_S:g}]")
        super().__init__(name="dltrain-gpu-watchdog", daemon=True)
        self.self_pid = os.getpid() if self_pid is None else int(self_pid)
        self.src, self.state = src, state if state is not None else ContinuationState()
        self.extra_self_pids = tuple(extra_self_pids)
        self.interval_s, self.hard_exit_s = float(interval_s), float(hard_exit_s)
        self._hard_exit = hard_exit or _default_hard_exit
        self._probe = probe or (lambda: continuation_probe(self.self_pid, self.src, state=self.state,
                                                           extra_self_pids=self.extra_self_pids))
        self._mono = monotonic
        self.yield_requested = threading.Event()
        self.hard_exit_fired = threading.Event()
        self._halt = threading.Event()
        self._lock = threading.Lock()
        self._latest: Verdict | None = None
        self.disarmed = False
        self.probes = 0
        self.errors: list[dict] = []
        self.intake_first_seen: float | None = None      # monotonic seconds
        self.intake_first_reasons: tuple[str, ...] = ()

    @property
    def latest(self) -> Verdict | None:
        with self._lock:
            return self._latest

    def disarm(self) -> None:
        with self._lock:
            self.disarmed = True
        self._halt.set()

    def _probe_once(self) -> Verdict:
        try:
            v = self._probe()
            if not isinstance(v, Verdict):
                raise TypeError(f"probe returned {type(v).__name__}")
        except Exception as e:
            reason = f"probe_exception:{type(e).__name__}"
            self.errors.append({"utc_us": time.time_ns() // 1000, "error": f"{type(e).__name__}: {str(e)[:300]}"})
            v = Verdict("continue", YIELD, (reason,), {"intake_signals": [reason], "exception": repr(e)[:300]},
                        time.time_ns() // 1000)
        return v

    def _record(self, v: Verdict) -> None:
        with self._lock:
            self._latest = v
            self.probes += 1
            if v.observations.get("intake_signals") and self.intake_first_seen is None:
                self.intake_first_seen = self._mono()
                self.intake_first_reasons = tuple(v.observations["intake_signals"])
        if v.decision in EXIT_DECISIONS:
            self.yield_requested.set()

    def _deadline(self) -> float | None:
        return None if self.intake_first_seen is None else self.intake_first_seen + self.hard_exit_s

    def _fire_if_due(self) -> bool:
        with self._lock:
            d = self._deadline()
            if self.disarmed or d is None or self._mono() < d:
                return False
            self.hard_exit_fired.set()
            self._halt.set()
        self._hard_exit(HARD_EXIT_CODE)
        return True

    def run(self) -> None:
        try:
            while not self._halt.is_set():
                started = self._mono()
                self._record(self._probe_once())
                if self._fire_if_due():
                    return
                wait = max(0.0, started + self.interval_s - self._mono())
                d = self._deadline()
                if d is not None:
                    wait = min(wait, max(0.0, d - self._mono()))
                if self._halt.wait(wait):
                    return
                if self._fire_if_due():
                    return
        except BaseException as e:      # the watchdog must not die silently: fail closed
            self.errors.append({"utc_us": time.time_ns() // 1000, "error": f"watchdog: {type(e).__name__}: {str(e)[:300]}"})
            self.yield_requested.set()
            with self._lock:
                fire = not self.disarmed and not self.hard_exit_fired.is_set()
                if fire:
                    self.hard_exit_fired.set()
            if fire:
                self._hard_exit(HARD_EXIT_CODE)


def main(argv=None, *, src: GateSources | None = None) -> int:
    ap = argparse.ArgumentParser(prog="dltrain.gpu_gate", description="Read-only GPU admission/continuation probe (PLAN §6.8).")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("probe")
    p.add_argument("--mode", choices=("admit", "continue"), required=True)
    p.add_argument("--json", action="store_true")
    p.add_argument("--self-pid", type=int, default=None)
    a = ap.parse_args(argv)
    src = DEFAULT_SOURCES if src is None else src
    try:
        if a.mode == "admit":
            v = admission_probe(src, self_pids=() if a.self_pid is None else (a.self_pid,))
        else:
            v = continuation_probe(os.getpid() if a.self_pid is None else a.self_pid, src, state=ContinuationState())
    except Exception as e:      # fail closed
        reason = f"probe_exception:{type(e).__name__}"
        v = Verdict(a.mode, REFUSE if a.mode == "admit" else YIELD, (reason,), {"exception": repr(e)[:300]},
                    time.time_ns() // 1000)
    print(v.to_json() if a.json else f"{v.decision} {' '.join(v.reasons)}".rstrip())
    return 0 if v.ok else 3


if __name__ == "__main__":
    raise SystemExit(main())
