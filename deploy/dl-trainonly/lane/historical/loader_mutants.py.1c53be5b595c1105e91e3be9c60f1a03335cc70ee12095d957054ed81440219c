    pr = subprocess.run(["env", "-C", str(d), f"PYTHONPATH={d}", "PYTHONDONTWRITEBYTECODE=1", f"TMPDIR={t}", "CUDA_VISIBLE_DEVICES=",
                         PY, "-m", "unittest", "tests.test_p8_trainer.LoaderGuardTests"], capture_output=True, text=True)
    res.append({"mutant": name, "rc": pr.returncode, "killed": pr.returncode != 0 if rel else None, "tail": pr.stderr[-200:]})
(out / "results.json").write_text(json.dumps(res, indent=1)); print(json.dumps([(r["mutant"], r["rc"], r["killed"]) for r in res]))
