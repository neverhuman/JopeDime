PREFLIGHT = ("import sys, os, importlib.util; from pathlib import Path; import dltrain.jtt1 as j, dltrain.scorer_labels as s; "
             "root = Path(os.getcwd()).resolve(); assert Path(j.__file__).resolve().parents[1] == root, j.__file__; "
             "assert Path(s.__file__).resolve().parents[1] == root, s.__file__; print('preflight-ok', root)")


def sha(b):
    return hashlib.sha256(b).hexdigest()


def run_copy(copy: Path, tests: list) -> dict:
    base = ["systemd-run", "--user", "--scope", "--quiet", "--slice=jopedime-dltrain.slice", "-p", "CPUQuota=300%", "-p", "MemoryMax=6G",
            "-p", "MemorySwapMax=0", "-p", "TasksMax=256", "nice", "-n", "10", "env", "-C", str(copy), f"PYTHONPATH={copy}", "PYTHONNOUSERSITE=1",
            "PYTHONDONTWRITEBYTECODE=1", f"TMPDIR={RUN}/tmp", "CUDA_VISIBLE_DEVICES=", "OMP_NUM_THREADS=4", "AWS_CONFIG_FILE=/dev/null",
            "AWS_SHARED_CREDENTIALS_FILE=/dev/null", PY]
    pre = subprocess.run(base + ["-c", PREFLIGHT], capture_output=True, text=True)
    if pre.returncode != 0 or "preflight-ok" not in pre.stdout:
        return {"preflight": "FAILED", "stderr": pre.stderr[-800:]}
    t0 = time.time()
    r = subprocess.run(base + ["-m", "unittest", *tests], capture_output=True, text=True)
    tail = r.stderr.strip().splitlines()[-3:]
    return {"preflight": "ok", "rc": r.returncode, "tail": tail, "seconds": round(time.time() - t0, 1),
            "failing": sorted({l.split("(")[1].split(")")[0].rsplit(".", 1)[-1] + "." + l.split()[1] for l in r.stderr.splitlines()
                               if l.startswith(("FAIL: ", "ERROR: ")) and "(" in l})[:20]}


def one(out: Path, m):
    name, rel, old, new, tests, leak = m
    copy = out / name
    shutil.copytree(SRC, copy)
    f = copy / rel
    s = f.read_text()
    if old is None:
        s2 = s + new
    else:
        if s.count(old) != 1:
            return name, {"status": "NOT-APPLIED", "count": s.count(old), "leak": leak}
        s2 = s.replace(old, new)
    f.write_text(s2)
    res = run_copy(copy, tests)
    status = "PREFLIGHT-FAILED" if res["preflight"] != "ok" else ("killed" if res["rc"] != 0 else "SURVIVED")
    return name, {"status": status, "leak": leak, "file": rel, "tests": tests, "mutated_sha256": sha(s2.encode()), **res}


def main():
    out = Path(sys.argv[1])
    out.mkdir(parents=True, exist_ok=False)
    base = out / "_baseline"
    shutil.copytree(SRC, base)
    b = run_copy(base, BOTH)
    if b.get("rc") != 0:
        print(json.dumps({"baseline": b}))
        return 2
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as ex:
        results = dict(ex.map(lambda m: one(out, m), M))
    files = sorted({m[1] for m in M} | {"tests/test_v2_publish.py", "tests/test_payload_strip.py"})
    doc = {"schema": "jope.dl-v2-mutants/v1", "method": "each mutant in a COPY of SRC with that copy's PYTHONPATH and cwd (preflight asserts the "
           "imported dltrain resolves inside the copy); killed = its test modules fail", "baseline": b,
           "source_sha256": {f: sha((SRC / f).read_bytes()) for f in files}, "harness_sha256": sha(Path(__file__).read_bytes()),
           "code_sha256": sha(Path(__file__).read_bytes()),
           "total": len(results), "killed": sum(r["status"] == "killed" for r in results.values()),
           "survived": sorted(k for k, r in results.items() if r["status"] == "SURVIVED"),
           "not_applied": sorted(k for k, r in results.items() if r["status"] not in ("killed", "SURVIVED")),
           "leak_mutants": {k: r["status"] for k, r in results.items() if r["leak"]}, "results": results,
           "utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    body = (json.dumps(doc, indent=1, sort_keys=True) + "\n").encode()
    with open(out / "mutants-payload-strip.json", "xb") as fh:
        fh.write(body)
    print(json.dumps({"total": doc["total"], "killed": doc["killed"], "survived": doc["survived"], "not_applied": doc["not_applied"],
                      "receipt_sha256": sha(body)}))
    return 0 if doc["killed"] == doc["total"] else 1


if __name__ == "__main__":
    sys.exit(main())
