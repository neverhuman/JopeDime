def early_return(func: str, value: str = "None"):
    """A mutation that makes ``func`` (a module-level def) return ``value`` before its first statement."""
    def apply(text: str) -> str:
        nodes = [n for n in ast.parse(text).body if isinstance(n, ast.FunctionDef) and n.name == func]
        if len(nodes) != 1:
            raise RuntimeError(f"expected one def {func}, found {len(nodes)}")
        first = nodes[0].body[0]
        lines = text.splitlines(keepends=True)
        lines.insert(first.lineno - 1, " " * first.col_offset + f"return {value}\n")
        return "".join(lines)
    apply.label = f"early return {value} in {func}"
    return apply


def replace(old: str, new: str):
    def apply(text: str) -> str:
        n = text.count(old)
        if n != 1:
            raise RuntimeError(f"mutation text found {n} times: {old[:80]!r}")
        return text.replace(old, new)
    apply.label = f"{old.strip()[:70]!r} -> {new.strip()[:50]!r}"
    return apply


