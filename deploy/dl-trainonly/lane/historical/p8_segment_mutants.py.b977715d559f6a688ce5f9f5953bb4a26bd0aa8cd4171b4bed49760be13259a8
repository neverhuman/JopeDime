def sha_file(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def make_copy(dest: Path) -> None:
    dest.mkdir(parents=True)
    for d in COPY_DIRS:
        shutil.copytree(SRC / d, dest / d, ignore=shutil.ignore_patterns("__pycache__"))
    (dest / "tests").mkdir()
    for f in COPY_FILES:
        shutil.copy2(SRC / f, dest / f)
    (dest / "p8_mutant_runner.py").write_text(RUNNER)


def run_suite(copy: Path, exclude: list[str], log: Path) -> dict:
    env = {"PYTHONPATH": str(copy), "PYTHONNOUSERSITE": "1", "PYTHONDONTWRITEBYTECODE": "1",
           "TMPDIR": str(RUN / "tmp"), "CUDA_VISIBLE_DEVICES": "", "OMP_NUM_THREADS": "4",
           "AWS_CONFIG_FILE": "/dev/null", "AWS_SHARED_CREDENTIALS_FILE": "/dev/null", "HOME": "/home/ubuntu",
           "PATH": "/usr/bin:/bin"}
    t0 = time.monotonic()
    proc = subprocess.run([PY, "p8_mutant_runner.py", json.dumps(exclude)], cwd=copy, env=env, capture_output=True,
                          text=True, timeout=TIMEOUT_S)
    log.write_text(proc.stdout + "\n---- stderr ----\n" + proc.stderr)
    out = {"returncode": proc.returncode, "wall_s": round(time.monotonic() - t0, 1),
           "import_guard": "P8SEG-IMPORT-GUARD" in proc.stderr + proc.stdout}
    lines = [x for x in proc.stdout.splitlines() if x.startswith("P8MUT_RESULT ")]
    out.update(json.loads(lines[0].split(" ", 1)[1]) if lines else {"ran": None, "failed": None, "ok": None})
    m = re.findall(r"^(?:FAIL|ERROR): (\S+) .*$", proc.stderr, re.M)
    out["first_failure_line"] = m[0] if m else None
    return out


def run_mutant(base: Path, name: str, exclude: list[str]) -> dict:
    kind, muts = MUTANTS[name] if name != "baseline_unmutated" else ("baseline", [])
    d = base / name
    make_copy(d)
    applied = []
    for rel, fn in muts:
        p = d / rel
        before = p.read_text()
        after = fn(before)
        if after == before:
            raise RuntimeError(f"{name}: mutation left {rel} unchanged")
        p.write_text(after)
        applied.append({"file": rel, "mutation": fn.label, "src_sha256": sha_file(SRC / rel),
                        "mutant_sha256": sha_file(p)})
    res = run_suite(d, exclude, base / f"{name}.log")
    if res["import_guard"]:
        verdict = "HARNESS_ERROR"
    elif kind == "baseline":
        verdict = "BASELINE_OK" if res["ok"] else "BASELINE_FAILED"
    elif res["ok"] is None:
        verdict = "HARNESS_ERROR"
    else:
        verdict = "SURVIVED" if res["ok"] else "DETECTED"
    return {"name": name, "kind": kind, "verdict": verdict, "applied": applied, **res}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("names", nargs="*")
    ap.add_argument("--jobs", type=int, default=3)
    ap.add_argument("--exclude", action="append", default=[], help="test id to drop (a known baseline failure)")
    args = ap.parse_args()
    names = args.names or sorted(MUTANTS)
    unknown = sorted(set(names) - set(MUTANTS))
    if unknown:
        raise SystemExit(f"unknown mutants {unknown}")
    src_before = {f: sha_file(SRC / f) for f in ("dltrain/train.py", "dltrain/tranche.py", COPY_FILES[-1])}
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    base = ROOT / f"mutants-{stamp}"
    base.mkdir(parents=True)
    print(f"mutant root {base}; SRC sha256 {json.dumps(src_before)}", flush=True)
    baseline = run_mutant(base, "baseline_unmutated", args.exclude)
    print(json.dumps({k: baseline[k] for k in ("name", "verdict", "ran", "failed", "wall_s")}), flush=True)
    results = [baseline]
    if baseline["verdict"] != "BASELINE_OK":
        print("baseline copy does not pass: mutant verdicts would be meaningless; stopping", flush=True)
    else:
        with concurrent.futures.ThreadPoolExecutor(max_workers=args.jobs) as pool:
            futs = {pool.submit(run_mutant, base, n, args.exclude): n for n in names}
            for fut in concurrent.futures.as_completed(futs):
                try:
                    r = fut.result()
                except Exception as err:  # noqa: BLE001 - a broken mutation is a harness error, reported
                    r = {"name": futs[fut], "kind": MUTANTS[futs[fut]][0], "verdict": "HARNESS_ERROR",
                         "error": repr(err)[:500]}
                results.append(r)
                print(json.dumps({k: r.get(k) for k in ("name", "kind", "verdict", "failed", "wall_s", "error")}),
                      flush=True)
    src_after = {f: sha_file(SRC / f) for f in src_before}
    summary = {
        "schema": "jope.dl-p8-segment-mutants/v1", "stamp": stamp, "src": str(SRC), "src_sha256_before": src_before,
        "src_sha256_after": src_after, "src_unchanged": src_before == src_after, "exclude": args.exclude,
        "counts": {v: sum(1 for r in results if r["verdict"] == v)
                   for v in ("BASELINE_OK", "BASELINE_FAILED", "DETECTED", "SURVIVED", "HARNESS_ERROR")},
        "guard_survivors": sorted(r["name"] for r in results if r["verdict"] == "SURVIVED" and r["kind"] == "guard"),
        "layer_survivors": sorted(r["name"] for r in results if r["verdict"] == "SURVIVED" and r["kind"] == "layer"),
        "results": sorted(results, key=lambda r: r["name"]),
    }
    (base / "summary.json").write_text(json.dumps(summary, indent=1, sort_keys=True))
    print(json.dumps({k: summary[k] for k in ("counts", "guard_survivors", "layer_survivors", "src_unchanged")}),
          flush=True)
    print(f"summary {base / 'summary.json'}", flush=True)
    ok = (baseline["verdict"] == "BASELINE_OK" and not summary["guard_survivors"]
          and not summary["counts"]["HARNESS_ERROR"] and summary["src_unchanged"])
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
