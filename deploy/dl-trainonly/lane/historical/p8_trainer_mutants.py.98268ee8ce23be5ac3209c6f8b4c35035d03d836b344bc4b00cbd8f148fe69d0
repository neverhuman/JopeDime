def run_one(name, rel, old, new, out):
    d = out / name
    shutil.copytree(SRC, d, ignore=shutil.ignore_patterns("__pycache__"))
    if rel:
        p = d / rel; s = p.read_text()
        if s.count(old) != 1:
            return {"mutant": name, "status": "PATCH_NOT_FOUND", "count": s.count(old)}
        p.write_text(s.replace(old, new))
    t = out / "tmp" / name; t.mkdir(parents=True, exist_ok=True)
    cmd = ["env", "-C", str(d), f"PYTHONPATH={d}", "PYTHONNOUSERSITE=1", "PYTHONDONTWRITEBYTECODE=1", f"TMPDIR={t}",
           "CUDA_VISIBLE_DEVICES=", "OMP_NUM_THREADS=2", PY, "-c",
           "import sys,unittest,dltrain; assert dltrain.__file__.startswith(sys.argv[1]), dltrain.__file__; "
           "r=unittest.main(module=None, argv=['x','tests.test_p8_trainer','-f'], exit=False); sys.exit(0 if r.result.wasSuccessful() else 1)",
           str(d)]
    t0 = time.time(); pr = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
    return {"mutant": name, "file": rel, "rc": pr.returncode, "killed": pr.returncode != 0, "wall_s": round(time.time() - t0, 1),
            "tail": pr.stderr[-300:]}
def main():
    out = RUN / "tmp/p8/mutants" / time.strftime("run-%Y%m%dT%H%M%SZ", time.gmtime()); out.mkdir(parents=True)
    base = run_one("baseline", None, None, None, out)
    res = {"baseline": base, "mutants": []}
    if base["rc"] != 0:
        print(json.dumps(res)); sys.exit(2)
    with concurrent.futures.ThreadPoolExecutor(3) as ex:
        res["mutants"] = list(ex.map(lambda m: run_one(*m, out), M))
    res["killed"] = sum(m.get("killed", False) for m in res["mutants"]); res["total"] = len(M)
    (out / "results.json").write_text(json.dumps(res, indent=1))
    print(json.dumps({"out": str(out), "killed": res["killed"], "total": res["total"],
                      "survived": [m["mutant"] for m in res["mutants"] if not m.get("killed")]}))
main()
