def _nvidia_smi(query: str) -> str:
    return subprocess.run(["nvidia-smi", f"--query-{query}", "--format=csv,noheader,nounits"], capture_output=True,
                          text=True, timeout=15, check=True).stdout


def foreign_compute_apps(self_pid: int) -> list[str]:
    """nvidia-smi compute apps whose pid is not this process (read-only; process_name is nvidia-smi's column)."""
    rows = [r.strip() for r in _nvidia_smi("compute-apps=pid,process_name,used_memory").splitlines() if r.strip()]
    return [r for r in rows if r.split(",")[0].strip() != str(self_pid)]


def smoke_configs(size: str, width: int, *, steps: int, commit_every: int, b_ctx: int = 32, dropout: float = 0.1,
                  spec_kw: dict | None = None, autocast: str | None = "bfloat16", publish_every: int | None = None):
    spec = synthetic_data.SyntheticSpec(ctx_dim=width, **(spec_kw or {}))
    scfg = sampler_mod.SamplerConfig(b_ctx=b_ctx)
    mcfg = model_mod.size_config(size, vocab_size=spec.vocab_size, ctx_dim=width, max_seq=spec.max_seq,
                                 dropout=dropout)
    tcfg = train.TrainConfig(lr=3e-4, lr_min=3e-5, warmup=min(1000, max(1, steps // 10)), commit_every_updates=commit_every,
                             commit_every_seconds=1200.0, eval_every_epochs=None, autocast_dtype=autocast,
                             num_threads=4, ctx_drop_prob=0.0, ctx_noise_std=0.0, publish_every_updates=publish_every)
    return spec, scfg, mcfg, tcfg


def bench(args) -> int:
    t_start = time.monotonic()
    out = Path(args.out_dir)
    out.mkdir(parents=True, exist_ok=False)
    device = "cuda" if args.device == "cuda" else "cpu"
    pre = foreign_compute_apps(os.getpid()) if device == "cuda" else []
    if pre:
        common.immutable_write(out / "refused.json", common.canonical({"refused": "foreign compute apps", "apps": pre}))
        print(json.dumps({"refused": "foreign compute apps", "apps": pre}), flush=True)
        return 3
    spec, scfg, mcfg, tcfg = smoke_configs(args.size, args.width, steps=args.steps, commit_every=args.commit_every,
                                           b_ctx=args.b_ctx, spec_kw=json.loads(args.spec_json or "{}"),
                                           autocast="bfloat16" if device == "cuda" else None)
    t0 = time.monotonic()
    data = synthetic_data.train_data(spec, scfg)
    build_s = time.monotonic() - t0
    plan = train.make_run_plan(run_id=args.run_id, run_seed=os.urandom(32), arm=f"synthetic-W{args.width}",
                               objective="successor-v1", model=mcfg, sampler=scfg, train=tcfg,
                               max_updates=args.steps, storage_cap_bytes=None, refs=synthetic_data.refs(spec),
                               device=device)
    plan_res = train.write_run_plan(out / "run-plan.json", plan)
    common.immutable_write(out / "data-spec.json", common.canonical(spec.to_json()))
    # CPU cost of the pure draw+collate for a few future steps (no global RNG; the sampler is counter-based).
    probe = sampler_mod.MacroSampler(data.fit, bytes.fromhex(plan["run_seed_hex"]), scfg)
    collate_s, seqs, toks = [], [], []
    for k in range(1, 6):
        c0 = time.monotonic()
        b = sampler_mod.collate(probe.draw(10_000 + k), data)
        collate_s.append(time.monotonic() - c0)
        seqs.append(int(b.tokens.shape[0]))
        toks.append(int(b.n_tokens))
    times: list[float] = []
    mem: list[int] = []

    def after_step(step: int) -> None:
        if device == "cuda":
            mem.append(int(torch.cuda.max_memory_allocated()))
        times.append(time.monotonic())

    t0 = time.monotonic()
    times.append(t0)
    res = train.run(plan, data, out / "work", hooks=train.TrainHooks(after_step=after_step))
    wall = time.monotonic() - t0
    dts = [b - a for a, b in zip(times, times[1:])]
    steady = dts[min(10, len(dts) // 4):] if dts else []
    med = statistics.median(steady) if steady else None
    gpu = None
    if device == "cuda":
        props = torch.cuda.get_device_properties(0)
        gpu = {"name": props.name, "total_mib": props.total_memory // 2**20,
               "max_memory_allocated_mib": torch.cuda.max_memory_allocated() / 2**20,
               "max_memory_reserved_mib": torch.cuda.max_memory_reserved() / 2**20,
               "nvidia_smi_after": _nvidia_smi("gpu=memory.used,memory.total,utilization.gpu,temperature.gpu").strip()}
    mean_seqs, mean_toks = statistics.mean(seqs), statistics.mean(toks)
    doc = {"schema": BENCH_SCHEMA, "host": socket.gethostname(), "utc_us": common.utc_us(), "run_id": args.run_id,
           "device": device, "size": args.size, "width": args.width, "b_ctx": args.b_ctx,
           "parameters": sum(p.numel() for p in model_mod.PolicyLM(mcfg).parameters()),
           "spec": spec.to_json(), "spec_sha256": spec.sha256(), "data_build_s": build_s,
           "run_plan": plan_res, "result": res.to_json(), "wall_s": wall, "steps": len(dts),
           "step_s_median_steady": med, "step_s_mean_all": statistics.mean(dts) if dts else None,
           "steps_per_s": (1.0 / med) if med else None,
           "collate_s_median": statistics.median(collate_s), "sequences_per_step_mean": mean_seqs,
           "tokens_per_step_mean": mean_toks,
           "tokens_per_s": (mean_toks / med) if med else None, "sequences_per_s": (mean_seqs / med) if med else None,
           "gpu": gpu, "max_rss_kib": __import__("resource").getrusage(__import__("resource").RUSAGE_SELF).ru_maxrss,
           "process_wall_s": time.monotonic() - t_start, "step_times_s": [round(x, 5) for x in dts]}
    common.immutable_write(out / "bench.json", common.canonical(doc))
    print(json.dumps({k: doc[k] for k in ("run_id", "size", "width", "steps", "step_s_median_steady", "steps_per_s",
                                           "tokens_per_s", "collate_s_median", "parameters")} | {"gpu": gpu,
                                                                                               "status": res.status}),
          flush=True)
    return 0 if res.status == "COMPLETED" else 1


