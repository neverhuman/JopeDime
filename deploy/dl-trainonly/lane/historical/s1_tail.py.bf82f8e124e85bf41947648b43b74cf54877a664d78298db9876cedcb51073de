def adapt_ledger_row(row: Any) -> tuple[str, dict]:
    """The one place that reads a production ledger row (s1-prod/code/ledger.py). Returns (kind, fields) with kind in
    LEDGER_EVENTS, "outer_test" (ignored entirely, never parsed) or "other" (counted, ignored)."""
    if not isinstance(row, Mapping):
        raise S1TailError(f"ledger row is not an object: {str(row)[:80]}")
    ev = row.get("event")
    if not isinstance(ev, str):
        return "other", {}
    if ev not in LEDGER_EVENTS:
        return ("outer_test" if is_outer_test_key(ev) else "other"), {}
    if ev == "open":
        return "open", {"ledger": row.get("ledger"), "header_sha256": row.get("header_sha256")}
    ctx = row.get("context_sha256")
    if not isinstance(ctx, str) or not HEX64.fullmatch(ctx):
        raise S1TailError(f"{ev} row without a valid context_sha256: {str(row)[:120]}")
    if ev != "final":
        return ev, {"context_sha256": ctx, "view_id": row.get("view_id"), "use": row.get("use"),
                    "host": row.get("host")}
    attempts = row.get("attempts") if isinstance(row.get("attempts"), Mapping) else {}
    return "final", {
        "context_sha256": ctx, "view_id": row.get("view_id"), "set": row.get("set"), "cut_id": row.get("cut_id"),
        "use": row.get("use"), "host": row.get("host"), "unit": row.get("unit"), "outcome": row.get("outcome"),
        "charged": attempts.get("charged"), "by_status": attempts.get("by_status"),
        "selected_program_sha256": row.get("selected_program_sha256"),
        "final_sha256": row.get("final_sha256"), "summary_sha256": row.get("summary_sha256"),
        "host_custody": row.get("host_custody")}


def attempt_files(plan: Mapping, ordinal: int, stage: Any, slot: Any) -> tuple[str, int | None]:
    """(file name, list index or None) of the evaluation record of one attempt (s1prod_context.py layout)."""
    g0, per_gen, gens = plan["g0"], plan["per_generation"], plan["generations"]
    if ordinal < g0:
        if stage != "g0" or slot != ordinal:
            raise ContextRefused("attempt_plan_mismatch", f"ordinal {ordinal} stage {stage} slot {slot}")
        return "g0-evaluations.json", ordinal
    g, k = divmod(ordinal - g0, per_gen)
    if g >= gens or stage != f"gen{g:02d}" or slot != k:
        raise ContextRefused("attempt_plan_mismatch", f"ordinal {ordinal} stage {stage} slot {slot}")
    return f"gen{g:02d}/{k:02d}.pack.json.gz", None


def adapt_evaluation(rec: Any, context_sha256: str) -> dict:
    """The one place that reads a jope.s1-evaluation/v1 record. Returns inner-CV facts only; refuses outer-test
    material anywhere in the record and any fold whose kind is not inner_cv; then tranche.assert_inner_cv_record (the
    trainer-side guard) must accept it too (else label_source_refused)."""
    if not isinstance(rec, Mapping) or rec.get("schema") != EVAL_SCHEMA:
        raise ContextRefused("evaluation_format", f"schema {rec.get('schema') if isinstance(rec, Mapping) else rec!r}")
    leak = outer_test_paths(rec, numeric_only=False)
    if leak:
        raise ContextRefused("outer_test_in_selection_record", ",".join(leak[:4]))
    if rec.get("fold_protocol") != PROTOCOL:
        raise ContextRefused("evaluation_format", f"fold_protocol {rec.get('fold_protocol')!r}")
    if rec.get("context_sha256", context_sha256) != context_sha256:
        raise ContextRefused("evaluation_context_mismatch", str(rec.get("context_sha256"))[:16])
    prog = rec.get("program")
    if not isinstance(prog, Mapping) or not isinstance(prog.get("dsl"), str):
        raise ContextRefused("evaluation_format", "program.dsl missing")
    dsl, psha = prog["dsl"], prog.get("program_sha256")
    if not isinstance(psha, str) or _sha(dsl.encode("utf-8")) != psha:
        raise ContextRefused("program_sha256_mismatch", str(psha)[:16])
    status = rec.get("status")
    if status not in ("completed", "failed", "timeout"):
        raise ContextRefused("evaluation_format", f"status {status!r}")
    folds = rec.get("inner_cv")
    if folds is not None and not isinstance(folds, list):
        raise ContextRefused("evaluation_format", "inner_cv is not a list")
    for f in folds or ():
        if not isinstance(f, Mapping) or f.get("kind") != "inner_cv":
            raise ContextRefused("non_inner_cv_fold_in_label", str(f.get("kind") if isinstance(f, Mapping) else f))
    try:
        tranche.assert_inner_cv_record(rec)                 # the trainer-side guard, as a second line
    except tranche.LabelSourceRefused as err:
        raise ContextRefused("label_source_refused", str(err)[:200]) from None
    facts = {"status": status, "program_sha256": psha, "dsl": dsl, "rmse_j": None, "baseline_rmse_j": None,
             "wall_us": None, "score_rows": None, "train_rows": None}
    if folds is None:
        if status == "completed":
            raise ContextRefused("evaluation_format", "completed record without inner_cv")
        return facts
    if status != "completed":
        return facts
    if len(folds) != INNER_FOLDS or rec.get("inner_cv_folds") != INNER_FOLDS:
        raise ContextRefused("evaluation_format", f"{len(folds)} inner folds")
    rmse, base, walls, score, train = [], [], [], [], []
    for j, f in enumerate(folds):
        if f.get("index") != j:
            raise ContextRefused("evaluation_format", f"fold index {f.get('index')} at {j}")
        r = (f.get("metrics") or {}).get("rmse")
        b = (f.get("baseline_metrics") or {}).get("rmse")
        if not (_is_real(r) and _is_real(b)):
            raise ContextRefused("evaluation_format", f"fold {j} rmse/baseline not numeric")
        rmse.append(float(r))
        base.append(float(b))
        w = f.get("wall_us")
        walls.append(int(w) if isinstance(w, int) and not isinstance(w, bool) and w >= 0 else None)
        score.append(f.get("score_rows"))
        train.append(f.get("train_rows"))
    facts.update({"rmse_j": rmse, "baseline_rmse_j": base,
                  "wall_us": None if None in walls else sum(walls),
                  "score_rows": score if all(isinstance(x, int) for x in score) else None,
                  "train_rows": train if all(isinstance(x, int) for x in train) else None})
    return facts


# ------------------------------------------------------------------------------------------------------- ledger tail

class LedgerTail:
    """Append-only JSONL ledger with a persisted cursor {path, offset, prefix_sha256, lines}. read_new() verifies that
    the consumed prefix still hashes the same (else LedgerRewritten) and returns only complete new lines."""

    def __init__(self, path: Path | str, cursor: Mapping | None = None):
        self.path = Path(path)
        self.cursor = dict(cursor) if cursor else {"path": str(self.path), "offset": 0,
                                                   "prefix_sha256": EMPTY_SHA256, "lines": 0}
        if self.cursor.get("path") != str(self.path):
            raise LedgerRewritten(f"cursor belongs to {self.cursor.get('path')}, not {self.path}")

    def read_new(self) -> list[tuple[int, bytes]]:
        off, want, lines = int(self.cursor["offset"]), self.cursor["prefix_sha256"], int(self.cursor["lines"])
        try:
            f = guard_path(self.path).open("rb")
        except FileNotFoundError:
            if off:
                raise LedgerRewritten(f"{self.path}: vanished after {off} consumed bytes") from None
            return []
        with f:
            size = os.fstat(f.fileno()).st_size
            if size < off:
                raise LedgerRewritten(f"{self.path}: truncated to {size} < consumed {off} bytes")
            h, nl, left = hashlib.sha256(), 0, off
            while left:
                block = f.read(min(left, 1 << 20))
                if not block:
                    raise LedgerRewritten(f"{self.path}: short read inside the consumed prefix")
                h.update(block)
                nl += block.count(b"\n")
                left -= len(block)
            if h.hexdigest() != want or nl != lines:
                raise LedgerRewritten(f"{self.path}: the consumed prefix ({off} bytes, {lines} lines) was rewritten")
            tail = f.read(size - off)
        cut = tail.rfind(b"\n")
        if cut < 0:
            return []
        complete = tail[:cut + 1]
        h.update(complete)
        new = complete.split(b"\n")[:-1]
        self.cursor = {"path": str(self.path), "offset": off + len(complete), "prefix_sha256": h.hexdigest(),
                       "lines": lines + len(new)}
        return [(lines + i + 1, b) for i, b in enumerate(new)]


# ---------------------------------------------------------------------------------------------- P3 and admission

class P3:
    """P3 family assignment by dataset_hash (holdout.json assignment + registry members), both sha256-pinned."""

    def __init__(self, holdout: Path | str, holdout_sha256: str, registry: Path | str, registry_sha256: str):
        hb, rb = guarded_read(holdout), guarded_read(registry)
        if _sha(hb) != holdout_sha256 or _sha(rb) != registry_sha256:
            raise S1TailError("P3 holdout/registry sha256 differs from the ledger header pin")
        self.holdout_sha256, self.registry_sha256 = holdout_sha256, registry_sha256
        self.assignment = json.loads(hb)["assignment"]
        self.family_of: dict[str, str] = {}
        for fid, fam in json.loads(rb)["families"].items():
            for m in fam.get("members") or []:
                if m.get("dataset_hash"):
                    self.family_of[m["dataset_hash"]] = fid

    def lookup(self, dataset_hash: str) -> tuple[str | None, str | None]:
        fam = self.family_of.get(dataset_hash)
        return fam, (self.assignment.get(fam) if fam is not None else None)


def admit(denylist: Path | str, denylist_sha256: str, view_id: str, assignment: str | None,
          keys: Sequence[str] = (), _cache: dict | None = None) -> tuple[str, str]:
    """(assignment, split_role) or ContextRefused. Fail closed through dltrain.admission.Admission."""
    cache = _cache if _cache is not None else {}
    sel = cache.get("select") or cache.setdefault("select", admission_mod.Admission(denylist, denylist_sha256,
                                                                                    purpose="selection"))
    trn = cache.get("train") or cache.setdefault("train", admission_mod.Admission(denylist, denylist_sha256,
                                                                                  purpose="train"))
    if sel.ok:
        listed = sel.assign.get(view_id)
        if assignment is not None and listed is not None and listed != assignment:
            raise ContextRefused("assignment_disagreement", f"P3 {assignment} != denylist {listed}")
    try:
        got = sel.check(view_id, assignment=assignment)
        for k in keys:
            sel.check(view_id, key=k, assignment=assignment)
    except admission_mod.AdmissionRefused as err:
        raise ContextRefused("admission", str(err)[:200]) from None
    if got == DEV:
        return DEV, DEV
    if got not in TRAIN_ASSIGNMENTS:
        raise ContextRefused("admission", f"{view_id}: assignment {got!r} is not trainable (fail closed)")
    try:
        trn.check(view_id, assignment=assignment)
    except admission_mod.AdmissionRefused as err:
        raise ContextRefused("admission", str(err)[:200]) from None
    return got, "train_fit"


# ------------------------------------------------------------------------------------------------------ encodings

class EncodingResolver:
    """Per-context encoding vectors from the local v2 build trees: CONTEXT_GLOBS under each tree (directories with
    .done only), identity-checked (context_sha256 and view_id), each file verified against that tree's context.json
    "files" sha256/bytes and decoded as a finite float32 vector. A component whose trees disagree is a conflict and
    is not resolved; nothing is ever imputed."""

    def __init__(self, trees: Sequence[Path | str]):
        self.trees = tuple(Path(t) for t in trees)

    def resolve(self, ctx: str, view_id: str) -> dict:
        cands: dict[str, list[dict]] = {}
        identity_mismatch = []
        for tree in self.trees:
            for pat in CONTEXT_GLOBS:
                for cj in sorted(tree.glob(pat.format(view=glob.escape(view_id)))):
                    d = cj.parent
                    if is_denied_path(cj) or not (d / ".done").exists():
                        continue                                     # outer-test subtrees are never walked
                    cjb = guarded_read(cj)
                    doc = json.loads(cjb)
                    if doc.get("context_sha256") != ctx or doc.get("view_id") != view_id:
                        identity_mismatch.append(str(cj))
                        continue
                    for name, meta in sorted((doc.get("files") or {}).items()):
                        suffix = Path(name).suffix
                        if suffix in COMPONENT_FORMATS and isinstance(meta, Mapping):
                            cands.setdefault(Path(name).stem, []).append(
                                {"path": d / name, "sha256": meta.get("sha256"), "bytes": meta.get("bytes"),
                                 "format": COMPONENT_FORMATS[suffix], "context_json_sha256": _sha(cjb)})
        found, conflicts, invalid = {}, [], {}
        for comp in sorted(cands):
            lst = cands[comp]
            if len({c["sha256"] for c in lst}) != 1:
                conflicts.append(comp)
                continue
            reason = "file_missing"
            for c in lst:
                if is_denied_path(c["path"]):
                    continue
                try:
                    b = guarded_read(c["path"])
                except OSError:
                    continue
                if _sha(b) != c["sha256"] or len(b) != c["bytes"]:
                    reason = "sha256_mismatch"
                    continue
                try:
                    vec = decode_vector(b, c["format"])
                except ValueError as err:
                    reason = f"decode:{err}"
                    continue
                found[comp] = {"path": str(c["path"]), "sha256": c["sha256"], "bytes": len(b), "format": c["format"],
                               "dtype": "float32", "shape": [int(vec.shape[0])],
                               "context_json_sha256": c["context_json_sha256"]}
                break
            else:
                invalid[comp] = reason
        return {"found": found, "conflicts": conflicts, "invalid": invalid,
                "identity_mismatch": len(identity_mismatch)}


def assembly_views(doc: Any) -> dict[str, dict]:
    """ADAPTER (assumed format of an encoding assembly receipt/manifest): every object holding a "view_id" plus a
    "context_json_sha256" and/or a "files" map ({name: sha256 | {sha256, ...}}) and/or "<component>_sha256" keys, at any
    depth. Returns {view_id: {"context_json_sha256": str | None, "files": {stem: sha256}}}; a view listed twice with
    different digests is dropped (fail closed)."""
    out: dict[str, dict] = {}
    bad: set[str] = set()

    def visit(x: Any) -> None:
        if isinstance(x, Mapping):
            vid = x.get("view_id")
            if isinstance(vid, str):
                files = {}
                fmap = x.get("files") if isinstance(x.get("files"), Mapping) else {}
                for name, v in fmap.items():
                    h = v.get("sha256") if isinstance(v, Mapping) else v
                    if isinstance(h, str) and HEX64.fullmatch(h):
                        files[Path(name).stem] = h
                for k, v in x.items():
                    if k.endswith("_sha256") and k not in ("context_json_sha256", "context_sha256") \
                            and isinstance(v, str) and HEX64.fullmatch(v):
                        files.setdefault(k[:-len("_sha256")], v)
                cjs = x.get("context_json_sha256") if isinstance(x.get("context_json_sha256"), str) else None
                if files or cjs:
                    entry = {"context_json_sha256": cjs, "files": files}
                    if vid in out and out[vid] != entry:
                        bad.add(vid)
                    out[vid] = entry
            for v in x.values():
                visit(v)
        elif isinstance(x, list):
            for v in x:
                visit(v)

    visit(doc)
    return {v: e for v, e in out.items() if v not in bad}


def completion_tsv_views(receipt: Path | str, doc: Mapping) -> tuple[dict[str, dict], str]:
    """ADAPTER for jope.dl-hyperion-v6all-encode-completion/v1 (RUN/build-v2/GPU-v6all/host-receipts): the per-view
    digests live in assembled-set.tsv beside the receipt, lines "<view_id>\t<sha256(context.json)>\t<sha256(npy)>";
    sha256(tsv) must equal doc["assembled_set_sha256"], the line count doc["assembled"], no view may repeat, and the
    receipt must report a label-free fine-tune for every assembled view and no missing or mismatching npy."""
    tsv = Path(receipt).parent / ASSEMBLED_SET_TSV
    tb = guarded_read(tsv)
    want = doc.get("assembled_set_sha256")
    if not isinstance(want, str) or _sha(tb) != want:
        raise S1TailError(f"{tsv} sha256 differs from assembled_set_sha256 {want}")
    lx = doc.get("label_exposure") or {}
    n = doc.get("assembled")
    if (not isinstance(n, int) or (lx.get("counts") or {}).get("label_free_finetune") != n
            or not str(lx.get("value", "")).startswith("label-free")):
        raise S1TailError(f"v6all receipt does not report a label-free fine-tune for all {n} views: {lx}")
    for k in ("missing", "assembled_missing", "assembled_npy_mismatch"):
        if doc.get(k) not in ([], None):
            raise S1TailError(f"v6all receipt {k} is not empty: {str(doc.get(k))[:120]}")
    views: dict[str, dict] = {}
    for i, line in enumerate(tb.decode("utf-8").splitlines()):
        parts = line.split("\t")
        if len(parts) != 3 or not all(HEX64.fullmatch(x) for x in parts[1:]):
            raise S1TailError(f"{tsv}:{i + 1} is not view_id<TAB>sha256<TAB>sha256")
        if parts[0] in views:
            raise S1TailError(f"{tsv}: view {parts[0]} listed twice")
        views[parts[0]] = {"context_json_sha256": parts[1], "files": {"hyperion_v6all": parts[2]}}
    if len(views) != n:
        raise S1TailError(f"{tsv} lists {len(views)} views, the receipt says {n}")
    return views, want


class PinnedEncodingSet:
    """An assembled encoding set pinned by its assembly receipt's sha256 (fail closed). Resolves only `components`
    (default PINNED_COMPONENTS), only for views the receipt lists, from the assembled tree (CONTEXT_GLOBS, .done,
    identity and context.json `files` checks as EncodingResolver), and each vector must also match the receipt's
    per-view digest (file sha256 and/or context.json sha256). Anything else is missing: the context is excluded."""

    def __init__(self, tree: Path | str, receipt: Path | str, receipt_sha256: str,
                 components: Sequence[str] = tuple(PINNED_COMPONENTS)):
        rb = guarded_read(receipt)
        if _sha(rb) != receipt_sha256:
            raise S1TailError(f"encoding assembly receipt {receipt} sha256 differs from the pin {receipt_sha256}")
        doc = json.loads(rb)
        self.assembled_set_sha256 = None
        if isinstance(doc, Mapping) and doc.get("schema") == V6ALL_COMPLETION_SCHEMA:
            self.views, self.assembled_set_sha256 = completion_tsv_views(receipt, doc)
        else:
            self.views = assembly_views(doc)
        if not self.views:
            raise S1TailError(f"encoding assembly receipt {receipt} lists no per-view digests (view_id with "
                              "context_json_sha256 / files / <component>_sha256); refusing (fail closed)")
        self.tree, self.receipt, self.receipt_sha256 = guard_path(tree), str(receipt), receipt_sha256
        self.components = frozenset(components)
        self._resolver = EncodingResolver([self.tree])

    def resolve(self, ctx: str, view_id: str) -> dict:
        listed = self.views.get(view_id)
        if listed is None:
            return {"found": {}, "conflicts": [], "invalid": {}, "identity_mismatch": 0}
        res = self._resolver.resolve(ctx, view_id)
        found, invalid = {}, dict(res["invalid"])
        for comp, ref in res["found"].items():
            if comp not in self.components:
                continue
            want_file = listed["files"].get(comp)
            want_cj = listed["context_json_sha256"]
            if (want_file is None and want_cj is None) or (want_file is not None and want_file != ref["sha256"]) \
                    or (want_cj is not None and want_cj != ref["context_json_sha256"]):
                invalid[comp] = "assembly_receipt_mismatch"
                continue
            found[comp] = dict(ref, source=f"pinned:{self.receipt_sha256[:12]}")
        return {"found": found, "conflicts": res["conflicts"], "invalid": invalid,
                "identity_mismatch": res["identity_mismatch"]}

    def binding(self) -> dict:
        return {"tree": str(self.tree), "receipt": self.receipt, "sha256": self.receipt_sha256,
                "assembled_set_sha256": self.assembled_set_sha256, "components": sorted(self.components),
                "views": len(self.views)}


def decode_vector(b: bytes, fmt: str) -> np.ndarray:
    if fmt == "npy":
        arr = np.load(io.BytesIO(b), allow_pickle=False)
    elif fmt == "f32le":
        if len(b) % 4:
            raise ValueError("f32le length")
        arr = np.frombuffer(b, dtype="<f4")
    else:
        raise ValueError(f"format {fmt}")
    if arr.dtype != np.float32 or arr.ndim != 1 or arr.shape[0] < 1:
        raise ValueError(f"dtype {arr.dtype} shape {arr.shape}")
    if not bool(np.isfinite(arr).all()):
        raise ValueError("non-finite")
    return np.ascontiguousarray(arr, dtype=np.float32)


# ---------------------------------------------------------------------------------------------- evaluation fetch

def parse_host_custody(value: Any, ctx: str) -> tuple[str, str]:
    if not isinstance(value, str) or ":" not in value:
        raise Pending("awaiting_evaluations", "no host_custody")
    host, path = value.split(":", 1)
    if not SAFE_HOST.fullmatch(host) or not SAFE_PATH.fullmatch(path) or ".." in path or Path(path).name != ctx:
        raise ContextRefused("host_custody_format", value[:120])
    return host, path


def fetch_via_ssh(ssh_command: Sequence[str], host_custody: str, ctx: str, names: Sequence[str],
                  timeout_s: int) -> dict[str, bytes]:
    """Read-only stream of exactly `names` from the execution host's context directory (tar -cf -); nothing stored."""
    host, path = parse_host_custody(host_custody, ctx)
    if any(part in path for part in tranche.DENIED_LABEL_PATH_PARTS):
        raise OuterTestPathRefused(f"host_custody {host_custody} lies under an outer-test path")
    remote = f"cd {shlex.quote(path)} && tar -cf - -- " + " ".join(shlex.quote(n) for n in names)
    try:
        res = subprocess.run([*ssh_command, host, remote], capture_output=True, timeout=timeout_s)
    except (OSError, subprocess.TimeoutExpired) as err:
        raise Pending("awaiting_evaluations", f"ssh: {type(err).__name__}") from None
    if res.returncode != 0:
        raise Pending("awaiting_evaluations", f"ssh rc={res.returncode}: {res.stderr[-200:].decode(errors='replace')}")
    out = {}
    want = set(names)
    try:
        with tarfile.open(fileobj=io.BytesIO(res.stdout), mode="r:") as tar:
            for m in tar.getmembers():
                if m.isfile() and m.name in want:
                    out[m.name] = tar.extractfile(m).read()
    except tarfile.TarError as err:
        raise Pending("awaiting_evaluations", f"tar: {err}") from None
    return out


# ---------------------------------------------------------------------------------------------- record building

def _cv_values(rmse_j: list | None, base_j: list | None) -> tuple[float | None, float | None, float | None]:
    if rmse_j is None or base_j is None:
        return None, None, None
    if not all(math.isfinite(x) and x > 0 for x in rmse_j + base_j):
        return None, None, None
    ratios = [r / b for r, b in zip(rmse_j, base_j)]
    if not all(math.isfinite(x) and x > 0 for x in ratios):
        return None, None, None
    mean_log = (math.log(ratios[0]) + math.log(ratios[1])) / 2.0
    return mean_log, corpus_schema.canonical_cv_log_ratio_sd(rmse_j, base_j), 0.5 * (ratios[0] + ratios[1])


def validate_train_record(rec: Mapping) -> None:
    """The P5 jope.dl-gp-train-record/v1 allowlist (exact field set) and value types. context_schema is the v2
    context's own schema string (corpus_schema's epoch-0 value pattern does not cover v2 contexts)."""
    if tuple(sorted(rec)) != tuple(sorted(RECORD_FIELDS)):
        raise S1TailError(f"record keys differ from the P5 allowlist: {sorted(set(rec) ^ set(RECORD_FIELDS))}")
    for k in ("context_sha256", "program_sha256", "skeleton_sha256"):
        if not isinstance(rec[k], str) or not HEX64.fullmatch(rec[k]):
            raise S1TailError(f"record {k} is not 64 hex")
    if not HEX16.fullmatch(str(rec["dataset_hash"])):
        raise S1TailError("dataset_hash is not 16 hex")
    toks = rec["tokens"]
    if (not isinstance(toks, list) or rec["length"] != len(toks) or len(toks) < 2 or toks[0] != dsl_tokenizer.BOS
            or toks[-1] != dsl_tokenizer.EOS or not all(isinstance(t, int) and 0 <= t < 65536 for t in toks)):
        raise S1TailError("tokens are not BOS..EOS u16 ids of `length`")
    if not corpus_schema.OUTCOME_RE.match(rec["outcome"]):
        raise S1TailError(f"outcome {rec['outcome']!r}")
    for k in ("rmse_j", "baseline_rmse_j"):
        v = rec[k]
        if v is not None and not (isinstance(v, list) and len(v) == 2 and all(isinstance(x, float) for x in v)):
            raise S1TailError(f"{k} must be null or 2 floats")
    for k in ("cv_mean_log_ratio", "cv_log_ratio_sd", "cv_mean_ratio"):
        if rec[k] is not None and not (isinstance(rec[k], float) and math.isfinite(rec[k])):
            raise S1TailError(f"{k} must be null or a finite float")
    if rec["gate_pass"] is not None and not isinstance(rec["gate_pass"], bool):
        raise S1TailError("gate_pass must be null or bool")
    if rec["wall_us"] is not None and not (isinstance(rec["wall_us"], int) and rec["wall_us"] >= 0):
        raise S1TailError("wall_us must be null or an int >= 0")
    if rec["backend"] not in corpus_schema.BACKENDS or not isinstance(rec["shared_seed"], bool):
        raise S1TailError("backend/shared_seed")


def build_records(ctx_meta: Mapping, attempts: Sequence[dict], vocab: dsl_tokenizer.Vocab, max_seq: int,
                  backend: str, seeds: frozenset) -> tuple[list[dict], list[dict], Counter]:
    """One TrainRecord per program (first completed attempt by ordinal, else the first attempt), plus refused
    records (over_max_seq, raw_form) and counts. attempts: [{ordinal, finish_status, facts}] sorted by ordinal."""
    counts: Counter = Counter()
    chosen: dict[str, dict] = {}
    for a in attempts:
        p = a["facts"]["program_sha256"]
        counts["attempts"] += 1
        counts["finish:" + a["finish_status"]] += 1
        prev = chosen.get(p)
        if prev is None:
            chosen[p] = a
            continue
        counts["duplicate_program_attempts"] += 1
        if prev["finish_status"] != "completed" and a["finish_status"] == "completed":
            chosen[p] = a
        elif (prev["finish_status"] == a["finish_status"] == "completed"
              and prev["facts"]["rmse_j"] != a["facts"]["rmse_j"]):
            counts["duplicate_metric_disagreements"] += 1
    records, refused = [], []
    for p in sorted(chosen):
        a = chosen[p]
        facts = a["facts"]
        outcome = STATUS_OUTCOME[a["finish_status"]]
        rmse_j = base_j = None
        if outcome == labels.COMPLETED:
            rmse_j, base_j = facts["rmse_j"], facts["baseline_rmse_j"]
            if not all(math.isfinite(x) and x >= 0 for x in rmse_j + base_j):
                outcome, rmse_j, base_j = labels.NONFINITE, None, None
        cvm, cvsd, ratio = _cv_values(rmse_j, base_j)
        ids = dsl_tokenizer.tokenize(facts["dsl"], vocab)
        if ids[1] == dsl_tokenizer.RAW_BEGIN:
            refused.append({"program_sha256": p, "reason": "raw_form", "length": len(ids), "outcome": outcome})
            continue
        if len(ids) > max_seq:
            refused.append({"program_sha256": p, "reason": "over_max_seq", "length": len(ids), "outcome": outcome})
            continue
        records.append({
            "context_sha256": ctx_meta["context_sha256"], "context_schema": ctx_meta["context_schema"],
            "dataset_hash": ctx_meta["dataset_hash"], "family_id": ctx_meta["family_id"],
            "split_role": ctx_meta["split_role"], "program_sha256": p,
            "skeleton_sha256": dsl_tokenizer.skeleton_sha256(facts["dsl"]), "tokens": ids, "length": len(ids),
            "outcome": outcome, "rmse_j": rmse_j, "baseline_rmse_j": base_j, "cv_mean_log_ratio": cvm,
            "cv_log_ratio_sd": cvsd, "cv_mean_ratio": ratio, "gate_pass": None,
            "wall_us": facts["wall_us"] if outcome == labels.COMPLETED else None,
            "backend": backend, "shared_seed": p in seeds})
    counts["programs"] = len(chosen)
    return records, refused, counts


# ------------------------------------------------------------------------------------------------------- the tailer

@dataclass
class TailConfig:
    ledger_dir: Path
    out_dir: Path
    denylist: Path
    denylist_sha256: str
    exclusion: Path
    exclusion_sha256: str
    evaluation_roots: tuple[Path, ...] = ()
    fetch_ssh: bool = False
    ssh_command: tuple[str, ...] = DEFAULT_SSH
    ssh_timeout_s: int = 900
    encoding_trees: tuple[Path, ...] = DEFAULT_ENCODING_TREES
    vocab_path: Path | None = None
    vocab_sha256: str | None = None
    seed_hashes: Path | None = None
    seed_hashes_sha256: str | None = None
    max_seq: int = DEFAULT_MAX_SEQ
    max_emit: int = 0                     # 0 = no cap per poll
    encoding_sets: tuple = ()             # ({tree, receipt, sha256}, ...): pinned assembled sets bound in header.json
    seed_from: Path | None = None         # a previous tail out dir: reuse its verified shard+prov for an identical final


class S1Tail:
    def __init__(self, cfg: TailConfig):
        self.cfg = cfg
        self.out = Path(cfg.out_dir)
        self.ledger_dir = Path(cfg.ledger_dir)
        if cfg.vocab_path is not None:
            vb = guarded_read(cfg.vocab_path)
            if _sha(vb) != cfg.vocab_sha256:
                raise S1TailError("vocab.json sha256 differs from --vocab-sha256")
            self.vocab = dsl_tokenizer.Vocab.from_json(vb)
        else:
            self.vocab = dsl_tokenizer.Vocab.from_names({})       # data-independent base vocabulary (P4 fixed block)
        self.seeds: frozenset = frozenset()
        if cfg.seed_hashes is not None:
            sb = guarded_read(cfg.seed_hashes)
            if _sha(sb) != cfg.seed_hashes_sha256:
                raise S1TailError("seed hash list sha256 mismatch")
            from dltrain import programs
            self.seeds = programs.load_seed_hashes(cfg.seed_hashes)
        if not 2 <= int(cfg.max_seq) <= 65535:
            raise S1TailError("max_seq out of range")
        for p in (cfg.out_dir, cfg.ledger_dir, cfg.denylist, cfg.exclusion, *cfg.evaluation_roots,
                  *cfg.encoding_trees):
            guard_path(p)
        try:
            self.exclusion = exclusions.load(cfg.exclusion, cfg.exclusion_sha256)
        except exclusions.ExclusionRefused as err:
            raise S1TailError(f"exclusion file refused (fail closed): {err}") from None
        self.encodings = EncodingResolver(cfg.encoding_trees)
        self.pinned_sets = [PinnedEncodingSet(x["tree"], x["receipt"], x["sha256"]) for x in cfg.encoding_sets]
        self._adm_cache: dict = {}

    # ----------------------------------------------------------------------------------------- out-dir plumbing
    def _p(self, *parts: str) -> Path:
        return self.out.joinpath(*parts)

    def _append(self, name: str, doc: Mapping) -> None:
        path = self._p(name)
        if path.exists() and path.stat().st_size:
            with path.open("rb") as f:
                f.seek(-1, os.SEEK_END)
                if f.read(1) != b"\n":
                    raise S1TailError(f"{path}: torn last line; refusing to append")
        with path.open("ab") as f:
            f.write(_line(doc))
            f.flush()
            os.fsync(f.fileno())

    def _read_jsonl(self, name: str) -> list[dict]:
        path = self._p(name)
        if not path.exists():
            return []
        data = path.read_bytes()
        if data and not data.endswith(b"\n"):
            raise S1TailError(f"{path}: torn last line")
        return [json.loads(x) for x in data.splitlines() if x.strip()]

    def _bind_header(self, ledger_header_sha: str, input_list_sha: str, p3: P3, joins=()) -> str:
        doc = {"schema": HEADER_SCHEMA, "ledger_dir": str(self.ledger_dir.resolve()),
               "ledger_header_sha256": ledger_header_sha, "input_list_sha256": input_list_sha,
               "p3": {"holdout_sha256": p3.holdout_sha256, "registry_sha256": p3.registry_sha256},
               "denylist_sha256": self.cfg.denylist_sha256, "vocab_sha256": self.vocab.sha256,
               "vocab_size": self.vocab.size,
               "encoding_sets": [ps.binding() for ps in self.pinned_sets],
               "exclusion": {"path": str(self.cfg.exclusion), "sha256": self.exclusion.sha256,
                             "excluded_contexts": len(self.exclusion.view_ids),
                             "review_contexts": len(self.exclusion.review_view_ids)},
               "max_seq": int(self.cfg.max_seq), "seed_hashes_sha256": self.cfg.seed_hashes_sha256,
               "record_fields": list(RECORD_FIELDS), "shard_schema": SHARD_SCHEMA,
               "label_source": "inner_cv[j].metrics.rmse, inner_cv[j].baseline_metrics.rmse, inner_cv[j].wall_us of "
                               f"{EVAL_SCHEMA} kind=inner_cv ({PROTOCOL}); y_train = JTT1 outer-train rows"}
        if joins:   # join-aware tail: the bound join lists are part of the header, so a tail dir can never change its joins
            doc["join_input_lists"] = list(joins)
        body = _line(doc)
        try:
            common.immutable_write(self._p("header.json"), body, mode=0o444)
        except common.ImmutableConflict:
            raise S1TailError(f"{self._p('header.json')} binds other inputs (ledger header, input list, P3, denylist, "
                              "vocab, max_seq or seeds); use a new --out") from None
        return _sha(body)

    # ----------------------------------------------------------------------------------------------- one poll
    def poll(self) -> dict:
        self.out.mkdir(parents=True, exist_ok=True)
        with self._p(".lock").open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise S1TailError(f"{self.out} is locked by another writer") from None
            return self._poll()

    def _poll(self) -> dict:
        hpath = self.ledger_dir / LEDGER_HEADER_NAME
        if not hpath.exists():
            return {"status": "waiting_for_ledger_header", "ledger_dir": str(self.ledger_dir)}
        hb = guarded_read(hpath)
        hsha = _sha(hb)
        hdr = json.loads(hb)
        if hdr.get("schema") != LEDGER_HEADER_SCHEMA:
            raise S1TailError(f"ledger header schema {hdr.get('schema')!r}")
        il = hdr["input_list"]
        ilb = guarded_read(il["path"])
        if _sha(ilb) != il["sha256"]:
            raise S1TailError("input list sha256 differs from the ledger header")
        rows = {}
        for r in json.loads(ilb)["admitted"]:
            if r["context_sha256"] in rows:
                raise S1TailError(f"input list repeats {r['context_sha256']}")
            rows[r["context_sha256"]] = r
        refused_rows = {r["context_sha256"] for r in json.loads(ilb).get("refused", [])}
        for r in rows.values():
            r["_input_list_sha256"] = il["sha256"]
        joins = []   # S1 joins under the SAME ledger header (non-raw/group, fill): every registration and list sha-checked
        jdir = self.ledger_dir / "joins"
        for jp in (sorted(jdir.glob("*.json")) if jdir.is_dir() else []):
            jrb = guarded_read(jp)
            jr = json.loads(jrb)
            if jr.get("schema") != JOIN_SCHEMA or jr.get("header_sha256") != hsha:
                raise S1TailError(f"{jp}: join registration does not bind this ledger header")
            jb = guarded_read(jr["input_list"])
            if _sha(jb) != jr["sha256"]:
                raise S1TailError(f"{jp}: join input list sha256 differs from its registration")
            jd = json.loads(jb)
            for r in jd["admitted"]:
                if r["context_sha256"] in rows:
                    raise S1TailError(f"join {jp.name} repeats {r['context_sha256']}")
                rows[r["context_sha256"]] = dict(r, _input_list_sha256=jr["sha256"])
            refused_rows |= {r["context_sha256"] for r in jd.get("refused", [])}
            joins.append({"registration": str(jp), "registration_sha256": _sha(jrb), "input_list": jr["input_list"],
                          "input_list_sha256": jr["sha256"], "admitted": len(jd["admitted"])})
        p3h = hdr["p3"]
        p3 = P3(p3h["holdout"], p3h["holdout_sha256"], p3h["registry"], p3h["registry_sha256"])
        for key, purpose in (("select", "selection"), ("train", "train")):
            if key not in self._adm_cache:
                self._adm_cache[key] = admission_mod.Admission(self.cfg.denylist, self.cfg.denylist_sha256,
                                                               purpose=purpose)
            if not self._adm_cache[key].ok:   # fail closed for the whole poll, never a permanent per-context refusal
                raise S1TailError(f"admission fail-closed: {self._adm_cache[key].reason}")
        out_header_sha = self._bind_header(hsha, il["sha256"], p3, joins)
        if self.cfg.seed_from is not None and getattr(self, "_seed_index", None) is None:
            self._open_seed(Path(self.cfg.seed_from))
        self.ctx_rows, self.refused_rows, self.p3, self.ledger_header_sha, self.input_list_sha = (
            rows, refused_rows, p3, hsha, il["sha256"])

        state = self._load_state(hsha)
        index = self._read_jsonl("index.jsonl")
        emitted = {e["context_sha256"]: e for e in index}
        refusals = {(r["context_sha256"], r["reason"]) for r in self._read_jsonl("refusals.jsonl")}
        conflicted = {c["context_sha256"] for c in self._read_jsonl("conflicts.jsonl")}
        contexts = state["contexts"]
        for c, e in emitted.items():
            st = contexts.setdefault(c, {"ledger": e["ledger"]})
            st["status"], st["shard_sha256"] = "emitted", e["sha256"]
        for c in conflicted:
            contexts.setdefault(c, {})["status"] = "conflict"

        ledgers = hdr.get("ledgers") or {}
        if not ledgers:
            raise S1TailError("ledger header names no ledgers")
        new_rows = 0
        for name in sorted(ledgers):
            path = Path(ledgers[name])
            if is_outer_test_key(name) or is_outer_test_key(path.stem):
                raise S1TailError(f"refusing to tail an outer-test ledger: {name} {path}")
            if path.resolve().parent != self.ledger_dir.resolve():
                raise S1TailError(f"ledger {name} is outside {self.ledger_dir}: {path}")
            tail = LedgerTail(path, state["cursors"].get(name))
            for line_no, raw in tail.read_new():
                new_rows += 1
                if not raw.strip():
                    state["counts"]["blank_lines"] = state["counts"].get("blank_lines", 0) + 1
                    continue
                try:
                    row = json.loads(raw)
                except ValueError:
                    raise S1TailError(f"{path}:{line_no} is not JSON") from None
                self._apply_row(name, line_no, row, hsha, state, conflicted)
            state["cursors"][name] = tail.cursor
        self._save_state(state)

        emitted_now, pending_now = 0, Counter()
        todo = sorted((c for c, st in contexts.items() if st.get("status") == "finalized"),
                      key=lambda c: (contexts[c]["final"]["ledger"], contexts[c]["final"]["line"]))
        for c in todo:
            if self.cfg.max_emit and emitted_now >= self.cfg.max_emit:
                pending_now["max_emit"] += 1
                continue
            st = contexts[c]
            try:
                shard, prov = self._build(c, st)
            except Pending as p:
                st["pending"] = p.reason
                pending_now[p.reason] += 1
                continue
            except ContextRefused as r:
                if (c, r.reason) not in refusals:
                    self._append("refusals.jsonl", {"schema": REFUSAL_SCHEMA, "context_sha256": c,
                                                    "view_id": st["final"]["fields"].get("view_id"),
                                                    "ledger": st["final"]["ledger"], "reason": r.reason,
                                                    "detail": r.detail[:300]})
                    refusals.add((c, r.reason))
                st["status"], st["refusal"] = "refused", r.reason
                st.pop("pending", None)
                continue
            entry = self._emit(c, st, shard, prov, len(index) + 1)
            index.append(entry)
            st["status"], st["shard_sha256"] = "emitted", entry["sha256"]
            st.pop("pending", None)
            emitted_now += 1
            self._save_state(state)
        self._save_state(state)
        manifest = self._manifest(state, index, out_header_sha)
        common.atomic_write(self._p("manifest.json"), _line(manifest), mode=0o644)
        return {"status": "ok", "new_ledger_rows": new_rows, "emitted_now": emitted_now,
                "pending_now": dict(sorted(pending_now.items())), **{k: manifest[k] for k in
                                                                     ("contexts", "index", "conflicts")}}

    # ------------------------------------------------------------------------------------------ ledger rows
    def _apply_row(self, ledger: str, line_no: int, row: Mapping, hsha: str, state: dict, conflicted: set) -> None:
        kind, f = adapt_ledger_row(row)
        counts = state["counts"]
        counts[f"rows:{kind}"] = counts.get(f"rows:{kind}", 0) + 1
        if kind in ("outer_test", "other"):
            return                                          # ignored entirely (outer-test rows are never parsed)
        if kind == "open":
            if f["header_sha256"] != hsha or f["ledger"] != ledger:
                raise S1TailError(f"{ledger}:{line_no} open row binds another header or ledger")
            return
        ctx = f["context_sha256"]
        st = state["contexts"].setdefault(ctx, {"ledger": ledger, "status": "seen"})
        if kind == "assign":
            if st.get("assign_line") is not None:
                counts["duplicate_assign"] = counts.get("duplicate_assign", 0) + 1
                return
            st["assign_line"], st["assign_ledger"] = line_no, ledger
            if st.get("status") in ("seen", "deferred"):
                st["status"] = "assigned"
            return
        if kind in ("defer", "release"):
            if st.get("status") == "seen":
                st["status"] = "deferred" if kind == "defer" else "seen"
            return
        # final
        ident = {k: f[k] for k in ("final_sha256", "summary_sha256", "outcome", "view_id", "use")}
        if st.get("final") is not None:
            prev = st["final"]
            if prev["identity"] == ident and prev["ledger"] == ledger:
                counts["duplicate_final_rows"] = counts.get("duplicate_final_rows", 0) + 1
                return
            if ctx not in conflicted:
                self._append("conflicts.jsonl", {"schema": CONFLICT_SCHEMA, "context_sha256": ctx,
                                                 "first": {"ledger": prev["ledger"], "line": prev["line"],
                                                           "identity": prev["identity"]},
                                                 "second": {"ledger": ledger, "line": line_no, "identity": ident},
                                                 "was_emitted": st.get("status") == "emitted"})
                conflicted.add(ctx)
            st["status"] = "conflict"
            return
        st["final"] = {"ledger": ledger, "line": line_no, "row_sha256": _sha(common.canonical(row)),
                       "identity": ident, "fields": f,
                       "outer_test_numeric": outer_test_paths(row, numeric_only=True)[:4]}
        if st.get("status") in ("emitted", "conflict", "refused"):
            return
        st["status"] = "finalized"
        if st.get("assign_line") is None:
            st["final"]["without_assign"] = True

    # ------------------------------------------------------------------------------------------ build one shard
    def _build(self, ctx: str, st: dict) -> tuple[dict, dict]:
        fin = st["final"]
        f = fin["fields"]
        ledger = fin["ledger"]
        if fin.get("without_assign"):
            raise ContextRefused("final_without_assign", f"{ledger}:{fin['line']}")
        if fin["outer_test_numeric"]:
            raise ContextRefused("outer_test_metrics_in_selection", ",".join(fin["outer_test_numeric"]))
        if ctx in self.refused_rows:
            raise ContextRefused("refused_by_input_list", ctx[:16])
        row = self.ctx_rows.get(ctx)
        if row is None:
            raise ContextRefused("not_in_input_list", ctx[:16])
        for k_final, k_row in (("view_id", "view_id"), ("set", "set"), ("cut_id", "cut_id"), ("use", "use")):
            if f.get(k_final) != row.get(k_row):
                raise ContextRefused("final_row_mismatch", f"{k_final} {f.get(k_final)!r} != {row.get(k_row)!r}")
        if row.get("ledger") != ledger:
            raise ContextRefused("final_row_mismatch", f"ledger {ledger} != input list {row.get('ledger')}")
        if f.get("outcome") not in CONSUMABLE_OUTCOMES:
            raise ContextRefused("unconsumable_outcome", str(f.get("outcome")))
        view_id, dataset_hash = row["view_id"], row["dataset_hash"]
        if view_id in self.exclusion.view_ids:                        # LINEAR-DETERMINED: never a training label
            raise ContextRefused(exclusions.EXCLUDE_FLAG, f"{view_id} in exclusion {self.exclusion.sha256[:12]}")

        # admission (fail closed): P3 explicitly, cross-checked with the input list and the denylist
        family_id, p3_assignment = self.p3.lookup(dataset_hash)
        listed = row.get("p3") or {}
        if listed.get("family_id") != family_id or listed.get("assignment") != p3_assignment:
            raise ContextRefused("p3_disagreement", f"input list {listed} != P3 ({family_id}, {p3_assignment})")
        keys = [v["key"] for v in (row.get("teacher"), row.get("teacher_input"))
                if isinstance(v, Mapping) and isinstance(v.get("key"), str)]
        assignment, split_role = admit(self.cfg.denylist, self.cfg.denylist_sha256, view_id, p3_assignment, keys,
                                       self._adm_cache)
        if f.get("use") != USE_FOR[split_role]:
            raise ContextRefused("use_disagreement", f"use {f.get('use')!r} for split_role {split_role}")

        # collected final.json + summary.tar.gz
        cdir = self.ledger_dir / "contexts" / ctx
        fpath, spath = cdir / "final.json", cdir / "summary.tar.gz"
        if not (fpath.is_file() and spath.is_file()):
            raise Pending("awaiting_collect", str(cdir))
        fb, sb = guarded_read(fpath), guarded_read(spath)
        if _sha(fb) != f.get("final_sha256") or _sha(sb) != f.get("summary_sha256"):
            raise ContextRefused("final_identity", "final.json/summary.tar.gz differ from the final row")
        final = json.loads(fb)
        checks = {"schema": FINAL_SCHEMA, "header_sha256": self.ledger_header_sha, "context_sha256": ctx,
                  "view_id": view_id, "outcome": f.get("outcome"), "use": f.get("use"), "ledger": ledger,
                  "summary_tar_gz_sha256": f.get("summary_sha256")}
        for k, want in checks.items():
            if final.get(k) != want:
                raise ContextRefused("final_identity", f"final.json {k} {str(final.get(k))[:40]!r}")
        leak = outer_test_paths(final, numeric_only=True)
        if leak:
            raise ContextRefused("outer_test_metrics_in_selection", ",".join(leak[:4]))
        seeded = self._seed_lookup(ctx, fin, f, row)
        if seeded is not None:                       # same final, same input row, same bindings: skip the costly fetch
            return seeded
        attempts, digests, plan = self._attempts(sb, final, f)

        # evaluation records (verified against digests.json)
        needed = sorted({attempt_files(plan, a["ordinal"], a["stage"], a["slot"])[0] for a in attempts})
        blobs = self._evaluation_blobs(ctx, needed, digests, f.get("host_custody"))
        g0_list = None
        rows_out = []
        for a in attempts:
            name, idx = attempt_files(plan, a["ordinal"], a["stage"], a["slot"])
            if idx is not None:
                if g0_list is None:
                    g0_list = json.loads(blobs[name])
                    if not isinstance(g0_list, list):
                        raise ContextRefused("evaluation_format", "g0-evaluations.json is not a list")
                if idx >= len(g0_list):
                    raise ContextRefused("evaluation_missing", f"g0 ordinal {idx}")
                rec = g0_list[idx]
            else:
                pack = json.loads(gzip.decompress(blobs[name]))
                g, k = divmod(a["ordinal"] - plan["g0"], plan["per_generation"])
                if pack.get("schema") != PACK_SCHEMA or pack.get("attempt_id") != f"gen{g:02d}-{k:02d}":
                    raise ContextRefused("evaluation_format", f"{name}: pack identity")
                rec = pack.get("record")
            facts = adapt_evaluation(rec, ctx)
            if facts["program_sha256"] != a["program_sha256"]:
                raise ContextRefused("attempt_program_mismatch", f"ordinal {a['ordinal']}")
            if facts["status"] != RECORD_STATUS_FOR[a["finish_status"]]:
                raise ContextRefused("status_mismatch", f"ordinal {a['ordinal']}: {a['finish_status']} vs "
                                                        f"{facts['status']}")
            rows_out.append({"ordinal": a["ordinal"], "finish_status": a["finish_status"], "facts": facts})
        if g0_list is not None and len(g0_list) != sum(1 for a in attempts if a["ordinal"] < plan["g0"]):
            raise ContextRefused("evaluation_format", "g0-evaluations.json length differs from the g0 attempts")

        # train side of the teacher JTT1 (y_train: outer-train targets only)
        cj = Path(row["context_dir"]) / "context.json"
        cjb = guarded_read(cj)
        if _sha(cjb) != row["context_json_sha256"]:
            raise ContextRefused("context_json_identity", str(cj))
        cdoc = json.loads(cjb)
        if (cdoc.get("context_sha256"), cdoc.get("view_id"), cdoc.get("dataset_hash")) != (ctx, view_id, dataset_hash):
            raise ContextRefused("context_json_identity", "context.json names another context")
        t = row["teacher"]
        gz = guarded_read(t["path"])
        tf = (cdoc.get("files") or {}).get("teacher.jtt1.gz") or {}
        if _sha(gz) != t["gz_sha256"] or len(gz) != t["gz_bytes"] or tf.get("sha256") != t["gz_sha256"]:
            raise ContextRefused("teacher_identity", "teacher.jtt1.gz")
        raw = gzip.decompress(gz)
        if _sha(raw) != t["raw_sha256"]:
            raise ContextRefused("teacher_identity", "teacher raw")
        try:
            train = corpus_schema.train_input(raw)
        except corpus_schema.CorpusStop as err:
            raise ContextRefused("teacher_jtt1", err.detail) from None
        shape = row.get("shape") or {}
        if (shape.get("n_train"), shape.get("p")) != (train.n_train, train.p):
            raise ContextRefused("teacher_shape", f"{shape} vs n_train={train.n_train} p={train.p}")
        audit = corpus_schema.leak_audit_train(train.X, train.y)      # P5 "Labels": train-only leak recompute
        if audit.target_leak:
            raise ContextRefused("target_leak", json.dumps(audit.to_json(), sort_keys=True)[:200])
        fold_counts = sorted(int((train.inner_labels == j).sum()) for j in range(INNER_FOLDS))
        for r in rows_out:
            sr, tr = r["facts"]["score_rows"], r["facts"]["train_rows"]
            if sr is not None and (sorted(sr) != fold_counts
                                   or (tr is not None and any(a + b != train.n_train for a, b in zip(sr, tr)))):
                raise ContextRefused("inner_fold_shape_mismatch", f"ordinal {r['ordinal']}: {sr}/{tr} vs {fold_counts}")

        host = f.get("host") or ""
        backend = "local" if corpus_schema.LOCAL_NODE_RE.fullmatch(host) else "unknown"
        cohort, fold = cdoc.get("cohort"), cdoc.get("fold")
        ctx_meta = {"context_sha256": ctx, "context_schema": cdoc.get("schema"), "dataset_hash": dataset_hash,
                    "family_id": family_id, "split_role": split_role}
        if not isinstance(ctx_meta["context_schema"], str) or not isinstance(fold, int) or isinstance(fold, bool):
            raise ContextRefused("context_json_identity", "schema/fold")
        records, refused, counts = build_records(ctx_meta, rows_out, self.vocab, int(self.cfg.max_seq), backend,
                                                 self.seeds)
        y = [float(v) for v in train.y.tolist()]
        try:
            ctx_label, rec_labels = labels.label_context({**ctx_meta, "y_train": y}, records)
        except labels.LabelError as err:
            raise ContextRefused("label_error", str(err)[:200]) from None
        by = {lab.program_sha256: lab for lab in rec_labels}
        for rec in records:
            lab = by[rec["program_sha256"]]
            if lab.outcome != rec["outcome"]:
                raise ContextRefused("label_error", f"outcome {rec['outcome']} != {lab.outcome}")
            rec["gate_pass"] = lab.gate_pass
            validate_train_record(rec)
        if ctx_label.s_c != train.s_c or ctx_label.eps_c != train.eps_c:
            raise ContextRefused("label_error", "s_c/eps_c differ from the JTT1 train input")
        enc = self.encodings.resolve(ctx, view_id)
        context_row = {
            **ctx_meta, "assignment": assignment, "view_id": view_id, "cut_id": row["cut_id"], "s1_ledger": ledger,
            "cohort": cohort, "fold": fold, "frozen_fold0": cohort == "frozen" and fold == 0,
            "n_train": train.n_train, "n_features": train.p, "inner_folds": train.inner_folds, "y_train": y,
            "train_rows_sha256": train.train_rows_sha256, "s_c": ctx_label.s_c, "eps_c": ctx_label.eps_c,
            "label_status": ctx_label.status,
            "baseline_rmse_j": None if ctx_label.baseline_rmse_j is None else list(ctx_label.baseline_rmse_j),
            "q_cap": ctx_label.q_cap, "n_records": len(records), "n_refused": len(refused),
            "s1_outcome": f.get("outcome"), "s1_selected_program_sha256": f.get("selected_program_sha256"),
            "flags": [flag] if (flag := exclusions.flag_for(view_id, self.exclusion)) else []}
        counts.update({"records": len(records), "refused_records": len(refused)})
        for k, v in ctx_label.counts.items():
            counts[f"label:{k}"] = v
        shard = {"schema": SHARD_SCHEMA, "context": context_row, "records": records,
                 "refused_records": sorted(refused, key=lambda r: r["program_sha256"]),
                 # context.json sha256 stays out of the shard: a context.json may hash outer-test-dependent files
                 "encodings": {k: {kk: vv for kk, vv in v.items() if kk != "context_json_sha256"}
                               for k, v in enc["found"].items()},
                 "encodings_missing": sorted(set(DEFAULT_COMPONENTS) - set(enc["found"])),
                 "encodings_conflicts": enc["conflicts"], "encodings_invalid": enc["invalid"],
                 "counts": dict(sorted(counts.items())),
                 "source": {"protocol": PROTOCOL, "evaluation_schema": EVAL_SCHEMA, "vocab_sha256": self.vocab.sha256,
                            "label_fields": "inner_cv[j].metrics.rmse, inner_cv[j].baseline_metrics.rmse, "
                                            "inner_cv[j].wall_us (kind=inner_cv only)",
                            "y_train": "JTT1 outer-train rows (dltrain.jtt1.train_view)"}}
        eval_map = {n: digests[n] for n in needed}
        prov = {"schema": PROV_SCHEMA, "context_sha256": ctx, "ledger": ledger, "ledger_line": fin["line"],
                "final_row_sha256": fin["row_sha256"], "final_sha256": f["final_sha256"],
                "summary_sha256": f["summary_sha256"],
                "attempts_jsonl_sha256": final["attempts"]["attempts_jsonl_sha256"],
                "digests_sha256": final.get("digests_sha256"), "evaluation_files": len(eval_map),
                "evaluation_files_sha256": _sha(common.canonical(eval_map)),
                "teacher": {"gz_sha256": t["gz_sha256"], "raw_sha256": t["raw_sha256"]},
                "context_json_sha256": row["context_json_sha256"], "input_list_sha256": row.get("_input_list_sha256", self.input_list_sha),
                "ledger_header_sha256": self.ledger_header_sha, "host": host,
                "encoding_identity_mismatches": enc["identity_mismatch"]}
        return shard, prov

    def _attempts(self, sb: bytes, final: Mapping, f: Mapping) -> tuple[list[dict], dict, dict]:
        try:
            with tarfile.open(fileobj=io.BytesIO(sb), mode="r:gz") as tar:
                att = tar.extractfile("attempts.jsonl").read()
                dig = tar.extractfile("digests.json").read()
        except (tarfile.TarError, KeyError, AttributeError) as err:
            raise ContextRefused("summary_format", str(err)[:120]) from None
        fa = final.get("attempts") or {}
        if _sha(att) != fa.get("attempts_jsonl_sha256") or _sha(dig) != final.get("digests_sha256"):
            raise ContextRefused("summary_format", "attempts.jsonl/digests.json differ from final.json")
        rows = [json.loads(x) for x in att.splitlines() if x.strip()]
        head = rows[0] if rows else {}
        if (head.get("event") != "open" or head.get("header_sha256") != self.ledger_header_sha
                or head.get("context_sha256") != final.get("context_sha256")):
            raise ContextRefused("attempt_ledger_binding", "attempts.jsonl open row")
        plan = head.get("plan") or {}
        if not all(isinstance(plan.get(k), int) and plan[k] > 0 for k in ("g0", "generations", "per_generation",
                                                                         "per_context")) \
                or plan["per_context"] != plan["g0"] + plan["generations"] * plan["per_generation"]:
            raise ContextRefused("attempt_ledger_binding", f"plan {plan}")
        res, fin = {}, {}
        for r in rows[1:]:
            o = r.get("ordinal")
            if not isinstance(o, int) or not 0 <= o < plan["per_context"]:
                raise ContextRefused("attempt_ledger", f"ordinal {o!r}")
            if r.get("event") == "reserve":
                if o in res:
                    raise ContextRefused("attempt_ledger", f"ordinal {o} reserved twice")
                res[o] = r
            elif r.get("event") == "finish":
                if o not in res or o in fin:
                    raise ContextRefused("attempt_ledger", f"finish of ordinal {o}")
                fin[o] = r
        if set(res) != set(fin):
            raise ContextRefused("attempt_ledger", "unfinished reservations")
        by = Counter(r.get("status") for r in fin.values())
        if (len(res) != fa.get("charged") or len(res) != f.get("charged") or dict(by) != fa.get("by_status")
                or dict(by) != (f.get("by_status") or {})):
            raise ContextRefused("attempt_ledger", "counts differ from final.json / final row")
        if any(s not in STATUS_OUTCOME for s in by):
            raise ContextRefused("attempt_ledger", f"unknown finish status in {dict(by)}")
        digests = json.loads(dig)
        out = []
        for o in sorted(res):
            r = res[o]
            if not isinstance(r.get("program_sha256"), str) or not HEX64.fullmatch(r["program_sha256"]):
                raise ContextRefused("attempt_ledger", f"ordinal {o} program")
            out.append({"ordinal": o, "stage": r.get("stage"), "slot": r.get("slot"),
                        "program_sha256": r["program_sha256"], "finish_status": fin[o]["status"]})
        return out, digests, plan

    def _evaluation_blobs(self, ctx: str, names: Sequence[str], digests: Mapping, host_custody: Any) -> dict:
        want = {}
        for n in names:
            d = digests.get(n)
            if not isinstance(d, str) or not HEX64.fullmatch(d):
                raise ContextRefused("evaluation_not_in_digests", n)
            want[n] = d
        got: dict[str, bytes] = {}
        mismatched = set()
        roots = list(self.cfg.evaluation_roots) + [self.ledger_dir / "contexts"]
        for root in roots:
            base = Path(root) / ctx
            if not base.is_dir():
                continue
            for n in names:
                if n in got:
                    continue
                p = base / n
                if p.is_file():
                    b = guarded_read(p)
                    if _sha(b) == want[n]:
                        got[n] = b
                    else:
                        mismatched.add(n)
        missing = [n for n in names if n not in got]
        if missing and self.cfg.fetch_ssh:
            fetched = fetch_via_ssh(self.cfg.ssh_command, host_custody, ctx, missing, self.cfg.ssh_timeout_s)
            for n, b in fetched.items():
                if _sha(b) == want[n]:
                    got[n] = b
                else:
                    mismatched.add(n)
            missing = [n for n in names if n not in got]
        if missing:
            if any(n in mismatched for n in missing):
                raise ContextRefused("evaluation_sha_mismatch", ",".join(sorted(set(missing) & mismatched))[:200])
            raise Pending("awaiting_evaluations", f"{len(missing)} of {len(names)} files")
        return got

    # ------------------------------------------------------------------------------------------ --seed-from
    SEED_BOUND = ("ledger_header_sha256", "p3", "denylist_sha256", "vocab_sha256", "vocab_size", "encoding_sets", "exclusion",
                  "max_seq", "seed_hashes_sha256", "record_fields", "shard_schema", "label_source")

    def _open_seed(self, so: Path) -> None:
        """A previous tail is reusable only when every binding that shapes a shard equals this tail's header."""
        sh = json.loads(guarded_read(so / "header.json"))
        mine = json.loads(self._p("header.json").read_bytes())
        diff = [k for k in self.SEED_BOUND if sh.get(k) != mine.get(k)]
        if diff:
            raise S1TailError(f"--seed-from {so} binds other inputs: {diff}")
        self._seed_dir = so
        self._seed_index = {e["context_sha256"]: e for e in read_index(so)[0]}
        self.seeded = 0

    def _seed_lookup(self, ctx: str, fin: dict, f: Mapping, row: Mapping):
        """Reuse the previous tail's shard + prov for `ctx` only if it was built from the SAME final row (final, summary and
        row sha), the same input row (context.json sha, input list sha) and the same ledger header; else build afresh."""
        idx = getattr(self, "_seed_index", None)
        e = idx.get(ctx) if idx else None
        if e is None:
            return None
        sb = guarded_read(self._seed_dir / e["shard"])
        if _sha(sb) != e["sha256"]:
            raise S1TailError(f"--seed-from shard {ctx[:16]} differs from its index")
        prov = json.loads(guarded_read(self._seed_dir / "prov" / ctx[:2] / f"{ctx}.json"))
        same = (prov.get("context_sha256") == ctx and prov.get("final_row_sha256") == fin["row_sha256"]
                and prov.get("final_sha256") == f.get("final_sha256") and prov.get("summary_sha256") == f.get("summary_sha256")
                and prov.get("context_json_sha256") == row["context_json_sha256"]
                and prov.get("input_list_sha256") == row.get("_input_list_sha256", self.input_list_sha)
                and prov.get("ledger_header_sha256") == self.ledger_header_sha)
        if not same:
            return None
        self.seeded += 1
        return json.loads(sb), prov

    def _emit(self, ctx: str, st: dict, shard: dict, prov: dict, seq: int) -> dict:
        try:
            exclusions.assert_none_excluded([shard["context"]["view_id"]], self.exclusion)
        except exclusions.ExclusionRefused as err:
            raise S1TailError(f"refusing to emit an excluded context: {err}") from None
        sub = ctx[:2]
        body = _line(shard)
        try:
            common.immutable_write(self._p("prov", sub, f"{ctx}.json"), _line(prov), mode=0o444)
            common.immutable_write(self._p("shards", sub, f"{ctx}.json"), body, mode=0o444)
        except common.ImmutableConflict as err:
            raise ShardConflict(f"re-run produced different bytes for {ctx}: {err}") from None
        c = shard["context"]
        entry = {"seq": seq, "context_sha256": ctx, "view_id": c["view_id"], "dataset_hash": c["dataset_hash"],
                 "family_id": c["family_id"], "assignment": c["assignment"], "split_role": c["split_role"],
                 "ledger": st["final"]["ledger"], "shard": f"shards/{sub}/{ctx}.json", "sha256": _sha(body),
                 "bytes": len(body), "n_records": c["n_records"], "label_status": c["label_status"],
                 "flags": c["flags"], "components": sorted(shard["encodings"])}
        self._append("index.jsonl", entry)
        return entry

    # ------------------------------------------------------------------------------------------ state, manifest
    def _load_state(self, hsha: str) -> dict:
        path = self._p("state.json")
        if not path.exists():
            return {"schema": STATE_SCHEMA, "ledger_header_sha256": hsha, "cursors": {}, "contexts": {}, "counts": {}}
        st = json.loads(path.read_bytes())
        if st.get("schema") != STATE_SCHEMA or st.get("ledger_header_sha256") != hsha:
            raise S1TailError("state.json belongs to another ledger header")
        return st

    def _save_state(self, state: dict) -> None:
        common.atomic_write(self._p("state.json"), _line(state), mode=0o644)

    def _manifest(self, state: dict, index: list[dict], out_header_sha: str) -> dict:
        ib = self._p("index.jsonl").read_bytes() if self._p("index.jsonl").exists() else b""
        rb = self._p("refusals.jsonl").read_bytes() if self._p("refusals.jsonl").exists() else b""
        cb = self._p("conflicts.jsonl").read_bytes() if self._p("conflicts.jsonl").exists() else b""
        statuses = Counter(st.get("status") for st in state["contexts"].values())
        pending = Counter(st.get("pending") for st in state["contexts"].values()
                          if st.get("status") == "finalized" and st.get("pending"))
        refusals = Counter(json.loads(x)["reason"] for x in rb.splitlines() if x.strip())
        comps = Counter(c for e in index for c in e["components"])
        return {
            "schema": MANIFEST_SCHEMA, "out_header_sha256": out_header_sha,
            "ledger_header_sha256": state["ledger_header_sha256"],
            "cursors": state["cursors"],
            "contexts": {"by_status": dict(sorted((str(k), v) for k, v in statuses.items())),
                         "pending_by_reason": dict(sorted(pending.items()))},
            "index": {"lines": len(index), "bytes": len(ib), "sha256": _sha(ib),
                      "records": sum(e["n_records"] for e in index),
                      "by_split_role": dict(sorted(Counter(e["split_role"] for e in index).items())),
                      "by_assignment": dict(sorted(Counter(e["assignment"] for e in index).items())),
                      "by_label_status": dict(sorted(Counter(e["label_status"] for e in index).items())),
                      "components": dict(sorted(comps.items()))},
            "refusals": {"lines": sum(refusals.values()), "sha256": _sha(rb),
                         "by_reason": dict(sorted(refusals.items()))},
            "conflicts": {"lines": len([x for x in cb.splitlines() if x.strip()]), "sha256": _sha(cb)},
            "ledger_rows": dict(sorted(state["counts"].items())),
            "exclusion": {**{k: v for k, v in self.exclusion.receipt().items()},
                          "refused_contexts": refusals.get(exclusions.EXCLUDE_FLAG, 0),
                          "review_flagged_emitted": sum(exclusions.REVIEW_FLAG in e.get("flags", []) for e in index)},
        }


# ------------------------------------------------------------------------------------------------------ the loader

class CorpusInputs(NamedTuple):
    contexts: list[dict]
    records: list[dict]
    encodings: dict[str, np.ndarray]
    assignment: dict[str, str]
    skipped: dict[str, str]


def read_index(out_dir: Path | str, offset: int = 0) -> tuple[list[dict], int]:
    """Complete index lines from byte `offset` (a torn tail is left for the next read); returns (entries, offset)."""
    path = Path(out_dir) / "index.jsonl"
    if not path.exists():
        return [], offset
    with guard_path(path).open("rb") as f:
        f.seek(offset)
        data = f.read()
    cut = data.rfind(b"\n")
    if cut < 0:
        return [], offset
    return [json.loads(x) for x in data[:cut + 1].splitlines() if x.strip()], offset + cut + 1


def conflicted_contexts(out_dir: Path | str) -> set[str]:
    path = Path(out_dir) / "conflicts.jsonl"
    if not path.exists():
        return set()
    return {json.loads(x)["context_sha256"] for x in guarded_read(path).splitlines() if x.strip()}


def load_shard(out_dir: Path | str, entry: Mapping, verify: bool = True) -> dict:
    body = guarded_read(Path(out_dir) / entry["shard"])
    if verify and (_sha(body) != entry["sha256"] or len(body) != entry["bytes"]):
        raise S1TailError(f"shard {entry['shard']} differs from its index entry")
    shard = json.loads(body)
    if shard.get("schema") != SHARD_SCHEMA or shard["context"]["context_sha256"] != entry["context_sha256"]:
        raise S1TailError(f"shard {entry['shard']} is not the indexed context")
    return shard


def compose_encoding(shard: Mapping, components: Sequence[str], verify: bool = True,
                     resolver: EncodingResolver | None = None, used: dict | None = None,
                     pinned: Sequence[PinnedEncodingSet] = ()) -> np.ndarray | None:
    """The float32 concatenation of `components` in order, or None if any is missing (never imputed). A component
    absent from the (immutable) shard, e.g. an encoding arm assembled after the shard was emitted, is resolved at load
    time through `resolver` (sha256-verified against its build tree's context.json) when one is given. `used`, when
    given, receives {component: {path, sha256, bytes, shape, source}} of every vector loaded."""
    parts, missing = [], []
    late = None
    for comp in components:
        if comp in PINNED_COMPONENTS:                      # only through a pinned assembled set, never substituted
            c = shard["context"]
            hits = [r for r in (ps.resolve(c["context_sha256"], c["view_id"])["found"].get(comp) for ps in pinned)
                    if r is not None]
            if len({h["sha256"] for h in hits}) != 1:       # none, or two pinned sets disagree
                missing.append(comp)
                continue
            ref, source = hits[0], hits[0]["source"]
        else:
            ref, source = shard["encodings"].get(comp), "shard"
        if ref is None and resolver is not None and comp not in PINNED_COMPONENTS:
            if late is None:
                c = shard["context"]
                late = resolver.resolve(c["context_sha256"], c["view_id"])["found"]
            ref, source = late.get(comp), "load_time_tree"
        if ref is None:
            missing.append(comp)
            continue
        b = guarded_read(ref["path"])
        if verify and (_sha(b) != ref["sha256"] or len(b) != ref["bytes"]):
            raise S1TailError(f"encoding {comp} of {shard['context']['context_sha256']} changed on disk")
        vec = decode_vector(b, ref["format"])
        if [int(vec.shape[0])] != ref["shape"]:
            raise S1TailError(f"encoding {comp} shape changed")
        parts.append(vec)
        if used is not None:
            used[comp] = {"path": ref["path"], "sha256": ref["sha256"], "bytes": ref["bytes"], "shape": ref["shape"],
                          "source": source}
    if missing:
        return None
    return np.concatenate(parts).astype(np.float32, copy=False)


def _accumulate(out_dir: Path | str, entries: Iterable[Mapping], acc: dict, *, components: Sequence[str] | None,
                split_roles: Sequence[str], admission: tuple[Path | str, str] | None, on_missing: str,
                conflicted: set[str]) -> None:
    for e in entries:
        c = e["context_sha256"]
        if c in conflicted:
            acc["skipped"][c] = "conflict"
            continue
        if e["split_role"] not in split_roles:
            acc["skipped"][c] = f"split_role:{e['split_role']}"
            continue
        shard = load_shard(out_dir, e)
        ctx = shard["context"]
        if admission is not None:
            try:
                got, role = admit(admission[0], admission[1], ctx["view_id"], ctx["assignment"],
                                  _cache=acc["adm_cache"])
            except ContextRefused as err:
                acc["skipped"][c] = f"admission:{err.reason}"
                continue
            if (got, role) != (ctx["assignment"], ctx["split_role"]):
                acc["skipped"][c] = "admission:role_changed"
                continue
        vec = None
        if components:
            vec = compose_encoding(shard, components)
            if vec is None:
                if on_missing == "raise":
                    raise S1TailError(f"context {c} lacks encoding components "
                                      f"{sorted(set(components) - set(shard['encodings']))}")
                acc["skipped"][c] = "encoding_missing"
                continue
        fam = ctx["family_id"]
        if acc["assignment"].setdefault(fam, ctx["assignment"]) != ctx["assignment"]:
            raise S1TailError(f"family {fam} has two assignments in the shards")
        acc["contexts"].append(ctx)
        acc["records"].extend(shard["records"])
        if vec is not None:
            acc["encodings"][c] = vec


def load_corpus_inputs(out_dir: Path | str, *, components: Sequence[str] | None = DEFAULT_COMPONENTS,
                       split_roles: Sequence[str] = ("train_fit", "dev"),
                       admission: tuple[Path | str, str] | None = None, on_missing: str = "exclude") -> CorpusInputs:
    """(contexts, records, encodings, assignment) for dltrain.sampler.Corpus.build, from every emitted shard.
    Conflicted contexts and contexts missing a requested encoding component (on_missing='exclude') are skipped and
    listed in `skipped`; components=None loads no encodings. admission=(denylist, sha256) re-checks every context."""
    if on_missing not in ("exclude", "raise"):
        raise ValueError("on_missing must be 'exclude' or 'raise'")
    entries, _ = read_index(out_dir)
    acc = {"contexts": [], "records": [], "encodings": {}, "assignment": {}, "skipped": {}, "adm_cache": {}}
    _accumulate(out_dir, entries, acc, components=components, split_roles=split_roles, admission=admission,
                on_missing=on_missing, conflicted=conflicted_contexts(out_dir))
    return CorpusInputs(acc["contexts"], acc["records"], acc["encodings"], acc["assignment"], acc["skipped"])


def build_corpus(out_dir: Path | str, **kw):
    from dltrain import sampler
    inputs = load_corpus_inputs(out_dir, **kw)
    return sampler.Corpus.build(inputs.contexts, inputs.records, inputs.encodings, inputs.assignment)


@dataclass
class ShardFollower:
    """Incremental loader: poll() returns the index entries appended since the last poll and accumulates them;
    inputs() returns the CorpusInputs so far (a conflict recorded later drops the context at the next poll)."""
    out_dir: Path
    components: Sequence[str] | None = DEFAULT_COMPONENTS
    split_roles: Sequence[str] = ("train_fit", "dev")
    admission: tuple[Path | str, str] | None = None
    on_missing: str = "exclude"
    offset: int = 0
    _acc: dict = field(default_factory=lambda: {"contexts": [], "records": [], "encodings": {}, "assignment": {},
                                                "skipped": {}, "adm_cache": {}})

    def poll(self) -> list[dict]:
        entries, self.offset = read_index(self.out_dir, self.offset)
        _accumulate(self.out_dir, entries, self._acc, components=self.components, split_roles=self.split_roles,
                    admission=self.admission, on_missing=self.on_missing, conflicted=conflicted_contexts(self.out_dir))
        return entries

    def inputs(self) -> CorpusInputs:
        bad = conflicted_contexts(self.out_dir)
        a = self._acc
        ctxs = [c for c in a["contexts"] if c["context_sha256"] not in bad]
        recs = [r for r in a["records"] if r["context_sha256"] not in bad]
        encs = {k: v for k, v in a["encodings"].items() if k not in bad}
        skipped = dict(a["skipped"], **{c: "conflict" for c in bad})
        fams = {c["family_id"] for c in ctxs}
        return CorpusInputs(ctxs, recs, encs, {f: x for f, x in a["assignment"].items() if f in fams}, skipped)


# ----------------------------------------------------------------------------------------------- tranche manifests

TRANCHE_ENTRY_KEYS = ("context_sha256", "shard_sha256")


def tranche_entries(index_path: Path | str, upto: int | None = None) -> list[dict]:
    """The tranche corpus manifest entries [{context_sha256, shard_sha256}] of the first `upto` index lines (all when
    None), in arrival order: never re-sorted, so tranche k-1's entries are an exact prefix of tranche k's.
    shard_sha256 is the sha256 of the shard file bytes. index_path is OUT/index.jsonl or OUT itself."""
    path = Path(index_path)
    out_dir = path if path.is_dir() else path.parent
    if not path.is_dir() and path.name != "index.jsonl":
        raise S1TailError(f"{path} is not an s1_tail index.jsonl")
    entries, _ = read_index(out_dir)
    if upto is not None:
        if isinstance(upto, bool) or not isinstance(upto, int) or not 0 <= upto <= len(entries):
            raise S1TailError(f"upto={upto!r}: the index holds {len(entries)} complete lines")
        entries = entries[:upto]
    return [{"context_sha256": e["context_sha256"], "shard_sha256": e["sha256"]} for e in entries]


def bound_exclusion(out_dir: Path | str) -> exclusions.Exclusion:
    """The exclusion file bound in OUT/header.json, re-loaded and re-verified (fail closed if absent)."""
    hdr = json.loads(guarded_read(Path(out_dir) / "header.json"))
    b = hdr.get("exclusion")
    if not isinstance(b, Mapping) or not b.get("path") or not b.get("sha256"):
        raise S1TailError(f"{out_dir}/header.json binds no LINEAR-DETERMINED exclusion; refusing its tranches")
    try:
        return exclusions.load(guard_path(b["path"]), b["sha256"])
    except exclusions.ExclusionRefused as err:
        raise S1TailError(f"bound exclusion refused: {err}") from None


def load_tranche(out_dir: Path | str, entries: Sequence[Mapping], admission: Any, *,
                 components: Sequence[str] | None = DEFAULT_COMPONENTS, on_missing: str = "raise",
                 exclusion: exclusions.Exclusion | None = None, encoding_trees: Sequence[Path | str] | None = None,
                 vector_receipt: dict | None = None, encoding_sets: Sequence[PinnedEncodingSet] = (),
                 ) -> tuple[list[dict], list[dict], dict[str, np.ndarray], dict[str, str]]:
    """(contexts, records, encodings, assignment) of exactly one tranche, for sampler.Corpus.build. Fail closed:
    `entries` must equal the first len(entries) index lines; every shard file's sha256 must equal its entry; a
    conflicted context refuses the tranche; the context rows pass tranche.admit_contexts with `admission`
    (a dltrain.admission.Admission built with purpose='selection', or a (denylist, sha256) pair); no row may be in
    the LINEAR-DETERMINED exclusion (default: the one bound in OUT/header.json); a missing encoding component raises
    unless on_missing='exclude' (then the context and its records are left out, never substituted).
    encoding_trees: build trees that resolve components the shards do not carry (a later encoding arm such as
    hyperion_v6all). PINNED_COMPONENTS (hyperion_v6all) resolve only through `encoding_sets` (PinnedEncodingSet).
    vector_receipt, when given, receives {context_sha256: {component: {path, sha256, ...}}} for
    every loaded context and {"_missing": {context_sha256: [components]}} for the excluded ones."""
    if on_missing not in ("exclude", "raise"):
        raise ValueError("on_missing must be 'exclude' or 'raise'")
    resolver = EncodingResolver(encoding_trees) if encoding_trees else None
    entries = [dict(e) for e in entries]
    for i, e in enumerate(entries):
        if tuple(sorted(e)) != tuple(sorted(TRANCHE_ENTRY_KEYS)) or not all(
                isinstance(e[k], str) and HEX64.fullmatch(e[k]) for k in TRANCHE_ENTRY_KEYS):
            raise S1TailError(f"tranche entry {i} must be {{context_sha256, shard_sha256}} of 64-hex strings")
    index, _ = read_index(out_dir)
    if len(entries) > len(index):
        raise S1TailError(f"tranche of {len(entries)} entries exceeds the {len(index)} index lines")
    have = [{"context_sha256": e["context_sha256"], "shard_sha256": e["sha256"]} for e in index[:len(entries)]]
    if have != entries:
        raise S1TailError("tranche entries are not an exact prefix of the append-only index (order or sha256 differ)")
    bad = conflicted_contexts(out_dir) & {e["context_sha256"] for e in entries}
    if bad:
        raise S1TailError(f"tranche holds conflicted contexts {sorted(bad)[:3]}; refusing the whole tranche")
    if not isinstance(admission, admission_mod.Admission):
        admission = admission_mod.Admission(admission[0], admission[1], purpose="selection")
    excl = exclusion if exclusion is not None else bound_exclusion(out_dir)
    by_ctx = {ix["context_sha256"]: ix for ix in index}
    shards = []
    for e in entries:
        ix = by_ctx[e["context_sha256"]]
        body = guarded_read(Path(out_dir) / ix["shard"])
        if _sha(body) != e["shard_sha256"]:
            raise S1TailError(f"shard {ix['shard']} sha256 differs from its tranche entry")
        shard = json.loads(body)
        if shard.get("schema") != SHARD_SCHEMA or shard["context"]["context_sha256"] != e["context_sha256"]:
            raise S1TailError(f"shard {ix['shard']} is not the context of its tranche entry")
        for rec in shard["records"]:
            validate_train_record(rec)
            if rec["context_sha256"] != e["context_sha256"]:
                raise S1TailError(f"shard {ix['shard']} holds a record of another context")
        shards.append(shard)
    try:
        exclusions.assert_none_excluded([s["context"]["view_id"] for s in shards], excl)
    except exclusions.ExclusionRefused as err:
        raise S1TailError(f"tranche refused: {err}") from None
    rows = tranche.admit_contexts([s["context"] for s in shards], admission)
    contexts, records, encodings, assignment = [], [], {}, {}
    for row, shard in zip(rows, shards):
        c = row["context_sha256"]
        if components:
            used: dict = {}
            vec = compose_encoding(shard, components, resolver=resolver, used=used, pinned=encoding_sets)
            if vec is None:
                missing = sorted(set(components) - set(used))
                if on_missing == "raise":
                    raise S1TailError(f"context {c} lacks encoding components {missing}")
                if vector_receipt is not None:
                    vector_receipt.setdefault("_missing", {})[c] = missing
                continue
            encodings[c] = vec
            if vector_receipt is not None:
                vector_receipt[c] = used
        if assignment.setdefault(row["family_id"], row["assignment"]) != row["assignment"]:
            raise S1TailError(f"family {row['family_id']} has two assignments in the tranche")
        contexts.append(row)
        records.extend(shard["records"])
    return contexts, records, encodings, assignment


def tranche_receipt(out_dir: Path | str, upto: int | None = None) -> dict:
    """Receipt of the tranche made of the first `upto` index lines (all when None): its entries, the corpus manifest
    sha256 (dltrain.train.corpus_manifest_sha256), counts, and the bound exclusion's sha256 with the excluded and
    review-flag counts. Verifies every shard's sha256 and that no row is excluded (fail closed)."""
    entries = tranche_entries(Path(out_dir) / "index.jsonl", upto)
    excl = bound_exclusion(out_dir)
    index, _ = read_index(out_dir)
    lines = index[:len(entries)]
    for e, ix in zip(entries, lines):
        if _sha(guarded_read(Path(out_dir) / ix["shard"])) != e["shard_sha256"]:
            raise S1TailError(f"shard {ix['shard']} differs from the index")
    try:
        exclusions.assert_none_excluded([ix["view_id"] for ix in lines], excl)
    except exclusions.ExclusionRefused as err:
        raise S1TailError(f"tranche refused: {err}") from None
    hdr_b = guarded_read(Path(out_dir) / "header.json")
    return {"schema": TRANCHE_RECEIPT_SCHEMA, "out_header_sha256": _sha(hdr_b), "tranche_lines": len(entries),
            "corpus_manifest": {"schema": CORPUS_MANIFEST_SCHEMA,
                                "sha256": _sha(common.canonical({"schema": CORPUS_MANIFEST_SCHEMA,
                                                                 "entries": entries}))},
            "index_prefix_sha256": _sha(b"".join(_line(ix) for ix in lines)),
            "counts": {"contexts": len(lines), "records": sum(ix["n_records"] for ix in lines),
                       "by_split_role": dict(sorted(Counter(ix["split_role"] for ix in lines).items())),
                       "by_assignment": dict(sorted(Counter(ix["assignment"] for ix in lines).items())),
                       "by_ledger": dict(sorted(Counter(ix["ledger"] for ix in lines).items()))},
            "exclusion": {**excl.receipt(), "excluded_in_tranche": 0,
                          "review_flagged_in_tranche": sum(exclusions.REVIEW_FLAG in ix.get("flags", [])
                                                           for ix in lines)},
            "encoding_sets": json.loads(hdr_b).get("encoding_sets") or [],
            "entries": entries}


def write_tranche_receipt(out_dir: Path | str, upto: int | None = None) -> Path:
    """Create-only OUT/tranches/tranche-<lines>-<manifest12>.json (equal bytes on a re-run; never overwritten)."""
    doc = tranche_receipt(out_dir, upto)
    name = f"tranche-{doc['tranche_lines']:06d}-{doc['corpus_manifest']['sha256'][:12]}.json"
    path = Path(out_dir) / "tranches" / name
    try:
        common.immutable_write(guard_path(path), _line(doc), mode=0o444)
    except common.ImmutableConflict as err:
        raise ShardConflict(str(err)) from None
    return path


def data_refs(out_dir: Path | str, components: Sequence[str] | None = DEFAULT_COMPONENTS) -> dict:
    """What a TrainData needs besides the corpus: the vocabulary bound in OUT/header.json (size, sha256; the base
    vocabulary unless a pinned P4 vocab.json was given), max_seq and ctx_dim for `components` (from the first
    shard that holds them all). No grammar is bound: legal masks come from dltrain.automaton."""
    hdr = json.loads(guarded_read(Path(out_dir) / "header.json"))
    base = dsl_tokenizer.Vocab.from_names({})
    ctx_dim = None
    if components:
        for e in read_index(out_dir)[0]:
            if all(c in e["components"] for c in components):
                shard = load_shard(out_dir, e)
                ctx_dim = sum(shard["encodings"][c]["shape"][0] for c in components)
                break
    return {"vocab_sha256": hdr["vocab_sha256"], "vocab_size": hdr.get("vocab_size"),
            "vocab_is_base": hdr["vocab_sha256"] == base.sha256, "max_seq": hdr["max_seq"],
            "components": list(components or []), "ctx_dim": ctx_dim, "grammar": None,
            "out_header_sha256": _sha(guarded_read(Path(out_dir) / "header.json"))}


# ------------------------------------------------------------------------------------------- TrainData per tranche

GRAMMAR_FILE_SCHEMA = "jope.dl-s1-tail-grammar/v1"
SPEC_KEYS = ("tail_out", "components", "exclusion", "grammar", "vocab_sha256", "max_seq")


def syntax_grammar_bytes(vocab: dsl_tokenizer.Vocab, max_seq: int) -> bytes:
    """The run grammar file: automaton.build_grammar over EMPTY signatures and the shards' vocabulary. Binding train_fit
    signatures needs their op/key names inside the vocabulary, which the data-independent base vocabulary does not
    hold (AutomatonStop), so the grammar is SYNTAX-only and data-independent: identical for every tranche of a run.
    Canonical JSON {schema, mode, vocab_sha256, max_seq, signatures, grammar}."""
    from dltrain import automaton
    sig = automaton.build_signatures([])
    doc = {"schema": GRAMMAR_FILE_SCHEMA, "mode": "SYNTAX", "vocab_sha256": vocab.sha256, "max_seq": int(max_seq),
           "signatures": sig, "grammar": automaton.build_grammar(sig, vocab, int(max_seq))}
    return common.canonical(doc)


def run_grammar(tail_out: Path | str, pinned: Mapping | None, vocab: dsl_tokenizer.Vocab, max_seq: int):
    """(automaton.Grammar, sha256, path). pinned=None (tranche k=0): build and write create-only
    <tail_out>/grammars/<sha12>.json; else load the pinned {path, sha256} and verify it (fail closed)."""
    from dltrain import automaton
    if pinned is None:
        body = syntax_grammar_bytes(vocab, max_seq)
        path = Path(tail_out) / "grammars" / f"{_sha(body)[:12]}.json"
        try:
            common.immutable_write(guard_path(path), body, mode=0o444)
        except common.ImmutableConflict as err:
            raise S1TailError(str(err)) from None
    else:
        path = Path(pinned["path"])
        body = guarded_read(path)
        if _sha(body) != pinned["sha256"]:
            raise S1TailError(f"grammar {path} sha256 differs from the pinned {pinned['sha256']}")
    doc = json.loads(body)
    if doc.get("schema") != GRAMMAR_FILE_SCHEMA or doc.get("vocab_sha256") != vocab.sha256 \
            or doc.get("max_seq") != int(max_seq):
        raise S1TailError("grammar file is not this run's (schema, vocab or max_seq)")
    try:
        g = automaton.Grammar(doc["grammar"], doc["signatures"], vocab)
    except automaton.AutomatonStop as err:
        raise S1TailError(f"grammar refused: {err}") from None
    return g, _sha(body), path


def syntax_masks(grammar, records: Sequence[Mapping]) -> tuple[list[dict], list[dict], Any]:
    """(kept records, dropped [{context_sha256, program_sha256, reason}], legal_mask_fn). A record that Mode.SYNTAX
    refuses is dropped and counted (never a collate-time crash). legal_mask_fn(tokens) -> bool[(len-1, V)], row i
    the set allowed for tokens[i+1] (sampler.collate), from one shared mask table keyed by the tokens tuple."""
    from dltrain import automaton
    kept, dropped = [], []
    for r in records:
        v = grammar.accepts(r["tokens"], automaton.Mode.SYNTAX)
        if v.ok:
            kept.append(r)
        else:
            dropped.append({"context_sha256": r["context_sha256"], "program_sha256": r["program_sha256"],
                            "reason": f"syntax_refused@{v.position}"})
    seqs = {tuple(r["tokens"]): None for r in kept}
    table, ids = grammar.compile_masks([list(t) for t in seqs], automaton.Mode.SYNTAX)
    index = dict(zip(seqs, ids))
    table.setflags(write=False)

    def legal_mask_fn(tokens: Sequence[int]) -> np.ndarray:
        key = tuple(int(t) for t in tokens)
        mid = index.get(key)
        if mid is None:                                    # outside the tranche: compile on demand (same grammar)
            t, (m,) = grammar.compile_masks([list(key)], automaton.Mode.SYNTAX)
            return t[m[1:]]
        return table[mid[1:]]

    return kept, dropped, legal_mask_fn


def train_data_for_tranche(spec: Mapping, entries: Sequence[Mapping], admission: Any, sampler_config: Any, *,
                           encoding_trees: Sequence[Path | str] | None = None, receipt: dict | None = None):
    """sampler.TrainData of one tranche (data-spec kind "s1-tranche/v1"). spec: {tail_out, components,
    exclusion {path, sha256}, grammar {path, sha256} | None (k=0 builds it), vocab_sha256, max_seq, and
    encoding_sets [{tree, receipt, sha256}] (required for PINNED_COMPONENTS such as hyperion_v6all)}. Fail closed on
    any mismatch with OUT/header.json. Contexts lacking a component are excluded (never substituted) and counted;
    SYNTAX-refused records are dropped and counted. `receipt`, when given, is filled (and also written create-only
    under <tail_out>/tranches/train-data-<lines>-<spec12>.json)."""
    from dltrain import sampler, train
    missing = [k for k in SPEC_KEYS if k not in spec]
    if missing:
        raise S1TailError(f"tranche spec lacks {missing}")
    out = guard_path(spec["tail_out"])
    hdr = json.loads(guarded_read(out / "header.json"))
    base = dsl_tokenizer.Vocab.from_names({})
    if spec["vocab_sha256"] != hdr["vocab_sha256"] or spec["max_seq"] != hdr["max_seq"]:
        raise S1TailError("spec vocab_sha256/max_seq differ from OUT/header.json")
    if hdr["vocab_sha256"] != base.sha256:
        raise S1TailError("OUT was tokenized with a pinned vocab.json; this loader serves the base vocabulary only")
    components = list(spec["components"])
    if not components:
        raise S1TailError("spec components are empty")
    try:
        excl = exclusions.load(guard_path(spec["exclusion"]["path"]), spec["exclusion"]["sha256"])
    except exclusions.ExclusionRefused as err:
        raise S1TailError(f"exclusion refused: {err}") from None
    trees = tuple(encoding_trees) if encoding_trees is not None else DEFAULT_ENCODING_TREES
    sets = [PinnedEncodingSet(x["tree"], x["receipt"], x["sha256"]) for x in (spec.get("encoding_sets") or [])]
    if set(components) & PINNED_COMPONENTS and not sets:
        raise S1TailError(f"components {sorted(set(components) & PINNED_COMPONENTS)} need a pinned assembled set: "
                          "spec['encoding_sets'] = [{tree, receipt, sha256}]")
    bound = {(b["sha256"], b.get("assembled_set_sha256")) for b in hdr.get("encoding_sets") or []}
    if sets and {(x.receipt_sha256, x.assembled_set_sha256) for x in sets} != bound:
        raise S1TailError(f"spec encoding_sets differ from the sets bound in OUT/header.json ({sorted(bound)})")
    vr: dict = {}
    contexts, records, encodings, assignment = load_tranche(
        out, entries, admission, components=components, on_missing="exclude", exclusion=excl,
        encoding_trees=trees, vector_receipt=vr, encoding_sets=sets)
    grammar, grammar_sha, grammar_path = run_grammar(out, spec["grammar"], base, int(spec["max_seq"]))
    kept, dropped, mask_fn = syntax_masks(grammar, records)
    missing_enc = vr.get("_missing", {})
    if not contexts:
        raise S1TailError(f"none of the {len(entries)} tranche contexts holds every component {components} "
                          f"({len(missing_enc)} excluded for missing components, never substituted)")
    corpus = sampler.Corpus.build(contexts, kept, encodings, assignment)
    try:
        fit = sampler.fit(corpus, sampler_config)
    except sampler.SamplerError as err:
        raise S1TailError(f"tranche has no trainable universe: {err} ({len(contexts)} contexts loaded, "
                          f"{len(missing_enc)} excluded for missing components)") from None
    msha = train.corpus_manifest_sha256([dict(e) for e in entries])
    refs = {"corpus": "corpus-manifest:" + msha, "encoding": "corpus-manifest:" + msha,
            "grammar": "grammar:" + grammar_sha, "tokenizer": "vocab:" + base.sha256}
    data = sampler.TrainData(corpus=corpus, fit=fit, config=sampler_config, legal_mask_fn=mask_fn,
                             vocab_size=base.size, ctx_dim=int(corpus.encoding_dim), refs=refs)
    dims = {}
    for c in contexts:
        for comp, ref in (vr.get(c["context_sha256"]) or {}).items():
            dims.setdefault(comp, ref["shape"][0])
    doc = {"schema": "jope.dl-s1-tail-train-data-receipt/v1", "spec_sha256": _sha(common.canonical(dict(spec))),
           "entries": len(entries), "corpus_manifest_sha256": msha, "refs": refs,
           "grammar": {"path": str(grammar_path), "sha256": grammar_sha, "mode": "SYNTAX",
                       "deviation": "training masks are SYNTAX-level, a superset of PLAN P4 POLICY masks: the "
                                    "data-independent base vocabulary cannot hold POLICY op/key names"},
           "vocab": {"sha256": base.sha256, "size": base.size}, "max_seq": int(spec["max_seq"]),
           "components": components, "ctx_dim": int(corpus.encoding_dim), "ctx_dim_by_component": dims,
           "encoding_sets": [x.binding() for x in sets],
           "counts": {"contexts_loaded": len(contexts), "records_loaded": len(records), "records_kept": len(kept),
                      "records_dropped_syntax": len(dropped),
                      "contexts_excluded_missing_component": len(missing_enc),
                      "fit_universe_contexts": fit.n_contexts(),
                      "by_split_role": dict(sorted(Counter(c["split_role"] for c in contexts).items()))},
           "excluded_missing_component": dict(sorted(missing_enc.items())),
           "dropped_records": dropped[:200],
           "exclusion": {**excl.receipt(), "excluded_in_tranche": 0,
                         "review_flagged_in_tranche": sum(exclusions.REVIEW_FLAG in (c.get("flags") or [])
                                                          for c in contexts)},
           "vectors": {c: v for c, v in sorted(vr.items()) if c != "_missing"},
           "train_data_content_sha256": data.content_sha256}
    name = f"train-data-{len(entries):06d}-{doc['spec_sha256'][:12]}.json"
    try:
        common.immutable_write(guard_path(out / "tranches" / name), _line(doc), mode=0o444)
    except common.ImmutableConflict as err:
        raise S1TailError(f"train-data receipt differs on a re-run: {err}") from None
    doc = dict(doc, receipt_path=str(out / "tranches" / name))
    object.__setattr__(data, "s1_tail_receipt", doc)          # read back with train_data_receipt / grammar_binding
    if receipt is not None:
        receipt.update(doc)
    return data


def train_data_receipt(data) -> dict:
    """The receipt train_data_for_tranche attached to its TrainData."""
    doc = getattr(data, "s1_tail_receipt", None)
    if doc is None:
        raise S1TailError("this TrainData was not made by s1_tail.train_data_for_tranche")
    return doc


def grammar_binding(data) -> dict:
    """{path, sha256} of the run grammar a TrainData was built with: pin it into the data-spec of tranches k >= 1."""
    g = train_data_receipt(data)["grammar"]
    return {"path": g["path"], "sha256": g["sha256"]}

