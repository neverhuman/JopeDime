class OneUpdateTest(unittest.TestCase):
    """P7 test 4: one optimizer update changes parameter_sha256 (sorted named_parameters, tied alias excluded)."""

    def test_one_update_changes_parameter_sha256(self):
        tmp = make_tmp(self)
        plan = make_plan(max_updates=1)
        data = fixtures_p7.train_data()
        res = train.run(plan, data, tmp / "run")
        self.assertEqual((res.status, res.step), ("COMPLETED", 1))
        self.assertTrue(res.optimizer_parameter_change_verified)
        self.assertNotEqual(res.initial_parameter_sha256, res.parameter_sha256)
        self.assertEqual(torch.get_num_threads(), 4)

        train.seed_fresh(run_seed(plan))
        m0, _opt0, _sch0 = train.build_training_objects(plan)
        names = model.parameter_names(m0)
        self.assertNotIn("lm_head.weight", names)
        self.assertIn("tok_emb.weight", names)
        self.assertEqual(manual_parameter_sha256(dict(m0.named_parameters())), res.initial_parameter_sha256)
        self.assertEqual(model.parameter_sha256(m0), res.initial_parameter_sha256)

        commit, closure = ckpt.open_commit(Path(res.last_commit))
        self.assertEqual((commit.step, commit.doc["parameter_sha256"]), (1, res.parameter_sha256))
        self.assertEqual(sorted(closure.model_tensors), names)
        self.assertEqual(manual_parameter_sha256(closure.model_tensors), res.parameter_sha256)
        self.assertEqual({float(v) for k, v in closure.optimizer_tensors.items() if k.endswith(".step")}, {1.0})
        self.assertEqual(closure.optimizer_meta["scheduler"]["last_epoch"], 1)
        self.assertEqual(closure.sampler_state["cursor"], 1)
        self.assertEqual(len(closure.journal_bytes.splitlines()), 1)
        before = dict(m0.named_parameters())
        moved = [n for n in names if tensor_bytes(before[n]) != tensor_bytes(closure.model_tensors[n])]
        self.assertIn("tok_emb.weight", moved)

        # The step-1 closure was captured from the trained model, and capture refuses an untied model. Loading it
        # into fresh objects keeps lm_head.weight the very tok_emb.weight tensor, with the same hash.
        m1, opt1, sch1 = train.build_training_objects(plan)
        ckpt.apply_closure(closure, model=m1, optimizer=opt1, scheduler=sch1)
        model.assert_tied(m1)
        self.assertIs(m1.lm_head.weight, m1.tok_emb.weight)
        self.assertEqual(model.parameter_sha256(m1), res.parameter_sha256)
        self.assertEqual(manual_parameter_sha256(dict(m1.named_parameters())), res.parameter_sha256)


# ------------------------------------------------------------------------------------------------------- test 5
class CheckpointClosureTest(unittest.TestCase):
    """P7 test 5: bitwise round trip, byte-identical re-save, strict refusals and weights-only commits."""

    def setUp(self):
        self.fx = closure_fixture()
        self.tmp = make_tmp(self)

    def fresh_objects(self, seed: int = 999):
        torch.manual_seed(seed)
        random.seed(seed)
        np.random.seed(seed)
        m, opt, sch = train.build_training_objects(self.fx.plan)
        smp = sampler.MacroSampler(self.fx.data.fit, run_seed(self.fx.plan), self.fx.data.config)
        return m, opt, sch, smp

    def restore(self):
        m, opt, sch, smp = self.fresh_objects()
        self.assertNotEqual(model.parameter_sha256(m), self.fx.commit.doc["parameter_sha256"])
        closure = ckpt.read_commit(self.fx.commit.dir)
        ckpt.apply_closure(closure, model=m, optimizer=opt, scheduler=sch)
        smp.load_state_dict(closure.sampler_state)
        return closure, m, opt, sch, smp

    def assert_bitwise(self, a: torch.Tensor, b: torch.Tensor, what: str) -> None:
        self.assertEqual((a.dtype, tuple(a.shape)), (b.dtype, tuple(b.shape)), what)
        self.assertTrue(tensor_bytes(a) == tensor_bytes(b), f"{what} differs bitwise")

    def assert_refused(self, commit_dir: Path, what: str) -> None:
        with self.assertRaises(ckpt.CheckpointRefused, msg=what):
            ckpt.read_commit(commit_dir)

    def test_round_trip_is_bitwise(self):
        closure, m, opt, sch, smp = self.restore()
        snap = self.fx.snap
        self.assertTrue(same_rng(rng_snapshot(), snap["rng"]), "torch/python/numpy RNG states differ after restore")
        params = dict(m.named_parameters())
        self.assertEqual(sorted(params), sorted(snap["params"]))
        for name, t in snap["params"].items():
            self.assert_bitwise(params[name], t, f"parameter {name}")
        model.assert_tied(m)
        names = {id(p): n for n, p in m.named_parameters()}
        restored = {names[id(p)]: st for p, st in opt.state.items()}
        self.assertEqual(sorted(restored), sorted(snap["opt_state"]))
        self.assertEqual(sorted(restored), sorted(params))
        for name, state in snap["opt_state"].items():
            self.assertEqual(sorted(restored[name]), ["exp_avg", "exp_avg_sq", "step"])
            for slot, t in state.items():
                self.assert_bitwise(restored[name][slot], t, f"optimizer {name}.{slot}")
        self.assertEqual({float(st["step"]) for st in restored.values()}, {float(FIXTURE_STEPS)})
        self.assertEqual([{k: v for k, v in g.items() if k != "params"} for g in opt.param_groups], snap["groups"])
        sd = sch.state_dict()
        self.assertEqual({k: sd[k] for k in ckpt.SCHEDULER_KEYS}, snap["sched"])
        self.assertEqual(sd["last_epoch"], FIXTURE_STEPS)
        self.assertEqual((smp.cursor, smp.state_dict()), (FIXTURE_STEPS, snap["sampler"]))
        self.assertEqual(closure.journal_bytes, snap["journal"])

    def test_capture_consumes_no_rng(self):
        self.assertTrue(same_rng(self.fx.snap["rng_after_save"], self.fx.snap["rng"]))

    def test_restored_objects_continue_identically(self):
        _closure, m, opt, sch, smp = self.restore()
        fixture_step(m, opt, sch, smp, self.fx.data)
        for name, p in m.named_parameters():
            self.assert_bitwise(p, self.fx.snap["next_params"][name], f"{name} after one more update")

    def test_resave_is_byte_identical(self):
        closure, m, opt, sch, smp = self.restore()
        again = ckpt.save_local_commit(
            self.tmp, run_id=closure.run_id, step=closure.step, model=m, optimizer=opt, scheduler=sch,
            sampler_state=smp.state_dict(), journal_bytes=closure.journal_bytes, identities=closure.identities,
            parent=closure.parent, last_event_seq=closure.last_event_seq, expected_pointer=closure.expected_pointer)
        first = self.fx.commit
        self.assertEqual(sorted(first.doc["files"]), sorted(ckpt.REQUIRED_RESUMABLE))
        self.assertEqual(again.doc["files"], first.doc["files"])
        for entry in first.doc["files"].values():
            self.assertTrue((first.dir / entry["name"]).read_bytes() == (again.dir / entry["name"]).read_bytes(),
                            f"{entry['name']} is not byte-identical after re-saving")
        without_time = lambda d: {k: v for k, v in d.items() if k != "wall_time_utc_us"}  # noqa: E731
        self.assertEqual(without_time(again.doc), without_time(first.doc))
        with self.assertRaises(ckpt.CheckpointRefused):  # a local commit is never replaced
            ckpt.write_commit(self.tmp / "commits", closure)

    def test_corrupted_files_refused(self):
        src = self.fx.commit.dir
        names = sorted(p.name for p in src.iterdir())
        self.assertEqual(names, sorted([ckpt.COMMIT_FILE] + [e["name"] for e in self.fx.commit.doc["files"].values()]))
        raw = (src / ckpt.COMMIT_FILE).read_bytes()
        doc = self.fx.commit.doc
        # commit.json flips land on verified fields: every file hash, parameter_sha256, the step, the schema
        verified = [e["sha256"] for e in doc["files"].values()] + [doc["parameter_sha256"], ckpt.SCHEMA_LOCAL_COMMIT]
        commit_positions = sorted({0, len(raw) - 1, raw.index(b'"step":') + len(b'"step":')}
                                  | {raw.index(v.encode()) + 5 for v in verified})
        ckpt.read_commit(copy_commit(src, self.tmp / "pristine"))
        for name in names:
            size = (src / name).stat().st_size
            positions = commit_positions if name == ckpt.COMMIT_FILE else sorted({0, 8, size // 2, size - 1})
            for pos in positions:
                d = copy_commit(src, self.tmp / f"flip-{name}-{pos}")
                data = bytearray((d / name).read_bytes())
                data[pos] ^= 0x01
                (d / name).write_bytes(bytes(data))
                self.assert_refused(d, f"one-byte flip at offset {pos} of {name}")
            for keep in (size - 1, size // 2, 0):
                d = copy_commit(src, self.tmp / f"trunc-{name}-{keep}")
                os.truncate(d / name, keep)
                self.assert_refused(d, f"{name} truncated to {keep} bytes")
            d = copy_commit(src, self.tmp / f"missing-{name}")
            (d / name).unlink()
            self.assert_refused(d, f"missing {name}")
        for extra in ("extra.bin", ".hidden", "models.safetensors.bak"):
            d = copy_commit(src, self.tmp / f"extra-{extra}")
            (d / extra).write_bytes(b"x")
            self.assert_refused(d, f"unlisted file {extra}")
        d = copy_commit(src, self.tmp / "extra-dir")
        (d / "sub").mkdir()
        self.assert_refused(d, "unlisted directory")

    def test_consistent_rewrites_refused_by_recomputation(self):
        src = self.fx.commit.dir
        closure = ckpt.read_commit(src)
        same = (src / "models.safetensors").read_bytes()
        ckpt.read_commit(rewrite_consistently(copy_commit(src, self.tmp / "same"), "models", same))  # control
