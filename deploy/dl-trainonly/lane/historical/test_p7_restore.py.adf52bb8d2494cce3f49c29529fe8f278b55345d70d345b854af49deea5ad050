        cls.B = train.run(cls.plan, cls.data, cls.tmp / "B", store=cls.store, store_prefix=PREFIX, stop_file=stop,
                          hooks=train.TrainHooks(after_step=after_step))
        sys.stderr.write(f"\n[p7 restore] run A {t1 - t0:.1f} s, run B {time.monotonic() - t1:.1f} s\n")
        cls.a_digest = closure_digest(Path(cls.A.last_commit))
        cls.b_commit = Path(cls.B.last_commit)
        # Cross-run determinism evidence: these hashes must be identical in every run of the suite.
        sys.stderr.write(f"[p7 restore] run A step {cls.A.step} parameter_sha256 {cls.A.parameter_sha256} "
                         f"journal_sha256 {cls.A.journal_sha256}; run B step {cls.B.step} parameter_sha256 "
                         f"{cls.B.parameter_sha256}\n")

    def empty_dir(self, name: str) -> Path:
        d = self.tmp / name
        d.mkdir(parents=True)
        return d

    def test_run_a_completes_and_run_b_yields_published(self):
