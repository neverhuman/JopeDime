def perturb(name: str, c: ckpt.ClosureData) -> None:
    """Apply one negative-control perturbation to a closure read from B's step-37 commit."""
    opt = c.optimizer_tensors
    if name == "exp_avg*1.5":
        c.optimizer_tensors = {k: v * 1.5 if k.endswith(".exp_avg") else v for k, v in opt.items()}
    elif name == "exp_avg_sq*2":
        c.optimizer_tensors = {k: v * 2.0 if k.endswith(".exp_avg_sq") else v for k, v in opt.items()}
    elif name == "step-1":
        c.optimizer_tensors = {k: v - 1.0 if k.endswith(".step") else v for k, v in opt.items()}
    elif name == "scheduler-1":
        c.optimizer_meta["scheduler"]["last_epoch"] -= 1
        c.optimizer_meta["scheduler"]["_step_count"] -= 1
    elif name == "sampler_cursor+1":
        c.sampler_state["cursor"] += 1
    elif name == "torch_rng=Generator(12345)":
        g = torch.Generator()
        g.manual_seed(12345)
        c.rng_tensors = {"torch_cpu": g.get_state()}
    elif name == "python_rng=Random(12345)":
        version, internal, gauss_next = random.Random(12345).getstate()
        c.rng_meta["python"] = {"version": version, "internal": list(internal), "gauss_next": gauss_next}
    elif name == "numpy_rng=RandomState(12345)":
        s = np.random.RandomState(12345).get_state()
        c.rng_meta["numpy"] = {"bit_generator": s[0], "key": [int(x) for x in s[1]], "pos": int(s[2]),
                               "has_gauss": int(s[3]), "cached_gaussian": float(s[4])}
    else:
        raise KeyError(name)


def inner_drops(c: ckpt.ClosureData) -> dict:
    """Consistent rewrites that drop one component inside a closure file: name -> (kind, new file bytes)."""
    opt = c.optimizer_tensors
    no_scheduler = {k: v for k, v in c.optimizer_meta.items() if k != "scheduler"}
    return {
        "optimizer:exp_avg": ("optimizer", safetensors.torch.save({k: v for k, v in opt.items()
                                                                     if not k.endswith(".exp_avg")})),
        "optimizer:exp_avg_sq": ("optimizer", safetensors.torch.save({k: v for k, v in opt.items()
                                                                        if not k.endswith(".exp_avg_sq")})),
        "optimizer:step": ("optimizer", safetensors.torch.save({k: v for k, v in opt.items()
                                                                  if not k.endswith(".step")})),
        "optimizer-meta:scheduler": ("optimizer-meta", common.canonical(no_scheduler)),
        "rng:torch_cpu": ("rng", safetensors.torch.save({})),
        "rng-meta:python": ("rng-meta", common.canonical({k: v for k, v in c.rng_meta.items() if k != "python"})),
        "rng-meta:numpy": ("rng-meta", common.canonical({k: v for k, v in c.rng_meta.items() if k != "numpy"})),
        "sampler:cursor": ("sampler", common.canonical({k: v for k, v in c.sampler_state.items() if k != "cursor"})),
    }


