    def test_publishing_run_whose_store_draws_global_rng_equals_a(self):
        """§6.6 determinism: a store client that draws from the global RNGs while publishing (retry jitter) must not
        shift the training streams; the step boundary is restored, so every commit equals run A's."""
        store = RngDrawingStore(ckpt.FileVersionedStore(self.tmp / "store-P"))
        res = train.run(self.plan, self.data, self.tmp / "P", store=store, store_prefix=PREFIX)
        self.assertEqual((res.status, res.step), ("COMPLETED", FINAL_STEP))
        self.assertGreater(store.draws, 0)
        self.assertEqual((res.parameter_sha256, res.journal_sha256), (self.A.parameter_sha256, self.A.journal_sha256))
        self.assertEqual(closure_digest(Path(res.last_commit)), self.a_digest)
        every = self.plan["train"]["commit_every_updates"]
        for step in range(every, FINAL_STEP, every):
            self.assertEqual(closure_digest(self.tmp / "P" / "commits" / f"{step:010d}"),
                             closure_digest(self.tmp / "A" / "commits" / f"{step:010d}"), f"commit {step}")
        published = [e for e in events(self.tmp / "P") if e["event"] == "published"]
        self.assertEqual(len(published), FINAL_STEP // every)
        self.assertTrue(all(e["rng_restored"] for e in published), "the publishes drew no RNG, so nothing was tested")

    def test_resume_refuses_other_training_data(self):
        """§6.6 identities: the closure binds the training data's content, so a resume against re-encoded contexts or
        changed labels is refused although the sampler fit is identical; stamped refs must equal the plan's."""
        ctxs, recs, enc = fixtures_p7.contexts(), fixtures_p7.records(), fixtures_p7.encodings()
        universe = set(self.data.fit.pi)
        shifted = {k: (v + np.float32(0.5) if k in universe else v) for k, v in enc.items()}
        slower = [dict(r, wall_us=2 * r["wall_us"])
                  if r["context_sha256"] in universe and r["outcome"] == "completed" and r["wall_us"] else r
                  for r in recs]
        for what, data in (("re-encoded", data_from(ctxs, recs, shifted)), ("rt-labels", data_from(ctxs, slower, enc))):
            with self.subTest(what):
                self.assertEqual(data.fit.sha256(), self.data.fit.sha256())
                with self.assertRaisesRegex(ckpt.CheckpointRefused, "train_data_sha256"):
                    train.resume_from_commit(self.plan, data, self.b_commit, self.empty_dir(f"data-{what}"))
        stamped = dataclasses.replace(self.data, refs={"corpus": "c" * 64})
        for name, call in (("resume", lambda: train.resume_from_commit(self.plan, stamped, self.b_commit,
                                                                       self.empty_dir("data-stamped"))),
                           ("fresh", lambda: train.run(self.plan, stamped, self.empty_dir("data-stamped-fresh")))):
            with self.subTest(name), self.assertRaisesRegex(ValueError, "'corpus'"):
                call()
        plan = make_plan(max_updates=1, refs={"corpus": "c" * 64})
        res = train.run(plan, stamped, self.empty_dir("data-stamped-ok"))
        self.assertEqual((res.status, res.step), ("COMPLETED", 1))

