def pointer_history(store: ckpt.FileVersionedStore, run_id: str) -> list[dict]:
    """Every version of the run's resume pointer, oldest first: its body plus the step of the manifest it names."""
    key = ckpt.pointer_key(PREFIX, run_id)
    out = []
    for version in store.list_versions(key):
        doc = json.loads(store.get(key, version_id=version["version_id"]).body)
        manifest = json.loads(store.get(ckpt.manifest_key(PREFIX, run_id, doc["target_manifest_sha256"]),
                                        version_id=doc["target_version_id"]).body)
        out.append(dict(doc, target_step=manifest["step"], version_id=version["version_id"],
                        manifest_files={k: r["sha256"] for k, r in manifest["files"].items()}))
    return out


