    fixture_step(m, opt, sch, smp, data)
    snap["next_params"] = {n: p.detach().clone() for n, p in m.named_parameters()}
    _MODULE["fixture"] = types.SimpleNamespace(plan=plan, data=data, commit=commit, snap=snap)
    return _MODULE["fixture"]


class FlakyStore:
    """Wraps a store; its first ``fail_puts`` PUTs raise ConnectionResetError before reaching it (nothing written)."""

    def __init__(self, inner: ckpt.FileVersionedStore, fail_puts: int):
        self.inner, self.bucket, self.fail_puts, self.puts = inner, inner.bucket, fail_puts, 0

    def _gate(self) -> None:
        self.puts += 1
        if self.puts <= self.fail_puts:
            raise ConnectionResetError("connection reset before the request was sent")

    def put_create_only(self, key, body):
        self._gate()
        return self.inner.put_create_only(key, body)

    def put_if_match(self, key, body, etag):
        self._gate()
        return self.inner.put_if_match(key, body, etag)

    def get(self, key, version_id=None):
        return self.inner.get(key, version_id)


def lose_responses(n: int):
    """A fault hook whose first ``n`` calls raise TimeoutError after the write succeeded (a lost response)."""
    calls = []

    def fault(op: str, key: str) -> None:
        calls.append((op, key))
        if len(calls) <= n:
            raise TimeoutError(f"response to {op} lost")
    fault.calls = calls
    return fault


def pointer_body(run_id: str, seq: int, target: str, prev: str | None = None, writer: str = "w1") -> bytes:
    return common.canonical({"schema": ckpt.SCHEMA_POINTER, "run_id": run_id, "pointer_name": "resume",
                             "target_manifest_sha256": target, "target_version_id": "v-" + target[:8], "seq": seq,
                             "prev_version_id": prev, "writer": {"host": writer}, "utc_us": 1_000_000 + seq})


class RngDrawingStore:
    """Wraps a store; every get() first draws from the global Python, numpy and torch RNGs, as a client's retry backoff
    would (botocore's ExponentialBackoff jitter calls random.random())."""

    def __init__(self, inner: ckpt.FileVersionedStore):
        self.inner, self.bucket, self.draws = inner, inner.bucket, 0

    def put_create_only(self, key, body):
        return self.inner.put_create_only(key, body)

    def put_if_match(self, key, body, etag):
        return self.inner.put_if_match(key, body, etag)

    def get(self, key, version_id=None):
        random.random()
        np.random.random()
        torch.rand(1)
        self.draws += 1
        return self.inner.get(key, version_id)


class OutageStore:
    """Wraps a store; while ``down`` every PUT raises ConnectionResetError before reaching it (nothing is written)."""

    def __init__(self, inner: ckpt.FileVersionedStore):
        self.inner, self.bucket, self.down = inner, inner.bucket, False

    def _gate(self) -> None:
        if self.down:
            raise ConnectionResetError("store outage: the request was never sent")

    def put_create_only(self, key, body):
        self._gate()
        return self.inner.put_create_only(key, body)

    def put_if_match(self, key, body, etag):
        self._gate()
        return self.inner.put_if_match(key, body, etag)

    def get(self, key, version_id=None):
        return self.inner.get(key, version_id)


