class VersionedStoreTest(unittest.TestCase):
    """P7 test 5: FileVersionedStore S3 conditional semantics and the §6.6 publish protocol."""

    def setUp(self):
        self.tmp = make_tmp(self)

    def test_conditional_writes_and_exact_version_reads(self):
        store = ckpt.FileVersionedStore(self.tmp / "s")
        key = ckpt.dep_key(PREFIX, "journal", "0" * 64)
        self.assertEqual((ckpt.PreconditionFailed.status, ckpt.NoSuchKey.status), (412, 404))
        v1 = store.put_create_only(key, b"one")
        with self.assertRaises(ckpt.PreconditionFailed):
            store.put_create_only(key, b"one")
        with self.assertRaises(ckpt.PreconditionFailed):
            store.put_create_only(key, b"two")
        with self.assertRaises(ckpt.PreconditionFailed):
            store.put_if_match(key, b"two", '"' + "0" * 32 + '"')
        v2 = store.put_if_match(key, b"two", v1.etag)
        with self.assertRaises(ckpt.PreconditionFailed):  # the ETag is stale now
            store.put_if_match(key, b"three", v1.etag)
        self.assertEqual(store.get(key), ckpt.GetResult(body=b"two", version_id=v2.version_id, etag=v2.etag))
        self.assertEqual(store.get(key, version_id=v1.version_id).body, b"one")
        self.assertEqual(store.get(key, version_id=v2.version_id).body, b"two")
        with self.assertRaises(ckpt.NoSuchKey):
            store.get(key, version_id="f" * 32)
        with self.assertRaises(ckpt.NoSuchKey):
            store.get(key + ".absent")
        with self.assertRaises(ckpt.NoSuchKey):
            store.put_if_match(key + ".absent", b"x", v1.etag)
        self.assertEqual(v1.etag, '"' + hashlib.md5(b"one").hexdigest() + '"')
        for seq, (put, body) in enumerate(((v1, b"one"), (v2, b"two")), start=1):
            self.assertEqual(put.version_id, hashlib.sha256(
                f"{key}\0{seq}\0{common.sha256_bytes(body)}".encode()).hexdigest()[:32])
        kdir = self.tmp / "s" / hashlib.sha256(key.encode()).hexdigest()
        self.assertEqual((kdir / "key.txt").read_text(), key)
        lines = (kdir / "log.jsonl").read_bytes().splitlines()
        self.assertEqual([json.loads(line) for line in lines], [
            {"seq": 1, "version_id": v1.version_id, "etag": v1.etag, "sha256": common.sha256_bytes(b"one"), "bytes": 3},
            {"seq": 2, "version_id": v2.version_id, "etag": v2.etag, "sha256": common.sha256_bytes(b"two"),
             "bytes": 3}])
        self.assertTrue(all(common.canonical(json.loads(line)) == line for line in lines))
        self.assertEqual(sorted(p.name for p in (kdir / "blobs").iterdir()), sorted([v1.version_id, v2.version_id]))
        self.assertEqual(ckpt.FileVersionedStore(self.tmp / "s").list_versions(key), store.list_versions(key))
        for obj in (store, ckpt.FileVersionedStore):
            self.assertEqual([a for a in dir(obj) if "delete" in a.lower() or "remove" in a.lower()], [])

    def test_publish_dependency_resolutions(self):
        body = b'{"cursor":1}'
        key = ckpt.dep_key(PREFIX, "sampler", common.sha256_bytes(body))
        store = ckpt.FileVersionedStore(self.tmp / "plain")
        ref = ckpt.publish_dependency(store, key, body)
        self.assertEqual(ref, {"bucket": store.bucket, "key": key, "version_id": store.get(key).version_id,
                               "sha256": common.sha256_bytes(body), "bytes": len(body), "readback_verified": True,
                               "new_bytes": len(body)})
        self.assertEqual(ckpt.publish_dependency(store, key, body), dict(ref, new_bytes=0))  # 412 with equal bytes
        with self.assertRaises(ckpt.PoisonedKey):
            ckpt.publish_dependency(store, key, b'{"cursor":2}')
        self.assertEqual(len(store.list_versions(key)), 1)

        fault = lose_responses(1)  # the PUT is applied but its response is lost: equal bytes on re-read
        lossy = ckpt.FileVersionedStore(self.tmp / "lossy", fault=fault)
        ref = ckpt.publish_dependency(lossy, key, body)
        self.assertEqual(fault.calls, [("put_create_only", key)])
        self.assertEqual([v["version_id"] for v in lossy.list_versions(key)], [ref["version_id"]])
        self.assertEqual(ref["new_bytes"], len(body))

        poisoned = ckpt.FileVersionedStore(self.tmp / "poisoned")
        poisoned.put_create_only(key, b"other bytes")
        with self.assertRaises(ckpt.PoisonedKey):  # a 412 whose re-read finds different bytes
            ckpt.publish_dependency(poisoned, key, body)
        with self.assertRaises(ckpt.PoisonedKey):  # a transport error whose re-read finds different bytes
            ckpt.publish_dependency(FlakyStore(poisoned, 1), key, body)
        self.assertEqual(len(poisoned.list_versions(key)), 1)

        flaky = FlakyStore(ckpt.FileVersionedStore(self.tmp / "flaky"), 1)
        ref = ckpt.publish_dependency(flaky, key, body)  # absent after a failed PUT: one more create-only PUT
        self.assertEqual((flaky.puts, ref["new_bytes"], len(flaky.inner.list_versions(key))), (2, len(body), 1))
        dead = FlakyStore(ckpt.FileVersionedStore(self.tmp / "dead"), 2)
        with self.assertRaises(ConnectionResetError):
            ckpt.publish_dependency(dead, key, body)
        self.assertEqual(dead.puts, 2)
        with self.assertRaises(ckpt.NoSuchKey):
            dead.get(key)

    def test_cas_pointer_cases(self):
        store = ckpt.FileVersionedStore(self.tmp / "p")
        key = ckpt.pointer_key(PREFIX, "run-x")
        m1, m2, m3 = (common.sha256_bytes(s) for s in (b"m1", b"m2", b"m3"))
        b1 = pointer_body("run-x", 1, m1)
        v1, e1, s1 = ckpt.cas_pointer(store, key, b1, None, parent_manifest_sha256=None)
        head = store.get(key)
        self.assertEqual((v1, e1, s1), (head.version_id, head.etag, 1))
        exp1 = ckpt.ExpectedPointer(v1, e1, common.sha256_bytes(b1), 1, m1, "mv1")
        with self.assertRaises(ckpt.Conflict):  # no expectation, but a pointer exists
            ckpt.cas_pointer(store, key, pointer_body("run-x", 1, m2), None, parent_manifest_sha256=None)
        with self.assertRaises(ckpt.Conflict):  # the manifest's parent is not the pointer's target
            ckpt.cas_pointer(store, key, pointer_body("run-x", 2, m2, v1), exp1, parent_manifest_sha256=m3)
        b2 = pointer_body("run-x", 2, m2, v1)
        v2, e2, s2 = ckpt.cas_pointer(store, key, b2, exp1, parent_manifest_sha256=m1)
        self.assertEqual((s2, len(store.list_versions(key))), (2, 2))
        self.assertEqual(ckpt.cas_pointer(store, key, b2, exp1, parent_manifest_sha256=m1), (v2, e2, 2))  # adopt
        exp2 = ckpt.ExpectedPointer(v2, e2, common.sha256_bytes(b2), 2, m2, "mv2")
        with self.assertRaises(ckpt.Conflict):  # a stale expectation
            ckpt.cas_pointer(store, key, pointer_body("run-x", 3, m3, v1), exp1, parent_manifest_sha256=m2)
        store.put_if_match(key, pointer_body("run-x", 3, m3, v2, writer="foreign"), e2)
        with self.assertRaises(ckpt.Conflict):  # a foreign writer moved the pointer
            ckpt.cas_pointer(store, key, pointer_body("run-x", 3, m3, v2), exp2, parent_manifest_sha256=m2)
        with self.assertRaises(ckpt.Conflict):  # absent while this writer expects a version
            ckpt.cas_pointer(store, ckpt.pointer_key(PREFIX, "run-y"), pointer_body("run-y", 3, m3, v2), exp2,
                             parent_manifest_sha256=m2)
        self.assertEqual(len(store.list_versions(key)), 3)

        fault = lose_responses(2)  # lost responses on the create and on the If-Match are adopted by the re-GET
        lossy = ckpt.FileVersionedStore(self.tmp / "lossy", fault=fault)
        lv1, le1, _ = ckpt.cas_pointer(lossy, key, b1, None, parent_manifest_sha256=None)
        lv2, _le2, _ = ckpt.cas_pointer(lossy, key, b2, ckpt.ExpectedPointer(lv1, le1, common.sha256_bytes(b1), 1,
                                                                              m1, "mv1"), parent_manifest_sha256=m1)
        self.assertEqual([op for op, _ in fault.calls], ["put_create_only", "put_if_match"])
        self.assertEqual([v["version_id"] for v in lossy.list_versions(key)], [lv1, lv2])

        dead = FlakyStore(ckpt.FileVersionedStore(self.tmp / "dead"), 2)
        with self.assertRaises(ckpt.Conflict):  # a PUT unresolved after one repeat
            ckpt.cas_pointer(dead, key, b1, None, parent_manifest_sha256=None)
        self.assertEqual(dead.puts, 2)
        with self.assertRaises(ckpt.NoSuchKey):
            dead.get(key)

