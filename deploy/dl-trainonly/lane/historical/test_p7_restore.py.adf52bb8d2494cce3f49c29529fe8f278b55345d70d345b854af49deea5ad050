        self.assertEqual(self.a_digest["step"], FINAL_STEP)
        self.assertEqual((self.B.status, self.B.reason, self.B.step), ("YIELDED_TO_INTAKE", "stop_file", STOP_STEP))
        self.assertIsNotNone(self.B.published)
