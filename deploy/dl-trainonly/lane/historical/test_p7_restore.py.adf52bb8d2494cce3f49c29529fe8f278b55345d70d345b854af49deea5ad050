        store = ckpt.FileVersionedStore(self.tmp / "store")
        commit, closure = ckpt.open_commit(fx.commit.dir)
        pub = ckpt.publish_commit(store, commit, prefix=PREFIX, expected=None, writer=WRITER)
        # P8: the journal is published as content-addressed chunks plus an index (ckpt.PUBLISHED_KINDS)
        self.assertEqual(sorted(pub["deps"]), sorted("journal-index" if k == "journal" else k
                                                     for k in commit.doc["files"]))
        for kind, ref in pub["deps"].items():
            if kind == "journal-index":
                index_body = store.get(ref["key"], version_id=ref["version_id"]).body
                self.assertEqual(ckpt._restore_journal(store, PREFIX, index_body),  # noqa: SLF001
                                 (commit.dir / commit.doc["files"]["journal"]["name"]).read_bytes())
                continue
            entry = commit.doc["files"][kind]
            self.assertEqual(ref["key"], ckpt.dep_key(PREFIX, kind, entry["sha256"]))
            self.assertEqual((ref["sha256"], ref["bytes"], ref["new_bytes"], ref["readback_verified"]),
                             (entry["sha256"], entry["bytes"], entry["bytes"], True))
            self.assertTrue(store.get(ref["key"], version_id=ref["version_id"]).body
                            == (commit.dir / entry["name"]).read_bytes())
        ptr = pub["pointer"]
        head = store.get(ckpt.pointer_key(PREFIX, closure.run_id))
        self.assertEqual((head.version_id, head.etag, common.sha256_bytes(head.body), ptr.seq),
                         (ptr.version_id, ptr.etag, ptr.sha256, 1))
        pdoc = json.loads(head.body)
        self.assertEqual((pdoc["schema"], pdoc["pointer_name"], pdoc["target_manifest_sha256"],
                          pdoc["target_version_id"], pdoc["prev_version_id"], pdoc["writer"]),
                         (ckpt.SCHEMA_POINTER, "resume", ptr.manifest_sha256, ptr.manifest_version_id, None, WRITER))
        manifest = json.loads(store.get(ckpt.manifest_key(PREFIX, closure.run_id, ptr.manifest_sha256),
                                        version_id=ptr.manifest_version_id).body)
        self.assertEqual((manifest["schema"], manifest["step"], manifest["parameter_sha256"]),
                         (ckpt.SCHEMA_CHECKPOINT, closure.step, commit.doc["parameter_sha256"]))
        self.assertEqual(manifest["files"]["models"], {k: pub["deps"]["models"][k] for k in ckpt.S3REF_KEYS})

        restored, pointer = ckpt.restore_closure(store, prefix=PREFIX, run_id=closure.run_id,
                                                 dest_dir=self.tmp / "restore")
        self.assertEqual(pointer, ptr)
        self.assertEqual(restored.dir, self.tmp / "restore" / "commits" / f"{closure.step:010d}")
        self.assertEqual(restored.doc["files"], commit.doc["files"])
        for entry in commit.doc["files"].values():
            self.assertTrue((restored.dir / entry["name"]).read_bytes() == (commit.dir / entry["name"]).read_bytes())
        self.assertEqual((restored.doc["expected_pointer"], restored.doc["parent"], restored.doc["wall_time_utc_us"]),
                         (ptr.to_json(), commit.doc["parent"], commit.doc["wall_time_utc_us"]))

        child = dataclasses.replace(
            closure, step=closure.step + 1,
            journal_bytes=closure.journal_bytes + common.canonical({"step": closure.step + 1}) + b"\n",
            parent={"commit_sha256": commit.commit_sha256, "manifest_sha256": ptr.manifest_sha256,
                    "manifest_version_id": ptr.manifest_version_id}, expected_pointer=ptr.to_json())
        child_commit = ckpt.write_commit(self.tmp / "commits", child)
        pub2 = ckpt.publish_commit(store, child_commit, prefix=PREFIX, expected=ptr, writer=WRITER)
        head_key = ckpt.pointer_key(PREFIX, closure.run_id)
        self.assertEqual(pub2["pointer"].seq, 2)
        self.assertEqual(json.loads(store.get(head_key).body)["prev_version_id"], ptr.version_id)
        shared = sorted(set(child_commit.doc["files"]) - {"journal"})
        self.assertEqual([pub2["deps"][k]["new_bytes"] for k in shared], [0] * len(shared))  # deduplicated (412)
        with self.assertRaises(ckpt.Conflict):  # republishing the parentless commit: its parent is not the target
            ckpt.publish_commit(store, commit, prefix=PREFIX, expected=pub2["pointer"], writer=WRITER)
        self.assertEqual(len(store.list_versions(head_key)), 2)
        restored2, pointer2 = ckpt.restore_closure(store, prefix=PREFIX, run_id=closure.run_id,
                                                   dest_dir=self.tmp / "restore2")
        self.assertEqual((restored2.step, pointer2), (closure.step + 1, pub2["pointer"]))

        with self.assertRaises(ckpt.CheckpointRefused):  # destination not empty
            ckpt.restore_closure(store, prefix=PREFIX, run_id=closure.run_id, dest_dir=self.tmp / "restore")
        with self.assertRaises(ckpt.CheckpointRefused):  # no pointer for another run
            ckpt.restore_closure(store, prefix=PREFIX, run_id="other-run", dest_dir=self.tmp / "restore3")
        ref = pub2["deps"]["models"]
        blob = self.tmp / "store" / hashlib.sha256(ref["key"].encode()).hexdigest() / "blobs" / ref["version_id"]
        data = bytearray(blob.read_bytes())
        data[-1] ^= 0x01
        blob.write_bytes(bytes(data))
        with self.assertRaises(ckpt.CheckpointRefused):  # stored bytes differ from the manifest: nothing written
            ckpt.restore_closure(store, prefix=PREFIX, run_id=closure.run_id, dest_dir=self.tmp / "restore4")
        self.assertFalse((self.tmp / "restore4" / "commits").exists())


