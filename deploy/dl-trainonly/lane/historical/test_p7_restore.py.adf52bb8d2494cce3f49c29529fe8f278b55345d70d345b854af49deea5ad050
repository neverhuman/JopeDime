def manual_parameter_sha256(named) -> str:
    """Independent recomputation of the §6.6 rule: for each name in sorted order, ``name NUL F32 NUL shape-csv LF``
    followed by the tensor's little-endian float32 bytes."""
    h = hashlib.sha256()
    for name in sorted(named):
        t = named[name].detach().to("cpu").contiguous()
        if t.dtype != torch.float32:
            raise AssertionError(f"{name} is {t.dtype}")
        h.update(f"{name}\0F32\0{','.join(str(int(s)) for s in t.shape)}\n".encode("utf-8"))
        h.update(np.ascontiguousarray(t.numpy(), dtype="<f4").tobytes())
    return h.hexdigest()


def tensor_bytes(t: torch.Tensor) -> bytes:
    return t.detach().to("cpu").contiguous().numpy().tobytes()


def rng_snapshot() -> tuple:
    return torch.get_rng_state().clone(), random.getstate(), np.random.get_state()


def same_rng(a: tuple, b: tuple) -> bool:
    (ta, pa, na), (tb, pb, nb) = a, b
    return (torch.equal(ta, tb) and pa == pb and na[0] == nb[0] and np.array_equal(na[1], nb[1])
            and tuple(na[2:]) == tuple(nb[2:]))


def closure_digest(commit_dir: Path) -> dict:
    """sha256 of every compared closure file plus parameter_sha256 and step, from a strictly verified commit."""
    commit, _closure = ckpt.open_commit(Path(commit_dir))
    out = {kind: commit.doc["files"][kind]["sha256"] for kind in COMPARED_KINDS}
    out.update(parameter_sha256=commit.doc["parameter_sha256"], step=commit.step)
    return out


def copy_commit(src: Path, dst: Path) -> Path:
    shutil.copytree(src, dst)
    for p in dst.iterdir():
        p.chmod(0o644)
    return dst


def rewrite_consistently(commit_dir: Path, kind: str, body: bytes | None) -> Path:
    """Replace (or drop) one closure file and update commit.json's entry and tensor inventory to match, so only the
    loader's semantic checks can refuse the result."""
    commit_path = commit_dir / ckpt.COMMIT_FILE
    doc = json.loads(commit_path.read_bytes())
    name = kind + ckpt.KINDS[kind]
    if body is None:
        (commit_dir / name).unlink()
        del doc["files"][kind]
    else:
        (commit_dir / name).write_bytes(body)
        doc["files"][kind] = {"name": name, "sha256": common.sha256_bytes(body), "bytes": len(body)}
        if kind in doc["tensor_inventory_sha256"]:
            doc["tensor_inventory_sha256"][kind] = model.tensor_inventory_sha256(safetensors.torch.load(body))
    commit_path.write_bytes(common.canonical(doc))
    return commit_dir


def fixture_step(m, opt, sch, smp, data) -> bytes:
    """One deterministic update that consumes the python, numpy and torch (dropout) global RNGs in that order."""
    draw = smp.draw_next()
    batch = sampler.collate(draw, data)
    scale = 0.05 * random.random()
    noise = torch.from_numpy(np.random.standard_normal(tuple(batch.ctx_z.shape)).astype(np.float32))
    m.train()
    out = m(batch.tokens, batch.lengths, batch.ctx_z + scale * noise, batch.seq_ctx)
    loss = (out.logits.float().square().mean() + out.q_hat.square().mean() + out.feas_logits.square().mean()
            + out.rt_hat.square().mean())
    opt.zero_grad(set_to_none=True)
    loss.backward()
    opt.step()
    sch.step()
    return common.canonical(draw.journal_record() | {"loss": float(loss.detach())}) + b"\n"


