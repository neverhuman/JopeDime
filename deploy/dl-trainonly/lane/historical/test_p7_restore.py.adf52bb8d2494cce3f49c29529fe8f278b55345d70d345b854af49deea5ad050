            "opt_state": {names[id(p)]: {k: v.clone() for k, v in st.items()} for p, st in opt.state.items()},
            "groups": copy.deepcopy([{k: v for k, v in g.items() if k != "params"} for g in opt.param_groups]),
            "sched": copy.deepcopy({k: sched[k] for k in ckpt.SCHEDULER_KEYS}),
            "rng": rng_snapshot(), "sampler": smp.state_dict(), "journal": journal}
    commit = ckpt.save_local_commit(
        _MODULE["tmp"] / "fixture", run_id=plan["run_id"], step=FIXTURE_STEPS, model=m, optimizer=opt, scheduler=sch,
