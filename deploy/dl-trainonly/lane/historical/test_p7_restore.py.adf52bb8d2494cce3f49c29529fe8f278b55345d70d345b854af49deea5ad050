    def test_fresh_subprocess_resume_equals_uninterrupted(self):
        workdir = self.empty_dir("C")
        store_root = self.tmp / "store-C"  # a replica of B's bucket, so B's own pointer stays at step 37
        shutil.copytree(self.store_root, store_root)
        args = {"plan": str(self.plan_path), "store": str(store_root), "workdir": str(workdir), "prefix": PREFIX}
        t0 = time.monotonic()
        proc = subprocess.run([sys.executable, "-c", CHILD, json.dumps(args)], cwd=str(SRC), env=dict(os.environ),
                              capture_output=True, text=True, timeout=CHILD_TIMEOUT_S)
        sys.stderr.write(f"\n[p7 restore] fresh-subprocess resume {time.monotonic() - t0:.1f} s\n")
        self.assertEqual(proc.returncode, 0, f"child failed:\n{proc.stderr[-6000:]}")
        lines = [line for line in proc.stdout.splitlines() if line.startswith("P7_CHILD_RESULT ")]
        self.assertEqual(len(lines), 1, proc.stdout[-2000:])
        out = json.loads(lines[0].split(" ", 1)[1])
        res = out["result"]
        self.assertEqual((res["status"], res["step"]), ("COMPLETED", FINAL_STEP))
        self.assertEqual((out["num_threads"], torch.get_num_threads()), (4, 4))
        self.assertEqual(out["plan_sha256"], train.plan_sha256(self.plan))
        c_commit = Path(res["last_commit"])
        self.assertTrue(c_commit.is_relative_to(workdir), c_commit)
        self.assertEqual(closure_digest(c_commit), self.a_digest)
        self.assertEqual((res["parameter_sha256"], res["journal_sha256"]),
                         (self.A.parameter_sha256, self.A.journal_sha256))
        final, pointer = ckpt.restore_closure(ckpt.FileVersionedStore(store_root), prefix=PREFIX,
                                              run_id=self.plan["run_id"], dest_dir=self.tmp / "final-restore")
        self.assertEqual(closure_digest(final.dir), self.a_digest)  # the child's last publish is A's closure too
        self.assertEqual(pointer.seq, ckpt.load_expected(workdir).seq)
        b_events, c_events = events(self.tmp / "B"), events(workdir)
        self.assertEqual((c_events[0]["event"], c_events[0]["rule"]), ("resumed", "restored_pointer_target"))
        self.assertEqual(c_events[0]["seq"], b_events[-1]["seq"] + 1, "C must continue above B's last event")
        seqs = [e["seq"] for e in b_events + c_events]
        self.assertEqual(len(seqs), len(set(seqs)), "an event seq repeats across the B -> C yield/resume chain")

    def test_in_process_resume_from_b_equals_a(self):
