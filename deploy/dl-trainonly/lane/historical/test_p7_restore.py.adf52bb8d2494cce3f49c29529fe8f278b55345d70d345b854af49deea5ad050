class YieldResumeProtocolTest(unittest.TestCase):
    """§6.8 at resume (ckpt.resume_point) on a 6-step plan that commits every 2 updates and stops at step 3, against
    the uninterrupted run U. A local commit is never discarded silently, and event seqs never repeat."""

    @classmethod
    def setUpClass(cls):
        tmp = tempfile.TemporaryDirectory(dir=os.environ["TMPDIR"], prefix="p7-yield-")
        cls.addClassCleanup(tmp.cleanup)
        cls.tmp = Path(tmp.name)
        cls.plan = make_plan(max_updates=SHORT_STEPS, train=fixtures_p7.train_config(commit_every_updates=SHORT_EVERY))
        cls.run_id = cls.plan["run_id"]
        cls.data = fixtures_p7.train_data()
        cls.U = train.run(cls.plan, cls.data, cls.tmp / "U")
        cls.u_digest = closure_digest(Path(cls.U.last_commit))

    def yielded(self, name: str, *, outage_from: int | None):
        """A launch that stops at SHORT_STOP through the STOP file; its store refuses every PUT from step
        ``outage_from`` on (0: from the start; None: never)."""
        store = OutageStore(ckpt.FileVersionedStore(self.tmp / f"store-{name}"))
        stop = self.tmp / f"STOP-{name}"
        store.down = outage_from == 0

        def after_step(step: int) -> None:
            if step == SHORT_STOP:
                stop.touch()
            if outage_from is not None and step == outage_from:
                store.down = True
        res = train.run(self.plan, self.data, self.tmp / name, store=store, store_prefix=PREFIX, stop_file=stop,
                        hooks=train.TrainHooks(after_step=after_step))
        store.down = False
        return res, store

    def resume(self, store, name: str, local: str | None) -> train.RunResult:
        return train.resume_from_store(self.plan, self.data, store, self.tmp / name, store_prefix=PREFIX,
                                       local_commits=None if local is None else self.tmp / local / "commits")

    def assert_chain(self, first: str, second: str, rule: str) -> list[dict]:
        """The second launch resumed under ``rule`` above every event seq of the first, with no repeated seq."""
        a, b = events(self.tmp / first), events(self.tmp / second)
        self.assertEqual((b[0]["event"], b[0]["rule"], b[0]["step"]), ("resumed", rule, SHORT_STOP))
        self.assertEqual(b[0]["seq"], a[-1]["seq"] + 1)
        self.assertEqual(len({e["seq"] for e in a + b}), len(a) + len(b))
        return a

    def test_unpublished_yield_is_published_first_by_the_next_launch(self):
        res, store = self.yielded("B1", outage_from=SHORT_STOP)
        self.assertEqual((res.status, res.reason, res.step), ("YIELDED_UNPUBLISHED", "stop_file", SHORT_STOP))
        self.assertEqual([p["target_step"] for p in pointer_history(store.inner, self.run_id)], [SHORT_EVERY])
        local_commit = ckpt.open_commit(self.tmp / "B1" / "commits" / f"{SHORT_STOP:010d}")[0]
        out = self.resume(store, "C1", "B1")
        self.assertEqual((out.status, out.step), ("COMPLETED", SHORT_STEPS))
        self.assertEqual(closure_digest(Path(out.last_commit)), self.u_digest)
        self.assertEqual(out.parameter_sha256, self.U.parameter_sha256)
        self.assertFalse((self.tmp / "C1" / "restore").exists())
        history = pointer_history(store.inner, self.run_id)
        self.assertEqual([p["target_step"] for p in history], [SHORT_EVERY, SHORT_STOP, 4, SHORT_STEPS])
        published_first = history[1]
        self.assertEqual(published_first["prev_version_id"], history[0]["version_id"])
        files = {k: e["sha256"] for k, e in local_commit.doc["files"].items() if k != "journal"}
        self.assertEqual({k: v for k, v in published_first["manifest_files"].items() if k != "journal-index"}, files)
        self.assertIn("journal-index", published_first["manifest_files"])      # P8: chunked journal
        b_events = self.assert_chain("B1", "C1", "published_newest_local_first")
        self.assertIn("publish_failed", [e["event"] for e in b_events])
        self.assertEqual(published_first["writer"]["event_seq"], b_events[-1]["seq"])

    def test_unpublished_first_commit_is_published_create_only(self):
        res, store = self.yielded("B5", outage_from=0)
        self.assertEqual((res.status, res.step), ("YIELDED_UNPUBLISHED", SHORT_STOP))
        with self.assertRaises(ckpt.NoSuchKey):
            store.get(ckpt.pointer_key(PREFIX, self.run_id))
        out = self.resume(store, "C5", "B5")
        self.assertEqual((out.status, out.step, closure_digest(Path(out.last_commit))),
                         ("COMPLETED", SHORT_STEPS, self.u_digest))
        history = pointer_history(store.inner, self.run_id)
        self.assertEqual([(p["target_step"], p["seq"]) for p in history], [(SHORT_STOP, 1), (4, 2), (SHORT_STEPS, 3)])
        self.assertIsNone(history[0]["prev_version_id"])
        self.assert_chain("B5", "C5", "published_newest_local_first")

    def test_pointer_target_that_is_the_newest_local_commit_is_continued_in_place(self):
        res, store = self.yielded("B2", outage_from=None)
        self.assertEqual((res.status, res.step), ("YIELDED_TO_INTAKE", SHORT_STOP))
        out = self.resume(store, "C2", "B2")
        self.assertEqual((out.status, out.step, closure_digest(Path(out.last_commit))),
                         ("COMPLETED", SHORT_STEPS, self.u_digest))
        self.assertFalse((self.tmp / "C2" / "restore").exists())
        self.assertEqual([p["target_step"] for p in pointer_history(store.inner, self.run_id)],
                         [SHORT_EVERY, SHORT_STOP, 4, SHORT_STEPS])
        self.assertEqual(events(self.tmp / "C2")[0]["commit_dir"],
                         str(self.tmp / "B2" / "commits" / f"{SHORT_STOP:010d}"))
        self.assert_chain("B2", "C2", "target_is_newest_local")

    def test_every_other_combination_stops_before_writing(self):
        _res, store = self.yielded("B3", outage_from=None)          # pointer at B3's published step 3
        self.yielded("B4", outage_from=SHORT_STOP)                  # B4's own step 3 never reached any store
        key = ckpt.pointer_key(PREFIX, self.run_id)
        versions = store.inner.list_versions(key)
        cases = {"same-step-other-closure": "B4", "newer-not-a-child": "U"}
        for what, local in cases.items():
            with self.subTest(what):
                with self.assertRaisesRegex(ckpt.CheckpointRefused, "STOP"):
                    self.resume(store, f"C3-{what}", local)
                self.assertEqual(store.inner.list_versions(key), versions)
                self.assertEqual(os.listdir(self.tmp / f"C3-{what}"), [])
        empty = ckpt.FileVersionedStore(self.tmp / "store-empty")
        for local in (None, "B3"):                                  # B3's newest commit has a published parent
            with self.subTest(empty_store_with=local), self.assertRaisesRegex(ckpt.CheckpointRefused, "no resume pointer"):
                self.resume(empty, f"C3-empty-{local}", local)
        self.assertEqual(empty.list_versions(key), [])
        with self.assertRaisesRegex(ValueError, "resume_from_store"):
            train.resume_from_commit(self.plan, self.data, self.tmp / "B3" / "commits" / f"{SHORT_STOP:010d}",
                                     self.tmp / "C3-local", store=store)
        with self.assertRaisesRegex(ckpt.CheckpointRefused, "resume pointer"):
            train.run(self.plan, self.data, self.tmp / "C3-fresh", store=store, store_prefix=PREFIX)
        self.assertEqual(store.inner.list_versions(key), versions)


