class WatchdogTests(unittest.TestCase):
    INTERVAL, HARD = 0.1, 0.6

    def make(self, name, **kw):
        fx = Fx(name, now_ns=time.time_ns())
        exits = []
        fired = threading.Event()

        def fake_exit(code):
            exits.append((code, time.monotonic()))
            fired.set()

        wd = gg.Watchdog(os.getpid(), fx.sources(), interval_s=kw.pop("interval_s", self.INTERVAL),
                         hard_exit_s=kw.pop("hard_exit_s", self.HARD), hard_exit=fake_exit, **kw)
        self.addCleanup(wd.disarm)
        return fx, wd, exits, fired

    def wait_probes(self, wd, n, timeout=10.0):
        end = time.monotonic() + timeout
        while wd.probes < n and time.monotonic() < end:
            time.sleep(0.01)
        self.assertGreaterEqual(wd.probes, n)

    def test_bounds(self):
        for kw in ({"interval_s": 15.01}, {"interval_s": 0}, {"hard_exit_s": 60.5}, {"hard_exit_s": 0}):
            with self.subTest(**kw), self.assertRaises(ValueError):
                gg.Watchdog(1, gg.DEFAULT_SOURCES, **kw)
        wd = gg.Watchdog(1, gg.DEFAULT_SOURCES)
        self.assertEqual((wd.interval_s, wd.hard_exit_s, wd.daemon), (15.0, 60.0, True))

    def test_startup_unit_signal_yields_within_interval_then_hard_exit(self):
        fx, wd, exits, fired = self.make("wd-startup")
        wd.start()
        self.wait_probes(wd, 1)
        self.assertEqual(wd.latest.decision, gg.CONTINUE, wd.latest.reasons)     # reserve held, no step taken yet
        t_inj = time.monotonic()
        fx.units.append((LANE_UNIT, "active"))
        self.assertTrue(wd.yield_requested.wait(10))
        self.assertLessEqual(time.monotonic() - t_inj, self.INTERVAL + SLACK_S)
        self.assertTrue(fired.wait(10))
        (code, t_exit), = exits
        self.assertEqual(code, 75)
        self.assertGreaterEqual(t_exit - wd.intake_first_seen, self.HARD - 1e-3)
        self.assertLessEqual(t_exit - t_inj, self.HARD + self.INTERVAL + SLACK_S)
        wd.join(5)
        self.assertFalse(wd.is_alive())
        self.assertTrue(wd.hard_exit_fired.is_set())
        self.assertEqual(wd.latest.decision, gg.YIELD)
        self.assertIn("intake_unit_active", codes(wd.intake_first_reasons))

    def test_checkpoint_pause_lock_signal_hard_exit_while_trainer_blocked(self):
        fx, wd, exits, fired = self.make("wd-ckpt")
        in_checkpoint, release, steps = threading.Event(), threading.Event(), []

        def trainer():
            while not wd.yield_requested.is_set():
                steps.append(time.monotonic())
                if len(steps) == 3:
                    in_checkpoint.set()
                    release.wait(30)          # a checkpoint write that does not return in time
                    return
                time.sleep(0.02)

        wd.start()
        self.wait_probes(wd, 2)
        t = threading.Thread(target=trainer, daemon=True)
        t.start()
        self.assertTrue(in_checkpoint.wait(10))
        t_inj = time.monotonic()
        fx.write_locks(held=True)
        self.assertTrue(wd.yield_requested.wait(10))
        self.assertLessEqual(time.monotonic() - t_inj, self.INTERVAL + SLACK_S)
        self.assertTrue(fired.wait(10))
        self.assertTrue(t.is_alive(), "the trainer was still in its checkpoint pause when the hard exit fired")
        self.assertEqual(exits[0][0], 75)
        self.assertGreaterEqual(exits[0][1] - wd.intake_first_seen, self.HARD - 1e-3)
        self.assertLessEqual(exits[0][1] - t_inj, self.HARD + self.INTERVAL + SLACK_S)
        self.assertEqual(len(steps), 3)
        release.set()
        t.join(5)
        self.assertIn("tabpfn_lock_held", codes(wd.intake_first_reasons))

    def test_disarm_before_deadline_prevents_hard_exit(self):
        fx, wd, exits, fired = self.make("wd-disarm", hard_exit_s=1.0)
        fx.write_locks(held=True)
        wd.start()
        self.assertTrue(wd.yield_requested.wait(10))
        wd.disarm()
        wd.join(5)
        self.assertFalse(wd.is_alive())
        self.assertFalse(fired.wait(1.0 + 3 * self.INTERVAL))
        self.assertEqual(exits, [])

    def test_disarm_during_inflight_probe_wins_over_hard_exit(self):
        """The trainer disarms (normal exit) while a probe is in flight and the deadline has already passed."""
        clock, holder = [0.0], {}

        def mono():
            clock[0] += 100.0                 # every reading is far past any hard-exit deadline
            return clock[0]

        def probe():
            holder["wd"].disarm()
            return verdict(gg.YIELD, ("tabpfn_lock_held:1",))

        fx, wd, exits, fired = self.make("wd-disarm-race", probe=probe, monotonic=mono)
        holder["wd"] = wd
        wd.start()
        wd.join(5)
        self.assertFalse(wd.is_alive())
        self.assertEqual((exits, wd.probes), ([], 1))
        self.assertFalse(wd.hard_exit_fired.is_set())
        self.assertTrue(wd.yield_requested.is_set())
        self.assertIsNotNone(wd.intake_first_seen)

    def test_foreign_app_yields_without_hard_exit(self):
        fx, wd, exits, fired = self.make("wd-foreign")
        fx.apps_lines = ["31337, codex-neural-encoding-worker, 900"]
        wd.start()
        self.assertTrue(wd.yield_requested.wait(10))
        self.assertFalse(fired.wait(self.HARD + 4 * self.INTERVAL))
        self.assertEqual(wd.latest.decision, gg.YIELD)
        self.assertIsNone(wd.intake_first_seen)

    def test_stop_and_abort_request_yield_without_hard_exit(self):
        for d in (gg.STOP, gg.ABORT_GATE):
            with self.subTest(decision=d):
                fx, wd, exits, fired = self.make("wd-" + d, probe=lambda d=d: verdict(d))
                wd.start()
                self.assertTrue(wd.yield_requested.wait(10))
                self.assertFalse(fired.wait(self.HARD + 3 * self.INTERVAL))
                wd.disarm()

    def test_pause_does_not_request_yield(self):
        fx, wd, exits, fired = self.make("wd-pause", probe=lambda: verdict(gg.PAUSE))
        wd.start()
        self.wait_probes(wd, 4)
        self.assertFalse(wd.yield_requested.is_set())

    def test_probe_exception_counts_as_yield_and_arms_hard_exit(self):
        def broken():
            raise OSError("nvidia-smi vanished")

        fx, wd, exits, fired = self.make("wd-exc", probe=broken)
        wd.start()
        self.assertTrue(wd.yield_requested.wait(10))
        self.assertEqual(wd.latest.decision, gg.YIELD)
        self.assertEqual(wd.latest.reasons, ("probe_exception:OSError",))
        self.assertTrue(wd.errors and "nvidia-smi vanished" in wd.errors[0]["error"])
        self.assertTrue(fired.wait(10))
        self.assertEqual(exits[0][0], 75)

    def test_probes_at_least_every_interval(self):
        times = []

        def probe():
            times.append(time.monotonic())
            return verdict(gg.CONTINUE)

        fx, wd, exits, fired = self.make("wd-rate", interval_s=0.05, probe=probe)
        wd.start()
        time.sleep(1.0)
        wd.disarm()
        wd.join(5)
        gaps = [b - a for a, b in zip(times, times[1:])]
        self.assertGreaterEqual(len(times), 8)
        self.assertLessEqual(max(gaps), 0.05 + 0.25, gaps)

    def test_child_trainer_releases_reserve_only_by_exiting(self):
        """CPU-only child: holds a stand-in reserve, blocks in a checkpoint pause, default hard exit os._exit(75)."""
        fx = Fx("wd-child", now_ns=time.time_ns())
        root = Path(gg.__file__).resolve().parents[1]
        cfg = {"q": str(fx.q), "c": str(fx.c), "lock": str(fx.lock), "dir": str(fx.dir), "glob": UNIT_GLOB,
               "interval": 0.1, "hard_exit_s": 1.0, "ready": str(fx.dir / "ready"), "yield_seen": str(fx.dir / "yield-seen")}
        (fx.dir / "cfg.json").write_text(json.dumps(cfg))
        script = fx.dir / "child_trainer.py"
        script.write_text(CHILD)
        with open(fx.dir / "child.stderr", "wb") as err:
            p = subprocess.Popen([sys.executable, str(script), str(fx.dir / "cfg.json")], cwd=root, env=child_env(root),
                                 stdout=subprocess.DEVNULL, stderr=err)
            try:
                end = time.monotonic() + 30
                while not Path(cfg["ready"]).exists() and p.poll() is None and time.monotonic() < end:
                    time.sleep(0.02)
                self.assertTrue(Path(cfg["ready"]).exists(), (fx.dir / "child.stderr").read_text())
                self.assertEqual(json.loads(Path(cfg["ready"]).read_text())["decision"], gg.CONTINUE)
                with open(fx.lock, "r+b") as fh:
                    fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)            # lane-owned dummy lock, real /proc/locks
                    t_inj = time.monotonic()
                    rc = p.wait(timeout=cfg["hard_exit_s"] + cfg["interval"] + 20)
                    t_exit = time.monotonic()
            finally:
                if p.poll() is None:
                    p.kill()
                    p.wait()
        self.assertEqual(rc, 75, (fx.dir / "child.stderr").read_text())
        self.assertIn("hard exit 75", (fx.dir / "child.stderr").read_text())
        t_yield = float(Path(cfg["yield_seen"]).read_text())
        self.assertLessEqual(t_yield - t_inj, cfg["interval"] + SLACK_S)
        self.assertGreaterEqual(t_exit - t_inj, cfg["hard_exit_s"] - 0.05)
        self.assertLessEqual(t_exit - t_inj, cfg["hard_exit_s"] + cfg["interval"] + SLACK_S + 1.0)


CHILD = r'''
import json, os, sys, threading, time
from pathlib import Path
from dltrain import gpu_gate as gg

cfg = json.loads(Path(sys.argv[1]).read_text())
PID = os.getpid()


def run_cmd(argv):
    if argv[0] == "systemctl":
        assert argv[3] == cfg["glob"]
        return ""
    if argv[1].startswith("--query-gpu="):
        return "0, 24576, 12500, 12076, 97, 60\n"
    return f"{PID}, {sys.executable}, 12000\n"                    # the trainer's own reserve: excluded


src = gg.GateSources(queue_status=Path(cfg["q"]), cpu_admission=Path(cfg["c"]), lock_path=Path(cfg["lock"]),
                     proc_locks=Path("/proc/locks"), unit_glob=cfg["glob"], host="xbabe2", disk_path=Path(cfg["dir"]),
                     disk_floor_bytes=1, run_cmd=run_cmd)
reserve = bytearray(8 << 20)        # stand-in for the GPU memory reserve; CUDA is never initialised here
wd = gg.Watchdog(PID, src, interval_s=cfg["interval"], hard_exit_s=cfg["hard_exit_s"])
wd.start()
while wd.latest is None:
    time.sleep(0.01)
Path(cfg["ready"]).write_text(json.dumps({"decision": wd.latest.decision, "reasons": list(wd.latest.reasons)}))


def on_yield():
    wd.yield_requested.wait()
    Path(cfg["yield_seen"]).write_text(repr(time.monotonic()))


threading.Thread(target=on_yield, daemon=True).start()
threading.Event().wait(60)          # checkpoint pause that never returns: the reserve is released only by exiting
del reserve
sys.exit(0)                         # reached only if the watchdog failed
'''


