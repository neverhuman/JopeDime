_RUN_DIR: list[Path] = []


def tmp_root() -> Path:
    """One directory per test run under $TMPDIR, holding every fixture of that run (left in place)."""
    if not _RUN_DIR:
        t = os.environ.get("TMPDIR")
        if not t:
            raise RuntimeError("TMPDIR must be set; these tests never use /tmp")
        p = Path(t).resolve()
        if p == Path("/tmp") or Path("/tmp") in p.parents:
            raise RuntimeError(f"TMPDIR {p} is under /tmp; refused")
        p.mkdir(parents=True, exist_ok=True)
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        _RUN_DIR.append(Path(tempfile.mkdtemp(prefix=f"p8gate-run-{stamp}-", dir=p)))
    return _RUN_DIR[0]


def codes(v) -> list[str]:
    reasons = v.reasons if isinstance(v, gg.Verdict) else v
    return [r.split(":", 1)[0] for r in reasons]


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


class Fx:
    """One fixture directory with every gate source as a snapshot, plus a fake run_cmd."""

    def __init__(self, name: str, now_ns: int = NOW):
        self.dir = Path(tempfile.mkdtemp(prefix=f"p8gate-{name}-", dir=tmp_root()))
        self.now_ns = now_ns
        self.q, self.c = self.dir / "queue-status.json", self.dir / "cpu-admission.json"
        self.lock, self.proc_locks = self.dir / "lane-dummy-tabpfn-gpu.lock", self.dir / "proc-locks.txt"
        self.lock.write_bytes(b"")
        self.units: list[tuple[str, str]] = [("jopedime-dltrain-p8test-gpu-old.service", "failed"),
                                             ("jopedime-dltrain-p8test-gpu-done.service", "inactive"),
                                             ("jopedime-incoming-gpu-not-lane.service", "active")]   # outside the glob
        self.gpu_lines = [CLEAN_GPU]
        self.apps_lines: list[str] = []
        self.fail: set[str] = set()
        self.calls: list[list[str]] = []
        self.outputs: dict[str, str] = {}
        self.write_q()
        self.write_c()
        self.write_locks()

    # ---- snapshots
    def queue_doc(self, age_s=5.0, poll_age_s=600.0, states=None, items=None):
        if states is None:
            states = {"complete": 582, "frozen": 570, "gp_recovery_required": 100, "rejected": 3, "retired": 73}
        if items is None:
            items = [{"canonical": "c" * 64, "dataset": "d" * 16, "id": f"{i:064x}", "reason": '{"exit_code": 0}',
                      "sample": "s" * 64, "state": s} for i, s in enumerate(["complete", "retired", "rejected",
                                                                              "gp_recovery_required", "frozen"])]
        return {"schema": gg.QUEUE_SCHEMA, "utc_ns_text": str(self.now_ns - int(age_s * S)),
                "registry": {"states": states, "items": items,
                             "poll": {"utc_ns": str(self.now_ns - int(poll_age_s * S)), "seq": 320, "status": "complete",
                                      "payload": '{"errors":[]}'}},
                "gp_active": [], "gpu_nodes": ["xbabe1", "xbabe2", "xbabe3"], "local_capacity": 640,
                "aws_lambda_calls": 0, "original_separate": True}

    def _put(self, path: Path, data: bytes):
        tmp = path.with_name(path.name + ".part")
        tmp.write_bytes(data)
        os.replace(tmp, path)

    def write_q(self, doc=None, raw: bytes | None = None, **kw):
        self._put(self.q, raw if raw is not None else json.dumps(doc if doc is not None else self.queue_doc(**kw)).encode())

    def cpu_doc(self, age_s=5.0, admit=True, rolling=29.2):
        return {"admit": admit, "sampled_unix_seconds": self.now_ns / 1e9 - age_s,
                "nodes": {HOST: {"cpu_busy_percent": 27.8, "cpu_rolling_percent": rolling, "disk_free_bytes": 5 * 10**11},
                          "xbabe1": {"cpu_rolling_percent": 99.0}}}

    def write_c(self, doc=None, raw: bytes | None = None, **kw):
        self._put(self.c, raw if raw is not None else json.dumps(doc if doc is not None else self.cpu_doc(**kw)).encode())

    def at(self, t_ns: int, rolling=29.2, admit=True, c_age_s=5.0, **qkw):
        """Advance the injected clock and rewrite fresh Q and C snapshots for it."""
        self.now_ns = t_ns
        self.write_q(**qkw)
        self.write_c(rolling=rolling, admit=admit, age_s=c_age_s)
        return t_ns

    def lock_id(self) -> str:
        st = os.stat(self.lock)
        return f"{os.major(st.st_dev):02x}:{os.minor(st.st_dev):02x}:{st.st_ino}"

    def write_locks(self, held=False, waiter=False, extra: list[str] | None = None):
        dev, ino = self.lock_id().rsplit(":", 1)
        lines = ["1: FLOCK  ADVISORY  WRITE 3196799 103:07:191829370 0 EOF",
                 "2: POSIX  ADVISORY  READ 3758465 103:07:84411533 128 128",
                 "3: OFDLCK ADVISORY  READ  -1 00:d7:11461 0 EOF",
                 f"4: FLOCK  ADVISORY  WRITE 999 {dev}:{int(ino) + 1} 0 EOF"]          # same device, neighbouring inode
        if held:
            lines.append(f"5: FLOCK  ADVISORY  WRITE 4242 {self.lock_id()} 0 EOF")
        if waiter:
            lines.append(f"5: -> FLOCK  ADVISORY  WRITE 4243 {self.lock_id()} 0 EOF")
        lines += extra or []
        self._put(self.proc_locks, ("\n".join(lines) + "\n").encode())

    # ---- fake commands
    def run_cmd(self, argv):
        self.calls.append(list(argv))
        if argv[0] == "systemctl":
            if argv[:3] != ["systemctl", "--user", "list-units"] or not argv[3].startswith("jopedime-dltrain-p8test-"):
                raise AssertionError(f"fixture refuses a non-lane unit query: {argv}")
            if "systemctl" in self.fail:
                raise gg.CommandFailed("systemctl exited 1")
            states = next(a for a in argv if a.startswith("--state=")).split("=", 1)[1].split(",")
            out = "".join(f"{n} loaded {s} running P8 lane test unit\n" for n, s in self.units
                          if fnmatch.fnmatchcase(n, argv[3]) and s in states)
        elif argv[0] == "nvidia-smi" and argv[1].startswith("--query-gpu="):
            if "gpu" in self.fail:
                raise gg.CommandFailed("nvidia-smi exited 9")
            out = "".join(line + "\n" for line in self.gpu_lines)
        elif argv[0] == "nvidia-smi" and argv[1].startswith("--query-compute-apps="):
            if "apps" in self.fail:
                raise gg.CommandFailed("nvidia-smi exited 9")
            out = "".join(line + "\n" for line in self.apps_lines)
        else:
            raise AssertionError(f"unexpected command {argv}")
        self.outputs[argv[1] if argv[0] == "nvidia-smi" else "systemctl"] = out
        return out

    def sources(self, **kw) -> gg.GateSources:
        base = dict(queue_status=self.q, cpu_admission=self.c, lock_path=self.lock, proc_locks=self.proc_locks,
                    unit_glob=UNIT_GLOB, host=HOST, disk_path=self.dir, disk_floor_bytes=1, run_cmd=self.run_cmd)
        base.update(kw)
        return gg.GateSources(**base)

    def admit(self, src=None, **kw) -> gg.Verdict:
        return gg.admission_probe(src or self.sources(), now_ns=self.now_ns, **kw)

    def cont(self, state, self_pid=4242, src=None, **kw) -> gg.Verdict:
        return gg.continuation_probe(self_pid, src or self.sources(), state=state, now_ns=self.now_ns, **kw)


class Constants(unittest.TestCase):
    def test_exact_sources_and_thresholds(self):
        d = gg.DEFAULT_SOURCES
        self.assertEqual((d.queue_status, d.cpu_admission, d.lock_path, d.proc_locks), (REAL_Q, REAL_C, REAL_LOCK, Path("/proc/locks")))
        self.assertEqual((d.unit_glob, d.host, d.disk_path, d.disk_floor_bytes, d.run_cmd),
                         ("jopedime-incoming-gpu-*", None, Path("/"), 300_000_000_000, None))
        self.assertEqual(gg.BLOCKING_STATES, {"queued", "discovered", "validated", "benchmarking", "benchmark_recovery_required"})
        self.assertEqual(gg.KNOWN_STATES, {"benchmarked", "benchmarking", "complete", "evolving", "frozen", "gp_recovery_required",
                                           "queued", "rejected", "retired", "benchmark_recovery_required", "discovered", "validated"})
        self.assertEqual(set(gg.DECISIONS), {"ADMIT", "REFUSE", "CONTINUE", "PAUSE", "YIELD", "STOP", "ABORT_GATE"})
        argv = gg.unit_argv("x-*")
        self.assertEqual(argv[:4], ["systemctl", "--user", "list-units", "x-*"])
        self.assertIn("active", next(a for a in argv if a.startswith("--state=")).split("=", 1)[1].split(","))
        self.assertIn("--no-legend", argv)
        self.assertIn("--plain", argv)
        self.assertEqual(gg.GPU_QUERY[1], "--query-gpu=index,memory.total,memory.used,memory.free,utilization.gpu,temperature.gpu")
        self.assertEqual(gg.APPS_QUERY[1], "--query-compute-apps=pid,process_name,used_memory")

    def test_module_is_stdlib_only_and_never_touches_locks_or_other_processes(self):
        tree = ast.parse(Path(gg.__file__).read_text())
        for node in ast.walk(tree):                                    # code only: drop every docstring
            body = getattr(node, "body", None)
            if (isinstance(body, list) and body and isinstance(body[0], ast.Expr)
                    and isinstance(body[0].value, ast.Constant) and isinstance(body[0].value.value, str)):
                node.body = body[1:] or [ast.Pass()]
        code = ast.unparse(tree)
        imported = {a.name.split(".")[0] for n in ast.walk(tree) if isinstance(n, (ast.Import, ast.ImportFrom))
                    for a in (n.names if isinstance(n, ast.Import) else [ast.alias(n.module or "")])}
        self.assertLessEqual(imported, {"argparse", "hashlib", "json", "math", "os", "re", "socket", "subprocess", "sys",
                                        "threading", "time", "dataclasses", "pathlib", "typing"})
        for banned in ("torch", "cuda", "CUDA", "fcntl", "flock", "lockf", "cmdline", "environ'", "/proc/self", "pgrep",
                       "'ps'", "kill("):
            self.assertFalse(banned in code, f"gpu_gate code contains {banned!r}")
        self.assertEqual(code.count("/proc/"), code.count("/proc/locks"))
        root = Path(gg.__file__).resolve().parents[1]
        r = subprocess.run([sys.executable, "-c", "import sys, json, dltrain.gpu_gate; print(json.dumps(sorted("
                            "m for m in sys.modules if m.split('.')[0] in ('torch', 'numpy', 'pynvml'))))"],
                           env=child_env(root), capture_output=True, text=True, timeout=60, cwd=root)
        self.assertEqual(r.returncode, 0, r.stderr)
        self.assertEqual(json.loads(r.stdout), [])

    def test_default_run_cmd(self):
        self.assertEqual(gg._default_run_cmd([sys.executable, "-c", "print('ok')"]), "ok\n")
        with self.assertRaises(gg.CommandFailed):
            gg._default_run_cmd([sys.executable, "-c", "raise SystemExit(4)"])


class Admission(unittest.TestCase):
    def setUp(self):
        self.fx = Fx(self._testMethodName[5:30])

    def assertRefused(self, v, code):
        self.assertEqual(v.decision, gg.REFUSE, v.reasons)
        self.assertIn(code, codes(v), v.reasons)

    def assertAdmitted(self, v):
        self.assertEqual((v.decision, v.reasons), (gg.ADMIT, ()), v.reasons)

    def test_admit_path_and_observations(self):
        fx = self.fx
        v = fx.admit()
        self.assertAdmitted(v)
        self.assertTrue(v.ok)
        self.assertEqual((v.mode, v.utc_us), ("admit", NOW // 1000))
        o = v.observations
        self.assertEqual(o["sources"]["queue_status"]["sha256"], sha(fx.q.read_bytes()))
        self.assertEqual(o["sources"]["cpu_admission"]["sha256"], sha(fx.c.read_bytes()))
        self.assertEqual(o["sources"]["proc_locks"]["sha256"], sha(fx.proc_locks.read_bytes()))
        self.assertEqual(o["sources"]["tabpfn_lock"]["id"], fx.lock_id())
        self.assertFalse(o["sources"]["tabpfn_lock"]["held"])
        self.assertEqual(o["commands"]["units"]["stdout_sha256"], sha(fx.outputs["systemctl"].encode()))
        self.assertEqual(o["commands"]["gpu"]["stdout_sha256"], sha(fx.outputs[gg.GPU_QUERY[1]].encode()))
        self.assertEqual(o["commands"]["compute_apps"]["stdout_sha256"], sha(fx.outputs[gg.APPS_QUERY[1]].encode()))
        self.assertEqual(o["intake_signals"], [])
        self.assertEqual(o["gate_sha256"], sha(Path(gg.__file__).read_bytes()))
        self.assertEqual(o["sources"]["cpu_admission"]["cpu_rolling_percent"], 29.2)
        self.assertEqual([c[3] for c in fx.calls if c[0] == "systemctl"], [UNIT_GLOB])
        doc = json.loads(v.to_json())
        self.assertEqual((doc["schema"], doc["decision"], doc["reasons"]), (gg.VERDICT_SCHEMA, "ADMIT", []))

    def test_fixture_never_names_real_lock_or_incoming_units(self):
        s = self.fx.sources()
        self.assertNotEqual(s.lock_path.resolve(), REAL_LOCK)
        self.assertFalse(s.unit_glob.startswith("jopedime-incoming"))
        self.assertTrue(str(s.lock_path).startswith(str(tmp_root())))

    # ---- lock
    def test_refuse_lock_held_fixture_snapshot(self):
        self.fx.write_locks(held=True)
        v = self.fx.admit()
        self.assertRefused(v, "tabpfn_lock_held")
        self.assertTrue(v.observations["sources"]["tabpfn_lock"]["held"])
        self.assertEqual(v.observations["intake_signals"], ["tabpfn_lock_held:1"])

    def test_refuse_lock_waiter_line(self):
        self.fx.write_locks(waiter=True)
        self.assertRefused(self.fx.admit(), "tabpfn_lock_held")

    def test_refuse_lock_held_real_proc_locks(self):
        fx = self.fx
        src = fx.sources(proc_locks=Path("/proc/locks"))
        self.assertAdmitted(fx.admit(src))
        for how in ("flock", "lockf"):
            with self.subTest(how=how), open(fx.lock, "r+b") as fh:
                if how == "flock":
                    fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                else:
                    fcntl.lockf(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                self.assertRefused(fx.admit(src), "tabpfn_lock_held")
            self.assertAdmitted(fx.admit(src))

    def test_lock_is_only_stat_ed_never_opened(self):
        fx = self.fx
        fx.write_locks(held=True)
        os.chmod(fx.lock, 0)
        try:
            v = fx.admit()
        finally:
            os.chmod(fx.lock, 0o664)
        self.assertRefused(v, "tabpfn_lock_held")
        self.assertNotIn("lock_path_unreadable", codes(v))

    def test_refuse_lock_path_or_proc_locks_unreadable(self):
        self.assertRefused(self.fx.admit(self.fx.sources(lock_path=self.fx.dir / "absent.lock")), "lock_path_unreadable")
        self.assertRefused(self.fx.admit(self.fx.sources(proc_locks=self.fx.dir / "absent-locks")), "proc_locks_unreadable")
        self.fx.write_locks(extra=["6: GARBLED LINE WITHOUT AN INODE"])
