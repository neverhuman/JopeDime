                                       "max_seq": SPEC.max_seq, **kw})


def train_cfg(**kw):
    return fixtures_p7.train_config(**{"commit_every_updates": EVERY, "warmup": 4, **kw})


_TRANCHES: dict = {}


def tranche(n: int):
    """(TrainData, entries) of the first n synthetic contexts (cached per process)."""
    if n not in _TRANCHES:
        _TRANCHES[n] = synthetic_data.tranche(SPEC, sampler_cfg(), n)
    return _TRANCHES[n]


def msha(entries) -> str:
    return train.corpus_manifest_sha256(entries)


def make_plan0(data0, e0, **kw) -> dict:
    args = {"run_id": RUN_ID, "run_seed": RUN_SEED, "arm": "p8-seg", "objective": "successor-v1",
            "model": model_cfg(), "sampler": sampler_cfg(), "train": train_cfg(), "max_updates": N,
            "deadline_utc_us": None, "storage_cap_bytes": 1 << 30, "refs": dict(data0.refs),
            "corpus_manifest_sha256": msha(e0), **kw}
    return train.make_run_plan(**args)


def make_seg(parent_plan, data, entries, *, start_step: int, parent_manifest: str) -> dict:
    return train.make_segment_plan(parent_plan, refs=dict(data.refs), corpus_manifest_sha256=msha(entries),
                                   start_step=start_step, parent_checkpoint_manifest_sha256=parent_manifest)


def restamp(data, corpus_ref: str):
    """``data`` with refs.corpus and refs.encoding replaced (content unchanged)."""
    return dataclasses.replace(data, refs=dict(data.refs, corpus=corpus_ref, encoding=corpus_ref))


def with_refs(data, entries):
    """``data`` stamped as tranche ``entries`` (corpus and encoding refs name that manifest)."""
    return restamp(data, train.CORPUS_REF_PREFIX + msha(entries))


def stopper(stop: Path, at: int) -> train.TrainHooks:
    def after_step(step: int) -> None:
        if step == at:
            stop.touch()
    return train.TrainHooks(after_step=after_step)


def closure_digest(commit_dir) -> dict:
    """sha256 of every closure file of a strictly verified commit, plus parameter_sha256 and step."""
    commit, _closure = ckpt.open_commit(Path(commit_dir))
    out = {kind: ref["sha256"] for kind, ref in commit.doc["files"].items()}
    out.update(parameter_sha256=commit.doc["parameter_sha256"], step=commit.step)
    return out


def events(workdir) -> list[dict]:
    return [json.loads(x) for x in (Path(workdir) / "events.jsonl").read_bytes().splitlines()]


def resumed_event(workdir) -> dict:
    return next(e for e in events(workdir) if e["event"] == "resumed")


def journal(path) -> list[dict]:
    return [json.loads(x) for x in Path(path).read_bytes().splitlines()]


def pointer_targets(store: ckpt.FileVersionedStore, prefix: str = PREFIX) -> list[tuple[int, str]]:
    """(manifest step, manifest sha256) of every version of the run's resume pointer, oldest first."""
    key = ckpt.pointer_key(prefix, RUN_ID)
    out = []
    for v in store.list_versions(key):
        doc = json.loads(store.get(key, version_id=v["version_id"]).body)
        man = json.loads(store.get(ckpt.manifest_key(prefix, RUN_ID, doc["target_manifest_sha256"]),
                                   version_id=doc["target_version_id"]).body)
        out.append((man["step"], doc["target_manifest_sha256"]))
    return out


def pointer_versions(store: ckpt.FileVersionedStore) -> list:
    return store.list_versions(ckpt.pointer_key(PREFIX, RUN_ID))


def copy_store(src: Path, name: str) -> tuple[Path, ckpt.FileVersionedStore]:
    dst = new_dir(name) / "store"
    shutil.copytree(src, dst)
    return dst, ckpt.FileVersionedStore(dst)


def strip_step_fields(rec: dict) -> dict:
    return {k: v for k, v in rec.items() if k not in ("lr", "loss", "grad_norm")}


# ------------------------------------------------------------------------------------------- the shared chain
class World:
    """Built once per process:
    - seg 0 (plan0, T0) yields at N0 into store S0, and S0 is kept pristine;
    - seg 1 (plan1, T1) runs from a copy to N (chain A);
    - the uninterrupted plan0 run U on T0 goes to N."""

    def __init__(self):
        t0 = time.monotonic()
        self.data0, self.e0 = tranche(N_T0)
        self.data1, self.e1 = tranche(N_T1)
        self.data2, self.e2 = tranche(N_T2)
        self.plan0 = make_plan0(self.data0, self.e0)
        base = self.base = new_dir("world")
        self.s0_root = base / "store-seg0"
        store = ckpt.FileVersionedStore(self.s0_root)
        stop = base / "STOP-seg0"
        self.seg0_wd = base / "seg0"
        self.S0 = train.run(self.plan0, self.data0, self.seg0_wd, store=store, store_prefix=PREFIX, stop_file=stop,
                            hooks=stopper(stop, N0))
        self.pm0 = self.S0.published["pointer"]["manifest_sha256"] if self.S0.published else None
        self.targets0 = pointer_targets(store)
        self.plan1 = make_seg(self.plan0, self.data1, self.e1, start_step=N0, parent_manifest=self.pm0)
        self.tr01 = train.Transition(parent_plan=self.plan0, parent_manifest=list(self.e0), manifest=list(self.e1))
        _root, chain_store = copy_store(self.s0_root, "chainA")
        self.A_wd = new_dir("chainA-run") / "work"
        self.A = train.resume_from_store(self.plan1, self.data1, chain_store, self.A_wd, store_prefix=PREFIX,
                                         transition=self.tr01)
        self.A_digest = closure_digest(self.A.last_commit)
        self.U = train.run(self.plan0, self.data0, base / "U")
        self.U_digest = closure_digest(self.U.last_commit)
        sys.stderr.write(f"\n[p8 segment] world built in {time.monotonic() - t0:.1f} s: seg0 {self.S0.status}@"
                         f"{self.S0.step} chainA {self.A.status}@{self.A.step} parameter_sha256 "
                         f"{self.A.parameter_sha256} journal_sha256 {self.A.journal_sha256}\n")


def world() -> World:
    if "world" not in _MODULE:
        _MODULE["world"] = World()
    return _MODULE["world"]


# ------------------------------------------------------------------------------------------- fresh-process child
def child_main(args: dict) -> dict:
    """One segment in a fresh process over the guarded fake store (s3store.open_fake, persisted under disk_root)."""
    from dltrain import s3store
    model.configure_determinism(4)
    d = Path(args["dir"])
    data0, e0 = tranche(N_T0)
    prefix = s3store.SMOKE_PREFIX_KEY
    store, ledger, _bucket = s3store.open_fake(prefix_key=prefix, view_id=RUN_ID,
                                               ledger_path=d / f"publish-ledger-{args['mode']}.jsonl",
                                               budget_ledger_path=d / "budget-ledger.jsonl", disk_root=d / "bucket")
    try:
        if args["mode"] == "seg0":
            plan0 = make_plan0(data0, e0)
            train.write_run_plan(d / "plan0.json", plan0)
            stop = d / "STOP-seg0"
            res = train.run(plan0, data0, d / "seg0", store=store, store_prefix=prefix, stop_file=stop,
                            hooks=stopper(stop, N0))
            return {"result": res.to_json(), "pm0": res.published["pointer"]["manifest_sha256"],
                    "digest": closure_digest(res.last_commit), "plan0_sha256": train.plan_sha256(plan0),
                    "e0_sha256": msha(e0)}
        plan0 = train.load_run_plan(d / "plan0.json")
        data1, e1 = tranche(N_T1)
        plan1 = make_seg(plan0, data1, e1, start_step=N0, parent_manifest=args["pm0"])
        train.write_run_plan(d / "plan1.json", plan1)
        res = train.resume_from_store(plan1, data1, store, d / "seg1", store_prefix=prefix,
                                      transition=train.Transition(parent_plan=plan0, parent_manifest=list(e0),
                                                                  manifest=list(e1)))
        ev = resumed_event(d / "seg1")
        return {"result": res.to_json(), "digest": closure_digest(res.last_commit),
                "plan1_sha256": train.plan_sha256(plan1), "e1_sha256": msha(e1),
                "resumed": {k: ev.get(k) for k in ("event", "rule", "step", "sampler_cursor")}}
    finally:
        ledger.close()


def run_child(args: dict) -> dict:
    env = dict(os.environ, PYTHONPATH=str(SRC), CUDA_VISIBLE_DEVICES="")
    proc = subprocess.run([sys.executable, "-c", CHILD, json.dumps(args)], cwd=str(SRC), env=env,
                          capture_output=True, text=True, timeout=CHILD_TIMEOUT_S)
    if proc.returncode != 0:
        raise AssertionError(f"child {args['mode']} failed:\n{proc.stderr[-6000:]}")
    lines = [x for x in proc.stdout.splitlines() if x.startswith("P8SEG_CHILD ")]
    if len(lines) != 1:
        raise AssertionError(f"child {args['mode']} printed no result:\n{proc.stdout[-2000:]}")
    return json.loads(lines[0].split(" ", 1)[1])


# ======================================================================================== T0: loader-side guards
def write_denylist(d: Path, assignment_by_view: dict, denied: tuple = ()) -> tuple[Path, str]:
    doc = {"contexts": [{"view_id": v, "assignment": assignment_by_view[v]} for v in denied], "object_keys": [],
           "assignment_by_view": assignment_by_view}
    path = d / "denylist.json"
    body = common.canonical(doc)
    path.write_bytes(body)
    return path, common.sha256_bytes(body)


class T0LabelSourceAndAdmissionTest(unittest.TestCase):
    """(c) the owner path-deny rule, admission of tranche contexts, and (d) inner-CV-only labels."""

    @classmethod
    def setUpClass(cls):
        from dltrain import tranche as tranche_mod
        cls.tr = tranche_mod
        cls.dir = new_dir("labels")

    # ---------------------------------------------------------------- path-deny rule
    def test_outer_test_label_path_is_refused(self):
        tr = self.tr
        self.assertIn("s1-prod/outer-test", tr.DENIED_LABEL_PATH_PARTS)
        fake = self.dir / "tree" / "s1-prod"
        (fake / "outer-test" / "ctx").mkdir(parents=True)
        (fake / "contexts" / "ctx").mkdir(parents=True)
        target = fake / "outer-test" / "ctx" / "eval.json"
        target.write_bytes(b"{}")
        inner = fake / "contexts" / "ctx" / "final.json"
        inner.write_bytes(b"{}")
        (self.dir / "innocent.json").symlink_to(target)
        (self.dir / "labels-dir").symlink_to(fake / "outer-test", target_is_directory=True)
        refused = {"real": REAL_S1 / "outer-test" / "ctx" / "eval.json",
                   "real-str": str(REAL_S1 / "outer-test" / "x.json"),
                   "dotdot": REAL_S1 / "contexts" / ".." / "outer-test" / "y.json",
                   "fake-tree": target, "file-symlink": self.dir / "innocent.json",
                   "dir-symlink": self.dir / "labels-dir" / "ctx" / "eval.json",
                   "dotdot-fake": fake / "contexts" / ".." / "outer-test" / "ctx" / "eval.json"}
        for name, p in refused.items():
            with self.subTest(refused=name), self.assertRaises(tr.LabelSourceRefused):
                tr.assert_label_path(p)
        for name, p in {"real-contexts": REAL_S1 / "contexts" / "ctx" / "final.json", "fake-inner": inner,
                        "fake-inner-str": str(inner)}.items():
            with self.subTest(allowed=name):
                tr.assert_label_path(p)

    # ---------------------------------------------------------------- admission of tranche contexts
    def admission(self, purpose: str = "selection"):
        views = {"v-train": "train_fit", "v-nonpool": "train_nonpool", "v-dev": "dev", "v-held": "heldout",
                 "v-sealed": "sealed_excluded", "v-denied": "train_fit"}
        path, sha = write_denylist(new_dir("admission"), views, denied=("v-denied",))
        return admission_mod.Admission(path, sha, purpose=purpose)

    @staticmethod
    def row(view: str, assignment: str, split_role: str) -> dict:
        return {"context_sha256": common.sha256_bytes(view.encode()), "view_id": view, "assignment": assignment,
                "split_role": split_role, "family_id": "fam-" + view}

    def test_heldout_sealed_and_denylisted_contexts_refuse_the_tranche(self):
        adm = self.admission()
        good = [self.row("v-train", "train_fit", "train_fit"), self.row("v-nonpool", "train_nonpool", "train_fit")]
        self.assertEqual(self.tr.admit_contexts(good, adm), good)
        for view, a in (("v-held", "heldout"), ("v-sealed", "sealed_excluded"), ("v-denied", "train_fit"),
                        ("v-other", "prohibited_excluded")):
            for role in ("train_fit", "dev", a):
                with self.subTest(view=view, split_role=role), self.assertRaises(admission_mod.AdmissionRefused):
                    self.tr.admit_contexts(good + [self.row(view, a, role)], adm)

    def test_dev_context_never_enters_training(self):
        adm = self.admission()
        for role in ("train_fit", "diag"):
            with self.subTest(split_role=role), self.assertRaises(admission_mod.AdmissionRefused):
                self.tr.admit_contexts([self.row("v-dev", "dev", role)], adm)
        ok = self.tr.admit_contexts([self.row("v-train", "train_fit", "train_fit"), self.row("v-dev", "dev", "dev")],
                                    adm)
        self.assertEqual([(r["view_id"], r["split_role"]) for r in ok], [("v-train", "train_fit"), ("v-dev", "dev")])
        with self.assertRaises(admission_mod.AdmissionRefused):        # a train-purpose Admission refuses dev too
            self.tr.admit_contexts([self.row("v-dev", "dev", "dev")], self.admission(purpose="train"))

    def test_train_context_with_a_non_training_split_role_is_refused(self):
        adm = self.admission()
        for role in ("dev", "heldout", "sealed_excluded", "outer_test"):
            with self.subTest(split_role=role), self.assertRaises(admission_mod.AdmissionRefused):
                self.tr.admit_contexts([self.row("v-train", "train_fit", role)], adm)
        ok = self.tr.admit_contexts([self.row("v-train", "train_fit", "diag")], adm)
        self.assertEqual([r["split_role"] for r in ok], ["diag"])

    def test_fail_closed_admission_refuses_everything(self):
        path, _sha = write_denylist(new_dir("admission-bad"), {"v-train": "train_fit"})
        adm = admission_mod.Admission(path, "0" * 64, purpose="selection")
        with self.assertRaises(admission_mod.AdmissionRefused):
            self.tr.admit_contexts([self.row("v-train", "train_fit", "train_fit")], adm)
        row = self.row("v-train", "train_fit", "train_fit")
        del row["assignment"]
        with self.assertRaises(admission_mod.AdmissionRefused):
            self.tr.admit_contexts([row], self.admission())

    # ---------------------------------------------------------------- (d) labels: inner-CV selection records only
    @staticmethod
    def inner_cv_record() -> dict:
        def fold(i):
            return {"kind": "inner_cv", "index": i, "metrics": {"rmse": 0.8 + 0.1 * i},
                    "baseline_metrics": {"rmse": 1.0 + 0.1 * i}, "wall_us": 120000 + i, "score_rows": 12,
                    "train_rows": 12, "predictions_sha256": "12" * 32}
        return {"schema": "jope.s1-evaluation/v1", "status": "completed", "fold_protocol": "jope.s1-two-fold/v1",
                "program": {"dsl": "(pipe X (ridge))", "program_sha256": "cd" * 32}, "context_sha256": "ef" * 32,
                "inner_cv_folds": 2, "inner_cv": [fold(0), fold(1)]}

    def test_inner_cv_selection_record_is_accepted(self):
        rec = self.inner_cv_record()
        self.tr.assert_inner_cv_record(rec)
        failed = dict(rec, status="failed", inner_cv=[])
        self.tr.assert_inner_cv_record(failed)

    def test_outer_test_material_in_label_records_is_refused(self):
        def outer_fold(r):
            r["inner_cv"].append({"kind": "outer_test", "index": 2, "metrics": {"rmse": 0.5}})

        def test_metrics(r):
            r["test_metrics"] = {"rmse": 0.5}

        def holdout_metrics(r):
            r["inner_cv"][0]["holdout"] = {"rmse": 0.5}

        def official(r):
            r["official_score"] = 0.5

        def fold_kind(r):
            r["inner_cv"][1]["kind"] = "outer"

        def schema(r):
            r["schema"] = "jope.s1-outer-test/v1"

        def outer_key(r):
            r["program"]["outer_test"] = {"rmse": 0.4}

        def completed_without_folds(r):
            del r["inner_cv"]

        def one_fold(r):
            r["inner_cv"] = r["inner_cv"][:1]

        def duplicate_index(r):
            r["inner_cv"][1]["index"] = 0

        def three_folds(r):
            r["inner_cv_folds"] = 3

        def protocol(r):
            r["fold_protocol"] = "jope.s1-outer-holdout/v1"

        def no_metrics(r):
            del r["inner_cv"][0]["metrics"]

        cases = [outer_fold, test_metrics, holdout_metrics, official, fold_kind, schema, outer_key,
                 completed_without_folds, one_fold, duplicate_index, three_folds, protocol, no_metrics]
        for mutate in cases:
            rec = self.inner_cv_record()
            mutate(rec)
            with self.subTest(mutate.__name__), self.assertRaises(self.tr.LabelSourceRefused):
                self.tr.assert_inner_cv_record(rec)


# ======================================================================================== T1: refusals
class T1RefusalTest(unittest.TestCase):
    """(c) transition refusals happen before anything is written: the workdir is never created and the store pointer
    is unchanged. Refusals inside the trainer (identities) leave no journal, events or commits."""

    @classmethod
    def setUpClass(cls):
        cls.w = world()

    def refused(self, plan, data, transition, *, regex: str, exc=None, store_root: Path | None = None,
                pristine: bool = True):
        exc = exc or train.TransitionRefused
        _root, store = copy_store(store_root or self.w.s0_root, "refusal")
        before = pointer_versions(store)
        wd = new_dir("refusal-run") / "work"
        with self.assertRaisesRegex(exc, regex):
            train.resume_from_store(plan, data, store, wd, store_prefix=PREFIX, transition=transition)
        self.assertEqual(pointer_versions(store), before, "a refusal moved the pointer")
        if pristine and wd.exists():
            self.assertEqual(sorted(os.listdir(wd)), [], "a transition refusal wrote into the workdir")
        for name in ("journal.jsonl", "events.jsonl", "commits"):
            self.assertFalse((wd / name).exists(), f"a refusal wrote {name}")

    def seg_case(self, entries, *, start_step=N0, parent_manifest=None, parent_plan=None, parent_entries=None):
        """A segment-1 plan and Transition over a (possibly altered) tranche manifest, data stamped to match."""
        w = self.w
        data = with_refs(w.data1, entries)
        plan = make_seg(w.plan0, data, entries, start_step=start_step, parent_manifest=parent_manifest or w.pm0)
        tr = train.Transition(parent_plan=parent_plan or w.plan0, parent_manifest=list(parent_entries or w.e0),
                              manifest=list(entries))
        return plan, data, tr

