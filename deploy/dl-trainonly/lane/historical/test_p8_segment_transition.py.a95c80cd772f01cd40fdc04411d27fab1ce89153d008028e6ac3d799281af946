# ======================================================================================== T2: state carries over
class T2CarriedStateTest(unittest.TestCase):
    """(a) the T0 -> T1 chain in process: plans, identities, journal, schedule, draws, optimizer, RNG."""

    @classmethod
    def setUpClass(cls):
        cls.w = world()

    def test_segment_plans_and_chain_shape(self):
        w = self.w
        self.assertEqual((w.S0.status, w.S0.reason, w.S0.step), ("YIELDED_TO_INTAKE", "stop_file", N0))
        self.assertEqual(w.targets0[-1], (N0, w.pm0))
        self.assertEqual(w.plan0["segment"], {"index": 0, "start_step": 0, "corpus_manifest_sha256": msha(w.e0),
                                              "parent_plan_sha256": None, "parent_checkpoint_manifest_sha256": None})
        self.assertEqual(w.plan1["segment"], {"index": 1, "start_step": N0, "corpus_manifest_sha256": msha(w.e1),
                                              "parent_plan_sha256": train.plan_sha256(w.plan0),
                                              "parent_checkpoint_manifest_sha256": w.pm0})
        self.assertEqual(w.plan1["refs"]["corpus"], "corpus-manifest:" + msha(w.e1))
        self.assertEqual(w.plan1["refs"]["encoding"], w.data1.refs["encoding"])
        same = {k: v for k, v in w.plan0.items() if k not in ("refs", "segment")}
        self.assertEqual({k: v for k, v in w.plan1.items() if k not in ("refs", "segment")}, same,
                         "a segment plan must copy every parent key except refs.corpus/encoding and segment")
        self.assertEqual({k: v for k, v in w.plan1["refs"].items() if k not in ("corpus", "encoding")},
                         {k: v for k, v in w.plan0["refs"].items() if k not in ("corpus", "encoding")})
        self.assertEqual(w.e1[:len(w.e0)], w.e0, "fixture: T0 must be an exact prefix of T1")
        self.assertGreater(len(w.e1), len(w.e0))
        self.assertEqual((w.A.status, w.A.step), ("COMPLETED", N))

    def test_transition_relaxes_exactly_three_identities(self):
        self.assertEqual(set(train._TRANSITION_MUTABLE), {"run_plan_sha256", "train_data_sha256",
                                                          "sampler_fit_sha256"})

    def test_final_closure_carries_segment_1_identities(self):
        w = self.w
        _commit, closure = ckpt.open_commit(Path(w.A.last_commit))
        ids = closure.identities
        self.assertEqual(ids["run_plan_sha256"], train.plan_sha256(w.plan1))
        self.assertEqual(ids["train_data_sha256"], w.data1.content_sha256)
        self.assertEqual(ids["sampler_fit_sha256"], w.data1.fit.sha256())
        self.assertNotEqual(w.data1.fit.sha256(), w.data0.fit.sha256())
        self.assertEqual(closure.sampler_state["fit_sha256"], w.data1.fit.sha256())
        self.assertEqual(closure.sampler_state["cursor"], N)
        _c0, parent = ckpt.open_commit(w.seg0_wd / "commits" / f"{N0:010d}")
        for key in train.RESUME_IDENTITY_KEYS:
            if key not in ("run_plan_sha256", "train_data_sha256", "sampler_fit_sha256"):
                self.assertEqual(ids[key], parent.identities[key], key)

    def test_journal_schedule_and_draws_carry_over(self):
        w = self.w
        seg0 = (w.seg0_wd / "journal.jsonl").read_bytes()
        final = (w.A_wd / "journal.jsonl").read_bytes()
        self.assertTrue(final.startswith(seg0), "segment 1's journal must continue segment 0's byte for byte")
        recs = journal(w.A_wd / "journal.jsonl")
        self.assertEqual([r["step"] for r in recs], list(range(1, N + 1)), "sampler cursor / step must not reset")
        tc, sch = w.plan1["train"], w.plan1["schedule"]
        for r in recs:
            want = tc["lr"] * objective_mod.lr_factor(r["step"] - 1, warmup=sch["warmup"],
                                                      max_updates=sch["max_updates"], lr=sch["lr"],
                                                      lr_min=sch["lr_min"])
            self.assertAlmostEqual(r["lr"], want, places=12, msg=f"lr at step {r['step']} (schedule reset?)")
        seed = bytes.fromhex(w.plan0["run_seed_hex"])
        s0 = sampler.MacroSampler(w.data0.fit, seed, w.data0.config)
        s1 = sampler.MacroSampler(w.data1.fit, seed, w.data1.config)
        t0_ctx = {e["context_sha256"] for e in w.e0}
        new_ctx = set()
        for r in recs:
            ref = (s0 if r["step"] <= N0 else s1).draw(r["step"]).journal_record()
            self.assertEqual(strip_step_fields(r), ref, f"step {r['step']} is not the counter-based draw")
            ctxs = {s["context_sha256"] for s in r["slots"]}
            if r["step"] <= N0:
                self.assertLessEqual(ctxs, t0_ctx, "segment 0 drew a context outside T0")
            else:
                new_ctx |= ctxs - t0_ctx
        self.assertTrue(new_ctx, "segment 1 never drew a T1-only context: the new fit was not used")

    def test_optimizer_scheduler_and_cursor_carry_over(self):
        w = self.w
        _c, closure = ckpt.open_commit(w.A_wd / "commits" / f"{N0 + EVERY:010d}")
        steps = {k: float(v) for k, v in closure.optimizer_tensors.items() if k.endswith(".step")}
        self.assertTrue(steps)
        self.assertEqual(set(steps.values()), {float(N0 + EVERY)}, "AdamW step counts were reset at the transition")
        self.assertEqual(closure.optimizer_meta["scheduler"]["last_epoch"], N0 + EVERY)
        self.assertEqual(closure.sampler_state["cursor"], N0 + EVERY)
        ev = resumed_event(w.A_wd)
        self.assertEqual((ev["step"], ev["sampler_cursor"], ev["rule"]), (N0, N0, "restored_pointer_target"))
        tev = [e for e in events(w.A_wd) if e["event"] == "segment_transition"]
        self.assertEqual(len(tev), 1)

    def test_identity_transition_equals_uninterrupted_run(self):
        """T1 == T0: a transition that adds nothing must reproduce the uninterrupted run bit for bit, so optimizer,
        scheduler, every RNG stream, the step and the cursor all carry across the segment boundary."""
        w = self.w
        plan1 = make_seg(w.plan0, w.data0, w.e0, start_step=N0, parent_manifest=w.pm0)
        _root, store = copy_store(w.s0_root, "identity")
        wd = new_dir("identity-run") / "work"
        res = train.resume_from_store(plan1, w.data0, store, wd, store_prefix=PREFIX,
                                      transition=train.Transition(parent_plan=w.plan0, parent_manifest=list(w.e0),
                                                                  manifest=list(w.e0)))
        self.assertEqual((res.status, res.step), ("COMPLETED", N))
        self.assertEqual(closure_digest(res.last_commit), w.U_digest)
        self.assertEqual((res.parameter_sha256, res.journal_sha256), (w.U.parameter_sha256, w.U.journal_sha256))


# ======================================================================================== T3: resume inside a segment
