        self.assertEqual(w.e2[:len(w.e1)], w.e1)
        plan2 = make_seg(w.plan1, w.data2, w.e2, start_step=M, parent_manifest=self.pmM)
        self.assertEqual(plan2["segment"]["index"], 2)
        self.assertEqual(plan2["segment"]["parent_plan_sha256"], train.plan_sha256(w.plan1))
        tr12 = train.Transition(parent_plan=w.plan1, parent_manifest=list(w.e1), manifest=list(w.e2))
        _root, store = copy_store(self.after_b1, "seg2-wrong-parent")
        before = pointer_versions(store)
        for name, bad in (("plan0-as-parent", train.Transition(parent_plan=w.plan0, parent_manifest=list(w.e1),
