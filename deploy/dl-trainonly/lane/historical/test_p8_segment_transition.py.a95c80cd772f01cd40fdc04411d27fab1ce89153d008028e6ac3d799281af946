                                                                     parent_manifest=list(w.e0),
                                                                     manifest=list(w.e2)))):
            with self.subTest(name), self.assertRaises(train.TransitionRefused):
                train.resume_from_store(plan2, w.data2, store, new_dir("seg2-bad") / "work", store_prefix=PREFIX,
                                        transition=bad)
        self.assertEqual(pointer_versions(store), before)
        _root, store = copy_store(self.after_b1, "seg2")
        wd = new_dir("seg2-run") / "work"
        res = train.resume_from_store(plan2, w.data2, store, wd, store_prefix=PREFIX, transition=tr12)
        self.assertEqual((res.status, res.step), ("COMPLETED", N))
        _c, closure = ckpt.open_commit(Path(res.last_commit))
        self.assertEqual(closure.identities["run_plan_sha256"], train.plan_sha256(plan2))
        recs = journal(wd / "journal.jsonl")
        seed = bytes.fromhex(w.plan0["run_seed_hex"])
        s2 = sampler.MacroSampler(w.data2.fit, seed, w.data2.config)
        self.assertEqual(recs[:M], journal(self.B1_wd / "journal.jsonl"))
        for r in recs[M:]:
            self.assertEqual(strip_step_fields(r), s2.draw(r["step"]).journal_record())


# ======================================================================================== T4: fresh processes
class T4FreshProcessDeterminismTest(unittest.TestCase):
    """(a) the chain twice, every segment in its own fresh process over the guarded fake store."""

    def test_fresh_processes_twice_are_bit_identical(self):
        w = world()
        outs = []
        for name in ("X", "Y"):
            d = new_dir(f"fresh-{name}")
            a = run_child({"mode": "seg0", "dir": str(d)})
            b = run_child({"mode": "seg1", "dir": str(d), "pm0": a["pm0"]})
            outs.append((a, b))
        (ax, bx), (ay, by) = outs
        self.assertEqual((ax["result"]["status"], ax["result"]["step"]), ("YIELDED_TO_INTAKE", N0))
        self.assertEqual((bx["result"]["status"], bx["result"]["step"]), ("COMPLETED", N))
        self.assertEqual(bx["resumed"], {"event": "resumed", "rule": "restored_pointer_target", "step": N0,
                                         "sampler_cursor": N0})
        # The parent checkpoint manifest (and so plan1's sha) carries wall_time_utc_us and differs per chain; the
        # training state is a function of (tranche manifests, switch steps) only.
        self.assertNotEqual(ax["pm0"], ay["pm0"])
        for key in ("digest", "plan0_sha256", "e0_sha256"):
            self.assertEqual(ax[key], ay[key], key)
        for key in ("digest", "e1_sha256", "resumed"):
            self.assertEqual(bx[key], by[key], key)
        for key in ("parameter_sha256", "journal_sha256", "initial_parameter_sha256", "step", "status"):
            self.assertEqual(bx["result"][key], by["result"][key], key)
        # ... and equal to the in-process chain over the plain FileVersionedStore.
        self.assertEqual(ax["digest"], closure_digest(w.seg0_wd / "commits" / f"{N0:010d}"))
        self.assertEqual(ax["plan0_sha256"], train.plan_sha256(w.plan0))
        self.assertEqual(bx["digest"], w.A_digest)
        self.assertEqual((bx["result"]["parameter_sha256"], bx["result"]["journal_sha256"]),
                         (w.A.parameter_sha256, w.A.journal_sha256))
        sys.stderr.write(f"\n[p8 segment] fresh X/Y final parameter_sha256 {bx['result']['parameter_sha256']} "
                         f"journal_sha256 {bx['result']['journal_sha256']}\n")


