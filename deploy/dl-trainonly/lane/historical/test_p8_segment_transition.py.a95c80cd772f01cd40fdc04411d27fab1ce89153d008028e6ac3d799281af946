# ------------------------------------------------------------------------------------------------------ helpers
def tmp_root() -> Path:
    t = os.environ.get("TMPDIR")
    if not t:
        raise RuntimeError("TMPDIR must be set; these tests never use /tmp")
    p = Path(t).resolve()
    if p == Path("/tmp") or Path("/tmp") in p.parents:
        raise RuntimeError(f"TMPDIR {p} is under /tmp; refused")
    root = p / "p8-segment-tests"
    root.mkdir(parents=True, exist_ok=True)
    return root


_MODULE: dict = {}


def run_dir() -> Path:
    """One directory per test-module run, never removed (evidence)."""
    if "dir" not in _MODULE:
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        _MODULE["dir"] = Path(tempfile.mkdtemp(prefix=f"run-{stamp}-", dir=tmp_root()))
    return _MODULE["dir"]


def new_dir(name: str) -> Path:
    return Path(tempfile.mkdtemp(prefix=f"{name}-", dir=run_dir()))


def setUpModule() -> None:
    _MODULE["t0"] = time.monotonic()
    model.configure_determinism(4)


def tearDownModule() -> None:
    elapsed = time.monotonic() - _MODULE["t0"]
    sys.stderr.write(f"\n[p8 segment] module wall time {elapsed:.1f} s; evidence under {_MODULE.get('dir')}\n")
    if elapsed > WALL_CAP_S:
        raise AssertionError(f"module wall time {elapsed:.1f} s exceeds {WALL_CAP_S:.0f} s")


def sampler_cfg():
