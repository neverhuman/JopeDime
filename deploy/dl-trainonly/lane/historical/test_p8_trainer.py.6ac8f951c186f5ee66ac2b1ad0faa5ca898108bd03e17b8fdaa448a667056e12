def _tmp(case) -> Path:
    TMP_ROOT.mkdir(parents=True, exist_ok=True)
    d = Path(tempfile.mkdtemp(prefix="p8-trainer-", dir=TMP_ROOT))
    return d


def _plan(data, run_id="p8t", max_updates=10, commit_every=3, **kw):
    mcfg = model.PolicyConfig(vocab_size=SPEC.vocab_size, ctx_dim=SPEC.ctx_dim, d_model=32, n_layers=2, n_heads=2,
                              d_ff=64, max_seq=SPEC.max_seq, dropout=0.1)
    tcfg = train.TrainConfig(lr=3e-3, lr_min=3e-4, warmup=3, commit_every_updates=commit_every,
                             commit_every_seconds=None, eval_every_epochs=None, ctx_drop_prob=0.25, ctx_noise_std=0.05)
    return train.make_run_plan(run_id=run_id, run_seed=bytes(range(32)), arm="syn", objective="successor-v1",
                               model=mcfg, sampler=data.config, train=tcfg, max_updates=max_updates, refs=data.refs,
                               **kw)


class _Fake:
    """A guarded fake-bucket store that persists under a directory (fresh store objects see the same versions)."""

    def __init__(self, root: Path, run_id: str):
        self.root, self.run_id, self.n = root, run_id, 0

    def open(self):
        self.n += 1
        store, ledger, bucket = s3store.open_fake(prefix_key=PREFIX, view_id=self.run_id,
                                                  ledger_path=self.root / f"ledger-{self.n}.jsonl",
                                                  budget_ledger_path=self.root / "budget.jsonl",
                                                  disk_root=self.root / "bucket")
        return store, ledger, bucket


