class CudaRuleTests(unittest.TestCase):
    def test_cuda_determinism_needs_cublas_workspace(self):
        with mock.patch.dict(os.environ, {"CUBLAS_WORKSPACE_CONFIG": ""}):
            with self.assertRaisesRegex(RuntimeError, "CUBLAS_WORKSPACE_CONFIG"):
                model.configure_determinism(4, "cuda")
        with self.assertRaises(ValueError):
            model.configure_determinism(4, "tpu")
        self.assertEqual(model.configure_determinism(4)["device"], "cpu")
        self.assertNotIn("cublas_workspace_config", model.configure_determinism(4))

    def test_rng_closure_accepts_contiguous_cuda_states_only(self):
        meta = ckpt._capture_rng()[1]                       # noqa: SLF001 (CUDA is never initialised here)
        cpu = torch.get_rng_state()
        cuda = torch.zeros(16, dtype=torch.uint8)
        ckpt._check_rng({"torch_cpu": cpu}, meta)           # noqa: SLF001
        ckpt._check_rng({"torch_cpu": cpu, "torch_cuda_0": cuda}, meta)   # noqa: SLF001
        for bad in ({"torch_cuda_0": cuda}, {"torch_cpu": cpu, "torch_cuda_1": cuda},
                    {"torch_cpu": cpu, "torch_cuda_0": cuda.to(torch.int64)}):
            with self.assertRaises(ckpt.CheckpointRefused):
                ckpt._check_rng(bad, meta)                  # noqa: SLF001

    def test_cpu_restore_of_a_cuda_closure_is_refused(self):
        d = _tmp(self)
        data = synthetic_data.train_data(SPEC, sampler.SamplerConfig(b_ctx=4))
        plan = _plan(data, run_id="p8cuda", max_updates=3, commit_every=3)
        res = train.run(plan, data, d / "w")
        closure = ckpt.read_commit(Path(res.last_commit))
        closure.rng_tensors["torch_cuda_0"] = torch.zeros(16, dtype=torch.uint8)
        net, opt, sched = train.build_training_objects(plan)
        with mock.patch.object(torch.cuda, "is_available", return_value=False):
            with self.assertRaisesRegex(ckpt.CheckpointRefused, "CUDA RNG"):
                ckpt.apply_closure(closure, model=net, optimizer=opt, scheduler=sched)


