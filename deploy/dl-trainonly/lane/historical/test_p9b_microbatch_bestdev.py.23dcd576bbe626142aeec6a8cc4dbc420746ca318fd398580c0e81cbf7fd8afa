def _tmp() -> Path:
    TMP_ROOT.mkdir(parents=True, exist_ok=True)
    return Path(tempfile.mkdtemp(prefix="p9b-", dir=TMP_ROOT))


def setUpModule():
    model.configure_determinism(4)


def _batches(mode: str, steps=(1, 2, 3, 7)):
    kw = {"group_mode": mode} if mode == objective.BASELINE_V1 else {}
    data = fixtures_p7.train_data(**kw)
    smp = sampler.MacroSampler(data.fit, fixtures_p7.RUN_SEED, data.config)
    return data, [sampler.collate(smp.draw(s), data) for s in steps]


def _net(data, mode):
    torch.manual_seed(5)
    cfg = fixtures_p7.model_config(dropout=0.0, context_free_head=mode == objective.BASELINE_V1)
    return model.PolicyLM(cfg)


def _grads(net):
    return {n: p.grad.detach().clone() for n, p in net.named_parameters() if p.grad is not None}


class SplitTests(unittest.TestCase):
    def test_parts_partition_the_batch_and_keep_contexts_whole(self):
        _data, batches = _batches(objective.SUCCESSOR_V1)
        for batch in batches:
            for budget in (2, 40, 200, 10 ** 6):
                parts = sampler.split_batch(batch, budget)
                ids = [m for p in parts for m in p.member_ids]
                self.assertEqual(sorted(ids), sorted(batch.member_ids))          # each sequence exactly once
                self.assertEqual(len(ids), len(set(ids)))
                ctxs = [c for p in parts for c in p.ctx_ids]
                self.assertEqual(sorted(ctxs), sorted(batch.ctx_ids))            # each context in one part
                for p in parts:
                    self.assertEqual({p.ctx_ids[int(k)] for k in p.seq_ctx}, set(p.ctx_ids))
                    self.assertEqual(p.tokens.shape[1], int(p.lengths.max()))
                    self.assertEqual(p.legal.shape[1], p.tokens.shape[1] - 1)
                    if len(p.ctx_ids) > 1:
                        self.assertLessEqual(p.tokens.shape[0] * p.tokens.shape[1], budget)
                    for k, (c, prog) in enumerate(p.member_ids):
                        i = batch.member_ids.index((c, prog))
                        self.assertTrue(torch.equal(p.tokens[k], batch.tokens[i, :p.tokens.shape[1]]))
                        self.assertEqual(p.ctx_ids[int(p.seq_ctx[k])], c)
                self.assertEqual(sum(p.n_tokens for p in parts), batch.n_tokens)
                if budget == 10 ** 6:
                    self.assertEqual(len(parts), 1)
                if budget == 2:
                    self.assertEqual(len(parts), len(batch.ctx_ids))
        with self.assertRaises(ValueError):
            sampler.split_batch(batches[0], 1)

    def test_split_is_deterministic(self):
        _data, batches = _batches(objective.SUCCESSOR_V1)
        a = sampler.split_batch(batches[0], 60)
        b = sampler.split_batch(batches[0], 60)
        self.assertEqual([p.member_ids for p in a], [p.member_ids for p in b])


class AccumulationTests(unittest.TestCase):
    """Sum of part losses over the full batch's denominators == the unsplit loss; gradients likewise."""

    def _check(self, mode):
        data, batches = _batches(mode)
        fn = objective.OBJECTIVES[mode]
        for batch in batches:
            net = _net(data, mode)
            out = net(batch.tokens, batch.lengths, batch.ctx_z, batch.seq_ctx)
            full = fn(out, batch)
            full.loss.backward()
            g_full = _grads(net)
            norm = objective.normalizers(batch)
            for budget in (2, 50, 120):
                parts = sampler.split_batch(batch, budget)
                net.zero_grad(set_to_none=True)
                total, terms = 0.0, {}
                for p in parts:
                    o = net(p.tokens, p.lengths, p.ctx_z, p.seq_ctx)
                    r = fn(o, p, norm=norm)
                    r.loss.backward()
                    total += float(r.loss.detach())
                    for k, v in r.terms.items():
                        terms[k] = terms.get(k, 0.0) + v
                with self.subTest(mode=mode, step=batch.step, budget=budget, parts=len(parts)):
                    self.assertAlmostEqual(total, float(full.loss.detach()), delta=1e-5 * max(1, abs(total)))
                    for k in full.terms:
                        self.assertAlmostEqual(terms[k], full.terms[k], delta=1e-5 * max(1.0, abs(full.terms[k])))
                    g = _grads(net)
                    self.assertEqual(set(g), set(g_full))
                    for name in g:
                        self.assertTrue(torch.allclose(g[name], g_full[name], rtol=1e-4, atol=1e-6), name)

    def test_successor(self):
        self._check(objective.SUCCESSOR_V1)

    def test_baseline(self):
        self._check(objective.BASELINE_V1)

    def test_own_denominators_would_be_wrong(self):
        """Control: parts normalised by their own counts do NOT sum to the full loss (the norm is load-bearing)."""
        data, batches = _batches(objective.SUCCESSOR_V1)
        batch = batches[0]
        net = _net(data, objective.SUCCESSOR_V1)
        full = float(objective.successor_v1(net(batch.tokens, batch.lengths, batch.ctx_z, batch.seq_ctx), batch).loss)
        parts = sampler.split_batch(batch, 2)
        own = sum(float(objective.successor_v1(net(p.tokens, p.lengths, p.ctx_z, p.seq_ctx), p).loss) for p in parts)
        self.assertGreater(abs(own - full), 1e-3)

    def test_normalizers_are_label_only_and_complete(self):
        for mode in (objective.SUCCESSOR_V1, objective.BASELINE_V1):
            _data, batches = _batches(mode)
            norm = objective.normalizers(batches[0])
            self.assertEqual(sorted(norm), sorted(objective.NORM_KEYS[mode]))
            self.assertTrue(all(v > 0 for v in norm.values()), norm)


def _plan(data, *, run_id="p9b", max_updates=8, **train_kw):
    tc = fixtures_p7.train_config(**{"ctx_drop_prob": 0.0, "ctx_noise_std": 0.0, **train_kw})
    return train.make_run_plan(**fixtures_p7.plan_kwargs(run_id=run_id, max_updates=max_updates,
                                                         model=fixtures_p7.model_config(dropout=0.0), train=tc))


def _journal(path):
    return [json.loads(x) for x in Path(path).read_bytes().splitlines()]


class TrainerMicroBatchTests(unittest.TestCase):
    def test_same_draws_journal_and_loss_with_and_without_bucketing(self):
        data = fixtures_p7.train_data()
        d = _tmp()
        a = train.run(_plan(data), data, d / "A")
        b = train.run(_plan(data, micro_batch_tokens=60), data, d / "B")
        self.assertEqual((a.status, b.status, a.step, b.step), ("COMPLETED", "COMPLETED", 8, 8))
        ja, jb = _journal(d / "A" / "journal.jsonl"), _journal(d / "B" / "journal.jsonl")
        self.assertEqual(len(ja), len(jb))
        for x, y in zip(ja, jb):
            self.assertEqual({k: v for k, v in x.items() if k not in ("loss", "grad_norm")},
                             {k: v for k, v in y.items() if k not in ("loss", "grad_norm")})   # identical draw set
            self.assertAlmostEqual(x["loss"], y["loss"], delta=1e-4 * max(1, abs(x["loss"])))
            self.assertAlmostEqual(x["grad_norm"], y["grad_norm"], delta=1e-3 * max(1, abs(x["grad_norm"])))
        pa = ckpt.read_commit(Path(a.last_commit)).model_tensors
        pb = ckpt.read_commit(Path(b.last_commit)).model_tensors
        for name in pa:
            self.assertTrue(torch.allclose(pa[name], pb[name], rtol=1e-3, atol=1e-5), name)

    def test_micro_batched_run_is_deterministic_and_resumes_exactly(self):
        data = fixtures_p7.train_data()
        d = _tmp()
        plan = _plan(data, micro_batch_tokens=60, commit_every_updates=4)
        a = train.run(plan, data, d / "A")
        stop = d / "STOP"
        b = train.run(plan, data, d / "B", stop_file=stop,
                      hooks=train.TrainHooks(after_step=lambda s: stop.touch() if s == 4 else None))
        self.assertEqual((b.status, b.step), ("YIELDED_TO_INTAKE", 4))
        r = train.resume_from_commit(plan, data, Path(b.last_commit), d / "R")
        self.assertEqual((r.parameter_sha256, r.journal_sha256), (a.parameter_sha256, a.journal_sha256))

    def test_config_rules_and_plan_compatibility(self):
        with self.assertRaises(ValueError):
            train.TrainConfig(micro_batch_tokens=1)
        with self.assertRaises(ValueError):
            train.TrainConfig(eval_every_updates=0)
        d = train.TrainConfig().to_json()
        for key in ("micro_batch_tokens", "eval_every_updates", "best_dev", "publish_every_updates"):
            self.assertNotIn(key, d)                           # P7/P9a-era plans hash unchanged
        self.assertEqual(train.TrainConfig(micro_batch_tokens=64).to_json()["micro_batch_tokens"], 64)


