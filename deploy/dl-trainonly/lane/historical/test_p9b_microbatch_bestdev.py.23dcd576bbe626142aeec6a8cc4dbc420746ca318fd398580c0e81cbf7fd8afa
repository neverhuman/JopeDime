class BestDevTests(unittest.TestCase):
    def _run(self, d, store, **kw):
        data = fixtures_p7.train_data()
        plan = _plan(data, run_id="p9bbest", max_updates=12, commit_every_updates=2, eval_every_updates=2,
                     best_dev=True, publish_every_updates=4, lr=3e-3, **kw)
        return plan, data, train.run(plan, data, d / "w", store=store)

    def _history(self, store, run_id):
        key = ckpt.best_dev_key("", run_id)
        return [json.loads(store.get(key, version_id=v["version_id"]).body) for v in store.list_versions(key)]

    def test_pointer_tracks_the_best_published_dev_checkpoint(self):
        d = _tmp()
        store = ckpt.FileVersionedStore(d / "store")
        plan, _data, res = self._run(d, store)
        self.assertEqual(res.status, "COMPLETED")
        events = _journal(d / "w" / "events.jsonl")
        pubs = [e for e in events if e["event"] == "published"]
        self.assertEqual([e["step"] for e in pubs], [4, 8, 12])
        dev = {e["step"]: e["metrics"]["ce_per_token_family_macro"] for e in events if e["event"] == "dev_validation"}
        hist = self._history(store, plan["run_id"])
        self.assertGreaterEqual(len(hist), 1)
        self.assertEqual([h["seq"] for h in hist], list(range(1, len(hist) + 1)))
        values = [h["metric"]["value"] for h in hist]
        self.assertEqual(values, sorted(values, reverse=True))                 # strictly improving
        self.assertEqual(len(set(values)), len(values))
        best_pub = min((dev[e["step"]], e["step"]) for e in pubs)
        self.assertEqual((hist[-1]["metric"]["value"], hist[-1]["step"]), best_pub)
        manifests = {e["manifest_sha256"]: e["manifest_version_id"] for e in pubs}
        for h in hist:
            self.assertEqual(manifests[h["target_manifest_sha256"]], h["target_version_id"])
            self.assertEqual(h["metric"]["split"], "dev")
        for e in pubs:
            self.assertEqual(e["best_dev"]["value"], dev[e["step"]])            # metric computed once per step
        self.assertEqual(sum(1 for e in events if e["event"] == "dev_validation" and e["step"] == 4), 1)

    def test_a_foreign_best_dev_pointer_is_a_conflict(self):
        d = _tmp()
        store = ckpt.FileVersionedStore(d / "store")
        key = ckpt.best_dev_key("", "p9bbest")
        foreign = common.canonical({"schema": ckpt.SCHEMA_BEST_DEV, "run_id": "p9bbest", "pointer_name": "best-dev",
                                    "target_manifest_sha256": "a" * 64, "target_version_id": "v", "step": 0,
                                    "metric": {"value": -1.0}, "seq": 1, "prev_version_id": None,
                                    "writer": {"host": "other"}, "utc_us": 1})
        store.put_create_only(key, foreign)
        with self.assertRaisesRegex(ckpt.CheckpointRefused, "best-dev"):
            self._run(d, store)

    def test_only_improvements_advance_and_metrics_are_computed_once_per_step(self):
        """Scripted dev metric (by call order, one call per eval step 2..12): publishes at 4, 8, 12 see 3.0, 2.0,
        2.5, so best-dev advances at 4 and 8 only; dev_metrics runs exactly once per eval step."""
        scripted = iter([5.0, 3.0, 4.0, 2.0, 9.0, 2.5])
        calls = []

        def fake(net, data, split="dev", **_kw):
            calls.append(split)
            return {"ce_per_token_family_macro": next(scripted), "validation_split": "dev-family-v1", "contexts": 2,
                    "families": 2, "token_validity": 1.0, "pairwise_accuracy_family_macro": 0.5}
        d = _tmp()
        store = ckpt.FileVersionedStore(d / "store")
        with mock.patch.object(train.evaluate, "dev_metrics", side_effect=fake):
            plan, _data, res = self._run(d, store)
        self.assertEqual(res.status, "COMPLETED")
        self.assertEqual(len(calls), 6)
        hist = self._history(store, plan["run_id"])
        self.assertEqual([(h["step"], h["metric"]["value"]) for h in hist], [(4, 3.0), (8, 2.0)])
        pubs = [e for e in _journal(d / "w" / "events.jsonl") if e["event"] == "published"]
        self.assertEqual([(e["step"], e["best_dev"]["advanced"]) for e in pubs], [(4, True), (8, True), (12, False)])

    def test_a_concurrent_writer_conflicts(self):
        d = _tmp()
        store = ckpt.FileVersionedStore(d / "store")
        exp = ckpt.advance_best_dev(store, prefix="", run_id="r", manifest_sha256="a" * 64, manifest_version_id="v1",
                                    step=2, metric={"value": 1.0}, expected=None, writer={})
        ckpt.advance_best_dev(store, prefix="", run_id="r", manifest_sha256="b" * 64, manifest_version_id="v2",
                              step=4, metric={"value": 0.5}, expected=exp, writer={})
        with self.assertRaises(ckpt.Conflict):                                # stale expectation
            ckpt.advance_best_dev(store, prefix="", run_id="r", manifest_sha256="c" * 64, manifest_version_id="v3",
                                  step=6, metric={"value": 0.4}, expected=exp, writer={})
        with self.assertRaises(ckpt.Conflict):                                # absent expectation, pointer exists
            ckpt.advance_best_dev(store, prefix="", run_id="r", manifest_sha256="c" * 64, manifest_version_id="v3",
                                  step=6, metric={"value": 0.4}, expected=None, writer={})
        empty = ckpt.FileVersionedStore(d / "empty")
        with self.assertRaisesRegex(ckpt.Conflict, "absent"):                 # expectation, but no pointer at all
            ckpt.advance_best_dev(empty, prefix="", run_id="r", manifest_sha256="c" * 64, manifest_version_id="v3",
                                  step=6, metric={"value": 0.4}, expected=exp, writer={})

    def test_create_only_store_keeps_best_dev_sequenced(self):
        d = _tmp()
        store, ledger, bucket = s3store.open_fake(prefix_key=s3store.SMOKE_PREFIX_KEY, view_id="r",
                                                  ledger_path=d / "l.jsonl", budget_ledger_path=d / "b.jsonl")
        p = s3store.SMOKE_PREFIX_KEY
        exp = ckpt.advance_best_dev(store, prefix=p, run_id="r", manifest_sha256="a" * 64, manifest_version_id="v1",
                                    step=2, metric={"value": 1.0}, expected=None, writer={})
        exp2 = ckpt.advance_best_dev(store, prefix=p, run_id="r", manifest_sha256="b" * 64, manifest_version_id="v2",
                                     step=4, metric={"value": 0.5}, expected=exp, writer={})
        self.assertEqual(exp2.seq, 2)
        found = ckpt.read_best_dev(store, p, "r")
        self.assertEqual((found[0].version_id, found[1]["step"]), (exp2.version_id, 4))
        keys = [k for k in bucket.keys() if "/best-dev/" in k]
        self.assertEqual(keys, [s3store.seq_key(ckpt.best_dev_key(p, "r"), i) for i in (1, 2)])
        self.assertFalse(any(k.endswith("HEAD.json") for k in bucket.keys()))
        ledger.close()

    def test_resume_adopts_the_pointer_and_keeps_improving_only(self):
        d = _tmp()
        store = ckpt.FileVersionedStore(d / "store")
        data = fixtures_p7.train_data()
        plan = _plan(data, run_id="p9bres", max_updates=12, commit_every_updates=2, eval_every_updates=2,
                     best_dev=True, publish_every_updates=4, lr=3e-3)
        stop = d / "STOP"
        b = train.run(plan, data, d / "B", store=store, stop_file=stop,
                      hooks=train.TrainHooks(after_step=lambda s: stop.touch() if s == 8 else None))
        self.assertEqual((b.status, b.step), ("YIELDED_TO_INTAKE", 8))
        before = self._history(store, "p9bres")
        r = train.resume_from_store(plan, data, store, d / "R")
        self.assertEqual(r.status, "COMPLETED")
        resumed = [e for e in _journal(d / "R" / "events.jsonl") if e["event"] == "resumed"][0]
        self.assertEqual(resumed["best_dev"]["value"], before[-1]["metric"]["value"])
        after = self._history(store, "p9bres")
        self.assertEqual(after[:len(before)], before)
        values = [h["metric"]["value"] for h in after]
        self.assertEqual(values, sorted(values, reverse=True))


