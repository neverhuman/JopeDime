    def _forge(self, out: Path, name: str, mutate=None, shard_rel: str | None = None, line: int = 0,
               update_index: bool = True) -> Path:
        """A copy of OUT whose index line `line` points at an edited shard (simulating a tampered tail output)."""
        dst = self.root / name
        shutil.copytree(out, dst)
        lines = [json.loads(x) for x in (dst / "index.jsonl").read_bytes().splitlines()]
        e = lines[line]
        shard = json.loads((dst / e["shard"]).read_bytes())
        if mutate is not None:
            shard = mutate(shard)
        body = T._line(shard)
        target = dst / (shard_rel or e["shard"])
        wbytes(target, body)
        if shard_rel:
            e["shard"] = shard_rel
        if update_index:
            e["sha256"], e["bytes"] = sha(body), len(body)
        wbytes(dst / "index.jsonl", b"".join(T._line(x) for x in lines))
        return dst

