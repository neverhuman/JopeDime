    def cli(self, fx: Fixture, out: Path, *args: str) -> tuple[int, list]:
        sys.path.insert(0, str(TOOLS))
        try:
            import importlib
            mod = importlib.import_module("s1_tail")
            argv = ["--ledger-dir", str(fx.prod), "--out", str(out), "--denylist", str(fx.denylist),
                    "--denylist-sha256", fx.denylist_sha, "--evaluations-root", str(fx.host),
                    "--exclusion", str(fx.exclusion), "--exclusion-sha256", fx.exclusion_sha]
            for t in fx.trees:
                argv += ["--encoding-tree", str(t)]
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                rc = mod.main(argv + list(args))
        finally:
            sys.path.remove(str(TOOLS))
        lines = [json.loads(x) for x in buf.getvalue().splitlines() if x.startswith("{")]
        return rc, lines


