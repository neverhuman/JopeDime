        wbytes(ot / "a0.f32", Path(a0["path"]).read_bytes())

        def a0_into_outer_test(sh):
            sh["encodings"]["a0"]["path"] = str(ot / "a0.f32")
            return sh

        forged = self._forge(out, "forged-encoding-path", a0_into_outer_test)
        with self.assertRaises(tranche.LabelSourceRefused):
            tdft(dict(spec, tail_out=str(forged)), T.tranche_entries(forged))
        # (b) heldout, sealed_excluded, unknown assignment, a dev row posing as train_fit, a denylisted view
        for k, (field, value) in enumerate((("assignment", "heldout"), ("assignment", "sealed_excluded"),
                                            ("assignment", "no_family"), ("assignment", None))):
            def claim(sh, field=field, value=value):
                sh["context"][field] = value
                return sh
            forged = self._forge(out, f"forged-assignment-{k}", claim)
            with self.assertRaises((admission_mod.AdmissionRefused, T.S1TailError), msg=str(value)):
                tdft(dict(spec, tail_out=str(forged)), T.tranche_entries(forged))
        dv_line = next(i for i, e in enumerate(T.read_index(out)[0]) if e["split_role"] == "dev")

        def dev_as_train(sh):
            sh["context"]["split_role"] = "train_fit"
            for r in sh["records"]:
                r["split_role"] = "train_fit"
            return sh

        forged = self._forge(out, "forged-dev-role", dev_as_train, line=dv_line)
        with self.assertRaises(admission_mod.AdmissionRefused):
            tdft(dict(spec, tail_out=str(forged)), T.tranche_entries(forged))
        t1_view = T.read_index(out)[0][0]["view_id"]
        d2 = json.loads(deny.read_bytes())
        d2["contexts"].append({"view_id": t1_view, "assignment": "heldout"})
        db = canon(d2)
        wbytes(self.root / "deny-t1.json", db)
        with self.assertRaises(admission_mod.AdmissionRefused):
            tdft(a=admission_mod.Admission(self.root / "deny-t1.json", sha(db), purpose="selection"))
        # (c) an excluded linear-determined view_id
        x = json.loads(excl.read_bytes())
        x["exclude"]["contexts"].append({"dataset": "0" * 16, "view_id": t1_view, "ols_rel_rmse": 1e-15})
        xb = canon(x)
        wbytes(self.root / "excl-t1.json", xb)
        with self.assertRaises(T.S1TailError):
            tdft(dict(spec, exclusion={"path": str(self.root / "excl-t1.json"), "sha256": sha(xb)}))
        # (d) shard bytes differ from the entry; a record altered with its entry sha recomputed but not the index
        def bump(sh):
            r = next(r for r in sh["records"] if r["rmse_j"] is not None)
            r["rmse_j"] = [r["rmse_j"][0] * 0.5, r["rmse_j"][1]]
            return sh

        forged = self._forge(out, "forged-bytes", bump, update_index=False)
        with self.assertRaises(T.S1TailError):
            tdft(dict(spec, tail_out=str(forged)), T.tranche_entries(forged))
        body = (forged / T.read_index(forged)[0][0]["shard"]).read_bytes()
        recomputed = [dict(e) for e in T.tranche_entries(forged)]
        recomputed[0]["shard_sha256"] = sha(body)
        with self.assertRaises(T.S1TailError):
            tdft(dict(spec, tail_out=str(forged)), recomputed)

    def test_v6all_completion_receipt_tsv_adapter(self):
        fx = self.fixture()
        fx.write_ledgers(finals=["t1", "t2", "t3"])
        pub = self.root / "PUBLISH-hyperion-v6all-v1"
        lines = []
        for k, n in enumerate(("t1", "t2")):                               # t3: no TSV row -> excluded
            d = pub / f"shard-xbabe{k + 1}" / fx.view[n]
            v = Fixture._npy(np.full(4, 3.0 + k, dtype=np.float32))
            wbytes(d / "hyperion_v6all.npy", v)
            wbytes(d / ".done", b"ok\n")
            cjb = wjson(d / "context.json", {"context_sha256": fx.ctx[n], "view_id": fx.view[n],
                                             "files": {"hyperion_v6all.npy": {"sha256": sha(v), "bytes": len(v)}}})
            lines.append(f"{fx.view[n]}\t{sha(cjb)}\t{sha(v)}\n")
        hr = self.root / "GPU-v6all" / "host-receipts"
        tsv = "".join(sorted(lines)).encode()
        wbytes(hr / "assembled-set.tsv", tsv)

        def receipt(**over):
            doc = {"schema": T.V6ALL_COMPLETION_SCHEMA, "assembled": 2, "assembled_set_sha256": sha(tsv),
                   "missing": [], "assembled_missing": [], "assembled_npy_mismatch": [],
                   "label_exposure": {"counts": {"label_free_finetune": 2},
                                      "value": "label-free (hyperion_v6all: v5 armB inheritance recorded)"}}
            doc.update(over)
            return sha(wjson(hr / "v6all-encode-completion.json", doc))

        rsha = receipt()
        ps = T.PinnedEncodingSet(pub, hr / "v6all-encode-completion.json", rsha)
        self.assertEqual(ps.assembled_set_sha256, sha(tsv))
        self.assertEqual(ps.binding()["assembled_set_sha256"], sha(tsv))
        sets = ({"tree": str(pub), "receipt": str(hr / "v6all-encode-completion.json"), "sha256": rsha},)
        s, out = self.run_tail(fx, encoding_sets=sets)
        hdr = json.loads((out / "header.json").read_bytes())
        self.assertEqual(hdr["encoding_sets"][0]["assembled_set_sha256"], sha(tsv))
        self.assertEqual(T.tranche_receipt(out)["encoding_sets"][0]["assembled_set_sha256"], sha(tsv))
        adm = admission_mod.Admission(fx.denylist, fx.denylist_sha, purpose="selection")
        spec = {"tail_out": str(out), "components": ["a0", "hyperion_v6all"], "encoding_sets": list(sets),
                "exclusion": {"path": str(fx.exclusion), "sha256": fx.exclusion_sha}, "grammar": None,
                "vocab_sha256": dsl_tokenizer.Vocab.from_names({}).sha256, "max_seq": 512}
        d = T.train_data_for_tranche(spec, T.tranche_entries(out), adm, sampler.SamplerConfig(),
                                     encoding_trees=fx.trees)
        r = T.train_data_receipt(d)
        self.assertEqual(set(d.corpus.contexts), {fx.ctx["t1"], fx.ctx["t2"]})
        self.assertEqual(r["excluded_missing_component"], {fx.ctx["t3"]: ["hyperion_v6all"]})
        self.assertEqual(r["encoding_sets"][0]["assembled_set_sha256"], sha(tsv))
        self.assertEqual(float(d.corpus.encodings[fx.ctx["t2"]][-1]), 4.0)
        # fail closed: a TSV that is not the assembled set, a non-label-free receipt, a tampered vector
        for over in ({"assembled_set_sha256": "0" * 64}, {"label_exposure": {"counts": {"label_free_finetune": 1},
                                                                             "value": "label-free"}},
                     {"assembled_npy_mismatch": [fx.view["t1"]]}):
            with self.assertRaises(T.S1TailError, msg=str(over)):
                T.PinnedEncodingSet(pub, hr / "v6all-encode-completion.json", receipt(**over))
        rsha = receipt()
        npy = pub / "shard-xbabe1" / fx.view["t1"] / "hyperion_v6all.npy"
        wbytes(npy, Fixture._npy(np.full(4, 9.0, dtype=np.float32)))
        ps2 = T.PinnedEncodingSet(pub, hr / "v6all-encode-completion.json", rsha)
        self.assertEqual(ps2.resolve(fx.ctx["t1"], fx.view["t1"])["found"], {})

