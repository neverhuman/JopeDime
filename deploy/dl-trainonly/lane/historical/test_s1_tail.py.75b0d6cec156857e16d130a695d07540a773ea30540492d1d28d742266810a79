def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def canon(doc) -> bytes:
    return json.dumps(doc, sort_keys=True, separators=(",", ":"), allow_nan=False).encode() + b"\n"


def wbytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.exists():
        os.chmod(path, 0o644)
    path.write_bytes(data)


def wjson(path: Path, doc) -> bytes:
    b = canon(doc)
    wbytes(path, b)
    return b


def jtt1(X_tr, y_tr, X_te, y_te) -> bytes:
    head = b"JTT1" + struct.pack("<IIIB", len(y_tr), len(y_te), X_tr.shape[1], 2)
    inner = bytes(i % 2 for i in range(len(y_tr)))
    mat = np.concatenate([np.c_[X_tr, y_tr], np.c_[X_te, y_te]]).astype("<f8")
    return head + inner + mat.tobytes()


def tar_gz(files: dict) -> bytes:
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tar:
        for name in sorted(files):
            info = tarfile.TarInfo(name)
            info.size, info.mtime, info.mode = len(files[name]), 0, 0o444
            tar.addfile(info, io.BytesIO(files[name]))
    return gzip.compress(buf.getvalue(), mtime=0)


class Fixture:
    """A production-shaped S1 world under `root`. poison=True perturbs every outer-test value (teacher JTT1 test rows,
    final.json/final-row outer_test, outer-test ledger rows, a separate outer-test ledger and per-context outer-test
    files) and nothing else. variants: {ctx_name: kind} for the negative cases."""

    def __init__(self, root: Path, *, poison: bool = False, variants: dict | None = None,
                 exclude: tuple = (), review: tuple = ()):
        self.root, self.poison, self.variants = Path(root), poison, dict(variants or {})
        self.exclude_names, self.review_names = tuple(exclude), tuple(review)
        self.prod = self.root / "s1-prod"
        self.host = self.root / "host" / "contexts"
        self.trees = (self.root / "build/ROWSEL", self.root / "build/PUBLISH", self.root / "build/GPU")
        self.names = list(SPECS)
        self.ctx, self.view, self.y = {}, {}, {}
        for i, n in enumerate(self.names):
            self.ctx[n] = sha(f"ctx-{n}".encode())
            self.view[n] = f"{i:02x}{n}00000000000__r0__f{i % 5}__rowselraw1_{self.ctx[n][:12]}"
        self._p3()
        self._denylist()
        self.exclusion, self.exclusion_sha = self.write_exclusion(self.root / "exclusion.json",
                                                                  self.exclude_names, self.review_names)
        rows = [self._context(i, n) for i, n in enumerate(self.names)]
        self.input_list_bytes = wjson(self.prod / "input-list.json", {"schema": "jope.dl-s1-prod-input-list/v1",
                                                                      "admitted": rows, "refused": []})
        self.header = {
            "schema": T.LEDGER_HEADER_SCHEMA,
            "input_list": {"path": str(self.prod / "input-list.json"), "sha256": sha(self.input_list_bytes)},
            "p3": {"holdout": str(self.root / "p3/holdout.json"), "holdout_sha256": self.holdout_sha,
                   "registry": str(self.root / "p3/registry.json"), "registry_sha256": self.registry_sha},
            "ledgers": {"production": str(self.prod / "ledger-production.jsonl"),
                        "research": str(self.prod / "ledger-research.jsonl")},
            "outer_test": {"policy": "after selection, stored separately, create-only"}}
        self.header_sha = sha(wjson(self.prod / T.LEDGER_HEADER_NAME, self.header))
        self.finals = {}
        for i, n in enumerate(self.names):
            if SPECS[n][3]:
                self.finals[n] = self._final(i, n)
        wbytes(self.prod / "ledger-outer-test.jsonl", b"".join(
            canon({"event": "outer_test", "context_sha256": self.ctx[n], "test_rmse": self._test_value(i)})
            for i, n in enumerate(self.names)))
        # the S1 outer-test subtree (unreviewed_adapter): poison values, and look-alike files that must never be read
        ot = self.prod / "outer-test"
        wbytes(ot / "ledger-outer-test.jsonl", b"".join(
            canon({"event": "final", "context_sha256": self.ctx[n], "test_rmse": self._test_value(i),
                   "official_test": {"metrics": {"rmse": self._test_value(i)}}}) for i, n in enumerate(self.names)))
        for i, n in enumerate(self.names):
            wjson(ot / "contexts" / self.ctx[n] / "g0-evaluations.json",
                  [{"schema": T.EVAL_SCHEMA, "official_test": {"metrics": {"rmse": self._test_value(i)}},
                    "outer_test_predictions": [self._test_value(i)] * 3}])

    # ------------------------------------------------------------------------------------------------- pieces
    def _test_value(self, i: int) -> float:
        return (999.0 if self.poison else 1.0) + i

    def _p3(self) -> None:
        assign, fams = {}, {}
        for i, n in enumerate(self.names):
            a = SPECS[n][0]
            if a is None:
                continue
            fam = f"fam-{n}"
            assign[fam] = a
            fams[fam] = {"members": [{"dataset_hash": self.dataset(n)}]}
        self.holdout_sha = sha(wjson(self.root / "p3/holdout.json", {"assignment": assign}))
        self.registry_sha = sha(wjson(self.root / "p3/registry.json", {"families": fams}))

    def _denylist(self) -> None:
        doc = {"schema": "jope.dl-v2-holdout-denylist/v1",
               "contexts": [{"view_id": self.view["dw"], "assignment": "heldout"}],
               "object_keys": [DENIED_KEY], "assignment_by_view": {}}
        self.denylist = self.root / "denylist.json"
        self.denylist_sha = sha(wjson(self.denylist, doc))

    def write_exclusion(self, path: Path, exclude: tuple, review: tuple) -> tuple[Path, str]:
        """A jope.dl-v2-linear-determined-exclusion/v1 file; a placeholder view keeps each list non-empty."""
        def ctxs(names, dummy):
            return [{"dataset": self.dataset(n), "view_id": self.view[n], "ols_rel_rmse": 1e-15} for n in names] \
                or [{"dataset": "f" * 16, "view_id": dummy, "ols_rel_rmse": 1e-15}]
        doc = {"schema": exclusions.SCHEMA,
               "exclude": {"flag": exclusions.EXCLUDE_FLAG, "contexts": ctxs(exclude, "ffffffffffffffff__r0__f0__x")},
               "review": {"flag": exclusions.REVIEW_FLAG, "contexts": ctxs(review, "eeeeeeeeeeeeeeee__r0__f0__y")}}
        return path, sha(wjson(path, doc))

    def dataset(self, n: str) -> str:
        return sha(n.encode())[:16]

    def family(self, n: str) -> str | None:
        return None if SPECS[n][0] is None else f"fam-{n}"

    def use(self, n: str) -> str:
        return "train_teacher" if self.variants.get(n) == "dev_as_teacher" else SPECS[n][2]

    def _context(self, i: int, n: str) -> dict:
        rng = np.random.default_rng(1000 + i)
        X_tr = rng.normal(size=(N_TRAIN, P))
        y_tr = (X_tr @ np.array([1.0, -2.0, 0.5]) + rng.normal(scale=0.3, size=N_TRAIN) + 10.0 * i).round(6)
        if self.variants.get(n) == "target_copy":
            X_tr[:, 0] = 2.0 * y_tr + 1.0                              # an affine copy of the target in the features
        prng = np.random.default_rng(9000 + i + (777 if self.poison else 0))
        X_te = prng.normal(size=(N_TEST, P))
        y_te = prng.normal(size=N_TEST) * (50.0 if self.poison else 1.0)
        self.y[n] = [float(v) for v in y_tr]
        raw = jtt1(X_tr, y_tr, X_te, y_te)
        gz = gzip.compress(raw, mtime=0)
        stripped = bytearray(raw)
        end = 17 + N_TRAIN + N_TRAIN * (P + 1) * 8
        for r in range(N_TEST):
            o = end + r * (P + 1) * 8 + P * 8
            stripped[o:o + 8] = struct.pack("<d", 0.0)
        d = self.trees[0] / "shard-0" / self.view[n]
        a0 = np.arange(COMPONENTS["a0"], dtype="<f4") + i
        wbytes(d / "teacher.jtt1.gz", gz)
        wbytes(d / "a0.f32", a0.tobytes())
        wbytes(d / ".done", b"ok\n")
        cdoc = {"schema": "jope.dl-v2-rowsel-raw-context/v1", "context_sha256": self.ctx[n], "view_id": self.view[n],
                "dataset_hash": self.dataset(n), "fold": i % 5, "cohort": "frozen" if i % 2 else "incoming",
                "files": {"teacher.jtt1.gz": {"sha256": sha(gz), "bytes": len(gz), "raw_sha256": sha(raw)},
                          "a0.f32": {"sha256": sha(a0.tobytes()), "bytes": len(a0.tobytes())}}}
        cjb = wjson(d / "context.json", cdoc)
        # PUBLISH tree: dope (+ the same a0); GPU tree: six components
        pd = self.trees[1] / "shard-0" / self.view[n]
        dope = self._npy(np.linspace(0, 1, COMPONENTS["dope"], dtype=np.float32) + i)
        a0b = a0.tobytes() if self.variants.get(n) != "encoding_conflict" else (a0 + 1).astype("<f4").tobytes()
        wbytes(pd / "dope.npy", dope)
        wbytes(pd / "a0.f32", a0b)
        wbytes(pd / ".done", b"ok\n")
        wjson(pd / "context.json", {"context_sha256": self.ctx[n], "view_id": self.view[n],
                                    "files": {"dope.npy": {"sha256": sha(dope), "bytes": len(dope)},
                                              "a0.f32": {"sha256": sha(a0b), "bytes": len(a0b)}}})
        gd = self.trees[2] / "out" / self.view[n]
        files = {}
        for k, comp in enumerate(GPU_COMPONENTS):
            b = self._npy(np.full(COMPONENTS[comp], 0.1 * (k + 1) + i, dtype=np.float32))
            wbytes(gd / f"{comp}.npy", b)
            files[f"{comp}.npy"] = {"sha256": sha(b), "bytes": len(b)}
        if self.variants.get(n) == "encoding_corrupt":
            wbytes(gd / "hyperion.npy", self._npy(np.zeros(COMPONENTS["hyperion"], dtype=np.float32)))
        wbytes(gd / ".done", b"ok\n")
        wjson(gd / "context.json", {"context_sha256": self.ctx[n], "view_id": self.view[n], "files": files})
        a = SPECS[n][0]
        row = {"context_dir": str(d), "context_json_sha256": sha(cjb), "context_sha256": self.ctx[n],
               "cut_id": f"trainonly-split-v2:{sha(n.encode())}", "dataset_hash": self.dataset(n), "fold": i % 5,
               "ledger": SPECS[n][1],
               "p3": {"family_id": self.family(n),
                      "assignment": "train_fit" if self.variants.get(n) == "p3_lie" else a},
               "set": "RIGHTS-RESEARCH-raw-v2/custody" if SPECS[n][1] == "research" else "ROWSEL-RAW-v2",
               "shape": {"n_train": N_TRAIN, "n_test": N_TEST, "p": P, "k": 2},
               "s1_input": {"sha256": sha(bytes(stripped)), "bytes": len(stripped)},
               "teacher": {"path": str(d / "teacher.jtt1.gz"), "gz_sha256": sha(gz), "gz_bytes": len(gz),
                           "raw_sha256": sha(raw), "raw_bytes": len(raw)},
               "use": self.use(n), "view_id": self.view[n]}
        if n == "dk":
            row["teacher_input"] = {"key": DENIED_KEY}
        return row

    @staticmethod
    def _npy(arr: np.ndarray) -> bytes:
        buf = io.BytesIO()
        np.save(buf, arr, allow_pickle=False)
        return buf.getvalue()

    def _record(self, i: int, n: str, ordinal: int, prog: int, status: str) -> dict:
        dsl = DSLS[prog]
        program = {"birth_seq": ordinal, "dsl": dsl, "operator": "grammar_random", "parents": [],
                   "program_sha256": sha(dsl.encode())}
        base = {"schema": T.EVAL_SCHEMA, "input_semantics": "unscaled_fit_rows_v1", "program": program,
                "fold_protocol": T.PROTOCOL, "inner_cv_folds": 2, "context_sha256": self.ctx[n]}
        if status != "completed" or (self.variants.get(n) == "status_lie" and prog == 4):
            rec = {**base, "status": "failed" if status in ("unknown", "completed") else status}
            if status == "unknown":
                rec["unknown_outcome"] = "reserved before an interruption; no committed output; charged"
            return rec
        b = [1.0 + 0.1 * i, 1.1 + 0.1 * i]
        ratio = 1.2 if prog == 6 else 0.6 + 0.03 * prog
        folds = []
        for j in range(2):
            fold = {"kind": "inner_cv", "index": j, "schema": "jope.teacher-fit/v2", "score_rows": N_TRAIN // 2,
                    "train_rows": N_TRAIN // 2, "wall_us": 1000 + 10 * prog + j,
                    "metrics": {"rmse": b[j] * (ratio + 0.01 * j), "mae": 0.5, "n": N_TRAIN // 2},
                    "baseline_metrics": {"rmse": b[j], "n": N_TRAIN // 2},
                    "training_metrics": {"rmse": 0.3}, "predictions": [0.1, 0.2], "targets": [0.3, 0.4]}
            folds.append(fold)
        if self.variants.get(n) == "outer_kind" and prog == 1:
            folds[1]["kind"] = "outer_test"
        rec = {**base, "status": "completed", "inner_cv": folds}
        if self.variants.get(n) == "official_test" and prog == 2:
            rec["official_test"] = {"metrics": {"rmse": 0.01}, "kind": "official_test"}
        if self.variants.get(n) == "fold_test_rmse" and prog == 4:
            folds[0]["test_rmse"] = 0.02
        return rec

    def _final(self, i: int, n: str) -> dict:
        ctx = self.ctx[n]
        hdir = self.host / ctx
        att = [canon({"event": "open", "header_sha256": self.header_sha, "context_sha256": ctx,
                      "ledger": SPECS[n][1], "plan": PLAN, "utc": "2026-10-06T11:00:00Z"})]
        g0, packs, by = [], {}, {}
        for o, (prog, status) in enumerate(ATTEMPTS):
            stage, slot = ("g0", o) if o < PLAN["g0"] else ("gen00", o - PLAN["g0"])
            att.append(canon({"event": "reserve", "ordinal": o, "program_sha256": sha(DSLS[prog].encode()),
                              "slot": slot, "stage": stage, "utc": "2026-10-06T11:00:01Z"}))
            att.append(canon({"event": "finish", "ordinal": o, "status": status, "utc": "2026-10-06T11:00:02Z",
                              "wall_s": 0.5}))
            by[status] = by.get(status, 0) + 1
            rec = self._record(i, n, o, prog, status)
            if o < PLAN["g0"]:
                g0.append(rec)
            else:
                k = o - PLAN["g0"]
                packs[f"gen00/{k:02d}.pack.json.gz"] = gzip.compress(canon(
                    {"schema": T.PACK_SCHEMA, "attempt_id": f"gen00-{k:02d}", "record": rec}), mtime=0)
        if self.variants.get(n) == "wrong_program":
            g0[1] = dict(g0[1], program={**g0[1]["program"], "dsl": DSLS[8], "program_sha256": sha(DSLS[8].encode())})
        files = {"g0-evaluations.json": canon(g0), **packs,
                 "outer-test/score.json": canon({"test_rmse": self._test_value(i),
                                                 "predictions": [self._test_value(i)]})}
        for name, b in files.items():
            wbytes(hdir / name, b)
        if self.variants.get(n) == "tampered_mirror":
            wbytes(hdir / "gen00/01.pack.json.gz", b"tampered")
        attb = b"".join(att)
        digests = {"attempts.jsonl": sha(attb), **{k: sha(v) for k, v in files.items()}}
        digb = canon(digests)
        summary = tar_gz({"attempts.jsonl": attb, "digests.json": digb})
        outer = {"status": "pending", "reason": "poisoned outer-test note" if self.poison else "no scorer at pin"}
        sel_prog = sha(DSLS[0].encode())
        final = {"schema": T.FINAL_SCHEMA, "header_sha256": self.header_sha, "context_sha256": ctx,
                 "view_id": self.view[n], "dataset_hash": self.dataset(n), "fold": i % 5,
                 "set": "RIGHTS-RESEARCH-raw-v2/custody" if SPECS[n][1] == "research" else "ROWSEL-RAW-v2",
                 "ledger": SPECS[n][1], "use": self.use(n), "p3": {"family_id": self.family(n),
                                                                    "assignment": SPECS[n][0]},
                 "cut_id": f"trainonly-split-v2:{sha(n.encode())}", "outcome": "selection_reached",
                 "selection": {"program_sha256": sel_prog, "fitness": -0.3, "cv_geomean_rmse_ratio": 0.7,
                               "leader_test_rmse_field": None},
                 "attempts": {"charged": len(ATTEMPTS), "finished": len(ATTEMPTS), "by_status": by,
                              "recovered_after_interruption": 1, "attempts_jsonl_sha256": sha(attb)},
                 "outer_test": outer, "digests_sha256": sha(digb), "summary_tar_gz_sha256": sha(summary),
                 "summary_bytes": len(summary), "host": "xbabe3", "unit": "u1"}
        if self.variants.get(n) == "final_outer_numeric":
            final["outer_test"] = {"status": "scored", "rmse": self._test_value(i)}
        fb = wjson(self.prod / "contexts" / ctx / "final.json", final)
        wbytes(self.prod / "contexts" / ctx / "summary.tar.gz", summary)
        wjson(self.prod / "contexts" / ctx / "outer-test.json", {"test_rmse": self._test_value(i)})
        return {"event": "final", "context_sha256": ctx, "view_id": self.view[n], "set": final["set"],
                "cut_id": final["cut_id"], "use": self.use(n), "host": "xbabe3", "unit": "u1",
                "outcome": "selection_reached", "attempts": {"charged": len(ATTEMPTS), "by_status": by},
                "selected_program_sha256": sel_prog, "selected_fitness": -0.3, "selected_cv_ratio": 0.7,
                "g0_unique_eligible": 5, "outer_test": final["outer_test"], "final_sha256": sha(fb),
                "summary_sha256": sha(summary), "host_custody": f"xbabe3:{hdir}", "utc": "2026-10-06T11:05:00Z"}

    # ------------------------------------------------------------------------------------------------- ledgers
    def base_rows(self, ledger: str) -> list[dict]:
        rows = [{"event": "open", "header_sha256": self.header_sha, "ledger": ledger, "utc": "2026-10-06T10:00:00Z"}]
        for i, n in enumerate(self.names):
            if SPECS[n][1] != ledger:
                continue
            if n == "pd":
                rows.append({"event": "defer", "context_sha256": self.ctx[n], "view_id": self.view[n],
                             "reason": "ordering", "utc": "x"})
                rows.append({"event": "release", "context_sha256": self.ctx[n], "view_id": self.view[n],
                             "reason": "ordering", "utc": "x"})
            rows.append({"event": "assign", "context_sha256": self.ctx[n], "view_id": self.view[n], "use": self.use(n),
                         "host": "xbabe3", "charge": 1248, "utc": "x"})
            rows.append({"event": "outer_test_score", "context_sha256": self.ctx[n],
                         "test_rmse": self._test_value(i), "official_test": {"rmse": self._test_value(i)}})
        return rows

    def write_ledgers(self, finals: list[str] | None = None) -> None:
        finals = [n for n in self.names if n in self.finals] if finals is None else finals
        for ledger in ("production", "research"):
            rows = self.base_rows(ledger) + [self.finals[n] for n in finals if SPECS[n][1] == ledger]
            wbytes(self.prod / f"ledger-{ledger}.jsonl", b"".join(canon(r) for r in rows))

    def append(self, ledger: str, data: bytes) -> None:
        with (self.prod / f"ledger-{ledger}.jsonl").open("ab") as f:
            f.write(data)

    def append_final(self, n: str) -> None:
        self.append(SPECS[n][1], canon(self.finals[n]))

    def config(self, out: Path, **kw) -> T.TailConfig:
        base = dict(ledger_dir=self.prod, out_dir=out, denylist=self.denylist, denylist_sha256=self.denylist_sha,
                    exclusion=self.exclusion, exclusion_sha256=self.exclusion_sha,
                    evaluation_roots=(self.host,), encoding_trees=self.trees)
        base.update(kw)
        return T.TailConfig(**base)


def build_fixture_out(tmpdir) -> tuple[Path, Path, str, Path, str]:
    """Shared fixture (also used by tests/test_p8_trainer.py): a production-shaped S1 world under a new directory in
    `tmpdir`, tailed once. Returns (out_dir, denylist, denylist_sha256, exclusion_path, exclusion_sha256). out_dir
    holds shards for t1 (train_fit), t2 (train_nonpool), t3 (research ledger, review-flagged) and dv (dev); the
    exclusion lists one placeholder view. Shard components: a0 dope hyperion hyperion_v6 foundation target
    context2048 tabpfn35 (use ["a0", "hyperion_v6"]; hyperion_v6all needs spec encoding_sets)."""
    root = Path(tempfile.mkdtemp(prefix="s1tail-fixture-", dir=str(tmpdir)))
    fx = Fixture(root / "w", review=("t3",))
    fx.write_ledgers(finals=["t1", "t2", "t3", "dv"])
    out = root / "out"
    T.S1Tail(fx.config(out)).poll()
    return out, fx.denylist, fx.denylist_sha, fx.exclusion, fx.exclusion_sha


