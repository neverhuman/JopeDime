def sha(b):
    return hashlib.sha256(b).hexdigest()


def load_custody(path, name):
    assert sha(path.read_bytes()) == path.name.rsplit(".", 1)[1], path
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(mod)
    return mod


def strip(d, keys=VOLATILE):
    return {k: v for k, v in d.items() if k not in keys}


class DiskDataset:
    """The on-disk inputs load_dataset reads (manifest, T1 blobs, registry split, membership, T1 meta) for a fixture
    matrix, with the I/O routing functions patched on the given builder module(s)."""

    def __init__(self, root: Path, m, folds=None):
        self.root = root
        ls = tb.lines_of(m)
        self.tr, self.te = b"\n".join(ls[:tb.NTR]) + b"\n", b"\n".join(ls[tb.NTR:]) + b"\n"
        n = len(ls)
        folds = folds or t2.REGISTRY_FOLDS
        blob = root / "blobs"; blob.mkdir(parents=True)
        for b in (self.tr, self.te):
            (blob / sha(b)).write_bytes(b)
        self.blob = blob
        split = {"schema": rb.SPLIT_SCHEMA, "method": rb.SPLIT_METHOD, "effective_folds": 5,
                 "source": {"dataset_hash": H, "train_sha256": sha(self.tr), "test_sha256": sha(self.te),
                            "train_rows": tb.NTR, "test_rows": n - tb.NTR},
                 "folds": [{"repeat": 0, "fold": f, "seed": 1, "test_indices": sorted(folds[f])} for f in range(5)]}
        self.split_body = json.dumps(split).encode()
        memb = {"ordered_source_row_ids": rowsel.t1_v1_source_row_ids(H, self.tr, self.te),
                "folds": [{"repeat": 0, "fold": f, "test_indices": sorted(folds[f])} for f in range(5)]}
        mg = gzip.compress(json.dumps(memb).encode(), mtime=0)
        (root / "membership.json.gz").write_bytes(mg)
        manifest = {"dataset_hash": H,
                    "source": {"train": {"sha256": sha(self.tr), "bytes": len(self.tr)}, "test": {"sha256": sha(self.te), "bytes": len(self.te)},
                               "split": {"sha256": sha(self.split_body), "version_id": "fixture", "key": "fixture"}},
                    "split_policy": {"parent_split": {"sha256": sha(self.split_body)}}, "shape": {"columns": 6, "source_rows": n},
                    "objects": {"membership": {"sha256": sha(mg), "bytes": len(mg)}},
                    "selected_source_indices_sha256": rowsel.selected_source_indices_sha256(list(range(n)))}
        mb = json.dumps(manifest).encode()
        (root / "manifest.json").write_bytes(mb)
        self.refs = {"manifest_sha256": sha(mb), "membership_sha256": sha(mg), "data_sha256": "f" * 64}
        meta = json.dumps(tb.META).encode()
        self.meta_dir = root / "meta"; self.meta_dir.mkdir()
        (self.meta_dir / f"{sha(meta)}.json").write_bytes(meta)
        self.inv = {"meta_key": {H: f"blobs/sha256/{sha(meta)}"}}
        self.rows = tb.epoch_rows(H, range(4))

    def patches(self, mod):
        return [mock.patch.object(mod.scale_check, "resolve_context", lambda r, src, cache: {"refs": dict(self.refs)}),
                mock.patch.object(mod, "lineage_route", lambda cohort, row, msha, memb: (self.root / "manifest.json", self.blob,
                                                                                         self.root / "membership.json.gz")),
                mock.patch.object(mod, "load_split", lambda cohort, h, sref: (self.split_body, {"path": "fixture", "source": "fixture"})),
                mock.patch.object(mod, "META_DIR", self.meta_dir)]

    def load(self, mod, **kw):
        ps = self.patches(mod)
        for p in ps:
            p.start()
        try:
            return mod.load_dataset(H, self.rows, None, None, self.inv, **kw)
        finally:
            for p in ps:
                p.stop()


class Spy:
    """rowsel.sampler_select wrapper recording whether a call fitted on every universe position; raise_on_all makes
    such a call fail (the must-fail control)."""

    def __init__(self, raise_on_all=False):
        self.orig, self.calls, self.raise_on_all = rowsel.sampler_select, [], raise_on_all

    def __call__(self, universe, positions, *a, **k):
        allpos = sorted(int(p) for p in positions) == sorted(int(p) for p in universe.positions)
        self.calls.append(allpos)
        if allpos and self.raise_on_all:
            raise AssertionError("sampler_select fitted on every universe position (all-row targets)")
        return self.orig(universe, positions, *a, **k)

    def all_position_calls(self):
        return sum(self.calls)


