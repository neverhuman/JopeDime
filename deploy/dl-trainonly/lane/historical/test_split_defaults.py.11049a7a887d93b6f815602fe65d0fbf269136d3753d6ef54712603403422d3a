class PortCheck(Base):
    def test_v1_port_check_must_be_given(self):
        """Refused before any read (not a lineage RebuildError further in), and nothing is fitted."""
        disk = DiskDataset(self.dir / "in", tb.fixture_matrix())
        spy = Spy()
        for kw in ({}, {"v1_port_check": None}):
            with mock.patch.object(rowsel, "sampler_select", spy), \
                    mock.patch.object(rb.scale_check, "resolve_context", side_effect=AssertionError("read before the check")):
                with self.assertRaises(ValueError) as cm:
                    rb.load_dataset(H, disk.rows, None, None, disk.inv, **kw)
            self.assertIs(type(cm.exception), ValueError)
            self.assertIn("v1_port_check must be given", str(cm.exception))
        self.assertEqual(spy.calls, [])

    def test_the_registry_replay_passes_v1_port_check_true(self):
        """build() of --split-version registry hands build_shard a loader that runs the v1 port; build_v2 does not."""
        loaders, kws = [], []
        src = mock.Mock(); src.included.return_value = []
        inv = self.dir / "inv.json"; inv.write_text("{}")
        shard_rec = {k: 0 for k in ("shard", "expected", "built_now", "already_done", "done", "done_by_label", "failed_by_reason",
                                    "cpu_s", "elapsed_s")} | {"complete": True}
        with mock.patch.object(rb.scale_check, "Sources", lambda load_index: src), \
                mock.patch.object(rb.scale_check, "DataCache", lambda max_items: None), mock.patch.object(rb, "DATASETS_INV", inv), \
                mock.patch.object(rb, "load_scope", lambda rows, scope: ([], {}, {})), mock.patch.object(rb, "input_refs", lambda r: {}), \
                mock.patch.object(rb, "build_shard", lambda out, shard, of, scope, loader, codes, refs: loaders.append(loader) or shard_rec), \
                mock.patch("builtins.print"):
            rc = rb.build(argparse.Namespace(out=str(self.dir), shard=0, of=1, scope="incoming-kmeans", datasets=None))
        self.assertEqual((rc, len(loaders)), (0, 1))
        with mock.patch.object(rb, "load_dataset", lambda *a, **k: kws.append(k) or {}):
            loaders[0](H, [])
        self.assertEqual(kws, [{"v1_port_check": True}])

    def test_only_the_registry_replay_fits_the_sampler_on_every_row(self):
        disk = DiskDataset(self.dir / "in", tb.fixture_matrix())
        spy = Spy()
        with mock.patch.object(rowsel, "sampler_select", spy):
            ds = disk.load(rb, v1_port_check=False)
        self.assertEqual(spy.all_position_calls(), 0)
        self.assertEqual({k: ds["lineage"][k] for k in PORT_FIELDS + (REASON_KEY,)},
                         {"port_reproduces_v1_selection": None, "port_fit_cpu_s": None, REASON_KEY: rb.PORT_NOT_RUN})
        self.assertEqual(rb.PORT_NOT_RUN, "not run: registry replay only (all-row targets; #218 finding 3)")
        with mock.patch.object(rowsel, "sampler_select", spy):
            ds = disk.load(rb, v1_port_check=True)
        self.assertEqual(spy.all_position_calls(), 1)
        self.assertIsInstance(ds["lineage"]["port_reproduces_v1_selection"], bool)
        self.assertNotIn(REASON_KEY, ds["lineage"])

