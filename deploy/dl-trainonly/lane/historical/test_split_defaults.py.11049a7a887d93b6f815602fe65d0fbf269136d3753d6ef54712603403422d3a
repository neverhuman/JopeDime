class RawDefaults(Base):
    def test_the_raw_cli_defaults_to_split_v2(self):
        seen = []
        for cmd, fn in (("plan", "plan"), ("summarize", "summarize")):
            with mock.patch.object(traw.tool, fn, lambda a: seen.append(a.split_version) or 0):
                traw.tool.main([cmd, "--out", str(self.dir)])
        with mock.patch.object(traw.tool, "build", lambda a: seen.append(a.split_version) or 0):
            traw.tool.main(["build", "--out", str(self.dir), "--shard", "0"])
        with mock.patch.object(traw.tool, "plan", lambda a: seen.append(a.split_version) or 0):
            traw.tool.main(["plan", "--out", str(self.dir), "--split-version", traw.tool.SPLIT_V1])
        self.assertEqual(seen, [traw.tool.SPLIT_V2] * 3 + [traw.tool.SPLIT_V1])

    def test_the_coverage_cli_defaults_to_split_v2(self):
        seen = []
        with mock.patch.object(traw.cov, "plan", lambda a: seen.append((a.split_version, a.out)) or 0):
            traw.cov.main(["plan"])
        self.assertEqual(seen, [(traw.tool.SPLIT_V2, str(traw.cov.OUT_V2))])

    def run_both(self, e, explicit):
        old = load_custody(RAW_BEFORE, "v2_rowsel_raw_28be7f98")
        outs = {}
        for name, mod, kw in (("old", old, {}), ("new", traw.tool, {"split_version": explicit})):
            shard = self.dir / name / "shard-0"; shard.mkdir(parents=True)
            with mock.patch.object(mod, "load_inputs", traw.fake_inputs), mock.patch.object(mod, "rematch", traw.fake_rematch):
                outs[name] = (mod.run_dataset(dict(e), shard, {"tools/v2_rowsel_raw.py": "1" * 64}, None, None, None, set(),
                                              traw._Guard(), log=lambda s: None, **kw), shard)
        return outs

    def assert_same_build(self, outs, linear_gate):
        """Byte-identical except, on the v2 path, the LINEAR-DETERMINED result added by name (v1 replay: nothing added)."""
        (a, sa), (b, sb) = outs["old"], outs["new"]
        self.assertEqual(a["status"], "done", a.get("detail"))
        self.assertEqual(strip(a, VOLATILE + ("contexts",)), strip(b, VOLATILE + ("contexts",)))
        self.assertEqual([LINEAR_KEY in c for c in b["contexts"]], [linear_gate] * len(b["contexts"]))
        self.assertEqual([strip(c) for c in a["contexts"]], [strip(c, VOLATILE + (LINEAR_KEY,)) for c in b["contexts"]])
        for c in a["contexts"]:
            da, db = sa / c["view_id"], sb / c["view_id"]
            self.assertEqual(sorted(x.name for x in da.iterdir()), sorted(x.name for x in db.iterdir()))
            for f in da.iterdir():
                if f.name == "context.json":
                    cb = json.loads((db / f.name).read_bytes())
                    self.assertEqual(LINEAR_KEY in cb, linear_gate)
                    self.assertEqual(strip(json.loads(f.read_bytes())), strip(cb, VOLATILE + (LINEAR_KEY,)))
                else:
                    self.assertEqual(f.read_bytes(), (db / f.name).read_bytes(), f.name)

    def test_the_explicit_v1_replay_builds_28be7f98s_bytes(self):
        self.assert_same_build(self.run_both(traw.plan_entry(), traw.tool.SPLIT_V1), linear_gate=False)

    def test_the_v2_path_builds_28be7f98s_bytes(self):
        e = dict(traw.plan_entry(), split_version=traw.tool.SPLIT_V2)
        self.assert_same_build(self.run_both(e, traw.tool.SPLIT_V2), linear_gate=True)


