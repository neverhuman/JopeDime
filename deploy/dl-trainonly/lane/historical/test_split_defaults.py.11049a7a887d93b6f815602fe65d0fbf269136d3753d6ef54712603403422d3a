class V2Path(Base):
    """build_v2 end to end (scope, guard and inventory stubbed; load_dataset real on disk inputs): no sampler fit over
    every universe position on the v2 or the v2g path."""

    def run_build_v2(self, tree, entry_extra, m):
        out = self.dir / tree; out.mkdir()
        e0 = [{"view_id": r["view_id"], "context_sha256": r["context_sha256"], "fold": r["fold"]} for r in tb.epoch_rows(H, range(4))]
        e = dict({"dataset_hash": H, "label": "clean", "epoch0": e0, "shard": 0, "est_cpu_s": 1.0,
                  "registry_grouping": {"registry_grouped_by_feature_column": bool(entry_extra)}}, **entry_extra)
        version = rb.tree_cfg(tree)["version"]
        (out / "plan.json").write_text(json.dumps({"of": 1, "tree": tree, "split_version": version, "counts": {"datasets": 1},
                                                   "owner_line": "fixture", "datasets": [e]}))
        disk = DiskDataset(self.dir / f"in-{tree}", m)
        inv = self.dir / f"inv-{tree}.json"; inv.write_text(json.dumps(disk.inv))
        its = tb.items(H, "clean", folds=range(4))
        src = mock.Mock(); src.included.return_value = []
        loads = []
        real = rb.load_dataset

        def spy_load(*a, **k):
            loads.append(k.get("v1_port_check"))
            return real(*a, **k)
        spy = Spy(raise_on_all=True)
        ps = disk.patches(rb) + [mock.patch.object(rb.scale_check, "Sources", lambda load_index: src),
                                 mock.patch.object(rb.scale_check, "DataCache", lambda max_items: None),
                                 mock.patch.object(rb, "DATASETS_INV", inv),
                                 mock.patch.object(rb, "load_tree_scope", lambda rows, t, *rest: ({H: its}, {}, {"datasets": 1})),
                                 mock.patch.object(rb, "input_refs", lambda r: dict(tb.REFS)),
                                 mock.patch.object(rb, "guard", lambda: 0), mock.patch.object(rb, "check_cap_label", lambda ds, acq: None),
                                 mock.patch.object(rb, "load_dataset", spy_load), mock.patch.object(rowsel, "sampler_select", spy)]
        for p in ps:
            p.start()
        try:
            rc = rb.build_v2(argparse.Namespace(out=str(out), tree=tree, of=1, shard=0, split_version=version, datasets=None))
        finally:
            for p in ps:
                p.stop()
        rec = json.loads((out / "shard-0" / "_datasets" / f"{H}.json").read_bytes())
        return rc, rec, loads, spy

    def test_v2_build_never_fits_on_every_row(self):
        rc, rec, loads, spy = self.run_build_v2("kmeans-clean", {}, tb.fixture_matrix())
        self.assertEqual((rc, rec["status"], loads, spy.all_position_calls()), (0, "done", [False], 0), rec.get("detail"))
        self.assertGreater(len(spy.calls), 0)                              # the per-fold selector did run (on fit rows)
        self.assertEqual((rec["lineage"]["port_reproduces_v1_selection"], rec["lineage"][REASON_KEY]), (None, rb.PORT_NOT_RUN))

    def test_v2g_build_never_fits_on_every_row(self):
        extra = {"disposition": "build", "group_column": tg.SPEC, "group_source": "fixture", "replaces_v2split": tg.REPL,
                 "group_evidence": {"reproducing": [tg.GCOL]}, "empty_folds": [], "effective_folds": 5}
        rc, rec, loads, spy = self.run_build_v2("kmeans-clean-groups", extra, tg.M)
        self.assertEqual((rc, rec["status"], loads, spy.all_position_calls()), (0, "done", [False], 0), rec.get("detail"))
        self.assertIsNone(rec["group_target_tie"])


class BeforeAfter(Base):
    """The same disk inputs built by custody fcfe3828 (before) and by this version (after)."""

    def build(self, mod, ds, prof, shard):
        shard.mkdir(parents=True)
        its = tb.items(H, "clean", folds=range(4))
        return mod.build_dataset_v2(ds, its, shard, tb.CODES, dict(tb.REFS), budget=tb.BUDGET, profile=prof,
                                    extra={"registry_grouping": {"registry_grouped_by_feature_column": True}})

    def compare(self, m, prof_of):
        old = load_custody(BUILD_BEFORE, "v2_rowsel_build_fcfe3828")
        disk = DiskDataset(self.dir / "in", m)
        ds_old, ds_new = disk.load(old), disk.load(rb, v1_port_check=False)
        a = self.build(old, ds_old, prof_of(old), self.dir / "before")
        b = self.build(rb, ds_new, prof_of(rb), self.dir / "after")
        self.assertEqual((a["status"], b["status"]), ("done", "done"), (a.get("detail"), b.get("detail")))
        self.assertEqual([(c["view_id"], c["context_sha256"]) for c in a["contexts"]], [(c["view_id"], c["context_sha256"]) for c in b["contexts"]])
        self.assertEqual((a["cut"], a["split"]), (b["cut"], b["split"]))                    # cut_id and every gate
        la, lb = dict(a["lineage"]), dict(b["lineage"])
        self.assertEqual(lb.pop(REASON_KEY), rb.PORT_NOT_RUN)
        self.assertEqual({k: lb[k] for k in PORT_FIELDS}, {"port_reproduces_v1_selection": None, "port_fit_cpu_s": None})
        self.assertIsInstance(la["port_reproduces_v1_selection"], bool)
        self.assertEqual(strip(la, PORT_FIELDS), strip(lb, PORT_FIELDS))
        rec_keys = VOLATILE + ("contexts", "lineage", "group_target_tie")
        self.assertEqual(strip(a, rec_keys), strip(b, rec_keys))
        self.assertIsNone(b.get("group_target_tie"))
        self.assertEqual([strip(c) for c in a["contexts"]], [strip(c, VOLATILE + (LINEAR_KEY,)) for c in b["contexts"]])
        for c in a["contexts"]:
            da, db = self.dir / "before" / c["view_id"], self.dir / "after" / c["view_id"]
            for f in ("encoder.jtt1.gz", "teacher.jtt1.gz", "a0.f32", ".done"):
                self.assertEqual((da / f).read_bytes(), (db / f).read_bytes(), f)
            ca, cb = (json.loads((x / "context.json").read_bytes()) for x in (da, db))
            lca, lcb = ca["rowsel"].pop("lineage"), cb["rowsel"].pop("lineage")
            self.assertEqual(lcb.pop(REASON_KEY), rb.PORT_NOT_RUN)
            self.assertEqual((lcb["port_reproduces_v1_selection"], type(lca["port_reproduces_v1_selection"])), (None, bool))
            self.assertEqual(strip(lca, PORT_FIELDS), strip(lcb, PORT_FIELDS))
            self.assertIsNone(cb[LINEAR_KEY]["verdict"])
            self.assertEqual(strip(ca), strip(cb, VOLATILE + (LINEAR_KEY,)))

    def test_v2(self):
        self.compare(tb.fixture_matrix(), lambda mod: mod.PROFILE_V2)

    def test_v2g(self):
        self.compare(tg.M, lambda mod: mod.profile_v2g(tg.GCOL, tg.GNAME, tg.REPL))


