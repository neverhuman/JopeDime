        rec = [json.loads(v[-1][1]) for (_, k), v in self.bucket.objects.items() if "/receipts/" in k]
        self.assertTrue(rec and all(r["t1_fallback"] == fb and r["row_selection_leak"] == ["acquisition_cap"] for r in rec))
