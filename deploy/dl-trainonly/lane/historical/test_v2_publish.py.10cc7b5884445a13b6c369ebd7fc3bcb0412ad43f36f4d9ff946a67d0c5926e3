SRC = Path(__file__).resolve().parents[1]
_spec = importlib.util.spec_from_file_location("v2_publish", SRC / "tools" / "v2_publish.py")
vp = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(vp)

V, P = s3io.V2_PREFIX_KEY, s3io.PREFIX_KEY
CODES = {"dltrain/t1prep.py": "1" * 64, "tools/v2_build_local.py": "2" * 64}


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def make_context(shard: Path, ds: str, fold: int = 0, files=None, split_seed=None, **over) -> Path:
    files = files if files is not None else {"encoder.jtt1.gz": os.urandom(64), "teacher.jtt1.gz": os.urandom(48), "a0.f32": os.urandom(16)}
    view = over.pop("view_id", f"{ds}__r0__f{fold}")
    d = shard / view
    d.mkdir(parents=True)
    for name, body in files.items():
        (d / name).write_bytes(body)
    seed = split_seed or f"{ds}{fold}"
    ctx = {"schema": vp.CONTEXT_SCHEMA, "view_id": view, "dataset_hash": ds, "fold": fold, "context_sha256": sha(f"ctx{seed}".encode()),
           "outer_train_indices_sha256": sha(f"tr{seed}".encode()), "outer_test_indices_sha256": sha(f"te{seed}".encode()),
           "n_train": 10, "n_test": 3, "scaler_sha256": sha(f"sc{seed}".encode()), "inner_labels_sha256": sha(b"il"),
           "t1_meta_sha256": sha(b"meta"), "values_mode": "L7b", "published": False, "code_sha256": dict(CODES), "utc_us": 1, "row_selection_leak": ["clean"],
           "files": {n: {"sha256": sha(b), "bytes": len(b)} for n, b in files.items()}}
    ctx.update(over)
    (d / "context.json").write_text(json.dumps(ctx, sort_keys=True) + "\n")
    (d / ".done").write_bytes(b"ok\n")
    return d


class _Base(unittest.TestCase):
    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp(prefix="v2pub-"))
        self.build = self.tmp / "build"
        self.shard = self.build / "shard-0"
        self.shard.mkdir(parents=True)
        self.budget_path = self.tmp / "s3-v2-ledger.jsonl"
        self.ledger_path = self.tmp / "publish-ledger.jsonl"
        self.bucket = vp.FakeBucket()
        self.rights_ds = set()
        self.assertNotEqual(self.budget_path.resolve(), s3io.V2_LEDGER_PATH.resolve())

    def tearDown(self):
        shutil.rmtree(self.tmp)

    def run_once(self, limit=None, workers=1):
        writer, reader, _ = vp.fake_clients(self.budget_path, self.bucket)
        ledger = vp.PublishLedger(self.ledger_path)
        try:
            return vp.run(self.build, writer, reader, ledger, writer._dltrain_guard.ledger, limit=limit, workers=workers)
        finally:
            ledger.close()

    def ledger_records(self):
        return [json.loads(x) for x in self.ledger_path.read_bytes().splitlines()]

    def body(self, key):
        return self.bucket.objects[(s3io.BUCKET, key)][-1][1]

    def assert_layout(self):
        for key in self.bucket.keys():
            self.assertTrue(key.startswith(V), key)
            self.assertFalse(key.startswith(P), key)
            self.assertEqual(len(self.bucket.objects[(s3io.BUCKET, key)]), 1, f"{key} has more than one version")
            self.assertEqual(any(f"/{c}/" in key for c in ("tabpfn35", "target", "context2048")) or key.split("/")[-3] in self.rights_ds,
                             key.startswith(s3io.V2_RESEARCH_ONLY_KEY), key)
        for op, key, _ in self.bucket.calls:
            self.assertIn(op, ("PutObject", "GetObject"))
            self.assertTrue(key.startswith(V), key)


class PublishLayout(_Base):
    def test_keys_receipts_readback_and_research_only(self):
        ds_a, ds_b = "0123456789abcdef", "fedcba9876543210"
        make_context(self.shard, ds_a, 0)
        files_b = {"encoder.jtt1.gz": b"enc", "a0.f32": b"\x00" * 8, "hyperion.npy": b"hyp", "tabpfn35.npy": b"tabpfn-research"}
        make_context(self.shard, ds_b, 3, files=files_b)
        doc = self.run_once()
        self.assertEqual(doc["verdict"], "PASS", json.dumps(doc, default=str)[:3000])
        self.assert_layout()
        c12 = sha(common.canonical(CODES))[:12]
        stem_b = f"{ds_b}/f3/{sha(f'tr{ds_b}3'.encode())[:12]}-{sha(f'sc{ds_b}3'.encode())[:12]}-{c12}"
        expected = {f"{V}inputs/jtt1-encoder/{stem_b}.jtt1.gz", f"{V}encodings/a0/{stem_b}.f32", f"{V}encodings/hyperion/{stem_b}.npy",
                    f"{V}research-only/encodings/tabpfn35/{stem_b}.npy", f"{V}receipts/jtt1-encoder/{stem_b}.json",
                    f"{V}receipts/a0/{stem_b}.json", f"{V}receipts/hyperion/{stem_b}.json", f"{V}research-only/receipts/tabpfn35/{stem_b}.json"}
        keys = set(self.bucket.keys())
        self.assertTrue(expected <= keys, expected - keys)
        self.assertEqual(len(keys), 2 * (3 + 4))
        tab_key = f"{V}research-only/encodings/tabpfn35/{stem_b}.npy"
        self.assertEqual(self.body(tab_key), b"tabpfn-research")
        with self.assertRaises(s3io.ResearchOnlyRefused):
            s3io.assert_production_loadable(tab_key)
        with self.assertRaises(s3io.ResearchOnlyRefused):
            s3io.assert_production_loadable(f"{V}research-only/receipts/tabpfn35/{stem_b}.json")
        s3io.assert_production_loadable(f"{V}encodings/hyperion/{stem_b}.npy")
        for comp, okey, ext in (("tabpfn35", tab_key, None), ("hyperion", f"{V}encodings/hyperion/{stem_b}.npy", None)):
            rkey = (f"{V}research-only/receipts/" if comp == "tabpfn35" else f"{V}receipts/") + f"{comp}/{stem_b}.json"
            rec = json.loads(self.body(rkey))
            vid, obody = self.bucket.objects[(s3io.BUCKET, okey)][0]
            self.assertEqual((rec["key"], rec["version_id"], rec["sha256"], rec["bytes"]), (okey, vid, sha(obody), len(obody)))
            self.assertEqual(rec["production_loader_allowed"], comp != "tabpfn35")
            self.assertEqual((rec["dataset_hash"], rec["fold"], rec["code12"], rec["values_mode"]), (ds_b, 3, c12, "L7b"))
        gets = [c for c in self.bucket.calls if c[0] == "GetObject"]
        self.assertEqual(len(gets), len(keys))
        self.assertTrue(all(c[2] for c in gets), "every readback pins a VersionId")
        recs = self.ledger_records()
        self.assertEqual(sum(r["event"] == "verified" for r in recs), len(keys))
        self.assertEqual(sum(r["event"] == "context_done" for r in recs), 2)
        total = sum(len(vs[0][1]) for vs in self.bucket.objects.values())
        self.assertEqual(s3io.V2Ledger(self.budget_path).usage()["used_bytes"], total)
        self.assertEqual(doc["budget_after"]["used_bytes"], total)
        for ctx_dir in self.shard.iterdir():   # the build tree is never modified
            self.assertFalse(json.loads((ctx_dir / "context.json").read_text())["published"])

    def test_resume_verifies_by_get_and_never_reputs(self):
        for i in range(3):
            make_context(self.shard, f"{i:016x}", i)
        self.assertEqual(self.run_once()["verdict"], "PASS")
        puts, budget = len(self.bucket.puts()), self.budget_path.read_bytes()
        self.bucket.calls.clear()
        doc = self.run_once()
        self.assertEqual(doc["verdict"], "PASS")
        self.assertEqual(self.bucket.puts(), [], "a resumed run must not PUT verified objects again")
        gets = [c for c in self.bucket.calls if c[0] == "GetObject"]
        self.assertEqual(len(gets), puts)
        self.assertTrue(all(c[2] for c in gets))
        self.assertEqual(doc["publish"]["stats"], {"object_verified_existing": 9, "receipt_verified_existing": 9, "contexts_done": 3})
        self.assertEqual(self.budget_path.read_bytes(), budget, "no new budget reservations on resume")
        self.assert_layout()

    def test_interrupted_put_resumes_create_only(self):
        make_context(self.shard, "0123456789abcdef", 0)
        make_context(self.shard, "1123456789abcdef", 1)
        plan = vp.scan_context(self.shard / "0123456789abcdef__r0__f0")
        key = plan["objects"][0]["key"]
        self.bucket.put_faults[key] = [("after", botocore.exceptions.ReadTimeoutError(endpoint_url="https://x"))]
        doc = self.run_once()
        self.assertEqual(doc["verdict"], "INCOMPLETE")
        self.assertEqual([f["view_id"] for f in doc["failed"]], ["0123456789abcdef__r0__f0"])
        self.assertEqual([r["event"] for r in self.ledger_records() if r.get("key") == key], ["intent", "failed"])
        doc = self.run_once()
        self.assertEqual(doc["verdict"], "PASS", json.dumps(doc["failed"]))
        self.assertEqual(doc["publish"]["stats"]["object_already_present_equal_bytes"], 1)
        verified = [r for r in self.ledger_records() if r.get("key") == key and r["event"] == "verified"]
        self.assertEqual(len(verified), 1)
        self.assertEqual(verified[0]["version_id"], self.bucket.objects[(s3io.BUCKET, key)][0][0])
        self.assertIn(("GetObject", key, verified[0]["version_id"]), self.bucket.calls, "412-equal is pinned by an exact-version GET")
        self.assert_layout()

    def test_workers_publish_the_same_keys(self):
        for i in range(6):
            make_context(self.shard, f"{i:016x}", i % 5)
        doc = self.run_once(workers=4)
        self.assertEqual(doc["verdict"], "PASS")
        self.assertEqual(len(self.bucket.keys()), 36)
        self.assert_layout()

    def test_limit_selects_first_contexts(self):
        for i in range(4):
            make_context(self.shard, f"{i:016x}", 0)
        doc = self.run_once(limit=2)
        self.assertEqual((doc["scan"]["contexts_selected"], doc["contexts_done_in_selection"], doc["verdict"]), (2, 2, "PASS"))
        self.assertEqual({k.split("/")[-3] for k in self.bucket.keys()}, {f"{0:016x}", f"{1:016x}"})


class Refusals(_Base):
    def _refused(self, doc):
        return {r["view_id"]: r["reason"] for r in doc["scan"]["refused"]}

    def test_bad_contexts_are_refused_before_any_put(self):
        good = make_context(self.shard, "a" * 16, 0)
        make_context(self.shard, "b" * 16, 0, published=True)
        d = make_context(self.shard, "c" * 16, 0)
        (d / "a0.f32").write_bytes(b"tampered-after-build")                  # hash and size differ
        d = make_context(self.shard, "d" * 16, 0)
        raw = (d / "a0.f32").read_bytes()
        (d / "a0.f32").write_bytes(bytes([raw[0] ^ 1]) + raw[1:])              # same size, different hash
        d = make_context(self.shard, "e" * 16, 0)
        (d / ".done").unlink()
        make_context(self.shard, "f" * 16, 0, files={"a0.f32": b"x", "extra.bin": b"y"})
        d = make_context(self.shard, "1" * 16, 0)
        (d / "stray.tmp").write_bytes(b"z")
        d = make_context(self.shard, "2" * 16, 0)
        (d / "a0.f32").unlink()
        (d / "a0.f32").symlink_to(good / "a0.f32")
        make_context(self.shard, "3" * 16, 0, dataset_hash="XYZ")
        make_context(self.shard, "5" * 16, 0, schema="jope.other/v1")
        d = make_context(self.shard, "6" * 16, 0)
        ctx = json.loads((d / "context.json").read_text())
        del ctx["published"]
        (d / "context.json").write_text(json.dumps(ctx))
        make_context(self.shard, "7" * 16, 0, published="false")
        doc = self.run_once()
        self.assertEqual(self._refused(doc), {
            "b" * 16 + "__r0__f0": "published_flag", "c" * 16 + "__r0__f0": "hash_mismatch", "d" * 16 + "__r0__f0": "hash_mismatch",
            "e" * 16 + "__r0__f0": "not_done", "f" * 16 + "__r0__f0": "unknown_file", "1" * 16 + "__r0__f0": "unlisted_files",
            "2" * 16 + "__r0__f0": "missing_file", "3" * 16 + "__r0__f0": "context_field", "5" * 16 + "__r0__f0": "context_schema",
            "6" * 16 + "__r0__f0": "published_flag", "7" * 16 + "__r0__f0": "published_flag"})
        self.assertEqual(doc["verdict"], "INCOMPLETE")
        self.assertEqual({k.split("/")[-3] for k in self.bucket.keys()}, {"a" * 16}, "only the good context was published")
        self.assert_layout()

    def test_values_mode_and_row_selection_gate(self):
        make_context(self.shard, "a" * 16, 0)                                                         # L7b, clean
        make_context(self.shard, "b" * 16, 0, schema="jope.dl-v2-l7a-context/v1", values_mode="L7a", admitted_values_mode="L7a")
        make_context(self.shard, "c" * 16, 0, schema="jope.dl-v2-l7a-context/v1")                    # L7a schema, L7b values
        make_context(self.shard, "d" * 16, 0, admitted_values_mode="L7a")                            # admitted mode differs
        make_context(self.shard, "e" * 16, 0, row_selection_leak=["kmeans"])
        make_context(self.shard, "f" * 16, 0, row_selection_leak=["clean", "acquisition_cap"])
        make_context(self.shard, "1" * 16, 0, row_selection_leak=[])
        d = make_context(self.shard, "2" * 16, 0)
        ctx = json.loads((d / "context.json").read_text())
        del ctx["row_selection_leak"]                                                                  # ungated tree
        (d / "context.json").write_text(json.dumps(ctx))
        doc = self.run_once()
        self.assertEqual(self._refused(doc), {
            "c" * 16 + "__r0__f0": "values_mode", "d" * 16 + "__r0__f0": "values_mode", "e" * 16 + "__r0__f0": "row_selection_gate",
            "f" * 16 + "__r0__f0": "row_selection_gate", "1" * 16 + "__r0__f0": "row_selection_gate",
            "2" * 16 + "__r0__f0": "row_selection_gate"})
        self.assertEqual({k.split("/")[-3] for k in self.bucket.keys()}, {"a" * 16, "b" * 16})
        modes = {}
        for (_, key), versions in self.bucket.objects.items():
            if "/receipts/" in key:
                r = json.loads(versions[-1][1] if isinstance(versions[-1], tuple) else versions[-1]["body"])
                self.assertEqual(r["row_selection_leak"], ["clean"])
                modes[r["dataset_hash"]] = r["values_mode"]
        self.assertEqual(modes, {"a" * 16: "L7b", "b" * 16: "L7a"})
        self.assert_layout()

