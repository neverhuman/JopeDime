    def test_dry_run_builds_no_aws_client_and_leaves_real_ledgers_alone(self):
        make_context(self.shard, "a" * 16, 0, files={"a0.f32": b"a0", "tabpfn35.npy": b"t"})
        real_budget, real_publish = self.tmp / "real-budget.jsonl", self.tmp / "real-publish.jsonl"
        s3io.V2Ledger(real_budget).reserve(V + "seed/x", sha(b"seed"), 1000)
        before = real_budget.read_bytes()
        receipt = self.tmp / "receipt.json"
        boom = mock.Mock(side_effect=AssertionError("dry run must not build an AWS client"))
        with mock.patch.object(s3io, "V2_LEDGER_PATH", real_budget), mock.patch.object(vp, "DEFAULT_PUBLISH_LEDGER", real_publish), \
                mock.patch.object(s3io, "make_client", boom), mock.patch("boto3.session.Session", boom):
            with contextlib.redirect_stdout(io.StringIO()):
                rc = vp.main(["--build", str(self.build), "--dry-run", "--work-dir", str(self.tmp / "work"), "--receipt", str(receipt)])
        self.assertEqual(rc, 0)
        doc = json.loads(receipt.read_text())
        self.assertEqual((doc["mode"], doc["verdict"], doc["ledgers"]["budget_is_real"]), ("dry-run", "PASS", False))
        self.assertEqual(doc["dry_run_bucket"]["keys_outside_v2"], 0)
        self.assertEqual(doc["dry_run_bucket"]["tabpfn35_keys_outside_research_only"], 0)
        self.assertEqual(doc["dry_run_bucket"]["research_only_keys"], 2)
        self.assertEqual(doc["budget_before"]["used_bytes"], 1000, "the dry run starts from a copy of the real budget")
        self.assertEqual(real_budget.read_bytes(), before)
        self.assertFalse(real_publish.exists())
        boom.assert_not_called()
        with contextlib.redirect_stderr(io.StringIO()):
            with mock.patch.object(vp, "DEFAULT_PUBLISH_LEDGER", real_publish), self.assertRaises(SystemExit):
                vp.main(["--build", str(self.build), "--dry-run", "--publish-ledger", str(real_publish)])
            with self.assertRaises(SystemExit):
                vp.main(["--build", str(self.build)])
            with self.assertRaises(SystemExit):
                vp.main(["--build", str(self.build), "--dry-run", "--real"])

    def test_real_mode_uses_the_v2_writer_and_the_real_budget_ledger(self):
