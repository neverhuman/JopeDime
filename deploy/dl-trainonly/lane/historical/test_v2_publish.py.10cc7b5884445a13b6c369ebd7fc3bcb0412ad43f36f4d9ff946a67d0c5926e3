    def test_ledger_conflict_after_local_rebuild(self):
        d = make_context(self.shard, "a" * 16, 0)
        self.assertEqual(self.run_once()["verdict"], "PASS")
        new = b"rebuilt-bytes"
        (d / "a0.f32").write_bytes(new)
        ctx = json.loads((d / "context.json").read_text())
        ctx["files"]["a0.f32"] = {"sha256": sha(new), "bytes": len(new)}
        (d / "context.json").write_text(json.dumps(ctx))
        self.bucket.calls.clear()
        doc = self.run_once()
        self.assertEqual(doc["failed_by_type"], {"PublishConflict": 1})
        self.assertEqual(self.bucket.puts(), [])

    def test_budget_preflight_and_guard(self):
        make_context(self.shard, "a" * 16, 0)
        s3io.V2Ledger(self.budget_path).reserve(V + "seed/x", sha(b"seed"), s3io.V2_BUDGET_BYTES - 10)
        doc = self.run_once()
        self.assertFalse(doc["preflight"]["fits"])
        self.assertIn("stopped", doc)
        self.assertEqual((doc["verdict"], self.bucket.calls), ("INCOMPLETE", []))
        writer, reader, _ = vp.fake_clients(self.budget_path, self.bucket)   # the guard holds even without the preflight
        ledger = vp.PublishLedger(self.ledger_path)
        try:
            with self.assertRaises(s3io.BudgetExceeded):
                vp.Publisher(writer, reader, ledger).publish_context(vp.scan_context(self.shard / ("a" * 16 + "__r0__f0")))
        finally:
            ledger.close()
        self.assertEqual(self.bucket.keys(), [])

    def test_publish_ledger_is_exclusive_and_validated(self):
        a = vp.PublishLedger(self.ledger_path)
        with self.assertRaisesRegex(RuntimeError, "another publisher"):
            vp.PublishLedger(self.ledger_path)
        a.close()
        with open(self.ledger_path, "ab") as f:
            f.write(b'{"schema":"jope.dl-v2-publish-ledger/v1","event":"verified","key":"experiments/gp-policy-dl/v1/x"}\n')
        with self.assertRaises(s3io.LedgerCorrupt):
            vp.PublishLedger(self.ledger_path)
        self.ledger_path.write_bytes(b'{"schema"')
        with self.assertRaises(s3io.LedgerCorrupt):
            vp.PublishLedger(self.ledger_path)


