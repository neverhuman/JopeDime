    def test_resplit_schemas_need_a_new_cut(self):
        good = {"cut_id": "trainonly-split-v2:" + "a" * 64, "comparable_with_replaced": False, "replaces_cut": {"x": 1}}
        goodg = dict(good, cut_id="trainonly-split-v2g:" + "b" * 64)
        RS, L7A, L7B = "jope.dl-v2-rowsel-context/v2", "jope.dl-v2-l7a-context/v2split", "jope.dl-v2-local-context/v2split"
        make_context(self.shard, "a" * 16, 0, schema=RS, cut=good)                                        # admitted
        make_context(self.shard, "a" * 16, 1, schema=L7A, values_mode="L7a", cut=goodg)                  # admitted
        make_context(self.shard, "a" * 16, 2, schema=L7B, cut=good, rights="licensed")                    # admitted, production
        make_context(self.shard, "b" * 16, 0, schema=RS)                                                  # no cut
        make_context(self.shard, "c" * 16, 0, schema=L7B, cut=dict(good, comparable_with_replaced=True))  # comparable with old cut
        make_context(self.shard, "d" * 16, 0, schema=L7B, cut=dict(good, cut_id="registry:" + "a" * 64)) # old registry cut
        make_context(self.shard, "e" * 16, 0, schema=L7B, cut=dict(good, cut_id="trainonly-split-v2:xyz"))
        make_context(self.shard, "f" * 16, 0, schema=L7A, cut=good)                                       # L7a schema, L7b values
        make_context(self.shard, "9" * 16, 0, schema=L7B, cut=good, rights="licensed-maybe")              # unknown rights value
        doc = self.run_once()
        self.assertEqual(self._refused(doc), {"b" * 16 + "__r0__f0": "cut", "c" * 16 + "__r0__f0": "cut", "d" * 16 + "__r0__f0": "cut",
                                              "e" * 16 + "__r0__f0": "cut", "f" * 16 + "__r0__f0": "values_mode",
                                              "9" * 16 + "__r0__f0": "rights"})
        keys = list(self.bucket.keys())
        self.assertTrue(keys and {k.split("/")[-3] for k in keys} == {"a" * 16})
        for (_, key), versions in self.bucket.objects.items():
            if "/hyperion/" in key or "/jtt1-encoder/" in key or "/a0/" in key:
                s3io.assert_production_loadable(key)
            if "/receipts/" in key and "/f2/" in key:
                self.assertEqual(json.loads(versions[-1][1])["rights"], "licensed")
        self.assert_layout()

