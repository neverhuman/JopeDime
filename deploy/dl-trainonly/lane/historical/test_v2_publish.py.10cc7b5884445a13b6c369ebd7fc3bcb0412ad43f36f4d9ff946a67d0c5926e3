    def test_target_and_context2048_are_research_only_and_tagged(self):
        files = {n: os.urandom(24) for n in ("hyperion.npy", "foundation.npy", "target.npy", "context2048.npy", "tabpfn35.npy")}
        tags = {"hyperion": {"ruling": "HYPERION-ARMB-LABELS", "status": "Exposed"}, "target": {"ruling": "TARGET-ENC", "label_exposed": True}}
        make_context(self.shard, "a" * 16, 0, files=files, label_exposure=tags)
        self.run_once()
        rec = {}
        for (_, key), versions in self.bucket.objects.items():
            comp = key.split("/")[-4]
            if "/receipts/" in key:
                rec[comp] = json.loads(versions[-1][1])
            else:
                self.assertEqual(key.startswith(s3io.V2_RESEARCH_ONLY_KEY), comp in ("target", "context2048", "tabpfn35"), key)
                if comp in ("target", "context2048", "tabpfn35"):
                    with self.assertRaises(s3io.ResearchOnlyRefused):
                        s3io.assert_production_loadable(key)
