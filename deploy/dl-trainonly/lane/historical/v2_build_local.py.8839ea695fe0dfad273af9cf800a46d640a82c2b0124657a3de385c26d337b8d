class SplitV2Error(ValueError):
    """A dataset that cannot be rebuilt on split v2; `reason` is a short stable code for the receipts."""

    def __init__(self, reason: str, detail: str = ""):
        super().__init__(f"{reason}: {detail}" if detail else reason)
        self.reason = reason
        self.detail = detail


def canon(o) -> bytes:
    return json.dumps(o, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()


def jdump(o) -> bytes:
    return (json.dumps(o, sort_keys=True) + "\n").encode()


def sha_file(p) -> str:
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def ref(p) -> dict:
    p = Path(p)
    return {"path": str(p), "sha256": sha_file(p), "bytes": p.stat().st_size}


