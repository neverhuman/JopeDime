def require_split_version(version, allowed=None) -> str:
    """No default split (PR #218 finding 10): a split version must be passed explicitly; None or an unknown one is refused."""
    allowed = (SPLIT_V2, SPLIT_V2G) if allowed is None else tuple(allowed)
    if version not in allowed:
        raise SplitV2Error("split_version_required", f"{version!r} not in {allowed}")
    return version


def code_shas_v2(extra=(), version=None) -> dict:
    require_split_version(version)
    root = Path(__file__).resolve().parents[1]
    files = V2_CODE_FILES + tuple(extra) + (("dltrain/rowsel_split_v2_groups.py",) if version == SPLIT_V2G else ())
    return {f: sha((root / f).read_bytes()) for f in files}


def routes(version) -> dict:
    return ROUTES_V2G if require_split_version(version) == SPLIT_V2G else ROUTES


# ------------------------------------------------------------------------------------------- the split

def t1_group_specs(width: int) -> list:
    """Grouping specs over a T1 table of `width` columns: every FEATURE column as numeric (exact float64 bytes), the
    target last. rowsel_raw.feature_bytes reads specs[:-1] only, so the target never reaches the group key."""
    specs = [{"index": j, "name": f"t1_col{j}", "kind": "numeric"} for j in range(width - 1)]
    specs.append({"index": width - 1, "name": "target", "kind": "numeric", "target": True})
    return specs


def split_prep(dataset_hash: str, values, specs, partition: str) -> rowsel_raw.Prep:
    """The universe as a rowsel_raw.Prep (positions 0..n-1, values read-only), for split_report and the value gates."""
    v = np.ascontiguousarray(np.asarray(values, dtype=np.float64))
    v.setflags(write=False)
    pos = np.arange(v.shape[0], dtype=np.int64)
    pos.setflags(write=False)
    rep = {"rows": int(v.shape[0]), "partition": partition, "positions_sha256": sha(np.asarray(pos, "<u8").tobytes()),
           "position_basis": "0-based row index of the universe (the epoch-0 data object A)"}
    return rowsel_raw.Prep(dataset_hash, list(specs), pos, v, (), (), rep)


def split_fn(partition: str):
    return functools.partial(rowsel_raw_split_v2.outer_split, partition=partition)


def v2_split(dataset_hash: str, values, specs, partition: str) -> tuple:
    """(folds, split record). The record carries the raw route's split fields plus the gates: straddling groups, the
    target check and the per-fold value check. The split sha256 is rowsel_raw_split_v2.split_sha256 exactly as it is
    returned (its canonical body holds the module's partition constant, 'raw'; the universe label is `partition`)."""
    prep = split_prep(dataset_hash, values, specs, partition)
    fn = split_fn(partition)
    folds = fn(dataset_hash, prep.positions, prep.values, prep.specs)
    srep = rowsel_raw_split_v2.split_report(prep, folds)
    tc = rowsel_raw.split_target_check(fn, prep)
    vc = [rowsel_raw_split_v2.value_check(fn, prep, f, salt=CF_SALT) for f in range(OUTER_FOLDS)]
    srep.update(partition=partition, target_check=tc, target_invariant=bool(tc["target_invariant"]),
                value_check={"folds": [{"fold": c["fold"], "valid": c["valid"], "invariant": c["invariant"],
                                        "rows_moved": {k: v["rows_moved"] for k, v in c["cases"].items()}} for c in vc],
                             "invariant": all(c["valid"] and c["invariant"] for c in vc)},
                sha256_partition_field=rowsel_raw_split_v2.PARTITION)
    srep["value_check_invariant"] = srep["value_check"]["invariant"]
    return folds, srep


def split_gate(srep) -> list:
    bad = []
    if srep["groups_straddling_folds"]:
        bad.append("groups_straddle_folds")
    if not srep["target_invariant"]:
        bad.append("split_reads_target")
    if not srep["value_check_invariant"]:
        bad.append("split_moves_under_outer_test_values")
    if min(srep["fold_sizes"]) == 0 or len(srep["fold_sizes"]) != OUTER_FOLDS:
        bad.append("empty_outer_fold")
    return bad


def split_record(srep) -> dict:
    """The raw route's `rowsel.split` fields (v2_rowsel_raw.run_dataset split_ref), plus the universe label."""
    out = {k: srep[k] for k in ("schema", "sha256", "fold_sizes", "groups", "largest_group", "groups_straddling_folds",
                                "duplicate_rows", "domain", "rule", "partition", "target_invariant", "value_check_invariant")}
    out["sha256_partition_field"] = srep["sha256_partition_field"]
    return out


def cut_block(srep, e) -> dict:
    reg = e["registry_split"]
    return {"cut_id": CUT_PREFIX + srep["sha256"], "schema": srep["schema"], "partition": srep["partition"],
            "replaces_cut": reg["sha256"], "comparable_with_replaced": False,
            "replaces_cut_ref": dict(REGISTRY_CUT, split_key=reg.get("key"), split_object_sha256=reg["sha256"],
                                     epoch0_view_ids=[c["view_id"] for c in e["epoch0"]]),
            "hwm_comparison": "GP-teacher HWM comparisons use this cut_id only, never the replaced registry cut",
            "cut_id_basis": "'trainonly-split-v2:' + rowsel_raw_split_v2.split_sha256(h, folds) as returned (canonical JSON "
                            "{schema, dataset_hash, partition: module constant 'raw', folds}); the universe label is "
                            "cut.partition"}


def split_fn_v2g(partition: str, group_values):
    """The GROUP-UNION-B split over (positions, values, specs): feature bytes from the values (target excluded by
    rowsel_raw.feature_bytes), annotated group values FIXED (aligned with positions 0..n-1)."""
    def fn(dataset_hash, positions, values, specs, folds=OUTER_FOLDS):
        return rowsel_split_v2_groups.split(dataset_hash, [int(p) for p in positions], rowsel_raw.feature_bytes(values, specs),
                                            group_values=group_values, partition=partition, folds=folds)   # explicit (F5)
    return fn


def v2g_split(dataset_hash: str, values, specs, partition: str, group_values, group_column) -> tuple:
    """(folds, split record) under rowsel_split_v2_groups: the v2 gates (structure, target check, per-fold value check with
    the group values held) plus the annotated-group straddle count. sha256 = rowsel_split_v2_groups.split_sha256(h,
    partition, group_column, folds), which binds the universe label and the group spec."""
    prep = split_prep(dataset_hash, values, specs, partition)
    fn = split_fn_v2g(partition, group_values)
    folds = fn(dataset_hash, prep.positions, prep.values, prep.specs)
    srep = rowsel_raw.split_report(prep, folds)                    # exact partition + feature-group structure
    pos = prep.positions.tolist()
    comps = rowsel_split_v2_groups.components(pos, rowsel_raw.feature_bytes(prep.values, prep.specs), group_values)
    tc = rowsel_raw.split_target_check(fn, prep)
    empty = [f for f in range(OUTER_FOLDS) if not folds[f]]
    vc = [rowsel_raw_split_v2.value_check(fn, prep, f, salt=CF_SALT) for f in range(OUTER_FOLDS) if folds[f]]
    srep.update(empty_folds=empty, effective_folds=OUTER_FOLDS - len(empty),
                empty_folds_allowed=bool(empty) and len(comps) < OUTER_FOLDS and empty == list(range(len(comps), OUTER_FOLDS)))
    srep.update(schema=SPLIT_V2G, sha256=rowsel_split_v2_groups.split_sha256(dataset_hash, partition, group_column, folds),
                domain=rowsel_split_v2_groups.SPLIT_DOMAIN, rule=rowsel_split_v2_groups.RULE, partition=partition,
                group_column=group_column, components=len(comps), largest_component=max(len(c) for c in comps),
                annotated_groups=len({g for g in group_values if g is not None}),
                annotated_groups_straddling_folds=rowsel_split_v2_groups.straddling_groups(folds, pos, group_values),
                target_check=tc, target_invariant=bool(tc["target_invariant"]),
                value_check={"folds": [{"fold": c["fold"], "valid": c["valid"], "invariant": c["invariant"],
                                        "rows_moved": {k: v["rows_moved"] for k, v in c["cases"].items()}} for c in vc],
                             "invariant": all(c["valid"] and c["invariant"] for c in vc)},
                sha256_partition_field=partition)
    srep["value_check_invariant"] = srep["value_check"]["invariant"]
    return folds, srep


def split_gate_v2g(srep) -> list:
    bad = [b for b in split_gate(srep) if not (b == "empty_outer_fold" and srep.get("empty_folds_allowed"))]
    if len(srep["fold_sizes"]) != OUTER_FOLDS and "empty_outer_fold" not in bad:
        bad.append("empty_outer_fold")
    if srep["annotated_groups_straddling_folds"]:
        bad.append("annotated_groups_straddle_folds")
    return bad


def split_record_v2g(srep) -> dict:
    out = split_record(srep)
    out.update({k: srep[k] for k in ("group_column", "components", "largest_component", "annotated_groups",
                                     "annotated_groups_straddling_folds", "empty_folds", "effective_folds")})
    return out


def cut_block_v2g(srep, e) -> dict:
    reg, v2s = e["registry_split"], e["v2split"]
    return {"cut_id": rowsel_split_v2_groups.cut_id(srep["sha256"]), "schema": srep["schema"], "partition": srep["partition"],
            "group_column": srep["group_column"], "replaces_cut": [reg["sha256"], v2s["cut_id"]], "comparable_with_replaced": False,
            "replaces_cut_ref": {"registry": dict(REGISTRY_CUT, split_key=reg.get("key"), split_object_sha256=reg["sha256"],
                                                  epoch0_view_ids=[c["view_id"] for c in e["epoch0"]]),
                                 "v2split": v2s},
            "hwm_comparison": "GP-teacher HWM comparisons use this cut_id only, never a replaced cut",
            "cut_id_basis": "'trainonly-split-v2g:' + rowsel_split_v2_groups.split_sha256(h, partition, group_column, folds): "
                            "canonical JSON {schema, dataset_hash, partition, group_column {index, name}, folds}"}


GROUP_TARGET_TIE = ("rowsel_split_v2_groups.target_tied_group(group values, A[:, -1]) over every row of A: refuses a group "
                    "column whose '<f8' bytes equal the T1 target, that is an affine copy of it, or that determines it "
                    "(PR #218 finding 8). Dataset-level admission only: split() and components() never receive y.")


def t1_group_values(A, index: int) -> list:
    """Annotated group value per universe row: the exact (canonical) float64 bytes of T1 column `index` of A. Refused when
    the column is not a feature column (the last is the target) or when it copies or determines the target
    (rowsel_split_v2_groups.target_tied_group against A's target column, every row; the reason is recorded)."""
    A = np.asarray(A, dtype=np.float64)
    if not 0 <= int(index) < A.shape[1] - 1:
        raise SplitV2Error("group_column_not_a_feature", f"{index} of {A.shape[1]} columns (the last is the target)")
    col = np.ascontiguousarray(A[:, int(index)] + 0.0, dtype="<f8")
    values = [col[i:i + 1].tobytes() for i in range(col.shape[0])]
    tie = rowsel_split_v2_groups.target_tied_group(values, A[:, -1])
    if tie is not None:
        raise SplitV2Error("group_column_target_tied", f"{tie}: T1 column {int(index)}")
    return values


def attach_groups(inp: dict, e, A) -> dict:
    """GROUP-UNION-B inputs: the group values from the plan's group column (refused when it is not a feature column)."""
    gc = e["group_column"]
    if "ambiguous" in gc:                                              # every candidate must give identical components
        res = resolve_group_column({"reproducing_group_columns": gc["ambiguous"], "match_group_none": False,
                                    "group_column_candidates": gc["evidence"]["census_candidates"]},
                                   {"columns": gc["ambiguous"], "n_columns": np.asarray(A).shape[1]}, gc["names"],
                                   lambda c: t1_group_values(A, c))
        if "refused" in res:
            raise SplitV2Error(res["refused"], json.dumps(gc["ambiguous"]))
        gc = dict(res, evidence=dict(gc["evidence"], **res["evidence"]))
        e["group_column"] = gc
    inp["group_values"] = t1_group_values(A, gc["spec"]["index"])
    inp["universe"] = dict(inp["universe"], group_column=gc["spec"], annotated_groups=len(set(inp["group_values"])),
                           group_value_basis="exact float64 bytes of T1 column group_column.index of the epoch-0 data object A "
                                             "(the bytes the registry grouped on); universe row i is A row i",
                           group_target_tie={"result": "admit", "rule": GROUP_TARGET_TIE,
                                             "rel_tol": rowsel_split_v2_groups.AFFINE_REL_RMSE,
                                             "reasons_checked": list(rowsel_split_v2_groups.TARGET_TIE_REASONS)})
    return inp


def resolve_group_column(census_rec, ga, names, group_values_of=None) -> dict:
    """The group column of one annotated dataset, by the evidence rule: the registry annotation file is not local, so the
    inferred column is accepted only when the registry split port reproduced every registry fold with it (census
    reproducing_group_columns) and it is a feature column (never the target). Several reproducing columns: accepted only
    when every candidate gives identical components (group_values_of(index) -> values); else refused.
    Returns {'spec', 'source', 'evidence'} or {'refused': reason}."""
    if census_rec is None:
        return {"refused": "no_census_record"}
    width = int(ga.get("n_columns") or 0)
    repro = [int(c) for c in (census_rec.get("reproducing_group_columns") or [])]
    cands = {int(x["column"]): x for x in census_rec.get("group_column_candidates") or []}
    ev = {"census_reproducing_group_columns": repro, "census_match_group_none": census_rec.get("match_group_none"),
          "census_candidates": [{"column": c, "match": x.get("match"), "is_target": x.get("is_target")} for c, x in sorted(cands.items())],
          "registry_split_sha256": census_rec.get("split_sha256"), "scope_receipt_columns": list(ga.get("columns") or []),
          "annotation_file": "not local (split-scope receipt generator.annotation_groups_observed)", "census": str(CENSUS)}
    if census_rec.get("match_group_none") is not False or not repro:
        return {"refused": "group_column_not_reproduced", "evidence": ev}
    if any(c >= width - 1 or c < 0 or cands.get(c, {}).get("is_target") for c in repro):
        return {"refused": "group_column_is_target_or_not_a_feature", "evidence": ev}
    if sorted(repro) != sorted(int(c) for c in ga.get("columns") or []):
        return {"refused": "census_and_scope_receipt_disagree", "evidence": ev}

    def spec(c):
        return rowsel_split_v2_groups.group_spec(c, names[c] if names is not None and c < len(names) else f"t1_col{c}")
    if len(repro) == 1:
        return {"spec": spec(repro[0]), "source": "inferred_single_column_registry_port_reproduced", "evidence": ev}
    if group_values_of is None:
        return {"refused": "ambiguous_group_column_unresolved", "evidence": ev}
    parts = {c: sorted(tuple(sorted(v)) for v in _partition_of(group_values_of(c))) for c in repro}
    if len({json.dumps(p) for p in parts.values()}) == 1:
        return {"spec": spec(min(repro)), "source": "ambiguous_columns_identical_components",
                "evidence": dict(ev, candidates_identical=True, chosen=min(repro))}
    return {"refused": "ambiguous_group_column_components_differ", "evidence": ev}


def _partition_of(values) -> list:
    out = {}
    for i, v in enumerate(values):
        out.setdefault(v, []).append(i)
    return list(out.values())


def fold_rows(folds, f: int, n: int) -> tuple:
    """(R, T) of new fold f: T = the fold's positions, R = every other position; both ascending."""
    T = sorted(int(p) for p in folds[f])
    tset = set(T)
    R = [p for p in range(n) if p not in tset]
    return R, T


# ------------------------------------------------------------------------------------------- per-context gate (L7b)

def t1_train_side(art) -> dict:
    rep = art["report"]
    refit_train = {"kept_columns": rep["kept_columns"], "target_copy_dropped": rep["target_copy_dropped"],
                   "categorical_train": {k: v["train"] for k, v in sorted(rep["categorical"].items())},
                   "possibly_imputed_train": rep["possibly_imputed_cells"]["train"]}
    return {"scaler": art["scaler_sha256"], "encoder_train_rows": jtt1.train_rows_sha256(art["encoder_raw"]),
            "teacher_train_rows": jtt1.train_rows_sha256(art["teacher_raw"]), "inner_labels": art["inner_labels_sha256"],
            "a0": sha(art["a0"]), "refit_train": sha(canon(refit_train))}


def _code_value(s, code):
    span = s["hi"] - s["lo"]
    return (float(code) - s["lo"]) / span if span != 0 else 0.0


def perturb_t1_test_rows(A, meta, R, T, kind: str, salt: str = CF_SALT) -> tuple:
    """(matrix, outer_test) with the outer-test rows of A changed (valid T1 codes for categorical columns); R untouched."""
    W = np.array(A, dtype=np.float64, copy=True)
    Tn = np.asarray(T, dtype=np.int64)
    specs = t1prep.layout(meta, W.shape[1])
    num = [s["index"] for s in specs if s["kind"] != "categorical_codes"]
    cats = [s for s in specs if s["kind"] == "categorical_codes"]
    rng = np.random.default_rng(int.from_bytes(hashlib.sha256(f"{salt}|{kind}".encode()).digest()[:8], "little"))
    T_out = list(T)
    if kind == "features":
        if num:
            W[np.ix_(Tn, num)] = rng.normal(0.5, 3.0, size=(Tn.size, len(num)))
        for s in cats:
            codes = sorted(s["inverse"])
            W[Tn, s["index"]] = [_code_value(s, c) for c in rng.choice(codes, size=Tn.size)]
    elif kind == "targets":
        W[Tn, -1] = rng.normal(1e7, 1e6, size=Tn.size)
    elif kind == "categories":
        for s in cats:                                     # categories no outer-train row holds (cycled), else the highest
            span = s["hi"] - s["lo"]
            train_codes = set(np.rint(np.asarray(A, dtype=np.float64)[R, s["index"]] * span + s["lo"]).astype(np.int64).tolist())
            unused = [c for c in sorted(s["inverse"]) if c not in train_codes] or [max(s["inverse"])]
            W[Tn, s["index"]] = [_code_value(s, unused[k % len(unused)]) for k in range(Tn.size)]
        if num and Tn.size:
            W[Tn[0], num[0]] = -7.0
    elif kind == "outlier":
        if Tn.size:
            if num:
                W[Tn[0], num] = 1e12
            W[Tn[0], -1] = -1e12
    elif kind == "drop":
        T_out = list(T)[1::2]
    elif kind == "replace_with_train_copies":
        if Tn.size and len(R):
            W[Tn] = np.asarray(A, dtype=np.float64)[rng.choice(np.asarray(R, dtype=np.int64), size=Tn.size)]
            W[Tn, -1] = W[Tn, -1] * -3.0 + 11.0
    else:
        raise SplitV2Error("unknown_perturbation", kind)
    return W, T_out


def t1_value_counterfactual(A, meta, R, T, art, build=None) -> dict:
    """The train side of context (R, T) must be bit-identical when only its outer-test rows change. The gate rebuilds
    its own base and requires it to equal `art` (the artifacts that are written)."""
    build = build or l7b_artifacts
    base = build(A, meta, R, T)
    want = t1_train_side(base)
    same_base = (base["encoder_raw"] == art["encoder_raw"] and base["teacher_raw"] == art["teacher_raw"]
                 and base["a0"] == art["a0"] and want == t1_train_side(art))
    cases = {}
    Ra = np.asarray(R, dtype=np.int64)
    for kind in T1_PERTURBATIONS:
        W, T2 = perturb_t1_test_rows(A, meta, R, T, kind)
        if W[Ra].tobytes() != np.asarray(A, dtype=np.float64)[Ra].tobytes():
            raise SplitV2Error("perturbation_touched_train_rows", kind)
        got = t1_train_side(build(W, meta, R, T2))
        cases[kind] = sorted(k for k in want if got[k] != want[k])
    return {"cases": cases, "base_equals_written": bool(same_base),
            "train_side_invariant": bool(same_base) and not any(cases.values()), "train_side": want}


# ------------------------------------------------------------------------------------------- identity and records

def identity_body(mode: str, h: str, fold: int, cut: dict, split_ref: dict, universe: dict, R, T) -> dict:
    body = identity_body_v2(mode, h, fold, cut, split_ref, universe, R, T)
    if cut["schema"] == SPLIT_V2G:
        body.update(schema=IDENTITY_SCHEMA_V2G, group_column=cut["group_column"])
    return body


IDENTITY_SCHEMA_V2G = "jope.dl-nonraw-v2gsplit/v1"


def identity_body_v2(mode: str, h: str, fold: int, cut: dict, split_ref: dict, universe: dict, R, T) -> dict:
    return {"schema": IDENTITY_SCHEMA, "route": f"nonraw-{mode.lower()}", "values_mode": mode, "dataset_hash": h,
            "fold": int(fold), "cut_id": cut["cut_id"], "partition": cut["partition"],
            "split": {k: split_ref[k] for k in ("schema", "sha256", "fold_sizes")},
            "universe": {k: universe.get(k) for k in ("kind", "rows", "data_sha256", "values_sha256", "t1_meta_sha256")},
            "outer_train_indices_sha256": sha(json.dumps(list(R)).encode()),
            "outer_test_indices_sha256": sha(json.dumps(list(T)).encode()),
            "row_order": "JTT1 train rows ascending universe position, then test rows ascending"}


def make_view_id(h: str, fold: int, tag: str, identity: str) -> str:
    return f"{h}__r0__f{int(fold)}__{tag}_{identity[:12]}"


def new_context_sha256(schema, view_id, h, fold, identity, fmeta, art, R, T) -> str:
    return sha(canon({"schema": schema, "view_id": view_id, "dataset_hash": h, "fold": int(fold), "identity": identity,
                      "files": {k: v.get("raw_sha256", v["sha256"]) for k, v in fmeta.items()},
                      "scaler_sha256": art["scaler_sha256"], "inner_labels_sha256": art["inner_labels_sha256"],
                      "outer_train_indices_sha256": sha(json.dumps(list(R)).encode()),
                      "outer_test_indices_sha256": sha(json.dumps(list(T)).encode())}))


def epoch0_replaced(e, sealed: int, holdout, new_contexts: int = OUTER_FOLDS) -> dict:
    return {"level": "dataset", "contexts": e["epoch0"], "count": len(e["epoch0"]), "new_contexts": int(new_contexts),
            "context_count_changed": len(e["epoch0"]) != new_contexts, "fold_correspondence": EPOCH0_FOLD_CORRESPONDENCE,
            "epoch0_sealed_contexts": int(sealed), "epoch0_holdout": holdout,
            "replaced_cut": e["registry_split"]["sha256"]}


def compute_dataset(e, inp, mode: str, existing, codes, guard=None, log=None, version=None) -> dict:
    """Every gate and every context of one dataset in memory; nothing is written. Returns {'passed', 'reason', 'detail',
    'split', 'cut', 'results': [(view_id, files, context record)], 'contexts': [summaries]}. `version` is required."""
    require_split_version(version)
    h = e["dataset_hash"]
    route = routes(version)[mode]
    partition = route["partition"]
    out = {"passed": False, "reason": None, "detail": "", "results": [], "contexts": []}
    if version == SPLIT_V2G:
        folds, srep = v2g_split(h, inp["values"], inp["specs"], partition, inp["group_values"], e["group_column"]["spec"])
        bad = split_gate_v2g(srep)
    elif version == SPLIT_V2:
        folds, srep = v2_split(h, inp["values"], inp["specs"], partition)
        bad = split_gate(srep)
    else:
        raise SplitV2Error("unknown_split_version", repr(version))
    out["split"] = srep
    if bad:
        raise SplitV2Error("split_check_failed", json.dumps({"failed": bad, "target_check": srep["target_check"],
                                                              "value_check": srep["value_check"]})[:1500])
    sref = split_record_v2g(srep) if version == SPLIT_V2G else split_record(srep)
    cut = cut_block_v2g(srep, e) if version == SPLIT_V2G else cut_block(srep, e)
    out["cut"] = cut
    e0 = epoch0_replaced(e, inp.get("sealed", 0), inp.get("holdout"), srep.get("effective_folds", OUTER_FOLDS))
    out["epoch0_replaced"] = e0
    n = int(inp["n"])
    seen = set()
    for f in range(OUTER_FOLDS):
        if not folds[f] and f in srep.get("empty_folds", []) and srep.get("empty_folds_allowed"):
            continue                                                   # v2g: fewer components than folds, no test rows
        if guard is not None:
            guard.wait()
        tf, cf0 = time.time(), cpu_s()
        R, T = fold_rows(folds, f, n)
        art = inp["build"](R, T)
        hdr = jtt1.parse_header(art["encoder_raw"])
        if (hdr["n_train"], hdr["n_test"]) != (len(R), len(T)):
            raise SplitV2Error("jtt1_layout", f"{hdr} for {len(R)}/{len(T)}")
        cf = inp["counterfactual"](R, T, art)
        body = identity_body(mode, h, f, cut, sref, inp["universe"], R, T)
        identity = sha(canon(body))
        vid = make_view_id(h, f, route["tag"], identity)
        if vid in existing or vid in seen:
            raise SplitV2Error("view_id_collision", vid)
        seen.add(vid)
        files = context_files(art)
        fmeta = files_meta(files, art)
        schema = route["context_schema"]
        crec = dict(inp["common"])
        crec.update(e.get("context_extra") or {})                      # rights, group annotation (plan data)
        crec.update({
            "schema": schema, "view_id": vid, "dataset_hash": h, "fold": f, "split_version": version,
            "context_sha256": new_context_sha256(schema, vid, h, f, identity, fmeta, art, R, T),
            "context_sha256_basis": "sha256 of canonical JSON {schema, view_id, dataset_hash, fold, identity, files (raw "
                                    "sha256), scaler, inner labels, outer train/test indices}; a NEW context identity, not "
                                    "an epoch-0 context_sha256",
            "values_mode": mode, "published": False, "row_selection_leak": ["clean"],
            "outer_train_indices_sha256": body["outer_train_indices_sha256"],
            "outer_test_indices_sha256": body["outer_test_indices_sha256"],
            "indices_basis": "json list of universe positions (0-based row index of the epoch-0 data object A) in JTT1 "
                             "row order",
            "n_train": len(R), "n_test": len(T), "files": fmeta, "scaler_sha256": art["scaler_sha256"],
            "inner_labels_sha256": art["inner_labels_sha256"], "inner_loads": art["inner_loads"],
            inp["report_key"]: art["report"], "cut": cut, "split": sref, "universe": inp["universe"],
            "epoch0_replaced": e0, "identity": identity, "identity_body": body,
            "counterfactual": {"train_side_invariant": cf["train_side_invariant"],
                               "base_equals_written": cf["base_equals_written"], "cases": sorted(cf["cases"]),
                               "differing": {k: v for k, v in cf["cases"].items() if v}, "train_side": cf["train_side"]},
            "code_sha256": dict(codes)})
        if version == SPLIT_V2G:
            crec.update(group_union=True, group_column=e["group_column"], v2split_superseded=e["v2split"])
        tlg = target_linear.check_jtt1(art["encoder_raw"])             # LINEAR-DETERMINED: outer-train rows only (jtt1.train_view)
        crec["target_linear"] = tlg
        out["results"].append((vid, files, crec))
        out["contexts"].append({"fold": f, "view_id": vid, "identity": identity, "context_sha256": crec["context_sha256"],
                                "n_train": len(R), "n_test": len(T), "passed": bool(cf["train_side_invariant"]),
                                "failures": sorted(k for k, v in cf["cases"].items() if v)
                                + ([] if cf["base_equals_written"] else ["counterfactual_base_differs"]),
                                "cpu_s": round(cpu_s() - cf0, 2), "wall_s": round(time.time() - tf, 2),
                                "target_linear": {"verdict": tlg["verdict"], "ols_rel_rmse": tlg["ols_rel_rmse"]}})
        if log:
            log(json.dumps({"dataset": h, "fold": f, "passed": cf["train_side_invariant"], "cpu_s": out["contexts"][-1]["cpu_s"],
                            "maxrss_mb": maxrss_mb()}))
        if not cf["train_side_invariant"]:
            raise SplitV2Error("counterfactual_failed", json.dumps(out["contexts"][-1]))
    lin = {c["fold"]: c["target_linear"]["ols_rel_rmse"] for c in out["contexts"] if c["target_linear"]["verdict"] == target_linear.REFUSE}
    if lin:                                                            # refused: compute_dataset raises before any write
        raise SplitV2Error(target_linear.REFUSE, json.dumps(lin))
    out["passed"] = True
    return out


def write_dataset(out_shard: Path, results) -> tuple:
    """Phase 1: files + context.json of every pending context; phase 2: .done of every pending context. A .done
    context is never rewritten; it must equal the recomputed identity and files. Returns (written, already_done)."""
    pending, already = [], 0
    for vid, files, crec in results:
        d = out_shard / vid
        if (d / ".done").exists():
            old = json.loads((d / "context.json").read_bytes())
            if old.get("identity") != crec["identity"] or old.get("files") != crec["files"]:
                raise SplitV2Error("done_context_differs", vid)
            already += 1
            continue
        pending.append((d, files, crec))
    for d, files, crec in pending:
        d.mkdir(parents=True, exist_ok=True)
        for name, body in files.items():
            atomic(d / name, body)
        atomic(d / "context.json", jdump(dict(crec, utc_us=int(time.time() * 1e6))))
    for d, _, _ in pending:
        atomic(d / ".done", b"ok\n")
    return len(pending), already


def run_dataset_v2(e, out_shard: Path, mode: str, loader, existing, codes, guard=None, log=print, ctx_args=(), version=None) -> dict:
    """Load, gate and build one dataset; write only when every gate of every fold passed. The dataset record goes to
    out_shard/_datasets/<h>.json (also on failure). `version` is required (refused before anything is read or written)."""
    require_split_version(version)
    h = e["dataset_hash"]
    t0, c0 = time.time(), cpu_s()
    rec = {"schema": DATASET_SCHEMA, "dataset_hash": h, "values_mode": mode, "split_version": version,
           "partition": routes(version)[mode]["partition"], "code_sha256": codes, "status": "failed", "published": False,
           "epoch0_contexts": len(e["epoch0"]), "epoch0_replaced": None}
    rec.update(e.get("context_extra") or {})
    try:
        inp = loader(e, *ctx_args)
        rec["universe"] = inp["universe"]
        if version == SPLIT_V2G:
            rec["group_column"] = e["group_column"]
            rec["v2split_superseded"] = e["v2split"]
        res = compute_dataset(e, inp, mode, existing, codes, guard, log, version=version)
        rec.update(split=res["split"], cut=res["cut"], epoch0_replaced=res["epoch0_replaced"], contexts=res["contexts"])
        written, already = write_dataset(out_shard, res["results"])
        rec.update(status="done", reason=None, contexts_written=written, contexts_already_done=already,
                   expected_contexts=len(res["results"]))
    except SplitV2Error as err:
        rec.update(reason=err.reason, detail=err.detail[:2000])
    except trainonly.IneligibleSplit as err:
        rec.update(reason="ineligible_split", detail=str(err)[:2000])
    except Exception as err:  # recorded; the shard continues
        rec.update(reason=getattr(err, "reason", "exception"), detail=f"{type(err).__name__}: {err}"[:2000])
    rec.setdefault("contexts", [])
    rec.update(cpu_s=round(cpu_s() - c0, 2), wall_s=round(time.time() - t0, 2), maxrss_mb=maxrss_mb(),
               utc_us=int(time.time() * 1e6))
    (out_shard / "_datasets").mkdir(parents=True, exist_ok=True)
    atomic(out_shard / "_datasets" / f"{h}.json", jdump(rec))
    return rec


def dataset_done(out_shard: Path, h: str, codes) -> bool:
    p = out_shard / "_datasets" / f"{h}.json"
    if not p.exists():
        return False
    r = json.loads(p.read_bytes())
    return (r.get("status") == "done" and r.get("code_sha256") == codes and len(r.get("contexts", [])) == r.get("expected_contexts", OUTER_FOLDS)
            and all((out_shard / c["view_id"] / ".done").exists() for c in r["contexts"]))


# ------------------------------------------------------------------------------------------- epoch-0 inputs

def epoch0_universe(ctxs) -> tuple:
    """The dataset's universe from its resolved epoch-0 contexts: one data object A shared by all of them, every
    context's R u T exactly all of A (disjoint). Returns (A, coverage report)."""
    data = sorted({c["refs"]["data_sha256"] for c in ctxs})
    if len(data) != 1:
        raise SplitV2Error("epoch0_contexts_on_different_data_objects", json.dumps(data))
    A = ctxs[0]["A"]
    n = int(A.shape[0])
    union = set()
    for c in ctxs:
        R, T = [int(i) for i in c["R"]], [int(i) for i in c["T"]]
        if set(R) & set(T) or sorted(R + T) != list(range(n)):
            raise SplitV2Error("epoch0_context_not_full_universe", c["row"]["view_id"])
        union.update(T)
    shapes = {(int(c["shape"]["sample_rows"]), int(c["shape"]["source_rows"])) for c in ctxs}
    if len(shapes) != 1:
        raise SplitV2Error("epoch0_shapes_differ", json.dumps(sorted(shapes)))
    sample_rows, source_rows = shapes.pop()
    cov = {"rows": n, "sample_rows": sample_rows, "source_rows": source_rows, "subsampled": sample_rows < source_rows,
           "epoch0_folds": sorted(int(c["fold"]) for c in ctxs), "epoch0_each_context_covers_all_rows": True,
           "epoch0_test_rows_union": len(union),
           "statement": "each epoch-0 context's outer-train u outer-test rows are all rows of the data object A; "
                        + ("A is a SUBSAMPLE of the source rows" if sample_rows < source_rows else
                           "A is the whole T1 table (sample_rows == source_rows)")}
    return A, data[0], cov


def resolve_epoch0(e, src, cache, by_dataset) -> tuple:
    rows = sorted(by_dataset.get(e["dataset_hash"], []), key=lambda r: int(r["fold"]))
    if [(r["view_id"], r["context_sha256"]) for r in rows] != [(c["view_id"], c["context_sha256"]) for c in e["epoch0"]]:
        raise SplitV2Error("epoch0_contexts_differ_from_plan")
    ctxs = [scale_check.resolve_context(r, src, cache) for r in rows]
    sealed = sum(1 for r in rows if r["context_sha256"] in src.sealed_ctx)
    holdout = sorted({json.dumps(src.holdout_flag(r["context_sha256"]), sort_keys=True) for r in rows})
    return rows, ctxs, sealed, [json.loads(x) for x in holdout]


def load_meta(h: str, inv) -> tuple:
    k = inv["meta_key"][h].rsplit("/", 1)[1]
    mb = (META_DIR / f"{k}.json").read_bytes()
    if sha(mb) != k:
        raise SplitV2Error("meta_sha_mismatch", k)
    return json.loads(mb), k


def l7b_inputs(e, A, meta, meta_sha: str, data_sha: str, cov, cohort: str, sealed: int = 0, holdout=()) -> dict:
    """L7b universe: the T1 table rows (data object A), grouping on the T1 feature bytes, partition 't1'."""
    A = np.ascontiguousarray(np.asarray(A, dtype=np.float64))
    universe = {"kind": ROUTES["L7b"]["universe"], "partition": ROUTES["L7b"]["partition"], "rows": int(A.shape[0]),
                "columns": int(A.shape[1]), "data_sha256": data_sha, "values_sha256": sha(np.ascontiguousarray(A, "<f8").tobytes()),
                "t1_meta_sha256": meta_sha, "positions": "0..rows-1 = row index of the epoch-0 data object A (the T1 table)",
                "group_basis": "exact float64 bytes of every T1 feature column (canonical -0.0/NaN); target excluded",
                "epoch0_coverage": cov}
    common = {"t1_meta_sha256": meta_sha, "data_sha256": data_sha, "cohort": cohort, "rights": e.get("rights"),
              "epoch0_row_selection_leak": e["epoch0_labels"]}
    return {"values": A, "specs": t1_group_specs(A.shape[1]), "n": int(A.shape[0]), "universe": universe, "common": common,
            "sealed": sealed, "holdout": list(holdout), "report_key": "t1prep",
            "build": lambda R, T: l7b_artifacts(A, meta, R, T),
            "counterfactual": lambda R, T, art: t1_value_counterfactual(A, meta, R, T, art)}


def l7b_loader(e, src, cache, inv, by_dataset) -> dict:
    rows, ctxs, sealed, holdout = resolve_epoch0(e, src, cache, by_dataset)
    A, data_sha, cov = epoch0_universe(ctxs)
    meta, k = load_meta(e["dataset_hash"], inv)
    inp = l7b_inputs(e, A, meta, k, data_sha, cov, rows[0]["cohort"], sealed, holdout)
    return attach_groups(inp, e, A) if e.get("group_column") else inp


# ------------------------------------------------------------------------------------------- plan

def check_pins():
    for p, want in PINS.items():
        got = sha_file(p)
        if got != want:
            raise SystemExit(f"pinned input drift: {p} {got} != {want}")


def scan_existing_view_ids(exclude=()) -> tuple:
    """Every view_id named by an existing context.json under build-v2 (trees in `exclude` skipped) and by the holdout
    denylist v2. Returns (sorted ids, per-source counts)."""
    ids, counts = set(), collections.Counter()
    excl = [os.path.abspath(x) + "/" for x in exclude]
    for dirpath, dirnames, filenames in os.walk(BUILD_V2):
        if any((os.path.abspath(dirpath) + "/").startswith(x) for x in excl):
            dirnames[:] = []
            continue
        if "context.json" in filenames:
            try:
                v = json.loads(Path(dirpath, "context.json").read_bytes()).get("view_id")
            except (OSError, ValueError):
                v = None
            v = v or Path(dirpath).name
            ids.add(v)
            ids.add(Path(dirpath).name)
            counts["build_v2_context_json"] += 1
    dl = json.loads(DENYLIST.read_bytes())
    for v in list(dl.get("assignment_by_view", {})) + [c["view_id"] for c in dl.get("contexts", [])]:
        ids.add(v)
        counts["denylist_v2_entries"] += 1
    return sorted(ids), dict(counts)


def load_existing(out: Path, pl) -> set:
    p = out / "existing-view-ids.json"
    b = p.read_bytes()
    if sha(b) != pl["existing_view_ids"]["sha256"]:
        raise SystemExit("existing-view-ids.json drift")
    return set(json.loads(b)["view_ids"])


def manifest_scope(scope: str) -> tuple:
    """(contexts by dataset, manifest ref): the published contexts of this scope from its pinned manifest."""
    cfg = SCOPES[scope]
    man = json.loads(cfg["manifest"].read_bytes())
    ctxs = [c for c in man["contexts"] if c["values_mode"] == cfg["values_mode"]]
    if cfg.get("cross_check_manifest"):
        other = json.loads(cfg["cross_check_manifest"].read_bytes())
        if sorted((c["view_id"], c["context_sha256"]) for c in other["contexts"]) != sorted((c["view_id"], c["context_sha256"]) for c in ctxs):
            raise SystemExit("research manifests disagree on the context set")
    by = collections.defaultdict(list)
    for c in ctxs:
        by[c["dataset_hash"]].append(c)
    return by, ref(cfg["manifest"])


def plan_entry_extra(scope: str, h: str, mctx, cfg) -> dict:
    """Rights fields of the research scope, read from the published research contexts (must agree per dataset)."""
    if scope != "research-clean":
        return {}
    vals = set()
    for c in mctx:
        hits = glob.glob(str(cfg["published_tree"] / "shard-*" / c["view_id"] / "context.json"))
        if len(hits) != 1:
            raise SystemExit(f"{c['view_id']}: {len(hits)} published research contexts")
        d = json.loads(Path(hits[0]).read_bytes())
        vals.add((d.get("rights"), d.get("rights_decision")))
    if len(vals) != 1 or next(iter(vals))[0] != "research-only":
        raise SystemExit(f"{h}: research rights fields disagree: {vals}")
    r, dec = vals.pop()
    return {"rights": r, "rights_decision": dec}


GROUP_ANNOTATION_RULE = ("registry split (grouped-stratified-kfold/v1) reproduced only with group = one T1 feature column "
                         "(split-scope-nonraw census); split v2 groups exact-duplicate feature rows only, so the annotated "
                         "group union is dropped; owner decision on group unions pending (contexts may be rebuilt later)")


def group_annotations() -> dict:
    """dataset_hash -> the scope receipt's group-annotated record (+ its subroute)."""
    d = json.loads(SCOPE_RECEIPT.read_bytes())
    out = {}
    for k, v in d["per_subroute"].items():
        for x in v.get("group_annotated_datasets", []):
            out[x["dataset_hash"]] = dict(x, subroute=k)
    return out


def group_annotation_fields(ga, names=None) -> dict:
    """The record/context fields for one dataset: dropped flag and the inferred registry group column (or 'ambiguous'
    with the candidates). `names`: the T1 table's column names (feature columns then target), when known."""
    if not ga:
        return {"group_annotation_dropped": False, "registry_group_column": None}

    def col(c):
        c = int(c)
        return {"t1_column_index": c, "t1_column_name": (names[c] if names is not None and 0 <= c < len(names) else None),
                "n_columns": ga.get("n_columns"), "distinct_values": ga.get("distinct_values"), "components": ga.get("components")}
    cols = list(ga["columns"])
    out = {"group_annotation_dropped": True,
           "group_annotation_source": f"{SCOPE_RECEIPT.name}#per_subroute.{ga.get('subroute')}.group_annotated_datasets",
           "group_annotation_rule": GROUP_ANNOTATION_RULE}
    if len(cols) == 1:
        out["registry_group_column"] = col(cols[0])
    else:
        out["registry_group_column"] = "ambiguous"
        out["registry_group_column_candidates"] = [col(c) for c in cols]
    return out


def t1_column_names(meta, width) -> list:
    try:
        return [s["name"] for s in t1prep.layout(meta, width)] + ["target"]
    except t1prep.T1PrepError:
        return None


def est_cost(e) -> float:
    return float(e["shape"]["sample_rows"]) * (min(int(e["shape"]["columns"]), 400) + 20)


def make_plan(a, extra_entry=None, extra_inputs=None) -> int:
    """plan.json + existing-view-ids.json for one new tree (both create-only; an identical plan.json is accepted)."""
    version = require_split_version(getattr(a, "split_version", None))         # before any read or write
    scope = a.plan
    cfg = SCOPES[scope]
    tree = TREES_V2G[scope] if version == SPLIT_V2G else cfg["tree"]
    out = Path(a.out)
    if any(out.resolve() == t.resolve() for t in OLD_TREES + ((cfg["tree"],) if version == SPLIT_V2G else ()) if t.exists()):
        raise SystemExit(f"{out} is an existing tree; split-v2 trees are new and create-only")
    if out.resolve() != tree.resolve() and not a.allow_other_out:
        raise SystemExit(f"--out for {scope} is {tree} (pass --allow-other-out for a pilot directory)")
    check_pins()
    out.mkdir(parents=True, exist_ok=True)
    by_m, man_ref = manifest_scope(scope)
    src = scale_check.Sources(load_index=False)
    by_e = collections.defaultdict(list)
    for r in src.included():
        by_e[r["dataset_hash"]].append(r)
    leak = {}
    for l in LEAK_V2.read_bytes().decode().splitlines():
        if l.strip():
            r = json.loads(l)
            leak[r["view_id"]] = r["row_selection_leak"]
    inv = json.loads(INVENTORY.read_bytes())
    inv0 = json.loads(DATASETS_INV.read_text())
    groups = group_annotations()
    entries = []
    for h in sorted(by_m):
        mctx = sorted(by_m[h], key=lambda c: int(c["fold"]))
        ep = sorted(by_e[h], key=lambda r: int(r["fold"]))
        if [(r["view_id"], r["context_sha256"]) for r in ep] != [(c["view_id"], c["context_sha256"]) for c in mctx]:
            raise SystemExit(f"{h}: the manifest does not hold every included epoch-0 context of the dataset")
        labels = {json.dumps(leak.get(c["view_id"])) for c in mctx}
        if labels != {json.dumps(["clean"])}:
            raise SystemExit(f"{h}: epoch-0 row-selection labels {labels}")
        iv = inv[h]
        if iv["class"] != ["clean"] or [int(c["fold"]) for c in mctx] != [int(f) for f in iv["folds"]]:
            raise SystemExit(f"{h}: inventory class/folds {iv['class']}/{iv['folds']}")
        pub = []
        for c in mctx:
            hits = glob.glob(str(cfg["published_tree"] / "shard-*" / c["view_id"] / "context.json"))
            if len(hits) != 1 or sha_file(hits[0]) != c["local_context_json_sha256"]:
                raise SystemExit(f"{c['view_id']}: published context.json missing or differs from the manifest")
            pub.append(hits[0])
        e = {"dataset_hash": h, "cohort": mctx[0]["cohort"], "values_mode": cfg["values_mode"], "rights": cfg["rights"],
             "epoch0": [{"view_id": c["view_id"], "context_sha256": c["context_sha256"], "fold": int(c["fold"]),
                         "published_context_json": {"path": p, "sha256": c["local_context_json_sha256"]}}
                        for c, p in zip(mctx, pub)],
             "epoch0_labels": ["clean"],
             "registry_split": {"sha256": iv["split_sha256"], "key": iv.get("split_key"), "version_id": iv.get("split_version_id"),
                                "local": iv.get("split_local")},
             "shape": iv["shape"]}
        x = plan_entry_extra(scope, h, mctx, cfg)
        ga = groups.get(h)
        names = t1_column_names(load_meta(h, inv0)[0], int(ga["n_columns"])) if ga else None
        x.update(group_annotation_fields(ga, names))
        e["context_extra"] = x
        if extra_entry is not None:
            extra_entry(e)
        entries.append(e)
    if version == SPLIT_V2G:
        entries = plan_v2g_entries(entries, scope, inv0)
    loads = [0.0] * a.of
    for e in sorted(entries, key=lambda e: (-est_cost(e), e["dataset_hash"])):     # LPT: deterministic balance
        i = min(range(a.of), key=lambda k: (loads[k], k))
        e["shard"], e["est_cost"] = i, est_cost(e)
        loads[i] += est_cost(e)
    ex_path = out / "existing-view-ids.json"
    if ex_path.exists():
        ex_body = ex_path.read_bytes()
    else:
        ids, counts = scan_existing_view_ids(exclude=[out] + list(NEW_TREES))
        ex_body = jdump({"schema": EXISTING_SCHEMA, "view_ids": ids, "counts": counts, "count": len(ids),
                         "sources": {"build_v2": str(BUILD_V2), "denylist": ref(DENYLIST)},
                         "excluded_trees": sorted(str(t) for t in NEW_TREES)})
        create_only(ex_path, ex_body)
    ex = json.loads(ex_body)
    doc = {"schema": PLAN_SCHEMA, "scope": scope, "values_mode": cfg["values_mode"], "split_version": version,
           "partition": routes(version)[cfg["values_mode"]]["partition"], "view_tag": routes(version)[cfg["values_mode"]]["tag"],
           "of": a.of,
           "tree": str(out), "datasets": entries,
           "counts": {"datasets": len(entries), "epoch0_contexts": sum(len(e["epoch0"]) for e in entries),
                      "new_contexts": OUTER_FOLDS * len(entries),
                      "datasets_with_fewer_than_5_epoch0_contexts": sum(len(e["epoch0"]) < OUTER_FOLDS for e in entries),
                      "group_annotation_dropped_datasets": sum(e["context_extra"]["group_annotation_dropped"] for e in entries),
                      "refused_datasets": sum(e.get("disposition", "build") != "build" for e in entries),
                      "rows": sum(int(e["shape"]["sample_rows"]) for e in entries)},
           "shard_est_cost": loads, "epoch": src.epoch_ref,
           "inputs": {"manifest": man_ref, "inventory": ref(INVENTORY), "row_selection_leak_v2": ref(LEAK_V2),
                      "split_scope_receipt": ref(SCOPE_RECEIPT), "owner_decision": ref(OWNER_DECISION),
                      "holdout_denylist_v2": ref(DENYLIST), "epoch0_datasets": ref(DATASETS_INV)}
                     | ({"cross_check_manifest": ref(cfg["cross_check_manifest"])} if cfg.get("cross_check_manifest") else {})
                     | (extra_inputs or {})
                     | ({"census": ref(CENSUS), "v2split_complete_marker": ref(cfg["tree"] / ".complete")} if version == SPLIT_V2G else {}),
           "existing_view_ids": {"path": str(ex_path), "sha256": sha(ex_body), "count": ex["count"], "counts": ex["counts"]},
           "outer_folds": OUTER_FOLDS, "replaced_cut": REGISTRY_CUT}
    p = out / "plan.json"
    body = (json.dumps(doc, indent=1, sort_keys=True) + "\n").encode()
    if p.exists() and p.read_bytes() != body:
        raise SystemExit(f"{p} exists with different content; refusing to replace a pinned plan")
    if not p.exists():
        create_only(p, body)
    print(json.dumps({"plan": str(p), "sha256": sha(body), "counts": doc["counts"], "shard_est_cost": loads,
                      "existing_view_ids": doc["existing_view_ids"]["count"]}))
    return 0


def registry_port_check(split_sha: str, column: int) -> dict:
    """Re-run the pinned registry port with group = the column's field bytes on the local registry split object (and the
    T1 blobs it binds); every repeat/fold must equal the object's folds exactly."""
    import importlib.util
    if sha_file(REGISTRY_PORT) != PINS[REGISTRY_PORT]:
        raise SystemExit("registry port drift")
    spec = importlib.util.spec_from_file_location("registry_port_gsk", REGISTRY_PORT)
    gsk = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(gsk)
    try:
        body, path = gsk.load_verified(split_sha, gsk.SPLIT_DIRS)
    except FileNotFoundError:
        return {"reproduced": False, "reason": "registry_split_object_not_local"}
    split = json.loads(body)
    if split.get("method") != REGISTRY_CUT["method"] or split.get("task") != "regression":
        return {"reproduced": False, "reason": "registry_split_method", "split_object": path}
    rows = gsk.universe(split)
    keys = [gsk.dup_key(r) for r in rows]
    seed = split["folds"][0]["seed"]
    k, folds, comps = gsk.generate_folds(keys, seed, groups=[r[int(column)] for r in rows])
    ok = k == split["effective_folds"] and folds == split["folds"]
    return {"reproduced": bool(ok), "split_object": {"path": path, "sha256": split_sha}, "rows": len(rows),
            "folds_compared": len(split["folds"]), "effective_folds": split["effective_folds"], "components": len(comps),
            "port": {"path": str(REGISTRY_PORT), "sha256": PINS[REGISTRY_PORT]}, "column": int(column)}


def plan_v2g_entries(entries, scope: str, inv0) -> list:
    """GROUP-UNION-B scope: the group-annotated datasets only, each with its group column (evidence rule, or refused with
    a reason) and the as-built v2split dataset record and cut it supersedes."""
    cen = {}
    for l in CENSUS.read_bytes().decode().splitlines():
        if l.strip():
            r = json.loads(l)
            cen[r["dataset_hash"]] = r
    ga_all = group_annotations()
    v2tree = SCOPES[scope]["tree"]
    out = []
    for e in entries:
        if not e["context_extra"].get("group_annotation_dropped"):
            continue
        h = e["dataset_hash"]
        ga = ga_all[h]
        names = t1_column_names(load_meta(h, inv0)[0], int(ga["n_columns"]))
        hits = glob.glob(str(v2tree / "shard-*" / "_datasets" / f"{h}.json"))
        if len(hits) != 1:
            raise SystemExit(f"{h}: {len(hits)} v2split dataset records")
        r = json.loads(Path(hits[0]).read_bytes())
        if r["status"] != "done":
            raise SystemExit(f"{h}: v2split record status {r['status']}")
        e["v2split"] = {"tree": str(v2tree), "record": {"path": hits[0], "sha256": sha_file(hits[0])}, "cut_id": r["cut"]["cut_id"],
                        "split_sha256": r["split"]["sha256"], "view_ids": [c["view_id"] for c in r["contexts"]],
                        "status": "superseded locally by GROUP-UNION-B (nothing deleted)"}
        e["context_extra"] = dict(e["context_extra"], group_annotation_dropped=False, group_annotation_kept=True)
        res = resolve_group_column(cen.get(h), ga, names)
        if "spec" in res:                                              # fresh port reproduction, else refused
            port = registry_port_check(e["registry_split"]["sha256"], res["spec"]["index"])
            res["evidence"] = dict(res["evidence"], registry_port_rerun=port)
            if not port["reproduced"]:
                res = {"refused": "registry_port_does_not_reproduce", "evidence": res["evidence"]}
        if "refused" in res and res["refused"] == "ambiguous_group_column_unresolved":
            e["group_column"] = {"ambiguous": sorted(int(c) for c in cen[h]["reproducing_group_columns"]), "names": names,
                                 "evidence": res["evidence"]}           # resolved on the universe at build time
        elif "refused" in res:
            e.update(disposition="not_built", reason=res["refused"], group_column_evidence=res.get("evidence"))
        else:
            e["group_column"] = res
        out.append(e)
    return out


def load_plan(out: Path) -> tuple:
    b = (out / "plan.json").read_bytes()
    return json.loads(b), sha(b)


# ------------------------------------------------------------------------------------------- build

def build_v2(a, loader=None, codes=None) -> int:
    asked = require_split_version(getattr(a, "split_version", None))           # before any read or write
    cpuguard.set_threads(2)
    out = Path(a.out)
    pl, plan_sha = load_plan(out)
    version = pl["split_version"]
    if pl["of"] != a.of or version not in (SPLIT_V2, SPLIT_V2G) or version != asked:
        raise SystemExit(f"plan is for --of {pl['of']} / {pl['split_version']}")
    mode = pl["values_mode"]
    loader = loader or l7b_loader
    codes = codes or code_shas_v2(version=version)
    existing = load_existing(out, pl)
    out_shard = out / f"shard-{a.shard}"
    out_shard.mkdir(parents=True, exist_ok=True)
    src = scale_check.Sources(load_index=False)
    cache = scale_check.DataCache(max_items=2)
    inv = json.loads(DATASETS_INV.read_text())
    by_dataset = collections.defaultdict(list)
    for r in src.included():
        by_dataset[r["dataset_hash"]].append(r)
    mine = [e for e in pl["datasets"] if e["shard"] == a.shard and e.get("disposition", "build") == "build"]
    if a.datasets:
        keep = set(a.datasets.split(","))
        mine = [e for e in mine if e["dataset_hash"] in keep]
    guard = cpuguard.Guard(journal_path=out / f"shard-{a.shard}.guard.jsonl")
    t0, c0 = time.time(), cpu_s()
    done_now, skipped, failed = [], [], []
    for n, e in enumerate(sorted(mine, key=lambda e: (-e["est_cost"], e["dataset_hash"]))):
        h = e["dataset_hash"]
        if dataset_done(out_shard, h, codes):
            skipped.append(h)
            continue
        guard.wait()
        rec = run_dataset_v2(e, out_shard, mode, loader, existing, codes, guard, ctx_args=(src, cache, inv, by_dataset),
                             version=version)
        if rec["status"] == "done":
            done_now.append(h)
        else:
            failed.append({"dataset_hash": h, "reason": rec.get("reason"), "detail": (rec.get("detail") or "")[:500],
                           "epoch0_contexts": len(e["epoch0"])})
        print(json.dumps({"shard": a.shard, "n": n + 1, "of": len(mine), "dataset": h, "status": rec["status"],
                          "reason": rec.get("reason"), "cpu_s": rec["cpu_s"], "elapsed_s": round(time.time() - t0)}), flush=True)
    rec = {"schema": SHARD_SCHEMA, "shard": a.shard, "of": a.of, "plan_sha256": plan_sha, "values_mode": mode, "split_version": version,
           "datasets_filter": a.datasets, "expected_datasets": len(mine), "done_now": len(done_now), "already_done": len(skipped),
           "failed": failed, "complete": not failed and len(done_now) + len(skipped) == len(mine),
           "cpu_s": round(cpu_s() - c0, 1), "wall_s": round(time.time() - t0, 1), "maxrss_mb": maxrss_mb(),
           "guard": guard.summary(), "published": False, "code_sha256": codes, "utc_us": int(time.time() * 1e6)}
    name = f"shard-{a.shard}-of-{a.of}.receipt.json" if not a.datasets else f"shard-{a.shard}-of-{a.of}.partial-{int(time.time())}.receipt.json"
    atomic(out / name, (json.dumps(rec, indent=1, sort_keys=True) + "\n").encode())
    print(json.dumps({k: rec[k] for k in ("shard", "expected_datasets", "done_now", "already_done", "complete", "cpu_s", "wall_s")}
                     | {"failed": len(failed)}))
    return 0 if rec["complete"] else 1


# ------------------------------------------------------------------------------------------- verify + summary

def verify_tree(out: Path, pl, codes) -> dict:
    """Re-read the tree: every done dataset's contexts (.done, files vs recorded sha256, identity recomputed, view_id
    form, cut_id formula, split gates, counterfactual), orphans, and view_id collisions against a FRESH scan of every
    other context.json under build-v2 plus the holdout denylist v2."""
    mode = pl["values_mode"]
    version = pl["split_version"]
    route = routes(version)[mode]
    problems, new_ids, ctx_dirs = [], [], set()
    counts = collections.Counter()
    failures = []
    datasets = []
    for e in pl["datasets"]:
        h = e["dataset_hash"]
        sd = out / f"shard-{e['shard']}"
        p = sd / "_datasets" / f"{h}.json"
        counts["planned_datasets"] += 1
        counts["planned_epoch0_contexts"] += len(e["epoch0"])
        if e.get("disposition", "build") != "build":
            counts["refused_datasets"] += 1
            failures.append({"dataset_hash": h, "reason": e.get("reason"), "refused_at": "plan",
                             "evidence": e.get("group_column_evidence"), "epoch0_contexts_kept": len(e["epoch0"])})
            continue
        if not p.exists():
            counts["missing_records"] += 1
            failures.append({"dataset_hash": h, "reason": "not_built", "epoch0_contexts_kept": len(e["epoch0"])})
            continue
        r = json.loads(p.read_bytes())
        row = {"dataset_hash": h, "shard": e["shard"], "status": r["status"], "reason": r.get("reason"),
               "record": {"path": str(p), "sha256": sha_file(p)}, "epoch0_contexts": len(e["epoch0"]),
               "cpu_s": r.get("cpu_s"), "maxrss_mb": r.get("maxrss_mb")}
        if r["status"] != "done":
            counts["failed_datasets"] += 1
            counts["failed_epoch0_contexts_kept"] += len(e["epoch0"])
            failures.append({"dataset_hash": h, "reason": r.get("reason"), "detail": (r.get("detail") or "")[:600],
                             "epoch0_contexts_kept": len(e["epoch0"])})
            datasets.append(row)
            continue
        if r.get("code_sha256") != codes:
            problems.append(f"{h}: built with other code")
        if version == SPLIT_V2G:
            want_replaces = [e["registry_split"]["sha256"], e["v2split"]["cut_id"]]
            if (r["cut"]["cut_id"] != rowsel_split_v2_groups.cut_id(r["split"]["sha256"]) or r["split"]["schema"] != SPLIT_V2G
                    or r["split"]["annotated_groups_straddling_folds"] or r["cut"]["replaces_cut"] != want_replaces
                    or r["split"]["group_column"] != r["group_column"]["spec"]):
                problems.append(f"{h}: v2g cut/split identity or group straddle")
        else:
            want_replaces = e["registry_split"]["sha256"]
            if r["cut"]["cut_id"] != CUT_PREFIX + r["split"]["sha256"] or r["split"]["schema"] != SPLIT_V2:
                problems.append(f"{h}: cut/split identity")
        if r["split"]["groups_straddling_folds"] or not r["split"]["target_invariant"] or not r["split"]["value_check_invariant"]:
            problems.append(f"{h}: split gate")
        empty = r["split"].get("empty_folds") or []
        if len(r["contexts"]) != OUTER_FOLDS - len(empty) or (empty and not (version == SPLIT_V2G and r["split"].get("effective_folds")
                                                                              == OUTER_FOLDS - len(empty))):
            problems.append(f"{h}: {len(r['contexts'])} contexts, empty folds {empty}")
        for c in r["contexts"]:
            d = sd / c["view_id"]
            ctx_dirs.add(str(d))
            new_ids.append(c["view_id"])
            if not (d / ".done").exists():
                problems.append(f"{c['view_id']}: no .done")
                continue
            cj = json.loads((d / "context.json").read_bytes())
            ident = sha(canon(cj["identity_body"]))
            checks = {"identity": ident == cj["identity"] == c["identity"],
                      "view_id": cj["view_id"] == c["view_id"] == make_view_id(h, cj["fold"], route["tag"], ident),
                      "cut": cj["cut"] == r["cut"] and cj["cut"]["comparable_with_replaced"] is False
                      and cj["cut"]["replaces_cut"] == want_replaces
                      and cj["cut"]["partition"] == route["partition"],
                      "split": cj["split"]["sha256"] == r["split"]["sha256"] and cj["split"]["groups_straddling_folds"] == 0
                      and cj["split"]["target_invariant"] is True,
                      "counterfactual": cj["counterfactual"]["train_side_invariant"] is True,
                      "epoch0_replaced": cj["epoch0_replaced"]["level"] == "dataset"
                      and [x["view_id"] for x in cj["epoch0_replaced"]["contexts"]] == [x["view_id"] for x in e["epoch0"]],
                      "context_sha256": cj["context_sha256"] == c["context_sha256"],
                      "group_annotation": all(cj.get(k) == v for k, v in (e.get("context_extra") or {}).items())
                      and "group_annotation_dropped" in cj,
                      "files": all(sha_file(d / n) == m["sha256"] and (d / n).stat().st_size == m["bytes"]
                                   for n, m in cj["files"].items()),
                      "jtt1": jtt1.parse_header(gzip.decompress((d / "encoder.jtt1.gz").read_bytes()))["n_train"] == cj["n_train"],
                      "published_false": cj["published"] is False,
                      "target_linear": "target_linear" in cj and cj["target_linear"].get("verdict") != target_linear.REFUSE}
            if (cj.get("target_linear") or {}).get("verdict") == target_linear.REVIEW:
                counts["target_linear_near_review_contexts"] += 1
            bad = sorted(k for k, ok in checks.items() if not ok)
            if bad:
                problems.append(f"{c['view_id']}: {bad}")
            counts["verified_contexts"] += 1
        counts["done_datasets"] += 1
        counts["done_new_contexts"] += len(r["contexts"])
        counts["epoch0_contexts_replaced"] += len(e["epoch0"])
        counts["context_count_changed_datasets"] += int(r["epoch0_replaced"]["context_count_changed"])
        row.update(new_view_ids=[c["view_id"] for c in r["contexts"]], cut_id=r["cut"]["cut_id"],
                   fold_sizes=r["split"]["fold_sizes"], groups=r["split"]["groups"], duplicate_rows=r["split"]["duplicate_rows"],
                   universe_rows=r["universe"]["rows"])
        datasets.append(row)
    orphans = []
    for sd in sorted(out.glob("shard-*")):
        if sd.is_dir():
            for d in sd.iterdir():
                if d.is_dir() and d.name != "_datasets" and str(d) not in ctx_dirs:
                    orphans.append(str(d))
    existing, ex_counts = scan_existing_view_ids(exclude=[out])
    frozen = set(json.loads((out / "existing-view-ids.json").read_bytes())["view_ids"])
    coll = sorted(set(new_ids) & set(existing))
    coll_frozen = sorted(set(new_ids) & frozen)
    dup = sorted(v for v, k in collections.Counter(new_ids).items() if k > 1)
    counts["orphan_context_dirs"] = len(orphans)
    return {"counts": dict(counts), "problems": problems, "failures": failures, "orphans": orphans, "datasets": datasets,
            "view_id_collisions": {"fresh_scan_existing": len(existing), "fresh_scan_counts": ex_counts,
                                   "collisions_fresh": coll, "collisions_plan_frozen": coll_frozen, "duplicates_within_tree": dup,
                                   "new_view_ids": len(new_ids)},
            "passed": not problems and not orphans and not coll and not coll_frozen and not dup}


def pilot_compare(out: Path, pilot_receipt) -> dict | None:
    """The pilot's contexts (a separate directory) must equal the full tree's: same view_ids and file sha256s."""
    if not pilot_receipt:
        return None
    pr = json.loads(Path(pilot_receipt).read_bytes())
    res = {}
    for h, d in pr.get("datasets", {}).items():
        want = {c["view_id"]: c["files"] for c in d.get("contexts", [])}
        got = {}
        for vid in want:
            hits = glob.glob(str(out / "shard-*" / vid / "context.json"))
            got[vid] = ({k: m["sha256"] for k, m in json.loads(Path(hits[0]).read_bytes())["files"].items()} if len(hits) == 1 else None)
        res[h] = {"contexts": len(want), "same": want == got}
    return {"receipt": ref(pilot_receipt), "datasets": res, "all_same": all(v["same"] for v in res.values())}


def group_summary(out: Path, pl) -> dict:
    """The group-annotated datasets of this tree (group union dropped by split v2; owner decision pending), with their
    build status and new view_ids, and the scope receipt's clean group-annotated datasets outside this tree."""
    rows = []
    for e in pl["datasets"]:
        x = e.get("context_extra") or {}
        if not x.get("group_annotation_dropped"):
            continue
        p = out / f"shard-{e['shard']}" / "_datasets" / f"{e['dataset_hash']}.json"
        r = json.loads(p.read_bytes()) if p.exists() else {}
        rows.append({"dataset_hash": e["dataset_hash"], "registry_group_column": x.get("registry_group_column"),
                     "registry_group_column_candidates": x.get("registry_group_column_candidates"),
                     "status": r.get("status", "not_built"), "new_view_ids": [c["view_id"] for c in r.get("contexts", [])]})
    clean = {h: g for h, g in group_annotations().items() if g["subroute"].startswith("clean")}
    planned = {e["dataset_hash"] for e in pl["datasets"]}
    return {"rule": GROUP_ANNOTATION_RULE, "datasets": rows, "count": len(rows),
            "scope_receipt": ref(SCOPE_RECEIPT), "scope_receipt_clean_group_annotated": len(clean),
            "clean_group_annotated_not_in_this_tree": sorted(h for h in clean if h not in planned)}


def group_union_summary(out: Path, pl) -> dict:
    """GROUP-UNION-B: every planned dataset with its group column (or refusal), status, new view_ids and the v2split cut
    and contexts it supersedes."""
    rows = []
    for e in pl["datasets"]:
        p = out / f"shard-{e['shard']}" / "_datasets" / f"{e['dataset_hash']}.json"
        r = json.loads(p.read_bytes()) if p.exists() else {}
        gc = r.get("group_column") or e.get("group_column") or {}
        rows.append({"dataset_hash": e["dataset_hash"], "group_column": gc.get("spec"), "source": gc.get("source"),
                     "status": r.get("status") or ("refused" if e.get("disposition") == "not_built" else "not_built"),
                     "reason": r.get("reason") or e.get("reason"), "cut_id": (r.get("cut") or {}).get("cut_id"),
                     "annotated_groups": (r.get("split") or {}).get("annotated_groups"),
                     "components": (r.get("split") or {}).get("components"),
                     "fold_sizes": (r.get("split") or {}).get("fold_sizes"),
                     "new_view_ids": [c["view_id"] for c in r.get("contexts", [])],
                     "supersedes_v2split": {k: e["v2split"][k] for k in ("cut_id", "view_ids", "record")}})
    return {"rule": rowsel_split_v2_groups.RULE, "datasets": rows, "count": len(rows),
            "done": sum(r["status"] == "done" for r in rows), "refused": sum(r["status"] == "refused" for r in rows),
            "module": {"path": "dltrain/rowsel_split_v2_groups.py", "sha256": sha_file(Path(__file__).resolve().parents[1]
                                                                                       / "dltrain" / "rowsel_split_v2_groups.py")},
            "census": ref(CENSUS), "scope_receipt": ref(SCOPE_RECEIPT)}


def summarize_v2(a, codes=None, stem=None) -> int:
    out = Path(a.out)
    pl, plan_sha = load_plan(out)
    codes = codes or code_shas_v2(version=pl["split_version"])
    stem = a.receipt_stem or stem or (f"nonraw-v2gsplit-{pl['scope']}" if pl["split_version"] == SPLIT_V2G else f"nonraw-v2split-{pl['scope']}")
    ts = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    ver = verify_tree(out, pl, codes)
    pilot = pilot_compare(out, a.pilot)
    vdoc = {"schema": VERIFY_SCHEMA, "utc_us": int(time.time() * 1e6), "tree": str(out), "scope": pl["scope"],
            "plan": {"path": str(out / "plan.json"), "sha256": plan_sha}, "split_version": pl["split_version"],
            "partition": pl["partition"], "code_sha256": codes, "pilot_vs_full": pilot, **ver,
            "passed": ver["passed"] and (pilot is None or pilot["all_same"])}
    vp = RECEIPTS / "build" / f"{stem}-verify-{ts}.json"
    vbody = (json.dumps(vdoc, indent=1, sort_keys=True) + "\n").encode()
    create_only(vp, vbody)
    shard_receipts = []
    for p in sorted(out.glob(f"shard-*-of-{pl['of']}.receipt.json")):
        r = json.loads(p.read_bytes())
        shard_receipts.append(ref(p) | {k: r.get(k) for k in ("expected_datasets", "done_now", "already_done", "complete", "cpu_s",
                                                              "wall_s", "maxrss_mb", "guard", "plan_sha256")}
                              | {"failed": len(r.get("failed", []))})
    mut = json.loads(Path(a.mutants).read_bytes())
    root = Path(__file__).resolve().parents[1]
    tests_file = root / "tests" / "test_v2_nonraw_split_v2.py"
    sdoc = {"schema": SUMMARY_SCHEMA, "utc_us": int(time.time() * 1e6), "tree": str(out), "scope": pl["scope"],
            "values_mode": pl["values_mode"], "split_version": pl["split_version"], "partition": pl["partition"],
            "plan": {"path": str(out / "plan.json"), "sha256": plan_sha, "counts": pl["counts"], "inputs": pl["inputs"],
                     "existing_view_ids": pl["existing_view_ids"]},
            "verify": {"path": str(vp), "sha256": sha(vbody), "passed": vdoc["passed"], "problems": len(ver["problems"])},
            "counts": ver["counts"], "failures": ver["failures"],
            "failure_reasons": dict(collections.Counter(f["reason"] for f in ver["failures"])),
            "view_id_collisions": {k: (len(v) if isinstance(v, list) else v) for k, v in ver["view_id_collisions"].items()},
            "shard_receipts": shard_receipts,
            "cpu": {"dataset_cpu_s": round(sum((d.get("cpu_s") or 0) for d in ver["datasets"]), 1),
                    "shard_process_cpu_s": round(sum((s.get("cpu_s") or 0) for s in shard_receipts), 1)},
            "tests": {"log": ref(a.tests_log), "tail": Path(a.tests_log).read_text().strip().splitlines()[-3:]},
            "mutants": {"path": a.mutants, "sha256": sha_file(a.mutants), "totals": mut.get("totals"),
                        "survived": [k for k, v in mut.get("mutants", {}).items() if not v.get("killed")],
                        "leak_mutants_killed": mut.get("totals", {}).get("leak_killed")},
            "group_annotation_dropped": group_summary(out, pl) if pl["split_version"] == SPLIT_V2 else None,
            "group_union": group_union_summary(out, pl) if pl["split_version"] == SPLIT_V2G else None,
            "pilot_vs_full": pilot,
            "code_sha256": codes | {t: sha_file(root / t) for t in ("tests/test_v2_nonraw_split_v2.py", "tests/test_v2_nonraw_split_v2g.py")
                                    if (root / t).exists()},
            "owner_decision": pl["inputs"]["owner_decision"], "policy": POLICY}
    sp = RECEIPTS / "build" / f"{stem}-summary-{ts}.json"
    sbody = (json.dumps(sdoc, indent=1, sort_keys=True) + "\n").encode()
    create_only(sp, sbody)
    complete = vdoc["passed"] and not ver["counts"].get("missing_records")
    marker = None
    if complete:
        marker = out / ".complete"
        create_only(marker, jdump({"schema": "jope.dl-v2-nonraw-v2split-tree-complete/v1", "tree": str(out), "scope": pl["scope"],
                                   "split_version": pl["split_version"], "summary": {"path": str(sp), "sha256": sha(sbody)},
                                   "verify": {"path": str(vp), "sha256": sha(vbody)}, "counts": ver["counts"],
                                   "published": False, "utc_us": int(time.time() * 1e6)}))
    print(json.dumps({"verify": str(vp), "verify_sha256": sha(vbody), "summary": str(sp), "summary_sha256": sha(sbody),
                      "counts": ver["counts"], "failure_reasons": sdoc["failure_reasons"], "problems": ver["problems"][:5],
                      "collisions": sdoc["view_id_collisions"], "complete_marker": str(marker) if marker else None}))
    return 0 if complete else 1


# ------------------------------------------------------------------------------------------- CLI

def arg_parser():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", required=True)
    ap.add_argument("--shard", type=int)
    ap.add_argument("--of", type=int, required=True)
    ap.add_argument("--split-version", choices=SPLIT_VERSIONS, required=True,
                    help="required, no default (PR #218 finding 10): rowsel-raw-split-v2 or rowsel-split-v2-groups; "
                         "registry-epoch0 only for an explicit historical replay")
    ap.add_argument("--views", help="registry build only: comma-separated view_ids (reproduction checks)")
    ap.add_argument("--plan", choices=tuple(SCOPES), help="split v2: write the tree's plan.json for this scope")
    ap.add_argument("--allow-other-out", action="store_true", help="split v2 plan: a pilot directory instead of the scope tree")
    ap.add_argument("--datasets", help="split v2 build: comma-separated dataset hashes (pilot / smoke runs only)")
    ap.add_argument("--summarize", action="store_true")
    ap.add_argument("--tests-log")
    ap.add_argument("--mutants")
    ap.add_argument("--pilot")
    ap.add_argument("--receipt-stem")
    return ap


def main(argv=None):
    ap = arg_parser()
    a = ap.parse_args(argv)
    if a.split_version == SPLIT_REGISTRY:
        if a.plan or a.summarize or a.datasets:
            ap.error("--plan/--summarize/--datasets need --split-version rowsel-raw-split-v2")
        if a.shard is None:
            ap.error("--shard is required for a build")
        return build_registry(a)
    if a.views:
        ap.error("--views is for the registry build only")
    if a.plan:
        if SCOPES[a.plan]["values_mode"] != "L7b":
            ap.error(f"scope {a.plan} is built by tools/v2_build_l7a.py")
        return make_plan(a)
    if a.summarize:
        return summarize_v2(a)
    if a.shard is None:
        ap.error("--shard is required for a build")
    return build_v2(a)


if __name__ == "__main__":
    sys.exit(main())
