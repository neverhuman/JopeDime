def check_pins():
    got = {}
    for p, want in PINS.items():
        h = sha(p.read_bytes())
        if not h.startswith(want):
            raise SystemExit(f"pin drift: {p} {h} (want {want})")
        got[str(p)] = h
    return got


def recipe_digest(recipe):
    return {"sha256": sha(canonical(recipe)), "summary": {k: v for k, v in recipe.items()
                                                          if not isinstance(v, (list, dict)) or k in ("scales",)}}


class Runner:
    def __init__(self, ledger, components=COMPONENTS, v6=None, v6all=None):
        import torch
        sys.path.insert(0, str(ENC_ROOT))
        from gpu_encoders import Encoders  # noqa: E402  (Codex's pinned forwards, read-only)
        from safetensors.torch import load_file
        self.torch, self.ledger = torch, ledger
        self.enc = Encoders()
        self.qualification = self.enc.qualify()
        self.norm = load_file(str(ENC_ROOT / "models/context-transforms"), device="cuda:0")
        self.uuid = nvidia("uuid")[0][0]
        self.components, self.v6 = tuple(components), None
        if v6:   # HYPERION-V6: the fine-tuned weights in the same pinned architecture, encoded with the same v5 recipe
            from hyperion_reference import MatrixGhostUnifiedStandalone  # noqa: E402
            path, want = v6
            if sha(Path(path).read_bytes()) != want:
                raise SystemExit(f"hyperion v6 weights sha256 mismatch: {path}")
            m = MatrixGhostUnifiedStandalone().float().cuda().eval()
            missing, extra = m.load_state_dict(load_file(str(path), device="cuda:0"), strict=False)
            if missing or any(not x.startswith(("cell_mlp", "h_")) for x in extra):
                raise SystemExit("hyperion v6 weights do not bind the complete embedding architecture")
            self.v6 = m
        if v6all:   # HYPERION-V6ALL: same binding and checks as hyperion_v6; the swap mirrors Runner.one's hyperion_v6 branch
            from hyperion_reference import MatrixGhostUnifiedStandalone  # noqa: E402
            path, want = v6all
            if sha(Path(path).read_bytes()) != want:
                raise SystemExit(f"hyperion v6all weights sha256 mismatch: {path}")
            m = MatrixGhostUnifiedStandalone().float().cuda().eval()
            missing, extra = m.load_state_dict(load_file(str(path), device="cuda:0"), strict=False)
            if missing or any(not x.startswith(("cell_mlp", "h_")) for x in extra):
                raise SystemExit("hyperion v6all weights do not bind the complete embedding architecture")
            enc = self.enc

            def hyperion_v6all(X, y=None, _m=m):
                saved = enc.models.get("hyperion")
                enc.models["hyperion"] = _m
                try:
                    return enc.hyperion(X)
                finally:
                    if saved is None:
                        enc.models.pop("hyperion", None)
                    else:
                        enc.models["hyperion"] = saved
            enc.hyperion_v6all = hyperion_v6all
            self.v6all = m

    def one(self, view, comp, X, y, kind, parent=None):
        torch = self.torch
        self.ledger.begin(view, comp, kind)
        torch.cuda.reset_peak_memory_stats(); t0 = time.time()
        try:
            if comp == "hyperion":
                arrays, recipe = self.enc.hyperion(X)
            elif comp == "hyperion_v6":
                saved = self.enc.models.get("hyperion")
                self.enc.models["hyperion"] = self.v6
                try:
                    arrays, recipe = self.enc.hyperion(X)
                finally:
                    if saved is None:
                        self.enc.models.pop("hyperion", None)
                    else:
                        self.enc.models["hyperion"] = saved
            elif comp == "context2048":
                v = {k: torch.from_numpy(parent[k]).cuda() for k in ("hyperion", "foundation", "target")}
                n = self.norm
                proj = (v["foundation"] - n["foundation_mean"]) @ n["projection"].t()
                vec = torch.cat([(v["hyperion"] - n["hyperion_mean"]) / n["hyperion_scale"], (proj - n["projected_mean"]) / n["projected_scale"],
                                 (v["target"] - n["target_mean"]) / n["target_scale"]]).float()
                arrays, recipe = {"vector": vec.cpu().numpy()}, {"role": "historical context ABI assembly from this context's own v2 vectors",
                                                                  "normalizer_sha256": PINS[ENC_ROOT / "models/context-transforms"]}
            else:
                arrays, recipe = getattr(self.enc, comp)(X, y)
            torch.cuda.synchronize()
            vec = np.asarray(arrays["vector"], dtype="<f4")
            if not np.all(np.isfinite(vec)):
                raise ValueError("non-finite vector")
        except BaseException as e:
            self.ledger.end(view, comp, False, time.time() - t0, kind, error=f"{type(e).__name__}: {e}"[:300])
            raise
        dt = time.time() - t0
        info = {"seconds": round(dt, 3), "peak_bytes": int(torch.cuda.max_memory_allocated()), "gpu_uuid": self.uuid, "host": HOST,
                "recipe": recipe_digest(recipe), "dimension": int(vec.shape[0])}
        self.ledger.end(view, comp, True, dt, kind, dimension=int(vec.shape[0]))
        torch.cuda.empty_cache()
        return vec, info

    def encode(self, view, raw, kind="production"):
        X, y = train_view(raw)
        Xk, yk, removed = drop_target_copies(X, y)
        vecs, infos = {}, {}
        for comp in self.components:
            vecs[comp], infos[comp] = self.one(view, comp, Xk, yk, kind, parent=vecs)
        binding = {"train_rows": int(X.shape[0]), "features_in": int(X.shape[1]), "removed_target_copy_features": removed,
                   "train_block_sha256": sha(np.ascontiguousarray(np.column_stack([X, y])).astype("<f8").tobytes()), "selection_fit": "outer_train_only"}
        return vecs, infos, binding


def npy_bytes(vec):
    b = io.BytesIO(); np.save(b, np.asarray(vec, dtype="<f4"), allow_pickle=False); return b.getvalue()


def wait_admitted(adm, start=False):
    t0 = time.monotonic()
    while True:
        ok, reasons, obs = adm.check(start)
        if ok:
            return obs
        if time.monotonic() - t0 > 1200:
            raise TimeoutError(f"YIELDED: not admitted for 20 min: {reasons}")
        time.sleep(15)


