HEADER = struct.Struct("<IIIB")
HB = 4 + HEADER.size


def sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def canonical(x) -> bytes:
    return json.dumps(x, sort_keys=True, separators=(",", ":"), allow_nan=False).encode()


def atomic(path: Path, data: bytes):
    tmp = path.with_name("." + path.name + ".tmp")
    with open(tmp, "wb") as f:
        f.write(data); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, path)


# ------------------------------------------------------------------------------------------------ JTT1 train view
def jtt1_header(raw):
    if bytes(raw[:4]) != b"JTT1":
        raise ValueError("only JTT1 is admitted")
    n_train, n_test, p, inner = HEADER.unpack(bytes(raw[4:HB]))
    if len(raw) != HB + n_train + 8 * (p + 1) * (n_train + n_test) or n_train < 1 or p < 1:
        raise ValueError("JTT1 length or shape mismatch")
    return n_train, n_test, p


def train_view(raw):
    """X f64[n_train, p], y f64[n_train] from the outer-train bytes only; the test range is never decoded."""
    n_train, _, p = jtt1_header(raw)
    start = HB + n_train
    block = np.frombuffer(memoryview(raw)[start:start + 8 * (p + 1) * n_train], dtype="<f8").reshape(n_train, p + 1).copy()
    return block[:, :-1], block[:, -1]


def test_rows_for_control_only(raw):
    """Decodes the outer-test block. Used only by the pilot's must-fail control, never by production."""
    n_train, n_test, p = jtt1_header(raw)
    start = HB + n_train + 8 * (p + 1) * n_train
    return np.frombuffer(memoryview(raw)[start:], dtype="<f8").reshape(n_test, p + 1).copy()


def perturb_test_block(raw, seed=7):
    n_train, n_test, p = jtt1_header(raw)
    start = HB + n_train + 8 * (p + 1) * n_train
    noise = np.random.default_rng(seed).normal(size=n_test * (p + 1)).astype("<f8").tobytes()
    return bytes(raw[:start]) + noise


def flip_test_targets(raw, seed=11):
    """Replace ONLY the outer-test targets (last column of the test block) with different values; test features unchanged."""
    n_train, n_test, p = jtt1_header(raw)
    start = HB + n_train + 8 * (p + 1) * n_train
    T = np.frombuffer(memoryview(raw)[start:], dtype="<f8").reshape(n_test, p + 1).copy()
    T[:, -1] = -T[:, -1] * 3.0 + np.random.default_rng(seed).normal(size=n_test)
    return bytes(raw[:start]) + T.astype("<f8").tobytes()


def drop_target_copies(X, y):
    removed = []
    if np.ptp(y) > 1e-12:
        c = y - y.mean(); den = float(c @ c)
        for i in range(X.shape[1]):
            v = X[:, i]; slope = float(c @ (v - v.mean())) / den
            if abs(slope) > 1e-12 and np.max(np.abs(v - (slope * y + (v.mean() - slope * y.mean())))) <= 1e-10 * max(1, float(np.max(np.abs(v)))):
                removed.append(i)
    kept = [i for i in range(X.shape[1]) if i not in removed]
    if not kept:
        raise ValueError("no non-target training features")
    return X[:, kept].astype("float32"), y.astype("float32"), removed


# ------------------------------------------------------------------------------------------------ admission
def nvidia(query, kind="gpu"):
    flag = "--query-gpu" if kind == "gpu" else "--query-compute-apps"
    out = subprocess.check_output(["nvidia-smi", f"{flag}={query}", "--format=csv,noheader,nounits"], text=True).strip()
    return [[x.strip() for x in line.split(",")] for line in out.splitlines() if line.strip()]


def intake_lock_held():
    """True if any /proc/locks entry names the intake lock's device and inode. Read-only: the lock is never opened."""
    if not INTAKE_LOCK.exists():
        return False
    st = INTAKE_LOCK.stat()
    want = (os.major(st.st_dev), os.minor(st.st_dev), st.st_ino)
    for line in Path("/proc/locks").read_text().splitlines():
        parts = line.split()
        if len(parts) < 6:
            continue
        try:
            maj, mnr, ino = parts[5].split(":")
            if (int(maj, 16), int(mnr, 16), int(ino)) == want:
                return True
        except ValueError:
            continue
    return False


class Admission:
    def __init__(self):
        import psutil
        self.psutil, self.samples = psutil, []

    def check(self, start=False):
        reasons = []
        own = os.getpid()
        foreign = [a for a in nvidia("pid,used_memory", "apps") if a and a[0].isdigit() and int(a[0]) != own]
        if foreign:
            reasons.append(f"foreign CUDA compute apps: {len(foreign)}")
        free = int(nvidia("memory.free")[0][0])
        if start and free < 20 * 1024:
            reasons.append(f"GPU free {free} MiB < 20480 at start")
        if intake_lock_held():
            reasons.append("intake tabpfn-gpu.lock held")
        cpu = self.psutil.cpu_percent(interval=0.5)
        now = time.monotonic(); self.samples = [(t, c) for t, c in self.samples if t > now - 60] + [(now, cpu)]
        rolling = sum(c for _, c in self.samples) / len(self.samples)
        if cpu >= 95 or rolling >= 85:
            reasons.append(f"CPU instant {cpu:.0f}% rolling {rolling:.0f}%")
        if LANE_GUARD.exists():
            try:
                g = json.loads(LANE_GUARD.read_text())
                if g.get("admit") is False:
                    reasons.append("lane cpu-admission admit=false")
            except ValueError:
                reasons.append("lane cpu-admission unreadable")
        return not reasons, reasons, {"cpu": cpu, "rolling": rolling, "gpu_free_mib": free, "foreign_apps": len(foreign)}


# ------------------------------------------------------------------------------------------------ ledger
class Ledger:
    def __init__(self, path: Path, cap_s: float):
        self.path, self.cap_s = path, cap_s
        self.attempts, self.seconds, self.open = {}, 0.0, {}
        if path.exists():
            for line in path.read_text().splitlines():
                r = json.loads(line)
                k = (r["view_id"], r["component"], r.get("kind", "production"))
                if r["event"] == "intent":
                    self.attempts[k] = self.attempts.get(k, 0) + 1; self.open[k] = r
                else:
                    self.open.pop(k, None); self.seconds += float(r.get("gpu_seconds", 0))
        # an intent without a result is an unknown outcome: it keeps its attempt and is charged the per-attempt timeout
        self.seconds += 1800.0 * len(self.open)
        self.fd = os.open(str(path), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)

    def append(self, rec):
        data = canonical(rec | {"host": HOST, "pid": os.getpid(), "utc_us": time.time_ns() // 1000}) + b"\n"
        os.write(self.fd, data); os.fsync(self.fd)

    def begin(self, view, comp, kind="production"):
        k = (view, comp, kind)
        if self.attempts.get(k, 0) >= MAX_ATTEMPTS:
            raise RuntimeError(f"attempt cap reached for {view}/{comp}")
        if self.seconds >= self.cap_s:
            raise RuntimeError(f"host GPU-second cap {self.cap_s:.0f} s reached")
        if time.time() >= DEADLINE_UNIX:
            raise RuntimeError("deadline 2026-10-10T00:00Z reached")
        self.attempts[k] = self.attempts.get(k, 0) + 1
        self.append({"event": "intent", "view_id": view, "component": comp, "kind": kind, "attempt": self.attempts[k]})

    def end(self, view, comp, ok, gpu_seconds, kind="production", **extra):
        self.seconds += gpu_seconds
        self.append({"event": "result", "view_id": view, "component": comp, "kind": kind, "ok": ok, "gpu_seconds": round(gpu_seconds, 3)} | extra)


