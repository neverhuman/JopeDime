                v2, _, b2 = run.encode(r["view_id"], raw2, "pilot-b")
                X, y = train_view(raw); T = test_rows_for_control_only(raw)
                Xl, yl, _ = drop_target_copies(np.vstack([X, T[:, :-1]]), np.concatenate([y, T[:, -1]]))
                vc = {}
                for comp in [c for c in run.components if c != "context2048"]:
                    vc[comp], _ = run.one(r["view_id"], comp, Xl, yl, "pilot-control")
                ctx_single = {}
                if "context2048" in run.components:
