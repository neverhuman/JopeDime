                    # so the must-fail control composes it from the leaky inputs, all three and each one alone.
                    vc["context2048"], _ = run.one(r["view_id"], "context2048", None, None, "pilot-control", parent=vc)
                    for k in ("hyperion", "foundation", "target"):
                        mixed = {**{c: v1[c] for c in ("hyperion", "foundation", "target")}, k: vc[k]}
                        cv, _ = run.one(r["view_id"], "context2048", None, None, f"pilot-control-ctx-{k}", parent=mixed)
                        ctx_single[k] = bool(not np.array_equal(v1["context2048"], cv))
                pilot.append({"view_id": r["view_id"], "train_view_identical_under_test_perturbation": same_view,
                              "outputs_bit_identical": {c: bool(np.array_equal(v1[c], v2[c])) for c in run.components},
                              "max_abs_diff": {c: float(np.max(np.abs(v1[c] - v2[c]))) for c in run.components},
                              "control_differs": {c: bool(not np.array_equal(v1[c], vc[c])) for c in vc},
                              "context2048_single_input_control_differs": ctx_single,
                              "binding_equal": b1 == b2})
                continue
            vecs, infos, binding = run.encode(r["view_id"], raw)
            d.mkdir(parents=True, exist_ok=True)
            files = {}
            for comp, vec in vecs.items():
                body = npy_bytes(vec); atomic(d / f"{comp}.npy", body); files[f"{comp}.npy"] = {"sha256": sha(body), "bytes": len(body)}
            ctx = dict(r["parent"]) | {"files": files, "published": False,
                                       "gpu": {"components": infos, "input": {"encoder_jtt1_key": r["encoder_key"], "encoder_jtt1_version_id": r["encoder_version_id"],
                                                                              "encoder_jtt1_sha256": r["encoder_sha256"], "binding": binding},
                                               "pins": pins, "code_sha256": code, "manifest": r["manifest"], "owner_decision": r["owner_decision"],
                                               "qualification_sha256": sha(canonical(run.qualification)), "admission_at_start": obs}}
            atomic(d / "context.json", (json.dumps(ctx, sort_keys=True) + "\n").encode())
            atomic(d / ".done", b"ok\n")
            done += 1
        except TimeoutError:
            raise
        except Exception as e:
            failed.append({"view_id": r["view_id"], "error": f"{type(e).__name__}: {e}"[:300]})
        if i % 10 == 0:
            atomic(status, canonical({"host": HOST, "done": done, "skipped": skipped, "failed": len(failed), "of": len(rows),
                                      "gpu_seconds": round(ledger.seconds, 1), "elapsed_s": round(time.time() - t_start), "utc_us": time.time_ns() // 1000}))
    rec = {"schema": "jope.dl-v2-gpu-encode-run/v1", "host": HOST, "gpu_uuid": run.uuid, "plan_sha256": sha(plan_b), "pilot": a.pilot, "perturb": a.perturb,
           "expected": len(rows[: a.pilot] if a.pilot else rows), "done": done, "skipped": skipped, "failed": failed, "pilot_results": pilot,
           "gpu_seconds_host_total": round(ledger.seconds, 1), "pins": pins, "code_sha256": code, "qualification": run.qualification,
           "admission_at_start": start_obs, "elapsed_s": round(time.time() - t_start, 1), "utc_us": time.time_ns() // 1000}
    name = f"{'pilot' if a.pilot else 'run'}-{HOST}-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}.json"
    atomic(out / name, (json.dumps(rec, indent=1, sort_keys=True) + "\n").encode())
    atomic(status, canonical({"host": HOST, "state": "finished", "done": done, "skipped": skipped, "failed": len(failed), "of": rec["expected"],
                              "gpu_seconds": round(ledger.seconds, 1), "utc_us": time.time_ns() // 1000}))
    print(json.dumps({k: rec[k] for k in ("host", "expected", "done", "skipped", "gpu_seconds_host_total", "elapsed_s")} | {"failed": len(failed), "receipt": name}))
    return 0 if not failed else 1


