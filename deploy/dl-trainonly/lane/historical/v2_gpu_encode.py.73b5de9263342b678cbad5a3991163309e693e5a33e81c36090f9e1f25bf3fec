    if ("hyperion_v6all" in comps) != bool(a.hyperion_v6all):
        raise SystemExit("hyperion_v6all and --hyperion-v6all go together")
    v6all = tuple(a.hyperion_v6all.split("#", 1)) if a.hyperion_v6all else None
