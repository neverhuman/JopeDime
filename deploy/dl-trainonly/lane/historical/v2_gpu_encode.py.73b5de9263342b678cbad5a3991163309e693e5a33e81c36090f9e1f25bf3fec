    run = Runner(ledger, comps, v6, v6all) if v6all else Runner(ledger, comps, v6)
    code = {"v2_gpu_encode.py": sha(Path(__file__).read_bytes())}
    t_start = time.time(); done = skipped = 0; failed = []; pilot = []
    status = out / f"status-{HOST}.json"
    for i, r in enumerate(rows[: a.pilot] if a.pilot else rows):
        d = out / r["view_id"]
