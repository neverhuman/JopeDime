ACQ = RECEIPTS / "acquisition-selection-20261005T2045Z.json"
LEAK = RECEIPTS / "row-selection-leak-v2-20261005T200546Z.jsonl"
L7A_SUMMARY = RECEIPTS / "l7a-build-summary-20261005T204452Z.json"
