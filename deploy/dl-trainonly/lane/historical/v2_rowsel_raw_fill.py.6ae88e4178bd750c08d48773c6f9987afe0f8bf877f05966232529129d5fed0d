def code_shas():
    root = _HERE.parent
    return {f: sha((root / f).read_bytes()) for f in CODE_FILES}


def create_only(path: Path, body: bytes, mode=0o444):
    with open(path, "xb") as f:
        f.write(body); f.flush(); os.fsync(f.fileno())
    os.chmod(path, mode)


def alldata_ref():
    return f"{ALLDATA}#sha256={sha_file(ALLDATA)}"


def fill_hashes():
    if sha_file(FETCH_PLAN) != FETCH_PLAN_SHA256:
        raise SystemExit("fetch plan drift")
    return [json.loads(l)["dataset_hash"] for l in FETCH_PLAN.read_text().splitlines() if l.strip()]


# --------------------------------------------------------------------------------------------------- epoch-0 bundle

def bundle(a):
    """Unmodified Sources + resolve_context over every epoch-0 context of the 36 datasets -> create-only bundle."""
    out = Path(a.bundle)
    out.mkdir(parents=True, exist_ok=False)
    hs = fill_hashes()
    src = scale_check.Sources(load_index=False)
    cache = scale_check.DataCache(max_items=2)
    idx = {"schema": BUNDLE_SCHEMA, "epoch": src.epoch_ref, "code_sha256": code_shas(), "utc_us": int(time.time() * 1e6),
           "rule": "A, rows and refs exactly as scale_check.resolve_context returned them on the lane host; A stored as "
                   "little-endian float64 C-order bytes; replay refuses any byte that differs", "datasets": {}}
    rows_all = list(src.included())
    for h in hs:
        rows = sorted((r for r in rows_all if r["dataset_hash"] == h), key=lambda r: int(r["fold"]))
        ctxs = [scale_check.resolve_context(r, src, cache) for r in rows]
        A = np.ascontiguousarray(ctxs[0]["A"], dtype="<f8")
        for c in ctxs[1:]:
            if c["refs"]["data_sha256"] == ctxs[0]["refs"]["data_sha256"] and not np.array_equal(np.asarray(c["A"]), A):
                raise SystemExit(f"{h}: two contexts on one data object with different A")
        body = A.tobytes()
        p = out / f"{h}.A.f8"
        create_only(p, body)
        idx["datasets"][h] = {"rows": rows, "refs": {r["view_id"]: {"data_sha256": c["refs"]["data_sha256"]} for r, c in zip(rows, ctxs)},
                              "A": {"file": p.name, "sha256": sha(body), "shape": list(A.shape), "dtype": "<f8"},
                              "sealed_context_sha256": sorted(r["context_sha256"] for r in rows if r["context_sha256"] in src.sealed_ctx)}
    b = (json.dumps(idx, indent=1, sort_keys=True) + "\n").encode()
    create_only(out / "index.json", b)
    print(json.dumps({"bundle": str(out), "index_sha256": sha(b), "datasets": len(idx["datasets"]),
                      "contexts": sum(len(d["rows"]) for d in idx["datasets"].values()),
                      "sealed_contexts": sum(len(d["sealed_context_sha256"]) for d in idx["datasets"].values())}))
    return 0


class BundleSources:
    """The two Sources members the loaders read (included(), sealed_ctx) plus epoch_ref, from the bundle."""

    def __init__(self, bdir: Path):
        self.dir = Path(bdir)
        b = (self.dir / "index.json").read_bytes()
        self.index_sha256 = sha(b)
        self.idx = json.loads(b)
        if self.idx["schema"] != BUNDLE_SCHEMA:
            raise SystemExit("not a fill epoch-0 bundle")
        self.epoch_ref = self.idx["epoch"]
        self._rows = [r for d in self.idx["datasets"].values() for r in d["rows"]]
        self.sealed_ctx = {s for d in self.idx["datasets"].values() for s in d["sealed_context_sha256"]}
        self._A = {}

    def included(self):
        return list(self._rows)

    def A(self, h):
        if h not in self._A:
            meta = self.idx["datasets"][h]["A"]
            body = (self.dir / meta["file"]).read_bytes()
            if sha(body) != meta["sha256"]:
                raise SystemExit(f"{h}: bundle array sha256 differs from the index")
            A = np.frombuffer(body, dtype="<f8").reshape(meta["shape"]).astype(np.float64)
            A.setflags(write=False)
            self._A = {h: A}                          # one dataset at a time (memory)
        return self._A[h]

    def resolve(self, row, sources=None, cache=None):
        d = self.idx["datasets"][row["dataset_hash"]]
        if row not in d["rows"]:
            raise SystemExit(f"{row.get('view_id')}: row not in the bundle")
        return {"A": self.A(row["dataset_hash"]), "refs": dict(d["refs"][row["view_id"]])}


def epoch0(a):
    """(src, cache, mode): live Sources, or the bundle with scale_check.resolve_context replaced in this process."""
    if a.epoch0 == "live":
        return scale_check.Sources(load_index=False), scale_check.DataCache(max_items=2), {"mode": "live"}
    bs = BundleSources(a.bundle)
    scale_check.resolve_context = bs.resolve       # read by the coverage and nonnumeric loaders at call time
    return bs, None, {"mode": "bundle", "index": str(Path(a.bundle) / "index.json"), "index_sha256": bs.index_sha256}


