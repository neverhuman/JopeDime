def plan(a):
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    if sha_file(COV_PLAN) != COV_PLAN_SHA256 or sha_file(FETCH_RUN) != FETCH_RUN_SHA256:
        raise SystemExit("coverage plan or fetch-run receipt drift")
    covp = json.loads(COV_PLAN.read_bytes())
    held = {e["dataset_hash"]: e for e in covp["datasets"] if e.get("reason") == "rights_held"}
    hs = fill_hashes()
    if sorted(held) != sorted(hs):
        raise SystemExit("fill datasets != coverage plan rights_held entries")
    st_b = Path(a.study).read_bytes()
    stud = {r["dataset_hash"]: r for r in (json.loads(l) for l in st_b.decode().splitlines() if l.strip())}
    if sorted(stud) != sorted(hs):
        raise SystemExit("study does not cover the 36")
    bs = BundleSources(a.bundle)
    rights_decision = alldata_ref()
    entries = []
    for h in sorted(hs):
        c = held[h]
        s = stud[h]
        raw, fj, rsha = raw_of(h)
        if rsha != s["raw_sha256"]:
            raise SystemExit(f"{h}: raw differs from the study")
        rows = sorted((r for r in bs.included() if r["dataset_hash"] == h), key=lambda r: int(r["fold"]))
        if [(r["view_id"], r["context_sha256"]) for r in rows] != [(x["view_id"], x["context_sha256"]) for x in c["epoch0"]]:
            raise SystemExit(f"{h}: bundle epoch-0 rows differ from the coverage plan")
        extra = {"rights": "research-only", "rights_basis": "formerly_rights_held", "rights_decision": rights_decision}
        e = {"dataset_hash": h, "class": CLASS, "cohort": "frozen", "epoch0_labels": LABEL, "epoch0": c["epoch0"],
             "selection_markers": c.get("selection_markers"), "acq_pre_selection_rows": c.get("acq_pre_selection_rows"),
             "rights": "research-only", "rights_basis": "formerly_rights_held", "raw_dir": str(RAW_FILL), "raw_from_held_dir": False,
             "match_record": None, "l7a_record": None, "route": s["route"], "nonnumeric_tier": s["tier"],
             "study": {"status": s["tier"] or (s["first"]["status"]), "reason": s["first"].get("reason"), "raw_sha256": s["raw_sha256"],
                       "first": s["first"]["status"], "nonnumeric": (s.get("nonnumeric") or {}).get("status")},
             "raw_rows": (s["first"].get("stats") or {}).get("raw_rows") or ((s.get("nonnumeric") or {}).get("stats") or {}).get("raw_rows") or 30000,
             "header_width": int(bs.idx["datasets"][h]["A"]["shape"][1])}
        if s["route"] is None:                    # the study decides first: no admitted match, nothing to build
            nn = s.get("nonnumeric") or {}
            e.update(disposition="not_built", reason=nn.get("reason") or nn.get("status") or s["first"].get("reason"),
                     detail=("also " + HOLD[h]) if h in HOLD else None)
        elif h in HOLD:
            e.update(disposition="not_built", reason=HOLD[h].split(":")[0], detail=HOLD[h])
        else:
            e["disposition"] = "build"
            if s["route"] == "nonnumeric":
                extra.update(values_route="nonnumeric", nonnumeric_tier=s["tier"],
                             nonnumeric_decision=f"{tool.NN_DECISION}#sha256={tool.NN_DECISION_SHA256}")
        e["context_extra"] = extra
        entries.append(e)
    loads = [0.0] * a.of
    for e in sorted((e for e in entries if e["disposition"] == "build"),
                    key=lambda e: (-tool.est_cost({"raw_rows": e["raw_rows"], "raw_rows_with_target": e["raw_rows"], "header_width": e["header_width"]}),
                                   e["dataset_hash"])):
        cst = tool.est_cost({"raw_rows": e["raw_rows"], "raw_rows_with_target": e["raw_rows"], "header_width": e["header_width"]})
        i = min(range(a.of), key=lambda k: (loads[k], k))
        e["shard"], e["est_cpu_s"] = i, round(cst, 1)
        loads[i] += cst
    cnt = collections.Counter(f"{e['disposition']}:{e.get('route') if e['disposition'] == 'build' else e.get('reason')}" for e in entries)
    doc = {"schema": PLAN_SCHEMA, "class": CLASS, "of": a.of, "datasets": entries,
           "counts": {"datasets": len(entries), "contexts": sum(len(e["epoch0"]) for e in entries), "by": dict(sorted(cnt.items())),
                      "build_datasets": sum(e["disposition"] == "build" for e in entries),
                      "build_epoch0_contexts": sum(len(e["epoch0"]) for e in entries if e["disposition"] == "build")},
           "inputs": {"owner_decision": ref(ALLDATA), "coverage_plan": ref(COV_PLAN), "fetch_plan": ref(FETCH_PLAN), "fetch_run": ref(FETCH_RUN),
                      "study": ref(a.study), "epoch0_bundle_index": ref(Path(a.bundle) / "index.json"),
                      "acquisition_selection": ref(tool.ACQ), "row_selection_leak": ref(tool.LEAK)},
           "epoch": bs.epoch_ref, "shard_est_cpu_s": [round(x, 1) for x in loads], "hold": HOLD,
           "precap_rows": rowsel_raw.PRECAP_ROWS, "outer_folds": rowsel_raw.OUTER_FOLDS, "budget": rowsel_raw.BUDGET,
           "rights": "lifted for these 36 by ALL-DATA-RESEARCH; research-only routing kept (owner permits it); leak rule unchanged"}
    tool.stamp_split_version(doc, a.split_version)
    p = out / "plan.json"
    body = (json.dumps(doc, indent=1, sort_keys=True) + "\n").encode()
    if p.exists() and p.read_bytes() != body:
        raise SystemExit(f"{p} exists with different content; refusing to replace a pinned plan")
    if not p.exists():
        atomic(p, body)
    print(json.dumps({"plan": str(p), "sha256": sha(body), "counts": doc["counts"], "shard_est_cpu_s": doc["shard_est_cpu_s"]}))
    return 0


