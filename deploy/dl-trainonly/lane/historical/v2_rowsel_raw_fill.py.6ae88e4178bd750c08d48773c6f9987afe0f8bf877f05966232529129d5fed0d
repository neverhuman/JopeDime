def xbabe3_check(now=None):
    mi = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mi[k] = int(v.split()[0])
    frac = mi["MemAvailable"] / mi["MemTotal"]
    load1 = os.getloadavg()[0]
    ncpu = os.cpu_count() or 1
    free = shutil.disk_usage("/").free
    reasons = []
    if frac < 0.20:
        reasons.append("mem_available_below_20pct")
    if load1 > 0.85 * ncpu:
        reasons.append("load_high")
    if free < cpuguard.HOST_FLOOR_BYTES:
        reasons.append("host_floor")
    return not reasons, reasons, {"mem_available_frac": round(frac, 4), "load1": load1, "cpus": ncpu, "root_free_bytes": free}


class ReplayClock:
    """Pilot equivalence only: the coverage loader's match receipt carries utc_us (wall clock); replaying the reference
    host's value makes the two hosts' receipts, view ids and contexts comparable byte for byte."""

    def __init__(self, utc_us_by_dataset):
        self.by = utc_us_by_dataset
        self.current = None

    def time(self):
        return self.by[self.current] / 1e6 if self.current in self.by else time.time()

    def __getattr__(self, name):
        return getattr(time, name)


def build(a):
    cpuguard.set_threads(2)
    out = Path(a.out)
    pl = json.loads((out / "plan.json").read_bytes())
    plan_sha = sha_file(out / "plan.json")
    tool.plan_split_version(pl, a.split_version)
    if pl["of"] != a.of:
        raise SystemExit(f"plan is for --of {pl['of']}")
    codes = code_shas()
    src, cache, mode = epoch0(a)
    inv = json.loads(tool.DATASETS_INV.read_text())
    tool.RAW_DIR = RAW_FILL                       # nonnumeric loader: the fill's raw dir (this process only)
    clock = None
    if a.replay_match_utc:
        clock = ReplayClock(json.loads(Path(a.replay_match_utc).read_bytes()))
        cov.time = clock
    jpath = out / (f"shard-{a.shard}.guard.jsonl" if not a.datasets else f"shard-{a.shard}.partial-{int(time.time())}.guard.jsonl")
    guard = cpuguard.Guard(journal_path=jpath, checker=xbabe3_check if a.guard == "xbabe3" else cpuguard.check)
    mine = [e for e in pl["datasets"] if e["disposition"] == "build" and e["shard"] == a.shard]
    if a.datasets:
        keep = set(a.datasets.split(","))
        mine = [e for e in mine if e["dataset_hash"] in keep]
    hooks = {"first": lambda: {"loader": cov.make_loader(out, codes), "matcher": cov.matcher},
             "nonnumeric": lambda: {"loader": tool.make_nonnumeric_loader(out, codes), "matcher": tool.nonnumeric_matcher,
                                    "post_gate": tool.nonnumeric_text_gate}}
    t0, c0 = time.time(), tool.cpu_s()
    results = []
    for e in sorted(mine, key=lambda e: -e["est_cpu_s"]):
        h = e["dataset_hash"]
        sd = out / f"shard-{e['shard']}"
        sd.mkdir(parents=True, exist_ok=True)
        if tool.dataset_done(sd, h, codes):
            results.append({"dataset_hash": h, "status": "already_done"})
            continue
        guard.wait()
        if clock is not None:
            clock.current = h
        rec = tool.run_dataset(dict(e), sd, codes, src, cache, inv, set(), guard, split_version=a.split_version, **hooks[e["route"]]())
        results.append({"dataset_hash": h, "route": e["route"], "status": rec["status"], "reason": rec.get("reason"),
                        "detail": (rec.get("detail") or "")[:500], "cpu_s": rec["cpu_s"], "wall_s": rec["wall_s"], "maxrss_mb": rec["maxrss_mb"]})
        print(json.dumps(results[-1]), flush=True)
    gs = guard.summary()
    if a.guard == "xbabe3":
        gs["rule"] = GUARD_RULE_XBABE3
    rec = {"schema": "jope.dl-v2-rowsel-raw-fill-build/v1", "shard": a.shard, "of": a.of, "plan_sha256": plan_sha,
           "datasets_filter": a.datasets, "expected_datasets": len(mine), "results": results,
           "counts": dict(collections.Counter(r["status"] for r in results)),
           "complete": all(r["status"] in ("done", "already_done") for r in results) and len(results) == len(mine),
           "cpu_s": round(tool.cpu_s() - c0, 1), "wall_s": round(time.time() - t0, 1), "maxrss_mb": tool.maxrss_mb(),
           "guard": gs, "code_sha256": codes, "epoch0": mode, "host": os.uname().nodename, "numpy": np.__version__,
           "python": sys.version.split()[0], "replay_match_utc": a.replay_match_utc,
           "process_overrides": {"rights_gate": "held=set() (ALL-DATA-RESEARCH)", "v2_rowsel_raw.RAW_DIR": str(RAW_FILL),
                                 "scale_check.resolve_context": "bundle replay" if mode["mode"] == "bundle" else None,
                                 "coverage.time": "ReplayClock (pilot equivalence only)" if clock else None},
           "published": False, "utc_us": int(time.time() * 1e6)}
    name = f"shard-{a.shard}-of-{a.of}.receipt.json" if not a.datasets else f"shard-{a.shard}-of-{a.of}.partial-{int(time.time())}.receipt.json"
    create_only(out / name, (json.dumps(rec, indent=1, sort_keys=True) + "\n").encode(), mode=0o444)
    print(json.dumps({k: rec[k] for k in ("shard", "expected_datasets", "counts", "complete", "cpu_s", "wall_s", "maxrss_mb")}))
    return 0 if rec["complete"] else 1


# --------------------------------------------------------------------------------------------------- verify + summary

def verify(a):
    """Every planned dataset accounted for; every done context complete, hash-checked, v2-split, rights-stamped, labelled."""
    out = Path(a.out)
    pl = json.loads((out / "plan.json").read_bytes())
    version = tool.plan_split_version(pl, a.split_version)
    codes = code_shas()
    rights_decision = alldata_ref()
    per, problems, counts = [], [], collections.Counter()
    ctx_total = 0
    seen_dirs = set()
    for e in pl["datasets"]:
        h, n0 = e["dataset_hash"], len(e["epoch0"])
        row = {"dataset_hash": h, "epoch0_contexts": n0, "epoch0_view_ids": [c["view_id"] for c in e["epoch0"]], "route": e.get("route"),
               "nonnumeric_tier": e.get("nonnumeric_tier")}
        if e["disposition"] != "build":
            row.update(status="not_built", reason=e["reason"], detail=e.get("detail"))
        else:
            sd = out / f"shard-{e['shard']}"
            p = sd / "_datasets" / f"{h}.json"
            if not p.exists():
                row.update(status="not_built", reason="no_dataset_record")
                problems.append(f"{h}: no dataset record")
            else:
                r = json.loads(p.read_bytes())
                row.update(status=r["status"], reason=r.get("reason"), detail=(r.get("detail") or "")[:600],
                           record={"path": str(p), "sha256": sha_file(p)}, cpu_s=r.get("cpu_s"))
                mp = out / "_match" / f"{h}.json"
                if mp.exists():
                    row["match_record"] = {"path": str(mp), "sha256": sha_file(mp)}
                if r["status"] == "done":
                    if r["code_sha256"] != codes:
                        problems.append(f"{h}: built with other code")
                    if r["split"]["schema"] != version or r.get("split_version") != version:
                        problems.append(f"{h}: split {r['split']['schema']}")
                    if r["split"]["groups_straddling_folds"] or not r["split"]["target_check"]["target_invariant"]:
                        problems.append(f"{h}: split checks")
                    if (r.get("rights"), r.get("rights_basis"), r.get("rights_decision")) != ("research-only", "formerly_rights_held", rights_decision):
                        problems.append(f"{h}: dataset record rights fields")
                    if e["route"] == "nonnumeric" and not (r.get("post_gate") or {}).get("passed"):
                        problems.append(f"{h}: nonnumeric text gate not passed")
                    vids = []
                    for c in r["contexts"]:
                        d = sd / c["view_id"]
                        seen_dirs.add(str(d))
                        if not c["passed"] or not (d / ".done").exists():
                            problems.append(f"{h}: {c['view_id']} not passed/done"); continue
                        cj = json.loads((d / "context.json").read_bytes())
                        if cj["rowsel"]["identity"] != c["identity"]:
                            problems.append(f"{h}: {c['view_id']} identity")
                        if (cj.get("rights"), cj.get("rights_basis"), cj.get("rights_decision")) != ("research-only", "formerly_rights_held", rights_decision):
                            problems.append(f"{h}: {c['view_id']} rights fields")
                        if e["route"] == "nonnumeric" and (cj.get("values_route"), cj.get("nonnumeric_tier")) != ("nonnumeric", e["nonnumeric_tier"]):
                            problems.append(f"{h}: {c['view_id']} nonnumeric route fields")
                        if cj.get("row_selection_leak") != LABEL:
                            problems.append(f"{h}: {c['view_id']} label {cj.get('row_selection_leak')}")
                        if (cj["rowsel"].get("split") or {}).get("sha256") != r["split"]["sha256"] or \
                                (cj["rowsel"].get("split") or {}).get("schema") != version:
                            problems.append(f"{h}: {c['view_id']} context split differs from the dataset record")
                        for name, meta in cj["files"].items():
                            if sha_file(d / name) != meta["sha256"]:
                                problems.append(f"{h}: {c['view_id']} {name} hash")
                        vids.append(c["view_id"])
                    row["new_view_ids"] = vids
                    row["cut_id"] = "trainonly-split-v2:" + r["split"]["sha256"]     # rule of the raw v2 cut index (3988f3ef)
                    row["split"] = {k: r["split"][k] for k in ("sha256", "fold_sizes", "groups", "largest_group")}
                    ctx_total += len(vids)
        counts[f"{row['status']}:{row.get('reason')}"] += 1
        per.append(row)
    for p in sorted(out.glob("shard-*/*/context.json")):
        if str(p.parent) not in seen_dirs:
            problems.append(f"orphan context dir {p.parent}")
    shards = [ref(p) for p in sorted(out.glob("shard-*-of-*.receipt.json"))]
    doc = {"schema": VERIFY_SCHEMA, "utc_us": int(time.time() * 1e6), "tree": str(out), "split_version": version,
           "plan": ref(out / "plan.json"), "shard_receipts": shards, "code_sha256": codes,
           "counts": {"planned_datasets": len(pl["datasets"]), "planned_epoch0_contexts": sum(len(e["epoch0"]) for e in pl["datasets"]),
                      "by_status_reason": dict(sorted(counts.items())), "done_datasets": sum(r["status"] == "done" for r in per),
                      "new_contexts": ctx_total,
                      "epoch0_contexts_replaced": sum(r["epoch0_contexts"] for r in per if r["status"] == "done"),
                      "epoch0_contexts_not_rebuilt": sum(r["epoch0_contexts"] for r in per if r["status"] != "done")},
           "problems": problems, "passed": not problems and all(r.get("reason") != "no_dataset_record" for r in per),
           "datasets": per,
           "policy": {"s3_calls": 0, "gpu": False, "git": False, "published": False, "credential_files_read": False,
                      "network": "read-only public GETs by tools/l7a_fetch.py only (fetch-run receipt pinned in the plan)",
                      "rights": "ALL-DATA-RESEARCH: formerly rights_held, research-only routing", "leak_rule": "unchanged"}}
    body = (json.dumps(doc, indent=1, sort_keys=True) + "\n").encode()
    create_only(Path(a.receipt), body)
    if doc["passed"] and a.complete:
        m = out / ".complete"
        create_only(m, jdump({"schema": "jope.dl-v2-rowsel-raw-tree-complete/v1", "tree": str(out), "split_version": version,
                              "verify": ref(a.receipt), "counts": doc["counts"], "published": False, "utc_us": int(time.time() * 1e6)}))
    print(json.dumps({"receipt": a.receipt, "sha256": sha(body), "passed": doc["passed"], "problems": problems[:20], "counts": doc["counts"]}))
    return 0 if doc["passed"] else 1


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=("bundle", "study", "plan", "build", "verify"))
    ap.add_argument("--bundle")
    ap.add_argument("--study")
    ap.add_argument("--out")
    ap.add_argument("--of", type=int, default=1)
    ap.add_argument("--shard", type=int, default=0)
    ap.add_argument("--datasets")
    ap.add_argument("--split-version", choices=tuple(tool.SPLIT_VERSIONS))
    ap.add_argument("--epoch0", choices=("bundle", "live"), default="bundle")
    ap.add_argument("--guard", choices=("xbabe3", "lane"), default="xbabe3")
    ap.add_argument("--replay-match-utc")
    ap.add_argument("--receipt")
    ap.add_argument("--complete", action="store_true")
    a = ap.parse_args(argv)
    if a.cmd in ("plan", "build", "verify") and a.split_version != tool.SPLIT_V2:
        raise SystemExit(f"--split-version {tool.SPLIT_V2} must be passed explicitly")
    return {"bundle": bundle, "study": study, "plan": plan, "build": build, "verify": verify}[a.cmd](a)


if __name__ == "__main__":
    raise SystemExit(main())
