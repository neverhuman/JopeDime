def raw_of(h):
    fdir = RAW_FILL / h
    fj = json.loads((fdir / "fetch.json").read_bytes())
    p = fdir / Path(fj["file"]).name
    got = sha_file(p)
    if got != fj["sha256"]:
        raise SystemExit(f"{h}: raw custody mismatch")
    return p, fj, got


def study(a):
    """Per dataset: the coverage first match (t1raw), and for rows_unmatched_nonnumeric_raw the nonnumeric match. Read-only."""
    if sha_file(FETCH_RUN) != FETCH_RUN_SHA256:
        raise SystemExit("fetch-run receipt drift")
    src, cache, mode = epoch0(a)
    inv = json.loads(tool.DATASETS_INV.read_text())
    hs = fill_hashes()
    if a.datasets:
        hs = [h for h in hs if h in set(a.datasets.split(","))]
    out = []
    for h in hs:
        t0 = time.time()
        rows = sorted((r for r in src.included() if r["dataset_hash"] == h), key=lambda r: int(r["fold"]))
        A = scale_check.resolve_context(rows[0], src, cache)["A"]
        k = inv["meta_key"][h].rsplit("/", 1)[1]
        meta = json.loads((tool.META_DIR / f"{k}.json").read_bytes())
        raw, fj, rsha = raw_of(h)
        rec = {"schema": STUDY_SCHEMA, "dataset_hash": h, "raw_sha256": rsha, "raw_file": str(raw), "raw_url": fj.get("url"),
               "t1_meta_sha256": k, "t1_rows": int(A.shape[0])}
        try:
            specs, got, m, trial = cov.first_match(raw, meta, A)
            st = m["stats"]
            rec["first"] = {"status": "matched" if m["matched"] else "unmatched",
                            "reason": None if m["matched"] else cov._classify(st, got["report"]),
                            "stats": {x: st[x] for x in ("rows", "matched_rows", "unmatched_rows", "ambiguous_rows", "oversubscribed_rows", "raw_rows")},
                            "zip_member_trial": trial}
        except rowsel_raw.RowselRawError as err:
            rec["first"] = {"status": "unmatched", "reason": err.reason, "detail": err.detail[:300]}
        rec["nonnumeric"] = None
        if rec["first"]["status"] == "matched":
            rec.update(route="first", tier=None)
        elif rec["first"]["reason"] == "rows_unmatched_nonnumeric_raw":
            mm = nonnumeric.match_dataset(raw, meta, A)
            rec["nonnumeric"] = {"status": mm["status"], "reason": mm["reason"], "detail": (mm.get("detail") or "")[:300],
                                 "stats": mm.get("stats"), "text_columns": mm.get("text_columns"),
                                 "readings": {n: c["reading"] for n, c in (mm.get("text_columns") or {}).items()}}
            ok = mm["status"] in tool.NN_TIERS
            rec.update(route="nonnumeric" if ok else None, tier=mm["status"] if ok else None)
        else:
            rec.update(route=None, tier=None)
        rec["seconds"] = round(time.time() - t0, 1)
        out.append(rec)
        print(json.dumps({"dataset": h, "first": rec["first"]["status"], "first_reason": rec["first"].get("reason"),
                          "nonnumeric": (rec["nonnumeric"] or {}).get("status"), "route": rec["route"], "s": rec["seconds"]}), flush=True)
    body = "".join(json.dumps(r, sort_keys=True, default=str) + "\n" for r in out).encode()
    create_only(Path(a.study), body)
    print(json.dumps({"study": a.study, "sha256": sha(body), "epoch0": mode,
                      "routes": dict(collections.Counter(str(r["route"]) for r in out))}))
    return 0


