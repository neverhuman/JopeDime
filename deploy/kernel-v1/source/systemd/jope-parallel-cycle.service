[Unit]
Description=JOPE real-data DL to adaptive GP to DL learning cycle
After=jope-parallel-monitor.service jope-parallel-gp.service
Requires=jope-parallel-monitor.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/jope-dime/parallel
ExecStart=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-neural-v31 --root /home/ubuntu/jope-dime/parallel cycle --corpus /home/ubuntu/jope-dime/parallel/corpus/qualification-v2 --output /home/ubuntu/jope-dime/parallel/runs/regression-cycle-1 --steps 300 --cuts 2 --qualification
Environment=JOPE_GP_EXECUTABLE=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-cpu-v28
Environment=OMP_NUM_THREADS=2
Environment=RAYON_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Restart=on-failure
RestartSec=20
MemoryHigh=96G
MemoryMax=128G
MemorySwapMax=0
TasksMax=512
CPUAccounting=true
MemoryAccounting=true
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
