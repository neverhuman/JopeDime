[Unit]
Description=JOPE eight-GPU frozen encodings for 40 reviewed source families
After=jope-parallel-monitor.service
Requires=jope-parallel-monitor.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/jope-dime/parallel
ExecStartPre=/usr/bin/sha256sum --check --status manifests/hyperion-concurrent-v30.sha256
ExecStart=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-cpu-v30 --root /home/ubuntu/jope-dime/parallel hyperion-service --jobs /home/ubuntu/jope-dime/parallel/manifests/generated/gp-reviewed3-jobs.json --spec /home/ubuntu/jope-dime/parallel/manifests/hyperion-concurrent-spec.json --output /home/ubuntu/jope-dime/parallel/data/encodings/hyperion-batched-cuts
Environment=JAIN_HYPERION_CUDA_MAX_LOAD_RATIO=1000
Environment=RAYON_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
AllowedCPUs=0-7,62-69
CPUQuota=1600%
CPUAccounting=true
MemoryHigh=512G
MemoryMax=640G
MemorySwapMax=0
MemoryAccounting=true
TasksMax=512
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
