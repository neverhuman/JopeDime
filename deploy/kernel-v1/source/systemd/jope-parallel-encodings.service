[Unit]
Description=JOPE frozen encodings for indexed real-data cuts
After=jope-parallel-monitor.service
Requires=jope-parallel-monitor.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Environment=JAIN_HYPERION_CUDA_MAX_LOAD_RATIO=1000
User=ubuntu
WorkingDirectory=/home/ubuntu/jope-dime/parallel
ExecStart=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-cpu --root /home/ubuntu/jope-dime/parallel hyperion-service --jobs /home/ubuntu/jope-dime/parallel/manifests/generated/gp-expanded-jobs.json --spec /home/ubuntu/jope-dime/parallel/manifests/hyperion-batch-spec.json --output /home/ubuntu/jope-dime/parallel/data/encodings/hyperion-batched-cuts
MemoryHigh=512G
MemoryMax=640G
MemorySwapMax=0
TasksMax=512
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
