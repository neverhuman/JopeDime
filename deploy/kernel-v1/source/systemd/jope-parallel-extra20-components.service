[Unit]
Description=JOPE target and foundation encodings for additional pointer cuts
After=jope-parallel-monitor.service
Requires=jope-parallel-monitor.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/jope-dime/parallel
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-neural-v31 --root /home/ubuntu/jope-dime/parallel target-service --jobs /home/ubuntu/jope-dime/parallel/manifests/generated/gp-extra20-jobs.json --spec /home/ubuntu/jope-dime/parallel/assets/sampling-extra20-v1/target-spec.json --output /home/ubuntu/jope-dime/parallel/data/encodings/target-cuts --batch 128
ExecStart=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-neural-v31 --root /home/ubuntu/jope-dime/parallel foundation-service --jobs /home/ubuntu/jope-dime/parallel/manifests/generated/gp-extra20-jobs.json --spec /home/ubuntu/jope-dime/parallel/assets/sampling-extra20-v1/foundation-spec.json --output /home/ubuntu/jope-dime/parallel/data/encodings/foundation-cuts --batch 2
MemoryHigh=96G
MemoryMax=128G
MemorySwapMax=0
TasksMax=256
KillMode=control-group
TimeoutStartSec=infinity
TimeoutStopSec=15
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
