[Unit]
Description=JOPE measured self-play cycle reports
After=jope-parallel-campaign.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/jope-dime/parallel
ExecStart=/usr/bin/python3 /home/ubuntu/jope-dime/parallel/tools/watch_campaign_reports.py --root /home/ubuntu/jope-dime/parallel --spec /home/ubuntu/jope-dime/parallel/manifests/generated/campaign64-qualification-v1.json
CPUAffinity=123
CPUQuota=100%
MemoryMax=8G
MemorySwapMax=0
Restart=on-failure
RestartSec=60
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
