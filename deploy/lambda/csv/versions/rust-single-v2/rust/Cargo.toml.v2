[package]
name = "jope-lambda-probe"
version = "0.1.0"
edition = "2021"
publish = false

[workspace]

[[bin]]
name = "bootstrap"
path = "src/main.rs"

[dependencies]
feat-math = { path = "../../../../crates/feat-math" }
lambda_runtime = "0.13"
tokio = { version = "1", features = ["macros", "rt"] }
serde_json = "1"
sha2 = "0.10"
aws-sigv4 = "1"
aws-credential-types = "1"
ureq = { version = "3", default-features = false, features = ["rustls"] }

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
strip = "symbols"
panic = "abort"
