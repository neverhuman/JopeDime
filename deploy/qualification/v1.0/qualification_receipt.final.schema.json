                  "T3",
                  "D1",
                  "D2"
                ]
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "counts": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "collected",
                  "executed",
                  "passed",
                  "failed",
                  "skipped",
                  "excluded"
                ],
                "properties": {
                  "collected": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "executed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "passed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "failed": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "skipped": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "excluded": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "result": {
                "$ref": "#/$defs/evidence"
              },
              "command_log": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "assembly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tooling_commit",
            "argv",
            "started_utc",
            "finished_utc",
            "exit_code",
            "stdout",
            "output",
            "log"
          ],
          "properties": {
            "tooling_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "started_utc": {
              "type": "string",
              "format": "date-time"
            },
            "finished_utc": {
              "type": "string",
              "format": "date-time"
            },
            "exit_code": {
              "const": 0
            },
            "stdout": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "$ref": "#/$defs/evidence"
            },
            "log": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nice",
            "cargo_build_jobs",
            "cargo_incremental",
            "cargo_profile_dev_debug",
            "cuda_visible_devices",
            "math_threads",
            "uid",
            "apparmor_profile",
            "host_policy_mutated_by_this_lane",
            "userns_restriction_at_start",
            "userns_restriction_at_assembly"
          ],
          "properties": {
            "nice": {
              "const": 19
            },
            "cargo_build_jobs": {
              "const": 4
            },
            "cargo_incremental": {
              "const": "0"
            },
            "cargo_profile_dev_debug": {
              "const": "line-tables-only"
            },
            "cuda_visible_devices": {
              "const": ""
            },
            "math_threads": {
              "const": 1
            },
            "uid": {
              "const": 1000
            },
            "apparmor_profile": {
              "const": "lxc-unshare (unconfined)"
            },
            "host_policy_mutated_by_this_lane": {
              "const": false
            },
            "userns_restriction_at_start": {
              "const": "1"
            },
            "userns_restriction_at_assembly": {
              "enum": [
                "0",
                "1"
              ]
            }
          }
        },
        "input_hashes_rechecked": {
          "const": true
        },
        "previous_attempts_promoted": {
          "const": 0
        },
        "controller_launch": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
