#!/usr/bin/env python3
"""Execute the 28 declared REL-07 gate commands on one artifact; never sign."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import signal
import socket
import subprocess
from pathlib import Path

import cpu_gates as cpu
from gates_receipt import RELEASE_GATE_IDS, from_cpu_prestage, from_gate_results

COUNTS = "collected executed passed failed skipped excluded".split()
INPUT_FIELDS = {
    "A5": {"manifest", "manifest_sha256"},
    "M5": {"golden_dir", "bundle_dir"},
}


def read_json(path):
    if path.is_symlink() or not path.is_file():
        raise ValueError(f"expected a regular, non-symlink JSON file: {path}")
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError("JSON root must be an object")
    return value


def manifest(path):
    if path.is_symlink() or not path.is_file():
        raise ValueError("gate manifest must be a regular, non-symlink file")
    raw = path.read_bytes()
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise ValueError("gate manifest must be an object")
    if value.get("schema") != "jope.rel07.gate-commands/v1":
        raise ValueError("unsupported gate-command schema")
    for field, length in [("source_sha", 40), ("artifact_sha256", 64)]:
        if not isinstance(value.get(field), str) or not re.fullmatch(
            "[0-9a-f]{" + str(length) + "}", value[field]
        ):
            raise ValueError("invalid " + field)
    rows = value.get("gates")
    if not isinstance(rows, list) or len(rows) != 28:
        raise ValueError("manifest requires exactly 28 release gates")
    commands = {}
    for row in rows:
        if not isinstance(row, dict) or set(row) != {"id", "argv", "timeout_seconds"}:
            raise ValueError("each command requires id, argv and timeout_seconds")
        gate = row["id"]
        if (
            not isinstance(gate, str)
            or gate not in RELEASE_GATE_IDS
            or gate in commands
        ):
            raise ValueError("unknown or duplicate release gate")
        argv = row["argv"]
        if (
            not isinstance(argv, list)
            or not argv
            or any(not isinstance(arg, str) or not arg or "\0" in arg for arg in argv)
        ):
            raise ValueError("argv must contain non-empty strings")
        timeout = row["timeout_seconds"]
        if type(timeout) not in (int, float):
            raise ValueError("timeout_seconds must be a number")
        cpu.validate_timeout(timeout)
        commands[gate] = row
    return value, commands, hashlib.sha256(raw).hexdigest()


def provider_inputs(path):
    """Only the declared external inputs may extend discovered provider commands."""
    if path is None:
        return {}
    if any(part.is_symlink() for part in (path, *path.parents)):
        raise ValueError("provider-input file must not contain symlinks")
    value = read_json(path)
    if (
        set(value) != {"schema", "gates"}
        or value["schema"] != "jope.rel07.provider-inputs/v1"
        or not isinstance(value["gates"], dict)
        or not set(value["gates"]) <= set(INPUT_FIELDS)
    ):
        raise ValueError("unsupported provider-input bindings")
    for gate, fields in value["gates"].items():
        if not isinstance(fields, dict) or set(fields) != INPUT_FIELDS[gate]:
            raise ValueError("provider input fields do not match " + gate)
        for name, item in fields.items():
            if not isinstance(item, str) or not item or "\0" in item:
                raise ValueError("provider inputs must be non-empty strings")
            if name == "manifest_sha256":
                if not re.fullmatch("[0-9a-f]{64}", item):
                    raise ValueError("A5 manifest SHA-256 must be full lowercase hex")
            elif not Path(item).is_absolute():
                raise ValueError("provider input paths must be absolute")
    return value["gates"]


def provider_commands(repo, bindings=None):
    """Return discovered commands and missing gate IDs without inventing rows."""
    bindings = bindings or {}
    provider_dir = repo / "deploy/qualification/v1.0/providers"
    if provider_dir.is_symlink() or not provider_dir.is_dir():
        raise ValueError("provider directory must be a regular, non-symlink directory")
    supported = {gate.lower() for gate in RELEASE_GATE_IDS}
    unexpected = []
    for path in provider_dir.glob("*.py"):
        if path.stem == "common":
            continue
        if path.stem not in supported:
            unexpected.append(path.name)
        elif path.is_symlink() or not path.is_file():
            raise ValueError(
                "provider must be a regular, non-symlink file: " + path.name
            )
    if unexpected:
        raise ValueError(
            "unregistered provider modules: " + ", ".join(sorted(unexpected))
        )
    commands = []
    missing = []
    for gate in RELEASE_GATE_IDS:
        relative = Path("deploy/qualification/v1.0/providers") / (gate.lower() + ".py")
        path = repo / relative
        if path.is_symlink():
            raise ValueError("provider must not be a symlink: " + str(relative))
        if not path.is_file():
            missing.append(gate)
            continue
        argv = ["python3", "-B", relative.as_posix()]
        if gate == "M5" and gate in bindings:
            argv += [
                "--golden-dir",
                bindings[gate]["golden_dir"],
                "--bundle-dir",
                bindings[gate]["bundle_dir"],
            ]
        if gate == "A5" and gate in bindings:
            # child_environment deliberately strips undeclared parent variables.
            # Explicit argv bindings survive that boundary without forwarding
            # credentials, overriding identity/resource variables, or a shell.
            argv = [
                "/usr/bin/env",
                "JOPE_REL07_A5_MANIFEST=" + bindings[gate]["manifest"],
                "JOPE_REL07_A5_MANIFEST_SHA256=" + bindings[gate]["manifest_sha256"],
                *argv,
            ]
        commands.append(
            dict(
                id=gate,
                argv=argv,
                timeout_seconds=3600,
            )
        )
    return commands, missing


def provider_inventory(repo, bindings=None):
    """Report the exact clean source's provider inventory without running gates."""
    repo = repo.resolve()
    source = cpu.identity(repo)
    if source["dirty_paths"]:
        raise ValueError("provider dry discovery requires a clean checkout")
    bindings = bindings or {}
    commands, missing = provider_commands(repo, bindings)
    found = [row["id"] for row in commands]
    unbound = [gate for gate in found if gate in INPUT_FIELDS and gate not in bindings]
    return dict(
        schema="jope.rel07.provider-discovery/v1",
        source_sha=source["head_sha"],
        origin_main_sha=source["main_sha"],
        is_origin_main=source["head_sha"] == source["main_sha"],
        expected_provider_count=len(RELEASE_GATE_IDS),
        found_provider_count=len(found),
        missing_provider_count=len(missing),
        found=found,
        missing=missing,
        unbound_provider_count=len(unbound),
        unbound_providers=unbound,
        complete=not missing and not unbound,
    )


def provider_manifest(repo, artifact, bindings=None):
    """Build the exact command manifest from registered, merged gate providers."""
    repo = repo.resolve()
    source = cpu.identity(repo, require_clean=True)
    source_sha = source["main_sha"]
    artifact = artifact.absolute()
    if artifact.is_symlink() or not artifact.is_file():
        raise ValueError("candidate must be a regular, non-symlink file")
    artifact_sha = cpu.digest(artifact)
    bindings = bindings or {}
    commands, missing = provider_commands(repo, bindings)
    if missing:
        raise ValueError(
            "provider inventory is incomplete; missing: " + ", ".join(missing)
        )
    unbound = [
        row["id"]
        for row in commands
        if row["id"] in INPUT_FIELDS and row["id"] not in bindings
    ]
    if unbound:
        raise ValueError("provider input bindings required for: " + ", ".join(unbound))
    return dict(
        schema="jope.rel07.gate-commands/v1",
        source_sha=source_sha,
        artifact_sha256=artifact_sha,
        gates=commands,
    )


def write_provider_manifest(repo, artifact, output, bindings=None):
    """Retain the generated manifest beside gate evidence before execution."""
    repo = repo.resolve()
    evidence = output.absolute()
    if evidence.resolve().is_relative_to(repo):
        raise ValueError("gate evidence must be outside the tested checkout")
    if evidence.exists() or evidence.is_symlink():
        raise ValueError("gate evidence output must be new")
    evidence.parent.mkdir(parents=True, exist_ok=True)
    path = evidence.with_name(evidence.name + ".gate-commands.json")
    if path.exists() or path.is_symlink():
        raise ValueError("generated gate manifest path must be new: " + str(path))
    value = provider_manifest(repo, artifact, bindings)
    path.write_text(json.dumps(value, indent=2) + "\n")
    return path


def verify_inputs(repo, artifact, source, digest):
    if cpu.git(repo, "rev-parse", "HEAD") != source or cpu.git(
        repo, "status", "--porcelain", "--untracked-files=all"
    ):
        raise ValueError("gate source changed or checkout is not clean")
    if (
        artifact.is_symlink()
        or not artifact.is_file()
        or cpu.digest(artifact) != digest
    ):
        raise ValueError("artifact bytes differ from the gate manifest")


def verified_result(path, gate, source, digest):
    result = read_json(path)
    if (
        result.get("schema") != "jope.rel07.gate-execution/v1"
        or result.get("id") != gate
        or result.get("source_sha") != source
        or result.get("artifact_sha256") != digest
    ):
        raise ValueError(
            "child result identity does not match this gate/source/artifact"
        )
    counts = result.get("counts")
    if (
        not isinstance(counts, dict)
        or set(counts) != set(COUNTS)
        or any(type(counts[key]) is not int or counts[key] < 0 for key in COUNTS)
    ):
        raise ValueError("child result requires all six nonnegative integer counts")
    if (
        result.get("status") != "PASS"
        or not counts["collected"] == counts["executed"] == counts["passed"] > 0
        or any(counts[key] for key in ["failed", "skipped", "excluded"])
    ):
        raise ValueError("gate did not PASS with positive, complete execution")
    return result


def execute(repo, artifact, commands_path, output):
    spec, commands, manifest_sha = manifest(commands_path)
    source, digest = spec["source_sha"], spec["artifact_sha256"]
    verify_inputs(repo, artifact, source, digest)
    if output.resolve().is_relative_to(repo):
        raise ValueError("gate evidence must be outside the tested checkout")
    output.mkdir(parents=True, exist_ok=False)
    rows = {
        gate: dict(
            id=gate, status="NOT_RUN", evidence=f"not started; artifact={digest}"
        )
        for gate in RELEASE_GATE_IDS
    }
    run = dict(
        schema="jope.rel07.gate-run/v1",
        mode="execute",
        source_sha=source,
        artifact=str(artifact),
        artifact_sha256=digest,
        manifest_sha256=manifest_sha,
        runner_sha256=cpu.digest(Path(__file__)),
        machine=socket.gethostname(),
        started_utc=cpu.utc(),
        checks=[],
        release_qualified=False,
    )

    def retain():
        results_path = output / "gate_results.json"
        cpu.write(
            results_path,
            dict(
                schema="jope.rel07.gate-results/v1",
                signed_bytes_sha256=digest,
                gates=[rows[g] for g in RELEASE_GATE_IDS],
            ),
        )
        receipt = dict(
            artifact_sha256=digest,
            gates=[dict(rows[g], artifact_sha256=digest) for g in RELEASE_GATE_IDS],
        )
        if all(row["status"] == "PASS" for row in rows.values()):
            receipt = from_gate_results(results_path, artifact)
            receipt["artifact_sha256"] = digest
            for row in receipt["gates"]:
                row["artifact_sha256"] = digest
        cpu.write(output / "execution.json", run)
        cpu.write(output / "gates_receipt.json", receipt)
        return receipt

    retain()
    interrupted = False
    for gate in RELEASE_GATE_IDS:
        record = dict(commands[gate], started_utc=cpu.utc(), exit_code=None)
        folder = output / gate
        try:
            verify_inputs(repo, artifact, source, digest)
            record["admission"] = cpu.admission(repo)
        except (OSError, ValueError) as error:
            rows[gate].update(status="BLOCKED", evidence=f"{error}; artifact={digest}")
            record["diagnostic"] = str(error)
            run["checks"].append(record)
            break
        folder.mkdir()
        (folder / "scratch").mkdir()
        environment = cpu.child_environment(folder, repo / "target", 4, source)
        environment.update(
            JOPE_REL07_ARTIFACT=str(artifact),
            JOPE_REL07_ARTIFACT_SHA256=digest,
            JOPE_REL07_SOURCE_SHA=source,
            JOPE_REL07_GATE_ID=gate,
            JOPE_REL07_RESULT=str(folder / "result.json"),
        )
        try:
            code, timed_out = cpu.invoke(
                commands[gate]["argv"],
                repo,
                folder / "command.log",
                environment,
                commands[gate]["timeout_seconds"],
            )
            record.update(exit_code=code, timed_out=timed_out)
            log = folder / "command.log"
            if log.is_symlink() or not log.is_file():
                raise ValueError("gate requires a retained regular command log")
            record["log_sha256"] = cpu.digest(log)
            verify_inputs(repo, artifact, source, digest)
            if code != 0 or timed_out:
                raise ValueError(
                    f"gate command failed: exit={code}, timeout={timed_out}"
                )
            result = verified_result(folder / "result.json", gate, source, digest)
            record.update(
                counts=result["counts"],
                result_sha256=cpu.digest(folder / "result.json"),
            )
            rows[gate].update(
                status="PASS", evidence=f"{folder / 'result.json'}; artifact={digest}"
            )
        except (OSError, ValueError) as error:
            record["diagnostic"] = str(error)
            rows[gate].update(
                status="FAIL", evidence=f"{folder}; {error}; artifact={digest}"
            )
        except KeyboardInterrupt:
            interrupted = True
            record["diagnostic"] = "interrupted; owned child group stopped"
            rows[gate].update(
                status="FAIL", evidence=f"interrupted; {folder}; artifact={digest}"
            )
        record["finished_utc"] = cpu.utc()
        run["checks"].append(record)
        # Recheck before publishing even the last PASS; source drift cannot emit 28 PASS.
        try:
            verify_inputs(repo, artifact, source, digest)
        except (OSError, ValueError) as error:
            rows[gate].update(status="FAIL", evidence=f"{error}; artifact={digest}")
            run["diagnostic"] = str(error)
            break
        retain()
        if interrupted:
            break
    run.update(finished_utc=cpu.utc(), interrupted=interrupted)
    receipt = retain()
    return receipt, 130 if interrupted else int(
        any(row["status"] != "PASS" for row in receipt["gates"])
    )


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    inputs = parser.add_mutually_exclusive_group(required=True)
    inputs.add_argument("--manifest", type=Path)
    inputs.add_argument(
        "--providers",
        action="store_true",
        help="discover the complete provider set and retain its command manifest beside evidence",
    )
    inputs.add_argument("--cpu-prestage", type=Path)
    parser.add_argument("--repo", type=Path)
    parser.add_argument("--artifact", type=Path)
    parser.add_argument(
        "--provider-inputs",
        type=Path,
        help="explicit M5 fixture directories and A5 transcript path/hash for --providers",
    )
    parser.add_argument("--dry-discovery", action="store_true")
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()
    if args.provider_inputs and not args.providers:
        parser.error("--provider-inputs requires --providers")
    try:
        bindings = provider_inputs(args.provider_inputs)
    except (OSError, ValueError) as error:
        parser.error(str(error))
    if args.dry_discovery:
        if not args.providers or args.repo is None or args.artifact or args.output:
            parser.error(
                "--dry-discovery requires --providers and --repo; it accepts no artifact or output"
            )
        try:
            report = provider_inventory(args.repo, bindings)
        except (OSError, ValueError, subprocess.CalledProcessError) as error:
            parser.error(str(error))
        print(json.dumps(report, sort_keys=True))
        return 0
    if args.output is None:
        parser.error("--output is required unless --dry-discovery is used")
    if args.manifest:

        def interrupted(_signum, _frame):
            raise KeyboardInterrupt

        signal.signal(signal.SIGTERM, interrupted)
    try:
        if args.cpu_prestage:
            if args.repo or args.artifact:
                raise ValueError("CPU-prestage dry-run accepts no artifact or repo")
            receipt = from_cpu_prestage(args.cpu_prestage)
            args.output.mkdir(parents=True, exist_ok=False)
            cpu.write(args.output / "gates_receipt.json", receipt)
            cpu.write(
                args.output / "execution.json",
                dict(
                    mode="dry-run",
                    gates_executed=0,
                    release_qualified=False,
                    input_sha256=cpu.digest(args.cpu_prestage),
                    finished_utc=cpu.utc(),
                ),
            )
            code = 0
        else:
            if not args.repo or not args.artifact:
                raise ValueError("execution requires --repo and --artifact")
            commands_path = args.manifest
            if args.providers:
                commands_path = write_provider_manifest(
                    args.repo.resolve(), args.artifact, args.output, bindings
                )
            receipt, code = execute(
                args.repo.resolve(),
                args.artifact.absolute(),
                commands_path,
                args.output.absolute(),
            )
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        parser.error(str(error))
    print(
        json.dumps(
            dict(
                gates=28,
                all_pass=all(g["status"] == "PASS" for g in receipt["gates"]),
                dry_run=bool(args.cpu_prestage),
            )
        )
    )
    return code


if __name__ == "__main__":
    raise SystemExit(main())
