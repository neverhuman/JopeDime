        ).encode()
        raw = (
            struct.pack("<Q", len(header))
            + header
            + struct.pack("<412f", *([0.0] * 412))
        )
        inputs = dict(
            names=names,
            programs=[dict(program_sha256="a" * 64)],
            catalog=dict(
                dsl_coverage=dict(
                    canonical_tensor_shards=[dict(start=0, end=1, path="fixture")]
                )
            ),
            load=lambda _: raw,
        )

        def measurement():
            return dict(
                names=names,
                programs=[
                    dict(
                        program_sha256="a" * 64, feat412=[0.0] * 412, proj16=[0.0] * 16
                    )
                ],
            )

        self.assertTrue(full.compare_features(measurement(), inputs)["passed"])
