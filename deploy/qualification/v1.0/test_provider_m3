class M3Tests(unittest.TestCase):
    def setUp(self):
        root = Path(os.environ.get("JOPE_QUALIFICATION_TEST_TMP", HERE / "target"))
        root.mkdir(parents=True, exist_ok=True)
        self.tmp = tempfile.TemporaryDirectory(prefix="m3-", dir=root)
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.repo = self.root / "checkout"
        self.repo.mkdir()
        self.artifact = self.root / "candidate"
        self.artifact.write_bytes(b"controlled M3 fixture; not a release")
        self.ctx = Context(
            "M3",
            self.artifact,
            hashlib.sha256(self.artifact.read_bytes()).hexdigest(),
            "a" * 40,
            self.root / "result.json",
        )
        self.calls = []
        self.test_calls = 0
        self.source = self.ctx.source_sha
        self.dirty = ""
        self.output_override = None
        self.returncode = 0
        self.after_test = lambda: None
        self.addCleanup(patch.stopall)
        patch.object(m3, "ROOT", self.repo).start()

    def run_child(self, args, **kwargs):
        self.calls.append(args)
        if args[:2] == ["git", "rev-parse"]:
            output = self.source
        elif args[:2] == ["git", "status"]:
            output = self.dirty
        elif args[0] == "cargo" and args[1] == "run":
            if "inspect" in args:
                output = json.dumps(
                    {
                        "manifest": {
                            "profile": "full",
                            "scope": "release",
                            "source": {"sha40": self.ctx.source_sha},
                        }
                    }
                )
            else:
                output = json.dumps({"schema": "jope.appliance-verify/v1", "ok": True})
        else:
            self.test_calls += 1
            test = m3.TESTS[self.test_calls - 1]
            self.after_test()
            if self.output_override is not None:
                output = self.output_override
            else:
                output = (
                    f"running 1 test\ntest {test} ... ok\n"
                    "test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 400 filtered out\n"
                )
                if test == m3.FREQUENCY_DIAGNOSTIC:
                    report = {
                        "schema": "jopedime.dsc06-generated-frequency-diagnostic/v1",
                        "population_comparable_to_reference": False,
                        "m3_qualified": False,
                    }
                    # The real --nocapture shape: the diagnostic interrupts the case line.
                    output = (
                        f"running 1 test\ntest {test} ... "
                        f"{m3.DIAGNOSTIC_PREFIX}{json.dumps(report)}\nok\n\n"
                        "test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 400 filtered out\n"
                    )
            return subprocess.CompletedProcess(args, self.returncode, output, "")
        return subprocess.CompletedProcess(args, 0, output, "")

    def invoke(self):
        with (
            contextlib.redirect_stdout(io.StringIO()),
            contextlib.redirect_stderr(io.StringIO()),
        ):
            return m3.qualify(self.ctx, run=self.run_child)

    def test_partial_source_controls_never_emit_pass_receipt(self):
        with self.assertRaisesRegex(
            ProviderError, "M3 remains not qualified; missing evidence"
        ):
            self.invoke()
        self.assertEqual(self.test_calls, len(m3.TESTS))
        self.assertFalse(self.ctx.result.exists())
        self.assertIn("full historical feat412 corpus", str(m3.INCOMPLETE))
        self.assertIn(m3.command(m3.TESTS[0]), self.calls)

    def test_default_cli_retains_candidate_qualification_path(self):
        with (
            patch.object(m3, "context", return_value=self.ctx) as context_call,
            patch.object(m3, "qualify", return_value=17) as qualify_call,
        ):
            self.assertEqual(m3.main([]), 17)
        context_call.assert_called_once_with("M3")
        qualify_call.assert_called_once_with(self.ctx)

    def test_zero_collected_tests_refuse_before_incomplete_result(self):
        self.output_override = "test result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 400 filtered out\n"
        with self.assertRaisesRegex(ProviderError, "exactly one passing case"):
            self.invoke()
        self.assertEqual(self.test_calls, 1)
        self.assertFalse(self.ctx.result.exists())

    def test_wrong_test_name_cannot_substitute_for_a_clause(self):
        self.output_override = "test other::case ... ok\ntest result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 400 filtered out\n"
        with self.assertRaisesRegex(ProviderError, "exactly one passing case"):
            self.invoke()
        self.assertFalse(self.ctx.result.exists())

    def test_failed_assertion_short_circuits_and_has_no_receipt(self):
        self.returncode = 42
        self.assertEqual(self.invoke(), 42)
        self.assertEqual(self.test_calls, 1)
        self.assertFalse(self.ctx.result.exists())

    def test_source_or_artifact_drift_refuses(self):
        for source, dirty in [("b" * 40, ""), (self.ctx.source_sha, " M source.rs")]:
            self.source, self.dirty = source, dirty
            with (
                self.subTest(source=source, dirty=dirty),
                self.assertRaisesRegex(ProviderError, "clean, candidate-pinned"),
            ):
                self.invoke()
        self.assertEqual(self.test_calls, 0)
        self.dirty = ""
        self.source = self.ctx.source_sha
        self.after_test = lambda: self.artifact.write_bytes(b"changed")
        with self.assertRaisesRegex(ProviderError, "candidate bytes changed"):
            self.invoke()
        self.assertEqual(self.test_calls, 1)
        self.assertFalse(self.ctx.result.exists())

    def test_interleaved_nocapture_case_block_is_one_pass_but_failed_is_not(self):
        name = m3.FREQUENCY_DIAGNOSTIC
        real = f"running 1 test\ntest {name} ... {m3.DIAGNOSTIC_PREFIX}{{}}\nok\n\ntest result: ok. 1 passed"
        self.assertTrue(m3.exact_case_passed(real, name))
        self.assertFalse(
            m3.exact_case_passed(real.replace("\nok\n", "\nFAILED\n"), name)
        )
        self.assertFalse(m3.exact_case_passed(real + f"\ntest {name} ... ok\n", name))
        report = {
            "schema": "jopedime.dsc06-generated-frequency-diagnostic/v1",
            "population_comparable_to_reference": False,
            "m3_qualified": False,
        }
        parsed = m3._frequency_report(real.replace("{}", json.dumps(report)))
        self.assertEqual(parsed["schema"], report["schema"])

    def test_frequency_diagnostic_cannot_claim_comparable_m3_population(self):
        report = json.dumps(
            {
                "schema": "jopedime.dsc06-generated-frequency-diagnostic/v1",
                "population_comparable_to_reference": True,
                "m3_qualified": False,
            }
        )
        with self.assertRaisesRegex(ProviderError, "limited population"):
            m3._frequency_report(f"{m3.DIAGNOSTIC_PREFIX}{report}\n")

    def test_existing_result_is_never_overwritten(self):
        self.ctx.result.write_bytes(b"prior evidence")
        with self.assertRaisesRegex(ProviderError, "new regular file"):
            self.invoke()
        self.assertEqual(self.ctx.result.read_bytes(), b"prior evidence")
        self.assertEqual(self.test_calls, 0)

    def test_context_refuses_symlink_and_nonfile_candidates(self):
        link = self.root / "candidate-link"
        link.symlink_to(self.artifact)
        directory = self.root / "candidate-directory"
        directory.mkdir()
        for candidate in (link, directory):
            env = {
                "JOPE_REL07_GATE_ID": "M3",
                "JOPE_REL07_ARTIFACT": str(candidate),
                "JOPE_REL07_ARTIFACT_SHA256": self.ctx.artifact_sha256,
                "JOPE_REL07_SOURCE_SHA": self.ctx.source_sha,
                "JOPE_REL07_RESULT": str(self.root / "new-result.json"),
            }
            with (
                self.subTest(candidate=candidate),
                patch.dict(os.environ, env),
                self.assertRaisesRegex(ProviderError, "regular non-symlink file"),
            ):
                common.context("M3")

    def test_evidence_path_inside_checkout_refuses(self):
        from dataclasses import replace

        self.ctx = replace(self.ctx, result=self.repo / "result.json")
        with self.assertRaisesRegex(ProviderError, "outside the source checkout"):
            self.invoke()
        self.assertEqual(self.test_calls, 0)
        self.assertFalse((self.repo / "result.json").exists())


class M3InputTests(unittest.TestCase):
    def setUp(self):
        base = Path(os.environ.get("JOPE_QUALIFICATION_TEST_TMP", HERE / "target"))
        base.mkdir(parents=True, exist_ok=True)
        self.tmp = tempfile.TemporaryDirectory(prefix="m3-input-", dir=base)
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.store = self.root / "cas"
        self.store.mkdir()
        self.payload = b"synthetic integrity fixture, never a numerical oracle"
        self.payload_pin = hashlib.sha256(self.payload).hexdigest()
        (self.store / self.payload_pin).write_bytes(self.payload)
        # Two logical files deliberately share one content-addressed object.
        self.catalog = dict(
            schema="jope.golden-custody/v1",
            storage="sha256-custody",
            authority="data-free control only",
            historical_scope="synthetic declared scope",
            historical_corpus_complete=True,
            original_historical_state_recovered=False,
            files={
                name: dict(bytes=len(self.payload), sha256=self.payload_pin)
                for name in ["dsl/one", "dsl/two"]
            },
            file_count=3,
            payload_bytes=2 * len(self.payload),
            unique_payload_bytes=len(self.payload),
            dsl_coverage=dict(
                delivered_unique_programs=3,
                evaluated_source_records=2,
                parent_source_records=1,
                covered_historical_programs=3,
                missing_historical_programs=0,
                excluded_unlogged=9,
            ),
        )

    def write_catalog(self, raw=None):
        if raw is None:
            # Byte totals include the catalog itself. Converge across decimal-width changes.
            for _ in range(20):
                raw = json.dumps(self.catalog, sort_keys=True).encode()
                total = self.catalog["payload_bytes"] + len(raw)
                unique = self.catalog["unique_payload_bytes"] + len(raw)
                if (
                    self.catalog.get("total_bytes"),
                    self.catalog.get("unique_custody_bytes"),
                ) == (total, unique):
                    break
                self.catalog.update(total_bytes=total, unique_custody_bytes=unique)
            else:
                self.fail("catalog totals did not converge")
        pin = hashlib.sha256(raw).hexdigest()
        (self.store / pin).write_bytes(raw)
        return pin

    def check(self, pin=None):
        return m3.input_preflight(
            self.store, self.write_catalog() if pin is None else pin
        )

    def test_complete_custody_is_input_integrity_only_and_deduplicates_hashes(self):
        with patch.object(
            m3.subprocess, "run", side_effect=AssertionError("no child allowed")
        ):
            report = self.check()
        self.assertEqual(report["status"], "INPUTS_VERIFIED_NOT_QUALIFIED")
        self.assertEqual(report["logical_files_verified"], 2)
        self.assertEqual(report["unique_objects_verified"], 2)
        self.assertTrue(report["reconstructed_corpus_complete"])
        self.assertFalse(report["original_historical_state_recovered"])
        self.assertFalse(report["release_qualified"])
        self.assertEqual(report["tests_executed"], 0)
        self.assertEqual(report["missing_scientific_comparisons"], list(m3.INCOMPLETE))

    def test_preflight_cli_works_without_candidate_and_never_writes_gate_result(self):
        pin = self.write_catalog()
        result = self.root / "must-not-write.json"
        output = io.StringIO()
        with (
            patch.object(
                m3, "context", side_effect=AssertionError("no candidate allowed")
            ),
            patch.dict(os.environ, JOPE_REL07_RESULT=str(result)),
            contextlib.redirect_stdout(output),
        ):
            self.assertEqual(
                m3.main(
                    [
                        "--preflight-inputs",
                        "--store",
                        str(self.store),
                        "--catalog-sha256",
                        pin,
                    ]
                ),
                0,
            )
        self.assertEqual(json.loads(output.getvalue())["release_qualified"], False)
        self.assertFalse(result.exists())

    def test_missing_and_changed_objects_are_refused(self):
        pin = self.write_catalog()
        payload = self.store / self.payload_pin
        payload.unlink()
        with self.assertRaises(OSError):
            self.check(pin)
        payload.write_bytes(b"x" * len(self.payload))
        with self.assertRaisesRegex(ProviderError, "hash differs"):
            self.check(pin)

    def test_object_symlink_and_directory_refused(self):
        pin = self.write_catalog()
        path = self.store / self.payload_pin
        path.unlink()
        real = self.root / "same-bytes"
        real.write_bytes(self.payload)
        path.symlink_to(real)
        with self.assertRaisesRegex(ProviderError, "regular non-symlink"):
            self.check(pin)
        path.unlink()
        path.mkdir()
        with self.assertRaisesRegex(ProviderError, "regular non-symlink"):
            self.check(pin)

    def test_symlink_parent_and_relative_store_refused(self):
        pin = self.write_catalog()
        link = self.root / "link"
        link.symlink_to(self.store, target_is_directory=True)
        for store in [Path("relative"), link]:
            with self.subTest(store=store), self.assertRaises(ProviderError):
                m3.input_preflight(store, pin)

    def test_bad_catalog_pin_and_malformed_json_refused(self):
        for pin in ["../outside", "A" * 64, "f" * 63]:
            with self.subTest(pin=pin), self.assertRaises(ProviderError):
                self.check(pin)
        for raw in [b"{", b"[]", b'{"schema":"one","schema":"two"}']:
            with self.subTest(raw=raw), self.assertRaises(ProviderError):
                self.check(self.write_catalog(raw))

    def test_unsafe_logical_names_refused(self):
        spec = dict(bytes=len(self.payload), sha256=self.payload_pin)
        for name in ["../outside", "/absolute", "a/../b", "a//b", "a/./b", "a\\b", ""]:
            self.catalog["files"] = {name: spec}
            with (
                self.subTest(name=name),
                self.assertRaisesRegex(ProviderError, "safe relative"),
            ):
                self.check()

    def test_wrong_inventory_count_size_and_strict_boolean_fields_refused(self):
        pin = self.write_catalog()
        good = json.loads((self.store / pin).read_bytes())
        for key, value in [
            ("file_count", 2),
            ("payload_bytes", 1),
            ("unique_payload_bytes", 1),
            ("file_count", True),
            ("historical_corpus_complete", 1),
            ("original_historical_state_recovered", 0),
        ]:
            self.catalog = dict(good)
            self.catalog[key] = value
            with self.subTest(key=key, value=value), self.assertRaises(ProviderError):
                self.check()

    def test_contradictory_duplicate_object_size_and_boolean_byte_counts_refused(self):
        self.catalog["files"]["dsl/two"]["bytes"] += 1
        with self.assertRaisesRegex(ProviderError, "contradictory lengths"):
            self.check()
        self.catalog["files"]["dsl/two"]["bytes"] = True
        with self.assertRaisesRegex(ProviderError, "positive bounded"):
            self.check()

    def test_declared_coverage_requires_nonnegative_integers(self):
        self.catalog["dsl_coverage"]["excluded_unlogged"] = False
        with self.assertRaisesRegex(ProviderError, "invalid declared DSL count"):
            self.check()

    def test_cli_missing_or_misplaced_custody_arguments_refused(self):
        with contextlib.redirect_stderr(io.StringIO()):
            self.assertEqual(m3.main(["--preflight-inputs"]), 2)
            self.assertEqual(m3.main(["--store", str(self.store)]), 2)


full = importlib.import_module("m3_full")


def full_report(source="a" * 40, pin="b" * 64):
    ops = [
        "champion_retrieval",
        "edit_parameter",
        "edit_replace_head",
        "edit_insert_stage",
        "edit_delete_stage",
        "edit_crossover",
        "landmark_synthesis",
    ]

    def mode(name, a, b):
        return dict(
            mode=name,
            reference=a,
            native=b,
            reference_counts={op: (a if i == 0 else 0) for i, op in enumerate(ops)},
            native_counts={op: (b if i == 0 else 0) for i, op in enumerate(ops)},
            passed=True,
        )

    return dict(
        schema="jope.rel07.m3-full-measurement/v1",
        source_sha=source,
        inputs_sha256=pin,
        status="NUMERICAL_PASS",
        scope="data-free control only",
        counts=dict(collected=4, executed=4, passed=4, failed=0, skipped=0, excluded=0),
        clauses=dict(
            feat412_proj16=dict(
                passed=True,
                programs=1137,
                coordinates=1137 * 412,
                projection_comparisons=1137 * 16,
                count_flag_comparisons=100,
                feature_mismatches=0,
                projection_mismatches=0,
                max_feature_error=0.0,
                max_projection_error=0.0,
            ),
            training_landmarks=dict(
                passed=True,
                contexts=50,
                comparisons=1000,
                mismatches=0,
                max_absolute_error=0.0,
            ),
            full_train_cv=dict(
                passed=True,
                evaluations=1024,
                contexts=132,
                evaluator_sha256=full.R0_EVALUATOR,
                protocol="full_train_cv/two-fold",
                mismatches=0,
                max_relative_error=0.0,
            ),
            r0_proposer=dict(
                passed=True,
                newly_generated=44544,
                admitted=10000,
                strata=[
                    mode("all", 1024, 10000),
                    mode(False, 192, 1920),
                    mode(True, 832, 8080),
                ],
            ),
        ),
    )


def mode_failure(report):
    proposer = report["clauses"]["r0_proposer"]
    # Pooled 1.2pp passes, but the false-mode 6.25pp miss must fail the gate.
    for row in proposer["strata"][:2]:
        row["native_counts"]["champion_retrieval"] -= 120
        row["native_counts"]["edit_parameter"] += 120
    proposer["strata"][1]["passed"] = False
    proposer["passed"] = False
    report["status"] = "NUMERICAL_FAIL"
    report["counts"].update(passed=3, failed=1)
    return report


class M3FullTests(unittest.TestCase):
    def setUp(self):
        self.ctx = Context(
            "M3",
            Path("/unused-controlled-candidate"),
            "c" * 64,
            "a" * 40,
            Path("/unused-result"),
        )
        self.pin = "b" * 64

    def test_all_four_complete_comparisons_allow_bound_pass(self):
        payload = full.gate_payload(self.ctx, full_report(), self.pin)
        self.assertEqual(payload["status"], "PASS")
        self.assertEqual(payload["counts"]["passed"], 4)
        self.assertEqual(payload["source_sha"], self.ctx.source_sha)
        self.assertEqual(payload["artifact_sha256"], self.ctx.artifact_sha256)

    def test_pooled_pass_cannot_hide_exploration_mode_failure(self):
        report = mode_failure(full_report())
        self.assertTrue(report["clauses"]["r0_proposer"]["strata"][0]["passed"])
        payload = full.gate_payload(self.ctx, report, self.pin)
        self.assertEqual(payload["status"], "FAIL")
        self.assertEqual(
            payload["counts"],
            dict(collected=4, executed=4, passed=3, failed=1, skipped=0, excluded=0),
        )

    def test_forged_proposer_flag_and_inconsistent_accounting_refused(self):
        for change in [
            lambda r: r["clauses"]["r0_proposer"].update(passed=True),
            lambda r: r.update(status="NUMERICAL_PASS"),
            lambda r: r["counts"].update(passed=4, failed=0),
        ]:
            report = mode_failure(full_report())
            change(report)
            with self.subTest(change=change), self.assertRaises(ProviderError):
                full.gate_payload(self.ctx, report, self.pin)

    def test_missing_partial_or_wrong_source_evidence_refused(self):
        changes = [
            lambda r: r["clauses"].pop("full_train_cv"),
            lambda r: r["clauses"]["feat412_proj16"].update(programs=1136),
            lambda r: r["clauses"]["training_landmarks"].update(contexts=49),
            lambda r: r["clauses"]["full_train_cv"].update(evaluations=1023),
            lambda r: r["clauses"]["full_train_cv"].update(evaluator_sha256="0" * 64),
            lambda r: r.update(source_sha="d" * 40),
            lambda r: r.update(inputs_sha256="d" * 64),
        ]
        for change in changes:
            report = full_report()
            change(report)
            with self.subTest(change=change), self.assertRaises(ProviderError):
                full.gate_payload(self.ctx, report, self.pin)

    def test_strict_booleans_counts_and_modes_required(self):
        changes = [
            lambda r: r["counts"].update(failed=False),
            lambda r: r["counts"].update(passed=4.0),
            lambda r: r["clauses"]["feat412_proj16"].update(passed=1),
            lambda r: r["clauses"]["feat412_proj16"].update(programs=1137.0),
            lambda r: r["clauses"]["training_landmarks"].update(mismatches=False),
            lambda r: r["clauses"]["r0_proposer"]["strata"][1].update(mode=0),
            lambda r: r["clauses"]["r0_proposer"]["strata"][0]["native_counts"].update(
                edit_parameter=True
            ),
        ]
        for change in changes:
            report = full_report()
            change(report)
            with self.subTest(change=change), self.assertRaises(ProviderError):
                full.gate_payload(self.ctx, report, self.pin)

    def test_no_tolerance_or_nonfinite_shortcuts(self):
        for clause, field, value in [
            ("feat412_proj16", "max_projection_error", 1.01e-12),
            ("feat412_proj16", "max_feature_error", 1.01e-6),
            ("full_train_cv", "max_relative_error", 1.01e-9),
            ("full_train_cv", "max_relative_error", float("nan")),
        ]:
            report = full_report()
            report["clauses"][clause][field] = value
            with self.subTest(clause=clause), self.assertRaises(ProviderError):
                full.gate_payload(self.ctx, report, self.pin)

    def test_evaluator_is_relative_without_absolute_floor_and_zero_is_exact(self):
        expected = [
            dict(
                row=dict(context_sha256="x", program_sha256="y"),
                score=dict(fitness=1e-8, cv_gate_passed=True),
            )
        ]
        actual = [
            dict(context_sha256="x", program_sha256="y", failure=None, fitness=1e-8)
        ]
        self.assertTrue(full.compare_evaluator(actual, expected)["passed"])
        actual[0]["fitness"] += 1e-16
        self.assertFalse(full.compare_evaluator(actual, expected)["passed"])
        expected[0]["score"]["fitness"] = 0.0
        actual[0]["fitness"] = 0.0
        self.assertTrue(full.compare_evaluator(actual, expected)["passed"])
        actual[0]["fitness"] = 1e-16
        report = full.compare_evaluator(actual, expected)
        self.assertFalse(report["passed"])
        json.dumps(report, allow_nan=False)

    def test_wrong_or_missing_evaluator_cases_never_count_as_pass(self):
        expected = [
            dict(
                row=dict(context_sha256="x", program_sha256="y"),
                score=dict(fitness=-0.5, cv_gate_passed=True),
            )
        ]
        for actual in [
            [],
            [
                dict(
                    context_sha256="other",
                    program_sha256="y",
                    failure=None,
                    fitness=-0.5,
                )
            ],
        ]:
            with self.subTest(actual=actual), self.assertRaises(ProviderError):
                full.compare_evaluator(actual, expected)
        actual = [
            dict(
                context_sha256="x",
                program_sha256="y",
                failure="InvalidRequest",
                fitness=None,
            )
        ]
        self.assertEqual(full.compare_evaluator(actual, expected)["mismatches"], 1)

