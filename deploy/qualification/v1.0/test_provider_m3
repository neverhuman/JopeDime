class M3FullFlowTests(unittest.TestCase):
    def setUp(self):
        base = Path(os.environ.get("JOPE_QUALIFICATION_TEST_TMP", HERE / "target"))
        base.mkdir(parents=True, exist_ok=True)
        self.tmp = tempfile.TemporaryDirectory(prefix="m3-full-control-", dir=base)
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.artifact = self.root / "candidate"
        self.artifact.write_bytes(b"data-free controller fixture")
        self.ctx = Context(
            "M3",
            self.artifact,
            hashlib.sha256(self.artifact.read_bytes()).hexdigest(),
            "a" * 40,
            self.root / "result.json",
        )

    def run_with(self, report):
        with (
            patch.object(m3, "check_binding"),
            patch.object(m3, "verify_candidate"),
            patch.object(full, "measure_full", return_value=report),
        ):
            return m3.qualify(
                self.ctx,
                full_inputs=self.root / "inputs.json",
                full_inputs_sha256="b" * 64,
            )

    def test_full_path_can_write_complete_pass_and_preserve_candidate_binding(self):
        self.assertEqual(self.run_with(full_report()), 0)
        result = json.loads(self.ctx.result.read_text())
        self.assertEqual(result["status"], "PASS")
        self.assertEqual(result["artifact_sha256"], self.ctx.artifact_sha256)

    def test_real_comparison_failure_produces_consistent_fail_receipt(self):
        self.assertEqual(self.run_with(mode_failure(full_report())), 1)
        result = json.loads(self.ctx.result.read_text())
        self.assertEqual(result["status"], "FAIL")
        self.assertEqual(result["counts"]["failed"], 1)
        self.assertEqual(result["counts"]["passed"], 3)

    def test_same_byte_artifact_symlink_replacement_never_writes_pass(self):
        def changed(*args, **kwargs):
            real = self.root / "other-candidate"
            real.write_bytes(self.artifact.read_bytes())
            self.artifact.unlink()
            self.artifact.symlink_to(real)
            return full_report()

        with (
            patch.object(m3, "check_binding"),
            patch.object(m3, "verify_candidate"),
            patch.object(full, "measure_full", side_effect=changed),
        ):
            with self.assertRaises(ProviderError):
                m3.qualify(
                    self.ctx,
                    full_inputs=self.root / "inputs.json",
                    full_inputs_sha256="b" * 64,
                )
        self.assertFalse(self.ctx.result.exists())

    def test_contradictory_measurements_never_write_a_result(self):
        report = mode_failure(full_report())
        report["status"] = "NUMERICAL_PASS"
        with self.assertRaises(ProviderError):
            self.run_with(report)
        self.assertFalse(self.ctx.result.exists())


