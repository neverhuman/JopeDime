#!/usr/bin/env python3
"""Data-free controls for the candidate-bound S2 provider."""

from __future__ import annotations

import contextlib
import hashlib
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE / "providers"))
import common  # noqa: E402
import s2  # noqa: E402

Context, ProviderError = common.Context, common.ProviderError


class S2ProviderTests(unittest.TestCase):
    def setUp(self):
        root = Path(os.environ.get("JOPE_QUALIFICATION_TEST_TMP", HERE / "target"))
        root.mkdir(parents=True, exist_ok=True)
        self.test_tmp_root = root.resolve()
        self.temp = tempfile.TemporaryDirectory(prefix="s2-provider-", dir=root)
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.repo = self.root / "checkout"
        self.repo.mkdir()
        s2.ROOT = self.repo
        self.artifact = self.root / "candidate.bin"
        self.artifact.write_bytes(b"synthetic candidate; not release bytes")
        self.ctx = Context(
            "S2",
            self.artifact,
            hashlib.sha256(self.artifact.read_bytes()).hexdigest(),
            "a" * 40,
            self.root / "evidence" / "result.json",
        )
        self.source = self.ctx.source_sha
        self.dirty = ""
        self.test_returncode = 0
        self.test_output = self.summary_output()
        self.calls = []
        self.test_calls = 0
        self.child_envs = []

    @staticmethod
    def summary_output(
        test=None,
        result="ok. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out",
    ):
        name = s2.TEST if test is None else test
        return f"running 1 test\ntest {name} ... ok\ntest result: {result}\n"

    def run_child(self, args, **kwargs):
        self.calls.append(args)
        if "env" in kwargs:
            self.child_envs.append(kwargs["env"])
        if args[:2] == ["git", "rev-parse"]:
            output = self.source
        elif args[:2] == ["git", "status"]:
            output = self.dirty
        elif args[:2] == ["cargo", "run"]:
            if "inspect" in args:
                output = json.dumps(
                    {
                        "manifest": {
                            "profile": "full",
                            "scope": "release",
                            "source": {"sha40": self.ctx.source_sha},
                        }
                    }
                )
            else:
                output = json.dumps({"schema": "jope.appliance-verify/v1", "ok": True})
        elif args == s2.BUILD_COMMAND:
            output = ""
        elif args == s2.command():
            self.test_calls += 1
            output = self.test_output
            return subprocess.CompletedProcess(args, self.test_returncode, output, "")
        else:
            self.fail(f"unexpected child command: {args!r}")
        return subprocess.CompletedProcess(args, 0, output, "")

    def invoke(self):
        with (
            contextlib.redirect_stdout(io.StringIO()),
            contextlib.redirect_stderr(io.StringIO()),
        ):
            return s2.qualify(self.ctx, run=self.run_child)

    def test_exact_native_s2_test_emits_bound_counts(self):
        self.assertEqual(self.invoke(), 0)
        receipt = json.loads(self.ctx.result.read_text())
        self.assertEqual(receipt["id"], "S2")
        self.assertEqual(receipt["source_sha"], self.ctx.source_sha)
        self.assertEqual(receipt["artifact_sha256"], self.ctx.artifact_sha256)
        self.assertEqual(receipt["status"], "PASS")
        self.assertEqual(receipt["counts"], s2.EXPECTED_COUNTS)
        self.assertEqual(self.test_calls, 1)
        self.assertEqual(
            [call for call in self.calls if call == s2.BUILD_COMMAND],
            [s2.BUILD_COMMAND],
        )
        self.assertEqual(
            [call for call in self.calls if call[0] == "cargo" and call[1] == "test"],
            [s2.command()],
        )
        self.assertIn("--ignored", s2.command())
        self.assertIn("--exact", s2.command())
        self.assertIn("--test-threads=1", s2.command())
        self.assertTrue(self.child_envs)
        self.assertTrue(
            all(
                Path(env["TMPDIR"]).is_relative_to(self.test_tmp_root)
                for env in self.child_envs
            )
        )

    def test_failed_native_s2_case_propagates_without_result(self):
        self.test_returncode = 42
        self.assertEqual(self.invoke(), 42)
        self.assertEqual(self.test_calls, 1)
        self.assertFalse(self.ctx.result.exists())

    def test_failed_worker_build_stops_before_s2(self):
        original = self.run_child

        def fail_build(args, **kwargs):
            if args == s2.BUILD_COMMAND:
                return subprocess.CompletedProcess(args, 43, "", "build failed")
            return original(args, **kwargs)

        with (
            contextlib.redirect_stdout(io.StringIO()),
            contextlib.redirect_stderr(io.StringIO()),
        ):
            self.assertEqual(s2.qualify(self.ctx, run=fail_build), 43)
        self.assertEqual(self.test_calls, 0)
        self.assertFalse(self.ctx.result.exists())

    def test_real_interleaved_nocapture_case_block_is_accepted(self):
        # The native test prints its summary between "test NAME ... " and "ok".
        real = (
            f"running 1 test\ntest {s2.TEST} ... DSC08 S2: real native CV; workers1/8\nok\n\n"
            "test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out\n"
        )
        self.assertTrue(s2.exact_case_passed(real, s2.TEST))
        self.assertFalse(
            s2.exact_case_passed(real.replace("\nok\n", "\nFAILED\n"), s2.TEST)
        )
        self.assertFalse(s2.exact_case_passed("test other ... ok\n", s2.TEST))

    def test_zero_skipped_or_wrong_case_cannot_emit_pass(self):
        bad_outputs = (
            "test result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out\n",
            self.summary_output(
                result="ok. 0 passed; 0 failed; 1 ignored; 0 measured; 0 filtered out"
            ),
            self.summary_output(test="discover::other_test"),
        )
        for output in bad_outputs:
            with self.subTest(output=output):
                self.test_output = output
                self.test_calls = 0
                with self.assertRaises(ProviderError):
                    self.invoke()
                self.assertFalse(self.ctx.result.exists())

    def test_wrong_or_dirty_source_refuses_before_running_s2(self):
        for source, dirty in (("b" * 40, ""), (self.ctx.source_sha, " M source.rs")):
            with self.subTest(source=source, dirty=dirty):
                self.source, self.dirty = source, dirty
                with self.assertRaises(ProviderError):
                    self.invoke()
        self.assertEqual(self.test_calls, 0)

    def test_platform_without_sigkill_recovery_support_refuses(self):
        with patch.object(s2.sys, "platform", "win32"):
            with self.assertRaisesRegex(ProviderError, "requires Linux or macOS"):
                self.invoke()
        self.assertEqual(self.calls, [])

    def test_candidate_mutation_after_test_refuses_result(self):
        original = self.run_child

        def mutate_after_test(args, **kwargs):
            result = original(args, **kwargs)
            if args[:2] == ["cargo", "test"]:
                self.artifact.write_bytes(b"changed")
            return result

        with self.assertRaisesRegex(ProviderError, "candidate bytes changed"):
            with (
                contextlib.redirect_stdout(io.StringIO()),
                contextlib.redirect_stderr(io.StringIO()),
            ):
                s2.qualify(self.ctx, run=mutate_after_test)
        self.assertFalse(self.ctx.result.exists())


if __name__ == "__main__":
    unittest.main()
