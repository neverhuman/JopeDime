#!/usr/bin/env python3
"""Data-free controls for the candidate-bound T3 adapter."""

import contextlib
import hashlib
import importlib
import io
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE / "providers"))
t3 = importlib.import_module("t3")
common = importlib.import_module("common")
Context, ProviderError = common.Context, common.ProviderError


class T3Tests(unittest.TestCase):
    def setUp(self):
        root = Path(os.environ.get("JOPE_QUALIFICATION_TEST_TMP", HERE / "target"))
        root.mkdir(parents=True, exist_ok=True)
        self.tmp = tempfile.TemporaryDirectory(prefix="t3-", dir=root)
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.repo = self.root / "checkout"
        self.repo.mkdir()
        self.artifact = self.root / "candidate"
        self.artifact.write_bytes(b"controlled provider fixture; not a release")
        self.ctx = Context("T3", self.artifact, hashlib.sha256(self.artifact.read_bytes()).hexdigest(), "a" * 40, self.root / "result.json")
        self.calls, self.test_calls = [], 0
        self.source, self.dirty = self.ctx.source_sha, ""
        self.output_override, self.returncode = None, 0
        self.output_override_test = None
        self.after_test = lambda: None
        self.addCleanup(patch.stopall)
        patch.object(t3, "ROOT", self.repo).start()

    def run_child(self, args, **kwargs):
        self.calls.append(args)
        if args[:2] == ["git", "rev-parse"]:
            output = self.source
        elif args[:2] == ["git", "status"]:
            output = self.dirty
        elif args[0] == "cargo" and args[1] == "run":
            output = json.dumps({"manifest": {"profile": "full", "scope": "release", "source": {"sha40": self.ctx.source_sha}}}) if "inspect" in args else json.dumps({"schema": "jope.appliance-verify/v1", "ok": True})
        else:
            self.test_calls += 1
            test = t3.TESTS[self.test_calls - 1]
            self.after_test()
            if self.output_override is not None and self.output_override_test in (None, test):
                output = self.output_override
            else:
                output = f"running 1 test\ntest {test} ... ok\n\ntest result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 500 filtered out\n"
            return subprocess.CompletedProcess(args, self.returncode, output, "")
        return subprocess.CompletedProcess(args, 0, output, "")

    def invoke(self):
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            return t3.qualify(self.ctx, run=self.run_child)

    def test_four_exact_clauses_produce_candidate_bound_counts(self):
        self.assertEqual(self.invoke(), 0)
        result = json.loads(self.ctx.result.read_text())
        self.assertEqual(result["artifact_sha256"], self.ctx.artifact_sha256)
        self.assertEqual(result["source_sha"], self.ctx.source_sha)
        self.assertEqual(result["counts"], {k: 4 * v for k, v in t3.SINGLE_PASS.items()})
        self.assertEqual(self.test_calls, 4)
        for test in t3.TESTS:
            self.assertIn(t3.command(test), self.calls)
            self.assertIn("--exact", t3.command(test))

    def test_zero_ignored_and_multiple_cases_never_pass(self):
        for output in (
            "test result: ok. 0 passed; 0 failed; 0 ignored; 0 measured; 500 filtered out\n",
            "test result: ok. 0 passed; 0 failed; 1 ignored; 0 measured; 500 filtered out\n",
            "test result: ok. 2 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out\n",
        ):
            self.test_calls, self.output_override = 0, output
            with self.subTest(output=output), self.assertRaises(ProviderError):
                self.invoke()
        self.assertFalse(self.ctx.result.exists())

    def test_valid_interleaved_benchmark_output_is_accepted(self):
        test = t3.TESTS[-1]
        self.output_override_test = test
        self.output_override = (
            f"running 1 test\ntest {test} ... fixed work off 2.9s on 2.8s overhead -3.8%\n"
            "ok\n\ntest result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out\n"
        )
        self.assertEqual(self.invoke(), 0)
        self.assertEqual(self.test_calls, len(t3.TESTS))
        result = json.loads(self.ctx.result.read_text())
        self.assertEqual(result["status"], "PASS")

    def test_wrong_or_dirty_source_refuses_before_tests(self):
        for source, dirty in [("b" * 40, ""), (self.ctx.source_sha, " M file.rs")]:
            self.source, self.dirty = source, dirty
            with self.subTest(source=source, dirty=dirty), self.assertRaises(ProviderError):
                self.invoke()
        self.assertEqual(self.test_calls, 0)

    def test_artifact_drift_during_suite_refuses_receipt(self):
        self.after_test = lambda: self.artifact.write_bytes(b"changed")
        with self.assertRaisesRegex(ProviderError, "candidate bytes changed"):
            self.invoke()
        self.assertFalse(self.ctx.result.exists())

    def test_existing_receipt_is_never_overwritten(self):
        self.ctx.result.write_bytes(b"prior")
        with self.assertRaises(ProviderError):
            self.invoke()
        self.assertEqual(self.ctx.result.read_bytes(), b"prior")
        self.assertEqual(self.test_calls, 0)


if __name__ == "__main__":
    unittest.main()
