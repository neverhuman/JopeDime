    def test_unbound_candidate_inputs_block_only_their_four_gate_rows(self):
        worker = (
            "import json,os\nfrom pathlib import Path\n"
            "p=Path(os.environ['JOPE_REL07_RESULT'])\n"
            "counts=dict(collected=1,executed=1,passed=1,failed=0,skipped=0,excluded=0)\n"
            "p.write_text(json.dumps(dict(schema='jope.rel07.gate-execution/v1',"
            "id=os.environ['JOPE_REL07_GATE_ID'],status='PASS',"
            "source_sha=os.environ['JOPE_REL07_SOURCE_SHA'],"
            "artifact_sha256=os.environ['JOPE_REL07_ARTIFACT_SHA256'],counts=counts)))\n"
        )
        self.commit_providers({gate: worker for gate in runner.RELEASE_GATE_IDS})
        source = runner.cpu.git(self.repo, "rev-parse", "HEAD")
        bindings = {
            "M3": {
                "full_inputs": str(self.root / "full-inputs.json"),
                "full_inputs_sha256": "c" * 64,
            }
        }
        commands, missing = runner.provider_commands(self.repo, bindings)
        self.assertEqual(missing, [])
        for command in commands:
            if command["id"] in runner.INPUT_FIELDS and command["id"] not in bindings:
                command["blocked_reason"] = "required provider inputs are unbound: fixture"
        manifest_path = self.root / "partial-input-manifest.json"
        manifest_path.write_text(
            json.dumps(
                {
                    "schema": "jope.rel07.gate-commands/v1",
                    "source_sha": source,
                    "artifact_sha256": self.sha,
                    "gates": commands,
                }
            )
        )
        output = self.root / "partial-input-run"
        receipt, code = runner.execute(self.repo, self.artifact, manifest_path, output)
        table = json.loads((output / "status_table.json").read_text())
        self.assertEqual(code, 1)
        self.assertEqual(len(receipt["gates"]), 28)
        self.assertEqual(
            sum(row["status"] == "BLOCKED" for row in table["gates"]), 4
        )
        self.assertEqual(sum(row["status"] == "PASS" for row in table["gates"]), 24)
        self.assertEqual(len(json.loads((output / "execution.json").read_text())["checks"]), 24)

    def test_source_ancestor_rule_rejects_non_ancestor_and_accepts_ancestor(self):
        self.commit_providers(
            {gate: "# ancestor fixture\n" for gate in runner.RELEASE_GATE_IDS}
        )
        head = runner.cpu.git(self.repo, "rev-parse", "HEAD")
        subprocess.run(
            [
                "git",
                "-C",
                str(self.repo),
                "-c",
                "user.name=Fixture",
                "-c",
                "user.email=fixture@example.invalid",
                "commit",
                "--allow-empty",
                "-qm",
                "advance main after candidate source",
            ],
            check=True,
        )
        main = runner.cpu.git(self.repo, "rev-parse", "HEAD")
        subprocess.run(
            ["git", "-C", str(self.repo), "update-ref", "refs/remotes/origin/main", main],
            check=True,
        )
        subprocess.run(
            ["git", "-C", str(self.repo), "reset", "--hard", head], check=True
        )
        self.assertTrue(runner.source_is_ancestor(self.repo, head, main))
        manifest = runner.provider_manifest(self.repo, self.artifact, self.bindings())
        self.assertEqual(manifest["source_sha"], head)
        tree = runner.cpu.git(self.repo, "rev-parse", "HEAD^{tree}")
        unrelated = subprocess.check_output(
            [
                "git",
                "-C",
                str(self.repo),
                "-c",
                "user.name=Fixture",
                "-c",
                "user.email=fixture@example.invalid",
                "commit-tree",
                tree,
                "-m",
                "unrelated root fixture",
            ],
            text=True,
        ).strip()
        self.assertFalse(runner.source_is_ancestor(self.repo, unrelated, main))

