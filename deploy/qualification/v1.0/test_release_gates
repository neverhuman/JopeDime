    def transport_stub(self, gate):
        """Use the maintained provider's CLI; replace qualification with observation."""
        provider = HERE / "providers" / (gate.lower() + ".py")
        return f"""import importlib.util,json,os,sys
sys.path.insert(0,{str(provider.parent)!r})
spec=importlib.util.spec_from_file_location('transport_provider',{str(provider)!r})
module=importlib.util.module_from_spec(spec);sys.modules[spec.name]=module;spec.loader.exec_module(module)
module.context=lambda gate:gate
def observe(ctx,*args,**kwargs):
    if ctx=='M3':
        if set(kwargs)!={{'full_inputs','full_inputs_sha256'}}:raise module.ProviderError('controlled missing M3 full inputs')
        fields=dict(full_inputs=str(kwargs['full_inputs']),full_inputs_sha256=kwargs['full_inputs_sha256'])
    elif ctx=='D1':
        fields=dict(macos_receipt=str(args[0]),macos_receipt_sha256=args[1],macos_artifact_sha256=args[2])
    else:
        fields={{name:os.environ.get(variable) for name,variable in [
            ('golden_dir','JOPE_GOLDEN_DIR'),('golden_index_sha256','JOPE_GOLDEN_INDEX_SHA256'),
            ('parity_bundle_dir','JOPE_PARITY_BUNDLE_DIR'),('parity_report_dir','JOPE_PARITY_REPORT_DIR')]}}
        if any(value is None for value in fields.values()):raise module.ProviderError('controlled missing transport inputs')
    identity={{name:os.environ.get(name) for name in ['JOPE_REL07_GATE_ID','JOPE_REL07_SOURCE_SHA','JOPE_REL07_ARTIFACT','JOPE_REL07_ARTIFACT_SHA256','JOPE_REL07_RESULT']}}
    print(json.dumps(dict(synthetic=True,fields=fields,identity=identity,jobs=os.environ['CARGO_BUILD_JOBS'])))
    return 0
module.qualify=observe
raise SystemExit(module.main())
"""

    def test_d1_m2_and_m3_flags_cross_the_real_restricted_environment_boundary(self):
        self.commit_providers(
            {gate: self.transport_stub(gate) for gate in ["D1", "M2", "M3"]}
        )
        inputs = runner.provider_inputs(self.input_file())
        inherited = {
            name: "discard inherited input"
            for name in [
                "JOPE_REL07_D1_MACOS_RECEIPT",
                "JOPE_REL07_D1_MACOS_RECEIPT_SHA256",
                "JOPE_REL07_D1_MACOS_ARTIFACT_SHA256",
                "JOPE_GOLDEN_DIR",
                "JOPE_GOLDEN_INDEX_SHA256",
                "JOPE_PARITY_BUNDLE_DIR",
                "JOPE_PARITY_REPORT_DIR",
            ]
        }
        source = runner.cpu.git(self.repo, "rev-parse", "HEAD")
        for gate in ["D1", "M2", "M3"]:
            folder = self.root / gate
            folder.mkdir()
            with mock.patch.dict(os.environ, inherited):
                env = runner.cpu.child_environment(
                    folder, self.root / "target", 4, source
                )
            self.assertTrue(set(inherited).isdisjoint(env))
            identity = dict(
                JOPE_REL07_GATE_ID=gate,
                JOPE_REL07_SOURCE_SHA=source,
                JOPE_REL07_ARTIFACT=str(self.artifact),
                JOPE_REL07_ARTIFACT_SHA256=self.sha,
                JOPE_REL07_RESULT=str(folder / "result.json"),
            )
            env.update(identity)
            commands, _ = runner.provider_commands(self.repo)
            bare = next(row["argv"] for row in commands if row["id"] == gate)
            unbound = subprocess.run(
                bare, cwd=self.repo, env=env, capture_output=True, text=True
            )
            self.assertEqual(unbound.returncode, 2, unbound.stdout + unbound.stderr)
            commands, _ = runner.provider_commands(self.repo, inputs)
            bound = next(row["argv"] for row in commands if row["id"] == gate)
            child = subprocess.run(
                bound, cwd=self.repo, env=env, capture_output=True, text=True
            )
            self.assertEqual(child.returncode, 0, child.stderr)
            observation = json.loads(child.stdout)
            self.assertTrue(observation["synthetic"])
            self.assertEqual(observation["fields"], inputs[gate])
            self.assertEqual(observation["identity"], identity)
            self.assertEqual(observation["jobs"], "4")
            self.assertFalse((folder / "result.json").exists())

