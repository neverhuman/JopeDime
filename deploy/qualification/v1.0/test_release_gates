            rejected = runner._candidate_record(candidate)
        finally:
            manifest.write_text(original_manifest)
        self.assertIsNone(rejected["d2_artifact"])
        self.assertIn("source differs", rejected["d2_blocked_reason"])

        fused_record = runner._candidate_record(candidate)["d2_artifact"]
        original_fused = fused_candidate.read_bytes()
        fused_candidate.write_bytes(b"changed after candidate binding")
        try:
            with self.assertRaisesRegex(ValueError, "D2 candidate bytes changed"):
                runner.verify_candidate_variant(fused_record, source)
        finally:
            fused_candidate.write_bytes(original_fused)

    def test_candidate_dry_run_writes_reasoned_28_row_status_without_execution(self):
        qualification = self.repo / "deploy/qualification/v1.0"
        wrapper = qualification / "a5_run.py"
        wrapper.parent.mkdir(parents=True)
        wrapper.write_text("raise SystemExit('dry-run invoked A5 wrapper')\n")
        self.commit_providers(
            {gate: "raise SystemExit('dry-run invoked provider')\n" for gate in runner.RELEASE_GATE_IDS}
        )
        source = runner.cpu.git(self.repo, "rev-parse", "HEAD")
        candidate_dir = self.root / "candidate-cut"
        candidate_path = candidate_dir / "full-linux-x86_64" / "jopedime"
        candidate_path.parent.mkdir(parents=True)
        candidate_path.write_bytes(b"synthetic signed envelope fixture")
        candidate_sha = runner.cpu.digest(candidate_path)
        seal = self.root / "sealed-variant.json"
        seal.write_text(
            json.dumps(
                {
                    "schema": "jope.rel07.rc2-sealed-variant/v1",
                    "id": "full-linux-x86_64",
                    "source_sha": source,
                    "sha256": candidate_sha,
                    "verify": {"ok": True, "report": {"file_sha256": candidate_sha}},
                }
            )
        )
        signature_receipt = {"receipt": {"verify": "PASS"}}
        rc2_manifest = candidate_dir / "rc2-manifest.json"
        rc2_manifest.write_text(
            json.dumps(
                {
                    "schema": "jope.rel07.rc2-manifest/v1",
                    "source_sha": source,
                    "release_candidate": True,
                    "qualified": False,
                    "artifacts": [
