        summary = json.loads(stdout.getvalue())
        table = json.loads((output / "status_table.json").read_text())
        self.assertEqual(summary["gates"], 28)
        self.assertTrue(summary["all_pass"])
        self.assertEqual(len(table["gates"]), 28)
