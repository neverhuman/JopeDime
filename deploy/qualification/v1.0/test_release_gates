                        },
                        {
                            "id": "fused-cpu-linux-x86_64",
                            "path": str(fused_candidate),
                            "profile": "fused-cpu",
                            "source_sha": source,
                            "sha256": fused_sha,
                            "bytes": fused_candidate.stat().st_size,
                            "seal_verify_receipt": str(fused_seal),
                            "signature_receipts": [
                                {"receipt": {"verify": "PASS"}}
                            ],
                        },
                    ],
                }
            )
        )
        inputs_path, inputs_sha256 = self.candidate_input_file()
        output = self.root / "candidate-run-output"
        with (
            mock.patch(
                "sys.argv",
                [
                    "release-gates",
                    "--candidate",
                    str(candidate),
                    "--repo",
                    str(self.repo),
                    "--inputs",
                    str(inputs_path),
