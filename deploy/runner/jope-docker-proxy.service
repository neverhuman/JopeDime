# /etc/systemd/system/jope-docker-proxy.service — the docker socket proxy for the xbabe2-kernel
# lane. Only container and image operations are allowed (CONTAINERS=1 IMAGES=1 POST=1); exec,
# volumes, networks, swarm, secrets, system and the build endpoint stay denied (defaults 0), so the
# kernel-v1 lane can `docker run --network none` its builder but nothing else. The proxy listens
# on a unix socket in /run/jope-docker-proxy that only root and the runner container see.
[Unit]
Description=JopeDime docker socket proxy (containers/images only) for the kernel lane
After=docker.service
Requires=docker.service

[Service]
Type=exec
RuntimeDirectory=jope-docker-proxy
RuntimeDirectoryMode=0750
ExecStartPre=-/usr/bin/docker rm -f jope-docker-proxy
ExecStart=/usr/bin/docker run --rm --name jope-docker-proxy \
  --cap-drop ALL --cap-add NET_BIND_SERVICE --cap-add SETGID --cap-add SETUID --security-opt no-new-privileges \
  --read-only --tmpfs /run --pids-limit 256 --memory 256m \
  -v /var/run/docker.sock:/var/run/docker.sock:ro -v /run/jope-docker-proxy:/sock \
  -e CONTAINERS=1 -e IMAGES=1 -e POST=1 -e EXEC=0 -e VOLUMES=0 -e NETWORKS=0 -e BUILD=0 -e COMMIT=0 \
  -e SYSTEM=0 -e INFO=1 -e VERSION=1 -e PING=1 -e SWARM=0 -e SECRETS=0 -e CONFIGS=0 -e PLUGINS=0 \
  -e LOG_LEVEL=warning -e BIND_OPTIONS=,mode,660 -e LISTEN_ADDR=unix@/sock/docker.sock \
  tecnativa/docker-socket-proxy:0.3.0@sha256:2f92c6e85a1199b3403c99d7439695898a162c69689b11130450ffadb352f0a0
ExecStop=/usr/bin/docker stop jope-docker-proxy
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
