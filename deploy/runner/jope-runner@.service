# /etc/systemd/system/jope-runner@.service — one ephemeral runner job for lane %i (ci|ci2|full).
# Started by jope-runner@%i.timer; never enabled directly. Root, because it reads the PAT file
# and talks to the docker daemon; the job itself runs as uid 1001 inside the container.
[Unit]
Description=JopeDime self-hosted runner job (%i lane, JIT/ephemeral)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
ConditionPathExists=/etc/jope-runner/github-pat

[Service]
Type=exec
ExecStart=/opt/jope-runner/run.sh %i
# The reviewed drop-in leaves idle listeners unbounded; workflows own job timeouts.
RuntimeMaxSec=infinity
TimeoutStopSec=90
KillMode=mixed
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/jope-runner
PrivateTmp=yes
