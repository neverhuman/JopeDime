[Unit]
Description=Jope completed-search teacher backfill v44
After=local-fs.target

[Service]
Type=oneshot
User=@JOPE_USER@
WorkingDirectory=@JOPE_STATE@
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=RAYON_NUM_THREADS=1
CPUAffinity=60
AllowedCPUs=60
CPUQuota=100%
MemoryHigh=20G
MemoryMax=24G
MemorySwapMax=0
TasksMax=8
Nice=5
TimeoutStartSec=3600
RemainAfterExit=yes
ExecStartPre=/usr/bin/sha256sum --check @JOPE_HOME@/crates/jope-engine/manifests/champion-import-v44.sha256
ExecStart=@JOPE_BUNDLE@/jope-parallel-champions-v44 --root @JOPE_STATE@ --source runs/gp-qualification --source runs/gp-expanded --source runs/gp-extra20 --source runs/gp-reviewed3 --source runs/gp-reviewed4 --source runs/regression-cycle-1 --source runs/regression-cycle-2 --output runs/champion-import-v44.json
StandardOutput=append:@JOPE_STATE@/runs/champion-import-v44.log
StandardError=append:@JOPE_STATE@/runs/champion-import-v44.log
