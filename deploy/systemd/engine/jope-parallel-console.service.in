[Unit]
Description=JOPE persistent full-history console
After=network.target

[Service]
Type=simple
User=@JOPE_USER@
WorkingDirectory=@JOPE_STATE@
ExecStart=/usr/bin/python3 @JOPE_HOME@/python/src/jope/tools/tui-session.py
Restart=always
RestartSec=3
KillMode=control-group
Environment=TERM=xterm-256color
CPUAffinity=60 61 122 123
MemoryMax=2G

[Install]
WantedBy=multi-user.target
