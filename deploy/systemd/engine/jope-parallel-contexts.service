[Unit]
Description=JOPE frozen target and foundation cut encodings
After=jope-parallel-monitor.service
Requires=jope-parallel-monitor.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/jope-dime/parallel
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-neural-v16 --root /home/ubuntu/jope-dime/parallel target-service --jobs /home/ubuntu/jope-dime/parallel/manifests/generated/gp-expanded-jobs.json --spec /home/ubuntu/jope-dime/parallel/manifests/target-spec.json --output /home/ubuntu/jope-dime/parallel/data/encodings/target-cuts --batch 128
ExecStart=/home/ubuntu/jope-dime/parallel/bin/jope-parallel-neural-v16 --root /home/ubuntu/jope-dime/parallel foundation-service --jobs /home/ubuntu/jope-dime/parallel/manifests/generated/gp-expanded-jobs.json --spec /home/ubuntu/jope-dime/parallel/manifests/foundation-spec.json --output /home/ubuntu/jope-dime/parallel/data/encodings/foundation-cuts --batch 2
MemoryHigh=96G
MemoryMax=128G
MemorySwapMax=0
TasksMax=256
KillMode=control-group
TimeoutStartSec=infinity
TimeoutStopSec=15
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
