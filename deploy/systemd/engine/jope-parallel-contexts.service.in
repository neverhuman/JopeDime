[Unit]
Description=JOPE frozen target and foundation cut encodings
After=jope-parallel-monitor.service
Requires=jope-parallel-monitor.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=@JOPE_USER@
WorkingDirectory=@JOPE_STATE@
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=@JOPE_BUNDLE@/jope-parallel-neural-v16 --root @JOPE_STATE@ target-service --jobs @JOPE_STATE@/manifests/generated/gp-expanded-jobs.json --spec @JOPE_HOME@/crates/jope-engine/manifests/target-spec.json --output @JOPE_STATE@/data/encodings/target-cuts --batch 128
ExecStart=@JOPE_BUNDLE@/jope-parallel-neural-v16 --root @JOPE_STATE@ foundation-service --jobs @JOPE_STATE@/manifests/generated/gp-expanded-jobs.json --spec @JOPE_HOME@/crates/jope-engine/manifests/foundation-spec.json --output @JOPE_STATE@/data/encodings/foundation-cuts --batch 2
MemoryHigh=96G
MemoryMax=128G
MemorySwapMax=0
TasksMax=256
KillMode=control-group
TimeoutStartSec=infinity
TimeoutStopSec=15
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
