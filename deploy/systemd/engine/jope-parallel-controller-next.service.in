[Unit]
Description=JOPE next-identity continuous controller (held train; requires gp-next)
After=jope-parallel-monitor.service jope-parallel-gp-next.service
Requires=jope-parallel-gp-next.service
Conflicts=jope-parallel-campaign.service jope-parallel-gp.service

[Service]
Type=simple
ExecCondition=/usr/bin/false
# Removed only by the qualified native authority handoff.
User=@JOPE_USER@
WorkingDirectory=@JOPE_STATE@
Environment=LD_LIBRARY_PATH=/usr/lib/python3/dist-packages/torch/lib
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=RAYON_NUM_THREADS=1
ExecStart=/usr/bin/python3 -B @JOPE_STATE@/runs/flywheel-utilization-20260911/runtime/tools/continuous_learning.py --root @JOPE_STATE@ --manifest @JOPE_STATE@/runs/flywheel-20260910/automatic-training-hold-deploy-v1/manifest.json
Restart=no
RestartSec=10
RuntimeMaxSec=infinity
MemoryHigh=192G
MemoryMax=256G
MemorySwapMax=0
TasksMax=512
CPUAccounting=true
MemoryAccounting=true
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
