[Unit]
Description=Bounded verified pure-policy proposal library during campaign GP waits
After=jope-parallel-monitor.service jope-parallel-gp.service

[Service]
Type=simple
User=@JOPE_USER@
WorkingDirectory=@JOPE_STATE@
ExecStartPre=/usr/bin/sha256sum --check @JOPE_HOME@/crates/jope-engine/manifests/opportunistic-proposals-v53.sha256
ExecStart=/usr/bin/python3 @JOPE_HOME@/python/src/jope/tools/opportunistic_proposals_v2.py --root @JOPE_STATE@ --spec @JOPE_HOME@/crates/jope-engine/manifests/opportunistic-proposals-v53.json
Environment=OMP_NUM_THREADS=2
Environment=RAYON_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
CPUAffinity=60 61
AllowedCPUs=0-7 60-69
CPUQuota=1800%
MemoryHigh=64G
MemoryMax=96G
MemorySwapMax=0
TasksMax=256
RuntimeMaxSec=20min
KillMode=control-group
TimeoutStopSec=10
Restart=no
StandardOutput=append:@JOPE_STATE@/runs/proposal-library-v53.log
StandardError=append:@JOPE_STATE@/runs/proposal-library-v53.log
