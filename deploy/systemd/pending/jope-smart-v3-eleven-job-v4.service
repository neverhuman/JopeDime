[Unit]
Description=Smart-v3 CPU eleven-job-v4 SCQ reconciler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/jope-dime
ExecStart=/usr/bin/python3 /home/ubuntu/jope-dime/scripts/smart_v3_cpu_scq.py run --poll-seconds 60
Restart=always
RestartSec=15
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
