[Unit]
Description=JOPE authoritative task-scoped causal evidence ledger
After=jope-selfplay-ingestion.service
Wants=jope-selfplay-ingestion.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@JOPE_STATE@/legacy/test_exact_gen0
ExecStart=@JOPE_BUNDLE@/jope_causal_evidence --interval-seconds 600
Restart=always
RestartSec=30
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
