[Unit]
Description=JOPE exact receipt-level causal pair repair executor
After=jope-causal-evidence.service jope-selfplay-ingestion.service
Wants=jope-causal-evidence.service jope-selfplay-ingestion.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/jope-flywheel/test_exact_gen0
ExecStart=/home/ubuntu/jope-flywheel/test_exact_gen0/runtime-bundles/current/runtime/bin/jope_causal_pair_repair
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
