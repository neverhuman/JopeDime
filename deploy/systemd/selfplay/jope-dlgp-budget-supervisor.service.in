[Unit]
Description=DIME budget-first DLGP campaign reconciliation
After=jope-utilization-supervisor.service

[Service]
Type=oneshot
WorkingDirectory=@JOPE_STATE@/legacy/test_exact_gen0
ExecStart=@JOPE_BUNDLE@/jope_dlgp_budget_supervisor --once --submit --protocol @JOPE_STATE@/legacy/test_exact_gen0/runtime-bundles/current/runtime/manifests/dlgp-budget-first/protocol.v1.json

[Install]
WantedBy=default.target
