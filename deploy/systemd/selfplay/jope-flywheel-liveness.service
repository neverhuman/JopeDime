[Unit]
Description=JOPE joined flywheel liveness and low-watermark alarms
After=jope-selfplay-queue.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/jope-flywheel/test_exact_gen0
ExecStart=/home/ubuntu/jope-flywheel/test_exact_gen0/runtime-bundles/current/runtime/bin/jope_flywheel_liveness
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
