[Unit]
Description=JOPE crash-safe xbabe1/2/3 GPU lane admission
After=jope-selfplay-queue.service
Wants=jope-selfplay-queue.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@JOPE_STATE@/legacy/test_exact_gen0
ExecStart=@JOPE_BUNDLE@/jope_gpu_lane_admission --interval-seconds 120
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
