[Unit]
Description=JOPE training corpus freezer: advance training/current-corpus.json independently of the promotion tournament
After=jope-selfplay-ingestion.service
Wants=jope-selfplay-ingestion.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@JOPE_STATE@/legacy/test_exact_gen0
# --label-step 250000, not the tournament's 50,000. MEASURED: ingestion adds
# ~8.4 rows/s, one freeze reads the whole 21 GB observations table and writes a
# ~35 GB snapshot, and nothing else in the system prunes those. A 50,000 step is
# a freeze every ~100 minutes (~490 GB/day of snapshot against 1.4 TB free) for a
# corpus the trainer consumes at best once per 1-3 hour run. 250,000 is ~8.3
# hours between freezes, still far faster than new datasets cross the encodable
# -row threshold, and ~105 GB/day before retention.
ExecStart=@JOPE_BUNDLE@/jope_selfplay_corpus_freezer --interval-seconds 600 --label-step 250000 --corpus-mode full_consolidation --keep-snapshots 3 --keep-snapshots-min-age-hours 24
Restart=always
RestartSec=60
# A freeze reads the whole 21 GB observations table and writes tens of GB of
# JSONL on the same NVMe the live SQLite stores and the DL trainer use. It is
# never latency-critical: the trainer keeps running on the corpus it already
# has while this one builds the next.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
