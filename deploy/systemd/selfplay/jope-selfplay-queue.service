[Unit]
Description=JOPE Rust checkpoint-fresh SCQ queue keeper
After=default.target
Conflicts=jope-selfplay-reserve.service jope-selfplay-watchdog.service
Before=jope-selfplay-reserve.service jope-selfplay-watchdog.service

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/jope-flywheel/test_exact_gen0
ExecStart=/home/ubuntu/jope-flywheel/test_exact_gen0/runtime-bundles/current/runtime/bin/jope_selfplay_queue --submit --max-submit-per-cycle 1024
CPUQuota=400%
CPUWeight=1
IOWeight=1
MemoryMax=4G
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
