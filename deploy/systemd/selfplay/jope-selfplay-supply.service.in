[Unit]
Description=JOPE Rust proactive immutable micro-wave supply supervisor
After=jope-selfplay-freshness.service jope-selfplay-queue.service

[Service]
Type=simple
WorkingDirectory=@JOPE_STATE@/legacy/test_exact_gen0
# Multiclass is ACTIVATED for cohort planning (explicit operator opt-in; pool
# size alone never changes wave shape). Timeseries remains advisory until its
# independent-data floor and sealed/replay gates pass; its v2 shard contract is
# now emitted explicitly by the wave builder.
Environment=JOPE_MICRO_COHORT_OPTIONAL_TASKS=multiclass
# Manifest cap 50 (validated range 25..=100): a 192-dataset three-task wave at
# cap 25 emits 2,112 manifests and breaks queued_target + manifests_per_wave
# <= queued_hard_cap (2048 + 2112 > 4096). At 50 it emits 1,152 -- and each
# eval job carries ~50 candidates instead of 25, halving run-dir churn for the
# same work. The original P1 plan approved raising this toward 100.
ExecStart=@JOPE_BUNDLE@/jope_selfplay_supply --build --queue-floor 2048 --queued-target 2048 --queued-hard-cap 4096 --ready-reserve-min 2048 --useful-work-min 6144 --min-complete-reserve-waves 2 --max-overlap-waves 8 --max-candidates-per-manifest 50 --queue-status-max-age-seconds 600 --performance-max-age-seconds 300 --wave-builder @JOPE_BUNDLE@/jope_selfplay_wave --proposal-generator @JOPE_STATE@/legacy/test_exact_gen0/runtime-bundles/current/pytorch/proposals/test_exact_context_proposals.py --proposal-legacy-generator @JOPE_STATE@/legacy/test_exact_gen0/runtime-bundles/current/pytorch/proposals/test_exact_dl_generate.py --proposal-common @JOPE_STATE@/legacy/test_exact_gen0/runtime-bundles/current/pytorch/shared/test_exact_common.py --proposal-pythonpath @JOPE_STATE@/legacy/test_exact_gen0/runtime-bundles/current/pytorch
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
