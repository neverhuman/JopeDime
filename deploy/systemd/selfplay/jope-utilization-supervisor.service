[Unit]
Description=DIME utilization supervisor (bounded repair, no scientific mutation)
After=jope-selfplay-queue.service jope-selfplay-supply.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/jope-flywheel/test_exact_gen0
ExecStart=/home/ubuntu/jope-flywheel/test_exact_gen0/runtime-bundles/current/runtime/bin/jope_utilization_supervisor --queue-floor-jobs 2048

[Install]
WantedBy=default.target
