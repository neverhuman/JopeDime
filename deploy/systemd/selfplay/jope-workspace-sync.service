[Unit]
Description=Preserve JOPE-Dime workspace generations and durable byte snapshots
Wants=network-online.target
After=network-online.target
ConditionHost=xbabe2

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/jope-dime-mirror
ExecStart=/usr/bin/python3 /home/ubuntu/jope-dime-mirror/controller/current/scripts/workspace_sync.py sync --bulk-seconds 180
Nice=15
IOSchedulingClass=idle
CPUQuota=50%
UMask=0077
TimeoutStartSec=infinity
NoNewPrivileges=true
PrivateDevices=true
