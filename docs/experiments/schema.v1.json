{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jope.experiment-record/v1",
  "title": "JopeDime / CLOVER Compressed Experiment Record (v1)",
  "description": "Machine- and LLM-consumable schema for each curated experiment row in docs/experiments/experiments.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "phase_hypothesis",
    "date_utc",
    "source_commit",
    "catalog_snapshot_commit",
    "claim_ids",
    "qualification_status",
    "summary",
    "data",
    "protocol",
    "metrics",
    "outcome",
    "artifacts",
    "next_experiment_implications"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "jope.experiment-record/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{3}-[a-z0-9-]+$",
      "description": "Stable identifier in this curated digest, e.g. EXP-001-v1-flywheel-baseline."
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "phase_hypothesis": {
      "type": "string",
      "enum": [
        "Phase_0_Evidence_and_Parity",
        "H1_GP_Vocabulary_Expansion",
        "H2_Outcome_Prediction_and_Selection",
        "H3_Closed_Loop_Distillation",
        "H4_End_to_End_Task_Win",
        "Benchmarks_and_Infrastructure"
      ]
    },
    "date_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "UTC date of the recorded run, verdict, or fresh-clone verification."
    },
    "source_commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|unknown)$",
      "description": "Exact 40-hex Git commit SHA recorded in the execution receipt, or 'unknown' when the underlying receipt pins artifact/file SHA-256 digests without a 40-hex repo commit."
    },
    "catalog_snapshot_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact 40-hex Git commit SHA on main from which this catalog entry was compiled."
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^C[0-9]{2,3}$"
      },
      "description": "Referenced claim IDs in docs/paper/claims.json (empty array if backed by a standalone receipt outside claims.json)."
    },
    "qualification_status": {
      "type": "string",
      "enum": [
        "ESTABLISHED",
        "PRELIMINARY",
        "NON_QUALIFYING",
        "DIAGNOSTIC_ONLY",
        "PENDING",
        "FAILED_BEFORE_EXECUTION"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "description": "1-2 sentence compressed summary of the experiment design and scope."
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "splits_and_contexts",
        "parent_clusters",
        "candidate_or_catalog_size",
        "sources",
        "contamination_controls"
      ],
      "properties": {
        "splits_and_contexts": {
          "type": "string"
        },
        "parent_clusters": {
          "type": "string"
        },
        "candidate_or_catalog_size": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "contamination_controls": {
          "type": "string"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arms_or_configs",
        "compute_budget",
        "evaluation_metric"
      ],
      "properties": {
        "arms_or_configs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "compute_budget": {
          "type": "string"
        },
        "evaluation_metric": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "array"
        ]
      },
      "description": "Compact key-value map of exact primary quantitative results, confidence intervals, and counts taken from claims.json or the named receipt."
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "what_worked",
        "what_failed",
        "non_claims"
      ],
      "properties": {
        "verdict": {
          "type": "string"
        },
        "what_worked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "what_failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "non_claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Tracked repository paths or receipt locators backing the record."
    },
    "next_experiment_implications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "description": "Concrete lessons and working hypotheses generated for future experiments."
    }
  }
}
