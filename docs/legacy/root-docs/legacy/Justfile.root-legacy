# CPU qualification runs without a CUDA installation. The neural release also
# requires the recorded SDK build and native GPU qualification receipts.
required:
    cargo fmt --manifest-path parallel/Cargo.toml --all -- --check
    env OMP_NUM_THREADS=1 RAYON_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 cargo test --manifest-path parallel/Cargo.toml --locked --lib -- --test-threads=4

fast:
    cargo check --manifest-path parallel/Cargo.toml --locked --all-targets

# Family recipes (jain-split conventions). `required` above stays the hosted check:
# fmt --check + locked lib tests, proven green on the freeze. These run the wider lanes on demand.
format:
    cargo fmt --manifest-path parallel/Cargo.toml --all -- --check

clippy:
    cargo clippy --workspace --all-targets --locked --manifest-path parallel/Cargo.toml -- -D warnings

test:
    env OMP_NUM_THREADS=1 RAYON_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 cargo test --workspace --locked --manifest-path parallel/Cargo.toml -- --test-threads=4

# Not in `required`: glibc<=2.36 kernel-v1 evaluator build (docker, network none) + receipt
kernel-v1-product-build out:
    ops/ci/kernel-v1-product-build.sh {{out}}
