% bh.sty — typography, regime badges, and layout for EurekaZero: The Tabular Black Hole.
% XeLaTeX only. Fonts are fetched and SHA-256 checked by scripts/build.sh (see fonts.lock).
%   Text: Libertinus Serif   Math: Libertinus Math   Display/sans: Inter   Code: JetBrains Mono
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{bh}[2026/11/16 EurekaZero Black-Hole paper style]

% ---------------------------------------------------------------- page geometry
\RequirePackage[letterpaper,
  textwidth=6.05in, textheight=8.95in,
  top=1.0in, headsep=0.32in, footskip=0.42in,
  hmarginratio=1:1]{geometry}

% ---------------------------------------------------------------- fonts
\RequirePackage{amsmath,mathtools}
\RequirePackage{fontspec}
\RequirePackage[math-style=TeX,bold-style=TeX]{unicode-math}
\providecommand\BHFontDir{./fonts/}
\setmainfont{LibertinusSerif}[
  Path=\BHFontDir, Extension=.otf,
  UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-Semibold, BoldItalicFont=*-SemiboldItalic,
  Numbers={Proportional,OldStyle}, Ligatures=TeX]
\setsansfont{Inter}[
  Path=\BHFontDir, Extension=.otf,
  UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic,
  FontFace={m}{n}{*-Regular}, FontFace={sb}{n}{*-SemiBold},
  FontFace={mb}{n}{*-Medium},
  Scale=MatchLowercase, Numbers=Lining]
\setmonofont{JetBrainsMono}[
  Path=\BHFontDir, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Bold,
  ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic, FontFace={sb}{n}{*-Medium},
  Scale=0.84, Contextuals=Alternate]
\setmathfont{LibertinusMath-Regular.otf}[Path=\BHFontDir]
\newfontfamily\BHdisplay{LibertinusSerifDisplay}[Path=\BHFontDir, Extension=.otf, UprightFont=*-Regular]
\newcommand\lining{\addfontfeatures{Numbers={Lining,Monospaced}}}
\newcommand\sbseries{\fontseries{sb}\selectfont}
\linespread{1.075}
\RequirePackage[protrusion=true, final]{microtype}

\frenchspacing
\setlength\emergencystretch{2.0em}

% ---------------------------------------------------------------- colour
\RequirePackage[dvipsnames]{xcolor}
\definecolor{bhink}{HTML}{1B1F27}      % primary body text
\definecolor{bhaccent}{HTML}{1F5AA6}   % primary blue
\definecolor{bhaccentsoft}{HTML}{E8EFF8}
\definecolor{bhwarm}{HTML}{B4501E}     % burnt orange (recall / specialist series)
\definecolor{bhwarmsoft}{HTML}{FBECE5}
\definecolor{bhgreen}{HTML}{2E7D4F}    % verified / fair regime
\definecolor{bhamber}{HTML}{A86A00}    % in-corpus / pre-registered
\definecolor{bhplum}{HTML}{6E3B8B}     % memory lookup regime
\definecolor{bhgrey}{HTML}{6B7280}
\definecolor{bhrule}{HTML}{C9CED6}
\definecolor{bhpaper}{HTML}{F6F7F9}
\color{bhink}

% ---------------------------------------------------------------- maths and units
\RequirePackage{siunitx}
\sisetup{group-minimum-digits=4, group-separator={,}, detect-all=false,
  text-family-to-math=false}

% ---------------------------------------------------------------- headings
\RequirePackage[explicit]{titlesec}
\titleformat{\section}
  {\sffamily\sbseries\Large\color{bhink}}
  {\llap{\color{bhaccent}\thesection\hspace{0.7em}}}{0pt}{#1}
\titleformat{\subsection}
  {\sffamily\sbseries\large\color{bhink}}
  {\llap{\color{bhaccent}\thesubsection\hspace{0.6em}}}{0pt}{#1}
\titleformat{\subsubsection}[runin]
  {\sffamily\sbseries\normalsize\color{bhink}}
  {}{0pt}{#1.}
\titleformat{\paragraph}[runin]
  {\normalfont\itshape}{}{0pt}{#1.}
\titlespacing*{\section}{0pt}{2.1ex plus .6ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.7ex plus .5ex minus .2ex}{0.7ex plus .1ex}
\titlespacing*{\subsubsection}{0pt}{1.1ex plus .3ex minus .2ex}{0.6em}
\titlespacing*{\paragraph}{0pt}{0.8ex plus .2ex}{0.5em}

% ---------------------------------------------------------------- running heads
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0pt}
\fancyhead[L]{\sffamily\footnotesize\color{bhgrey}\BHShortTitle}
\fancyhead[R]{\sffamily\footnotesize\color{bhgrey}\nouppercase{\leftmark}}
\fancyfoot[C]{\sffamily\footnotesize\color{bhgrey}\thepage}
\renewcommand\sectionmark[1]{\markboth{\thesection\enspace #1}{}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\footnotesize\color{bhgrey}\thepage}}
\providecommand\BHShortTitle{EurekaZero \textperiodcentered{} The Tabular Black Hole}

% ---------------------------------------------------------------- lists, captions, floats
\RequirePackage{enumitem}
\setlist{itemsep=0.25ex, topsep=0.6ex, parsep=0.2ex, leftmargin=1.4em}
\setlist[enumerate]{label=\textsf{\small\arabic*}., leftmargin=1.6em}
\RequirePackage{caption}
\DeclareCaptionFont{bhlabel}{\sffamily\sbseries\color{bhaccent}}
\captionsetup{font={small,sf}, labelfont=bhlabel, labelsep=period,
  justification=justified, singlelinecheck=false, skip=6pt, width=\linewidth}
\captionsetup[table]{position=top, skip=4pt}
\RequirePackage{subcaption}
\RequirePackage{booktabs, tabularx, multirow, array, colortbl}
\setlength\heavyrulewidth{0.09em}
\setlength\lightrulewidth{0.05em}
\setlength\cmidrulewidth{0.04em}
\renewcommand\arraystretch{1.12}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}
\newcommand\tablesf{\sffamily\small\lining}
\newcommand\bhtablenote[1]{\par\smallskip{\raggedright\footnotesize\color{bhgrey}#1\par}}
\RequirePackage{float}
\setlength\textfloatsep{14pt plus 4pt minus 4pt}
\setlength\floatsep{12pt plus 4pt minus 4pt}
\setlength\intextsep{12pt plus 4pt minus 4pt}

% ---------------------------------------------------------------- graphics
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,shapes.geometric,shapes.misc,decorations.pathreplacing,patterns}
\RequirePackage{pgfplots}
\RequirePackage{pgfplotstable}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots,fillbetween}
\pgfplotsset{
  table/comment chars={\#},
  bh/.style={
    width=\linewidth, height=0.42\linewidth,
    axis line style={bhrule}, tick style={bhrule},
    every tick label/.append style={font=\sffamily\scriptsize\color{bhgrey}},
    label style={font=\sffamily\footnotesize},
    title style={font=\sffamily\sbseries\small},
    legend style={font=\sffamily\scriptsize, draw=none, fill=none},
    grid style={bhrule!60, line width=0.3pt},
    major grid style={bhrule!60},
  }}
\tikzset{
  bhbox/.style={draw=bhrule, fill=white, rounded corners=2.5pt, line width=0.6pt,
    font=\sffamily\small, align=center, inner sep=5pt},
  bhstage/.style={bhbox, fill=bhaccentsoft, draw=bhaccent!55},
  bhwarmbox/.style={bhbox, fill=bhwarmsoft, draw=bhwarm!60},
  bhprotected/.style={bhbox, fill=bhink, text=white, draw=bhink},
  bharrow/.style={-{Stealth[length=2.5mm,width=1.8mm]}, line width=0.7pt, color=bhgrey},
  bhnote/.style={font=\sffamily\scriptsize\color{bhgrey}, align=center},
}

% ---------------------------------------------------------------- boxes: definitions, propositions, key takeaways
\RequirePackage[most]{tcolorbox}
\newtcolorbox{bhdef}[1]{enhanced, breakable, colback=bhpaper, colframe=bhpaper,
  borderline west={2.2pt}{0pt}{bhaccent}, arc=0pt, outer arc=0pt,
  left=10pt, right=8pt, top=6pt, bottom=6pt, before skip=10pt, after skip=10pt,
  fontupper=\normalsize,
  title={\sffamily\sbseries\small\color{bhaccent}#1}, coltitle=bhaccent,
  attach title to upper={\par\smallskip}}
\newtcolorbox{bhkeybox}[1]{enhanced, breakable, colback=white, colframe=bhaccent, boxrule=0.65pt,
  arc=2pt, left=11pt, right=11pt, top=8pt, bottom=8pt, before skip=10pt, after skip=10pt,
  title={\sffamily\sbseries\small\color{bhaccent}#1}, coltitle=bhaccent,
  attach title to upper={\par\smallskip}}
\newtcolorbox{bhabstract}{enhanced, colback=bhpaper, colframe=bhpaper, arc=0pt, fontupper=\small,
  left=14pt, right=14pt, top=10pt, bottom=10pt, before skip=6pt, after skip=10pt}

% ---------------------------------------------------------------- evidence & regime badges
\DeclareRobustCommand\bhbadge[2]{\kern1pt\raisebox{0.12ex}{\tikz[baseline]\node[anchor=base,
  font=\sffamily\sbseries\fontsize{5.8pt}{5.8pt}\selectfont\color{white}, fill=#1,
  rounded corners=1.4pt, inner xsep=2.2pt, inner ysep=1.4pt]{#2};}\kern1pt}
\DeclareRobustCommand\est{\bhbadge{bhgreen}{EST}}
\DeclareRobustCommand\pre{\bhbadge{bhamber}{PRE}}
\DeclareRobustCommand\pend{\bhbadge{bhgrey}{PEND}}

% Explicit data-exposure regime badges (mandatory beside every Dev91 / benchmark score)
\DeclareRobustCommand\regrecall{\bhbadge{bhwarm}{RECALL}}
\DeclareRobustCommand\regincorpus{\bhbadge{bhamber}{IN-CORPUS}}
\DeclareRobustCommand\regfair{\bhbadge{bhgreen}{FAIR 0\%}}
\DeclareRobustCommand\regmem{\bhbadge{bhplum}{MEMORY}}
\DeclareRobustCommand\regunseen{\bhbadge{bhaccent}{UNSEEN-SCREENED}}

% ---------------------------------------------------------------- references and links
\RequirePackage[numbers,sort&compress]{natbib}
\setlength\bibsep{2.2pt plus 1pt}
\renewcommand\bibfont{\small}
\RequirePackage[hyphens]{url}
\RequirePackage[pdfusetitle, colorlinks=true, linkcolor=bhaccent, citecolor=bhaccent,
  urlcolor=bhaccent, bookmarksnumbered=true, bookmarksopen=true, pdfdisplaydoctitle=true,
  pdfstartview=FitH]{hyperref}
\RequirePackage[capitalise, noabbrev, nameinlink]{cleveref}

\newcounter{bhdefinition}
\newenvironment{definition}[1]{\refstepcounter{bhdefinition}%
  \begin{bhdef}{Definition~\thebhdefinition\quad\normalfont\sffamily\color{bhink}#1}}{\end{bhdef}}
\crefname{bhdefinition}{Definition}{Definitions}

\newcounter{bhproposition}
\newenvironment{proposition}[1]{\refstepcounter{bhproposition}%
  \begin{bhdef}{Proposition~\thebhproposition\quad\normalfont\sffamily\color{bhink}#1}}{\end{bhdef}}
\crefname{bhproposition}{Proposition}{Propositions}

% ---------------------------------------------------------------- helpers
\newcommand\EZ{EurekaZero}
\newcommand\BH{Black-Hole}
\ExplSyntaxOn
\tl_new:N \l__bh_code_tl
\NewDocumentCommand\code{m}{\texttt{
  \tl_set:Nn \l__bh_code_tl {#1}
  \regex_replace_all:nnN { / } { /\c{allowbreak} } \l__bh_code_tl
  \regex_replace_all:nnN { \c{_} } { \c{_}\c{allowbreak} } \l__bh_code_tl
  \regex_replace_all:nnN { \- } { \-\c{allowbreak} } \l__bh_code_tl
  \regex_replace_all:nnN { \. } { \.\c{allowbreak} } \l__bh_code_tl
  \tl_use:N \l__bh_code_tl}}
\ExplSyntaxOff
\newcommand\PhiP{\ensuremath{\Phi_{\mathcal{P}}}}
\newcommand\PsiK{\ensuremath{\Psi_{\mathcal{K}}}}
\newcommand\Kk{\ensuremath{K_{\mathcal{K}}}}
\newcommand\zp{\ensuremath{z_{\mathrm{p}}}}
\newcommand\zs{\ensuremath{z_{\mathrm{s}}}}
\newcommand\eg{e.g.,\ }
\newcommand\ie{i.e.,\ }
\renewcommand\footnoterule{\kern-3pt{\color{bhrule}\hrule width 1.4in height 0.4pt}\kern 2.6pt}
\setlength\footnotesep{8pt}

% ---------------------------------------------------------------- title block
\newcommand\BHTitle{}\newcommand\BHSubtitle{}\newcommand\BHAuthors{}\newcommand\BHDate{}\newcommand\BHStatus{}
\newcommand\bhmaketitle{%
  \thispagestyle{plain}%
  \begingroup
  \vspace*{-0.35in}%
  {\sffamily\footnotesize\color{bhaccent}\sbseries\BHStatus\par}\vspace{10pt}%
  {\raggedright\BHdisplay\fontsize{26pt}{30pt}\selectfont\color{bhink}\BHTitle\par}\vspace{9pt}%
  {\raggedright\sffamily\large\color{bhgrey}\BHSubtitle\par}\vspace{12pt}%
  {\sffamily\normalsize\color{bhink}\BHAuthors\par}\vspace{3pt}%
  {\sffamily\footnotesize\color{bhgrey}\BHDate\par}\vspace{10pt}%
  \noindent{\color{bhrule}\rule{\linewidth}{0.5pt}}\par\vspace{6pt}%
  \endgroup}

\endinput
