% ================================================================ north-star (synthetic) machinery
% The north-star draft shows the intended finished paper with SYNTHETIC, illustrative results.
% Four mechanisms keep every synthetic element visible and traceable, and scripts/check.sh
% enforces them:
%   \syn[EZ-Gnn]{value}  a synthetic number: purple, hyperlinked to its row in the gap ledger
%                        (Appendix K), whose work package must replace it with a sealed result;
%   \synbadge            a SYN badge beside synthetic prose claims, like EST/PRE/PEND;
%   \synfigtag           a SYNTHETIC tag drawn inside every figure that plots synthetic data;
%   watermark            every page carries a diagonal NORTH-STAR DRAFT mark and a footer line.
% \EZsyntheticfalse removes none of them silently: check.sh --submission refuses any remaining
% \syn, \synbadge or \synfigtag, any input of data/synthetic or generated/numbers.tex.
\newif\ifEZsynthetic \EZsynthetictrue
\definecolor{ezsyn}{HTML}{7A2CB8}      % synthetic-result purple
\definecolor{ezsynsoft}{HTML}{F3ECFA}
\NewDocumentCommand\syn{o m}{%
  \IfNoValueTF{#1}{\PackageError{ez}{\string\syn\space needs a gap id, e.g. \string\syn[EZ-G01]{...}}{}}{%
    \hyperlink{gap.#1}{\textcolor{ezsyn}{#2}}}}
\DeclareRobustCommand\synbadge{\ezbadge{ezsyn}{SYN}}
\newcommand\synfigtag[1][SYNTHETIC \textperiodcentered{} ILLUSTRATIVE]{%
  \node[anchor=south east, inner xsep=3pt, inner ysep=1.8pt, rounded corners=1.4pt, fill=ezsyn,
    text=white, font=\sffamily\sbseries\fontsize{5.6pt}{6pt}\selectfont]
    at ([yshift=2pt]current bounding box.north east) {#1};}
\newtcolorbox{ezsynnote}{enhanced, breakable, colback=ezsynsoft, colframe=ezsyn, boxrule=0.6pt,
  arc=2pt, left=10pt, right=10pt, top=7pt, bottom=7pt, before skip=8pt, after skip=10pt,
  fontupper=\small}
\pgfplotsset{table/comment chars={\#}}
% Plot only the rows of a table whose column #1 equals #2 (string comparison).
\pgfplotsset{ezwhere/.style 2 args={x filter/.append code={%
  \edef\ezcell{\thisrow{#1}}\edef\ezwant{#2}\ifx\ezcell\ezwant\else\def\pgfmathresult{nan}\fi}}}
\RequirePackage{eso-pic}
\AddToShipoutPictureBG{\ifEZsynthetic
  \AtPageCenter{\makebox(0,0){\rotatebox{52}{\sffamily\sbseries\fontsize{58pt}{58pt}\selectfont
    \color{ezsyn!7}NORTH-STAR DRAFT}}}%
  \AtPageLowerLeft{\raisebox{0.32in}{\makebox[\paperwidth]{\sffamily\fontsize{6.4pt}{7pt}\selectfont
    \color{ezsyn}North-star draft \textperiodcentered{} results in purple are SYNTHETIC and illustrative
    \textperiodcentered{} not for submission \textperiodcentered{} gap ledger: Appendix K}}}\fi}

