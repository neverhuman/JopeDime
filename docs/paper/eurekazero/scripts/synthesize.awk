# synthesize.awk — deterministic SYNTHETIC data for the EurekaZero north-star draft.
#
# NOTHING WRITTEN BY THIS PROGRAM IS A RESULT. It draws illustrative numbers from hand-chosen
# target effects plus pseudo-random noise, so that the manuscript's figures, tables and prose can
# show the intended shape of the finished paper. Every file it writes starts with a SYNTHETIC
# banner and names the gap (northstar/gaps.json) whose measured evidence must replace it.
#
# Run through scripts/synthesize.sh, which passes -v out=DIR. Portable awk only (mawk or gawk): a
# Park-Miller generator in exact double arithmetic and a Box-Muller transform, so the same seed
# gives the same bytes on any POSIX awk with IEEE-754 doubles.

function rnd() { seed = (seed * 16807) % 2147483647; return seed / 2147483647 }
function gauss(  u1, u2) {
  u1 = rnd(); u2 = rnd(); if (u1 < 1e-12) u1 = 1e-12
  return sqrt(-2 * log(u1)) * cos(6.283185307179586 * u2)
}
function clip(x, lo, hi) { return x < lo ? lo : (x > hi ? hi : x) }
function banner(f, gap, what) {
  printf "# SYNTHETIC north-star data: illustrative, not a measured result.\n" > f
  printf "# Generated by scripts/synthesize.sh (seed %d). Gap %s: %s.\n", SEED, gap, what > f
  printf "# Replace only with a receipt-bound measurement; see northstar/gaps.json.\n" > f
}
function macro(name, value) { printf "\\newcommand\\%s{%s}\n", name, value > NUM }
function pct(x) { return sprintf("%.1f", 100 * x) }
function sgn(x) { return sprintf("%+.3f", x) }
function f3(x) { return sprintf("%.3f", x) }
function f2(x) { return sprintf("%.2f", x) }
function f1(x) { return sprintf("%.1f", x) }

# Family-level paired differences for one domain. Draws a comparator utility and a paired
# difference per family; a fixed share of families (evenly spaced) get a failed first proposal,
# whose utility is -1 and which stays in every mean.
function families(tag, gap, n, cmean, csd, dmean, dsd, pfail,   f, file, i, c, d, e, s, ss, m, sd, se, fails, su, nfail, step) {
  file = out "/family-" tag ".csv"
  banner(file, gap, "family-level paired utilities, domain " tag)
  print "family,u_ez,u_cmp,delta" > file
  s = 0; ss = 0; fails = 0; su = 0; sc = 0
  nfail = int(n * pfail + 0.5); step = nfail > 0 ? int(n / nfail) : n + 1
  for (i = 1; i <= n; i++) {
    c = clip(cmean + csd * gauss(), -1, 1)
    e = clip(c + dmean + dsd * gauss(), -1, 1)
    if (i % step == 0 && fails < nfail) { e = -1; fails++ }
    d = e - c
    printf "%s%03d,%.4f,%.4f,%.4f\n", tag, i, e, c, d > file
    s += d; ss += d * d; su += e; sc += c
  }
  close(file)
  m = s / n; sd = sqrt((ss - n * m * m) / (n - 1)); se = sd / sqrt(n)
  DMEAN[tag] = m; DLO[tag] = m - 1.96 * se; DHI[tag] = m + 1.96 * se
  UEZ[tag] = su / n; UCMP[tag] = sc / n; FAIL[tag] = fails / n
}

BEGIN {
