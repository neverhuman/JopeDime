  macro("EZbuildC", pct(1 - FAIL["C"])); macro("EZcomplyC", "92.7"); macro("EZfeasC", "90.6")
  macro("EZmassC", "0.78"); macro("EZmassClo", "0.74"); macro("EZmassChi", "0.82")
