    printf "%s,%.4f,%.4f\n", CM[j], MM[j] * exp(SD[j] * gauss()), CC[j] * exp(0.6 * SD[j] * gauss() + 0.04 * gauss()) > f
  close(f)

  # ------------------------------------------------------------------ frontier comparison (EZ-G07)
  f = out "/frontier.csv"; banner(f, "EZ-G07", "first-proposal utility of three frontier models at K=1 with matched information")
  print "domain,ez,frontier1,frontier2,frontier3,valid_ez,valid_best" > f
  printf "A,%.3f,%.3f,%.3f,%.3f,98.4,96.1\n", UEZ["A"], UEZ["A"] - 0.083, UEZ["A"] - 0.104, UEZ["A"] - 0.139 > f
  printf "B,%.3f,%.3f,%.3f,%.3f,99.4,99.2\n", UEZ["B"], UEZ["B"] - 0.039, UEZ["B"] - 0.051, UEZ["B"] - 0.066 > f
  printf "C,%.3f,%.3f,%.3f,%.3f,97.9,71.3\n", UEZ["C"], UEZ["C"] - 0.157, UEZ["C"] - 0.188, UEZ["C"] - 0.231 > f
  close(f)
  split("0.083 0.104 0.139", GA, " "); split("0.039 0.051 0.066", GB, " "); split("0.157 0.188 0.231", GC, " ")
  split("One Two Three", WORD, " ")
  for (j = 1; j <= 3; j++) {
    macro("EZfr" WORD[j] "A", f3(UEZ["A"] - GA[j])); macro("EZfr" WORD[j] "B", f3(UEZ["B"] - GB[j]))
    macro("EZfr" WORD[j] "C", f3(UEZ["C"] - GC[j]))
  }
  macro("EZfrValidA", "96.1"); macro("EZfrValidB", "99.2")
  macro("EZfrA", "+0.083"); macro("EZfrB", "+0.039"); macro("EZfrC", "+0.157"); macro("EZfrValidC", "71.3")
  macro("EZtabpfnRatio", "1.012"); macro("EZtabpfnLo", "0.991"); macro("EZtabpfnHi", "1.034")
  macro("EZfitMedian", "0.4")

  # ------------------------------------------------------------------ ablations (EZ-G09, G12)
  f = out "/ablations.csv"; banner(f, "EZ-G09/G12", "utility change against full EurekaZero, per domain")
  print "y,domain,arm,delta,err" > f
  split("Direct decoder|Imitation only|Catalog-bound decoder|Retrieval|Search-only teacher", ARM, "|")
  split("-0.021 -0.029 -0.047 -0.058 -0.006", ADA, " ")
  split("-0.012 -0.018 -0.025 -0.031 -0.004", ADB, " ")
  split("-0.038 -0.044 -0.071 -0.094 -0.009", ADC, " ")
  for (j = 1; j <= 5; j++) {
    printf "%d,A,%s,%.4f,%.4f\n", 6 - j, ARM[j], ADA[j] + 0.002 * gauss(), 0.010 > f
    printf "%d,B,%s,%.4f,%.4f\n", 6 - j, ARM[j], ADB[j] + 0.002 * gauss(), 0.009 > f
    printf "%d,C,%s,%.4f,%.4f\n", 6 - j, ARM[j], ADC[j] + 0.003 * gauss(), 0.019 > f
  }
  close(f)
  macro("EZabDirectA", "-0.021"); macro("EZabImitA", "-0.029"); macro("EZabCatA", "-0.047")
  macro("EZabRetA", "-0.058"); macro("EZabDirectC", "-0.038"); macro("EZabImitC", "-0.044")
  macro("EZshufA", "-0.212"); macro("EZshufB", "-0.140"); macro("EZshufC", "-0.305")
  macro("EZnativeA", "-0.011"); macro("EZnativeAlo", "-0.022"); macro("EZnativeAhi", "+0.000")
  macro("EZswapRate", "87"); macro("EZswapRateLo", "83"); macro("EZswapRateHi", "90")
  macro("EZswapShuffled", "12"); macro("EZswapPairs", 400)
  # objective and constraint interventions (EZ-G10)
  macro("EZhistAlow", 4); macro("EZhistClow", 2); macro("EZhistSaveLow", "1.2"); macro("EZstaticThree", 30)
  macro("EZsteerA", "91.3"); macro("EZsteerC", "94.8"); macro("EZsteerCostA", "-0.012"); macro("EZsteerN", 120)

  # ------------------------------------------------------------------ transfer (EZ-G11)
  f = out "/transfer.csv"; banner(f, "EZ-G11", "shared model minus separate models, per domain")
  print "y,domain,delta,lo,hi,err" > f
  printf "3,Learning procedures,0.006,-0.004,0.016,0.010\n" > f
  printf "2,Next experiment,0.004,-0.006,0.014,0.010\n" > f
  printf "1,Specification to CAD,-0.009,-0.026,0.008,0.017\n" > f
  close(f)
  macro("EZtrA", "+0.006"); macro("EZtrAlo", "-0.004"); macro("EZtrAhi", "+0.016")
  macro("EZtrC", "-0.009"); macro("EZtrClo", "-0.026"); macro("EZtrChi", "+0.008")

  # ------------------------------------------------------------------ experience scaling (EZ-G13, G14)
  f = out "/history.csv"; banner(f, "EZ-G13", "search-equivalent budget against the fraction of training history")
  print "fraction,beqA,beqC,saveB" > f
  printf "0.125,4,2,1.2\n0.25,12,6,1.6\n0.5,28,14,2.3\n1,64,32,3.2\n" > f
  close(f)
  f = out "/generations.csv"; banner(f, "EZ-G14", "search-equivalent budget by improvement round, with a static-teacher control")
  print "gen,ez,static" > f
  printf "0,16,16\n1,32,24\n2,48,28\n3,64,30\n" > f
  close(f)

  # ------------------------------------------------------------------ novelty funnel (EZ-G15)
  f = out "/funnel.csv"; banner(f, "EZ-G15", "novelty ladder counts, learning procedures (A) and CAD (C)")
  print "y,level,A,Arate,C,Crate" > f
  na = NA * 9; nc = NC * 3
  split("Committed|Valid|N1 structurally distinct|N2 out of archive|N4 useful out of archive|Dossier opportunities|N5 mechanism supported|N6 replicated", LV, "|")
  split("2808 2763 2102 1151 486 12 3 1", CA, " ")
  split("288 282 241 131 74 6 2 1", CCn, " ")
  for (j = 1; j <= 8; j++) printf "%d,%s,%d,%.4f,%d,%.4f\n", 9 - j, LV[j], CA[j], CA[j] / CA[1], CCn[j], CCn[j] / CCn[1] > f
  close(f)
  macro("EZnovAtwo", pct(CA[4] / CA[1])); macro("EZnovAfour", pct(CA[5] / CA[1])); macro("EZnovAfourLo", "15.6"); macro("EZnovAfourHi", "19.1")
  macro("EZnovCtwo", pct(CCn[4] / CCn[1])); macro("EZnovCfour", pct(CCn[5] / CCn[1])); macro("EZnovAone", pct(CA[3] / CA[1])); macro("EZnovCone", pct(CCn[3] / CCn[1]))
  macro("EZdossA", 12); macro("EZdossC", 6); macro("EZnFive", CA[7] + CCn[7]); macro("EZnFiveA", CA[7]); macro("EZnFiveC", CCn[7]); macro("EZnSix", CA[8] + CCn[8])

  # ------------------------------------------------------------------ dossiers (EZ-G16, G17)
  f = out "/dossier.csv"; banner(f, "EZ-G16/G17", "mechanism interventions on 60 reserved families or specifications")
  print "y,case,intervention,delta,err" > f
  printf "4,D-A1,Remove component,-0.024,0.013\n3,D-A1,Nearest known replacement,-0.017,0.011\n" > f
  printf "2,D-C1,Remove feature,-0.081,0.024\n1,D-C1,Nearest known replacement,-0.052,0.021\n" > f
