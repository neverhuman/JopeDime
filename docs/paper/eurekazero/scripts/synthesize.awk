    print line > f
  }
  close(f)
  # Evaluations to reach normalized regret 0.15, and the savings ratio at t = 20 against Gaussian-process EI.
  for (j = 1; j <= 7; j++) REACH[M[j]] = int((A0[j] / 0.15) ^ (1 / B0[j])) + 1
  macro("EZreachEZ", REACH["ez"]); macro("EZreachGPEI", REACH["gpei"]); macro("EZreachZS", REACH["zeroshot"])
  macro("EZreachOF", REACH["optformer"]); macro("EZreachTPE", REACH["tpe"])
  r20 = A0[1] * 20 ^ (-B0[1]); keq20 = int((A0[2] / r20) ^ (1 / B0[2])) + 1
  macro("EZkeqBtwenty", keq20); macro("EZsaveB", f1(keq20 / 20))
  macro("EZvalidA", pct(1 - FAIL["A"])); macro("EZvalidB", pct(1 - FAIL["B"]))

