  print "n,ez,search" > f
  for (p = 1; p <= 5; p += 0.25) {
    n = 10 ^ p
    printf "%.0f,%.2f,%.2f\n", n, 46000 + 0.02 * n, 20.0 * n > f
  }
  close(f)
  macro("EZteachA", "41{,}000"); macro("EZteachB", "8{,}200"); macro("EZteachC", "63{,}000")
  macro("EZgpuH", "1{,}900"); macro("EZbreakA", "2{,}300"); macro("EZbreakC", "610")
  macro("EZfixA", "46{,}000"); macro("EZshareA", "5{,}000"); macro("EZgpuRate", 8); macro("EZsearchPerA", 20)
  macro("EZfixC", "68{,}300"); macro("EZsearchPerC", 112); macro("EZmarginA", "0.02")
  macro("EZlatA", "0.9"); macro("EZlatB", "0.05"); macro("EZlatC", "2.7")
  macro("EZparamShared", "184"); macro("EZparamAdapters", "31--52"); macro("EZslots", 16); macro("EZslotDim", 256)
  # GPU shares by domain and break-even at half and twice the declared GPU conversion rate
  macro("EZgpuA", 625); macro("EZgpuB", 612); macro("EZgpuC", 663)
