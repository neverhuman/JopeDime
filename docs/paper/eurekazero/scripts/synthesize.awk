  NA = 312; NB = 180; NC = 96
  macro("EZnA", NA); macro("EZnB", NB); macro("EZnC", NC)
  macro("EZctxA", NA * 9); macro("EZcompB", 41); macro("EZspecC", NC * 3)

  # ------------------------------------------------------------------ primaries (EZ-G01, G03, G05)
  families("A", "EZ-G01", NA, 0.351, 0.22, 0.080, 0.140, 0.016)
  families("B", "EZ-G03", NB, 0.180, 0.20, 0.050, 0.110, 0.006)
  families("C", "EZ-G05", NC, 0.120, 0.30, 0.120, 0.150, 0.021)
  split("A B C", T, " ")
  for (j = 1; j <= 3; j++) {
    t = T[j]
    macro("EZd" t, sgn(DMEAN[t])); macro("EZd" t "lo", sgn(DLO[t])); macro("EZd" t "hi", sgn(DHI[t]))
    macro("EZu" t, f3(UEZ[t])); macro("EZc" t, f3(UCMP[t])); macro("EZfail" t, pct(FAIL[t]))
  }
  f = out "/primary.csv"
  banner(f, "EZ-G01/G03/G05", "domain-level primary differences against the locked comparator")
  print "row,domain,delta,lo,hi,err" > f
  printf "3,Learning procedures (C0),%.4f,%.4f,%.4f,%.4f\n", DMEAN["A"], DLO["A"], DHI["A"], (DHI["A"] - DLO["A"]) / 2 > f
  printf "2,Next experiment (CH),%.4f,%.4f,%.4f,%.4f\n", DMEAN["B"], DLO["B"], DHI["B"], (DHI["B"] - DLO["B"]) / 2 > f
  printf "1,Specification to CAD (C0),%.4f,%.4f,%.4f,%.4f\n", DMEAN["C"], DLO["C"], DHI["C"], (DHI["C"] - DLO["C"]) / 2 > f
  close(f)

  # ------------------------------------------------------------------ search-equivalent curves (EZ-G02, G06)
  # U_S(k) is built to cross the first-proposal utility at the stated budget; bands are fixed widths.
  f = out "/curve-A.csv"; banner(f, "EZ-G02", "learning-procedure utility against search budget")
  print "k,mean,lo,hi" > f
  for (p = 0; p <= 8; p++) {
    k = 2 ^ p; u = UEZ["A"] + 0.004 - 0.16 * (k ^ (-0.35) - 64 ^ (-0.35)) + 0.002 * gauss()
    if (k == 64 && u < UEZ["A"]) u = UEZ["A"] + 0.001
    w = 0.019 - 0.0008 * p
    printf "%d,%.4f,%.4f,%.4f\n", k, u, u - w, u + w > f
  }
  close(f)
  f = out "/curve-C.csv"; banner(f, "EZ-G06", "CAD utility against simulation budget of topology optimization")
  print "k,mean,lo,hi" > f
  for (p = 0; p <= 8; p++) {
    k = 2 ^ p; u = UEZ["C"] + 0.006 - 0.32 * (k ^ (-0.40) - 32 ^ (-0.40)) + 0.003 * gauss()
    if (k == 32 && u < UEZ["C"]) u = UEZ["C"] + 0.001
    w = 0.046 - 0.002 * p
    printf "%d,%.4f,%.4f,%.4f\n", k, u, u - w, u + w > f
  }
  close(f)
  macro("EZbeqA", 64); macro("EZbeqAlo", 32); macro("EZbeqAhi", 128)
  macro("EZbeqC", 32); macro("EZbeqClo", 16); macro("EZbeqChi", 64)
  # Reference lines drawn across the curves.
  f = out "/curve-lines.csv"; banner(f, "EZ-G02/G06/G07", "reference lines for the search-equivalent panels")
  print "domain,ez,ez_lo,ez_hi,comparator,retrieval,frontier" > f
  printf "A,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f\n", UEZ["A"], UEZ["A"] - 0.017, UEZ["A"] + 0.017, UCMP["A"], UCMP["A"] - 0.031, UEZ["A"] - 0.083 > f
  printf "C,%.4f,%.4f,%.4f,%.4f,%.4f,%.4f\n", UEZ["C"], UEZ["C"] - 0.041, UEZ["C"] + 0.041, UCMP["C"], UCMP["C"], UEZ["C"] - 0.157 > f
  close(f)

  # ------------------------------------------------------------------ closed-loop regret (EZ-G04)
  split("ez gpei tpe cmaes optformer zeroshot random", M, " ")
  split("0.75 0.85 0.85 0.90 0.80 0.78 0.90", A0, " ")
  split("0.72 0.55 0.45 0.42 0.60 0.63 0.25", B0, " ")
