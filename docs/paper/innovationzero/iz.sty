% iz.sty — typography and layout for the InnovationZero paper.
% XeLaTeX only. Fonts are fetched and hash-checked by build.sh (see fonts.lock).
%   Text: Libertinus Serif   Math: Libertinus Math   Display/sans: Inter   Code: JetBrains Mono
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{iz}[2026/10/22 InnovationZero paper style]

% ---------------------------------------------------------------- page geometry
\RequirePackage[letterpaper,
  textwidth=6.05in, textheight=8.95in,
  top=1.0in, headsep=0.32in, footskip=0.42in,
  hmarginratio=1:1]{geometry}

% ---------------------------------------------------------------- fonts
\RequirePackage{amsmath,mathtools}
\RequirePackage{fontspec}
\RequirePackage[math-style=TeX,bold-style=TeX]{unicode-math}
\providecommand\IZFontDir{./fonts/}
\setmainfont{LibertinusSerif}[
  Path=\IZFontDir, Extension=.otf,
  UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-Semibold, BoldItalicFont=*-SemiboldItalic,
  Numbers={Proportional,OldStyle}, Ligatures=TeX]
\setsansfont{Inter}[
  Path=\IZFontDir, Extension=.otf,
  UprightFont=*-Regular, ItalicFont=*-Italic,
  BoldFont=*-SemiBold, BoldItalicFont=*-SemiBoldItalic,
  FontFace={m}{n}{*-Regular}, FontFace={sb}{n}{*-SemiBold},
  FontFace={mb}{n}{*-Medium},
  Scale=MatchLowercase, Numbers=Lining]
\setmonofont{JetBrainsMono}[
  Path=\IZFontDir, Extension=.ttf,
  UprightFont=*-Regular, BoldFont=*-Bold,
  ItalicFont=*-Italic, BoldItalicFont=*-BoldItalic,
  Scale=0.84, Contextuals=Alternate]
\setmathfont{LibertinusMath-Regular.otf}[Path=\IZFontDir]
\newfontfamily\IZdisplay{LibertinusSerifDisplay}[Path=\IZFontDir, Extension=.otf, UprightFont=*-Regular]
\newcommand\lining{\addfontfeatures{Numbers={Lining,Monospaced}}}
\newcommand\sbseries{\fontseries{sb}\selectfont}
\newcommand\mdseries@inter{\fontseries{mb}\selectfont}
\linespread{1.075}
\RequirePackage[protrusion=true, final]{microtype}

\frenchspacing
\setlength\emergencystretch{1.6em}

% ---------------------------------------------------------------- colour
\RequirePackage[dvipsnames]{xcolor}
\definecolor{izink}{HTML}{1B1F27}      % text
\definecolor{izaccent}{HTML}{1F5AA6}   % deep blue
\definecolor{izaccentsoft}{HTML}{E8EFF8}
\definecolor{izwarm}{HTML}{B4501E}     % burnt orange, second series
\definecolor{izgreen}{HTML}{2E7D4F}
\definecolor{izamber}{HTML}{A86A00}
\definecolor{izgrey}{HTML}{6B7280}
\definecolor{izrule}{HTML}{C9CED6}
\definecolor{izpaper}{HTML}{F6F7F9}
\color{izink}

% ---------------------------------------------------------------- maths and units
\RequirePackage{siunitx}
\sisetup{group-minimum-digits=4, group-separator={,}, detect-all=false,
  text-family-to-math=false}

% ---------------------------------------------------------------- headings
\RequirePackage[explicit]{titlesec}
\titleformat{\section}
  {\sffamily\sbseries\Large\color{izink}}
  {\llap{\color{izaccent}\thesection\hspace{0.7em}}}{0pt}{#1}
\titleformat{\subsection}
  {\sffamily\sbseries\large\color{izink}}
  {\llap{\color{izaccent}\thesubsection\hspace{0.6em}}}{0pt}{#1}
\titleformat{\subsubsection}[runin]
  {\sffamily\sbseries\normalsize\color{izink}}
  {}{0pt}{#1.}
\titleformat{\paragraph}[runin]
  {\normalfont\itshape}{}{0pt}{#1.}
\titlespacing*{\section}{0pt}{2.1ex plus .6ex minus .2ex}{1.0ex plus .2ex}
\titlespacing*{\subsection}{0pt}{1.7ex plus .5ex minus .2ex}{0.7ex plus .1ex}
\titlespacing*{\subsubsection}{0pt}{1.1ex plus .3ex minus .2ex}{0.6em}
\titlespacing*{\paragraph}{0pt}{0.8ex plus .2ex}{0.5em}

% ---------------------------------------------------------------- running heads
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrulewidth{0pt}
\fancyhead[L]{\sffamily\footnotesize\color{izgrey}\IZShortTitle}
\fancyhead[R]{\sffamily\footnotesize\color{izgrey}\nouppercase{\leftmark}}
\fancyfoot[C]{\sffamily\footnotesize\color{izgrey}\thepage}
\renewcommand\sectionmark[1]{\markboth{\thesection\enspace #1}{}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\footnotesize\color{izgrey}\thepage}}
\providecommand\IZShortTitle{InnovationZero}

% ---------------------------------------------------------------- lists, captions, floats
\RequirePackage{enumitem}
\setlist{itemsep=0.25ex, topsep=0.6ex, parsep=0.2ex, leftmargin=1.4em}
\setlist[enumerate]{label=\textsf{\small\arabic*}., leftmargin=1.6em}
\RequirePackage{caption}
\DeclareCaptionFont{izlabel}{\sffamily\sbseries\color{izaccent}}
\captionsetup{font={small,sf}, labelfont=izlabel, labelsep=period,
  justification=justified, singlelinecheck=false, skip=6pt, width=\linewidth}
\captionsetup[table]{position=top, skip=4pt}
\RequirePackage{subcaption}
\RequirePackage{booktabs, tabularx, multirow, array, colortbl}
\setlength\heavyrulewidth{0.09em}
\setlength\lightrulewidth{0.05em}
\setlength\cmidrulewidth{0.04em}
\renewcommand\arraystretch{1.12}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}
\newcolumntype{R}{>{\raggedleft\arraybackslash}X}
\newcommand\tablesf{\sffamily\small\lining}
\RequirePackage{float}
\setlength\textfloatsep{14pt plus 4pt minus 4pt}
\setlength\floatsep{12pt plus 4pt minus 4pt}
\setlength\intextsep{12pt plus 4pt minus 4pt}

% ---------------------------------------------------------------- graphics
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,shapes.geometric,decorations.pathreplacing}
\RequirePackage{pgfplots}
\RequirePackage{pgfplotstable}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{groupplots,fillbetween}
\pgfplotsset{
  iz/.style={
    width=\linewidth, height=0.42\linewidth,
    axis line style={izrule}, tick style={izrule},
    every tick label/.append style={font=\sffamily\scriptsize\color{izgrey}},
    label style={font=\sffamily\footnotesize},
    title style={font=\sffamily\sbseries\small},
    legend style={font=\sffamily\scriptsize, draw=none, fill=none},
    grid style={izrule!60, line width=0.3pt},
    major grid style={izrule!60},
  }}
\tikzset{
  izbox/.style={draw=izrule, fill=white, rounded corners=2.5pt, line width=0.6pt,
    font=\sffamily\small, align=center, inner sep=5pt},
  izstage/.style={izbox, fill=izaccentsoft, draw=izaccent!55},
  izhidden/.style={izbox, fill=izink, text=white, draw=izink},
  izarrow/.style={-{Stealth[length=2.6mm,width=1.8mm]}, line width=0.7pt, color=izgrey},
  iznote/.style={font=\sffamily\scriptsize\color{izgrey}, align=center},
}

% ---------------------------------------------------------------- boxes: definitions, claims
\RequirePackage[most]{tcolorbox}
\newtcolorbox{izdef}[1]{enhanced, breakable, colback=izpaper, colframe=izpaper,
  borderline west={2.2pt}{0pt}{izaccent}, arc=0pt, outer arc=0pt,
  left=10pt, right=8pt, top=6pt, bottom=6pt, before skip=10pt, after skip=10pt,
  fontupper=\normalsize,
  title={\sffamily\sbseries\small\color{izaccent}#1}, coltitle=izaccent,
  attach title to upper={\par\smallskip}}
\newtcolorbox{izquestion}{enhanced, colback=white, colframe=izaccent, boxrule=0.7pt,
  arc=2pt, left=12pt, right=12pt, top=9pt, bottom=9pt, before skip=12pt, after skip=12pt,
  fontupper=\large\itshape}
\newtcolorbox{izabstract}{enhanced, colback=izpaper, colframe=izpaper, arc=0pt,
  left=14pt, right=14pt, top=10pt, bottom=10pt, before skip=6pt, after skip=10pt}

% Evidence badges: every empirical sentence that is not textbook fact carries one.
\DeclareRobustCommand\izbadge[2]{\kern1pt\raisebox{0.12ex}{\tikz[baseline]\node[anchor=base,
  font=\sffamily\sbseries\fontsize{6pt}{6pt}\selectfont\color{white}, fill=#1,
  rounded corners=1.4pt, inner xsep=2.1pt, inner ysep=1.4pt]{#2};}\kern1pt}
\DeclareRobustCommand\est{\izbadge{izgreen}{EST}}
\DeclareRobustCommand\pre{\izbadge{izamber}{PRE}}
\DeclareRobustCommand\pend{\izbadge{izgrey}{PEND}}

% ---------------------------------------------------------------- code listings
\RequirePackage{fvextra}
\RequirePackage{listings}
\lstdefinelanguage{Rust}{
  morekeywords={as,break,const,continue,crate,else,enum,extern,false,fn,for,if,impl,in,let,
    loop,match,mod,move,mut,pub,ref,return,self,Self,static,struct,super,trait,true,type,
    unsafe,use,where,while,dyn},
  morekeywords=[2]{f64,f32,u8,u16,u32,u64,usize,i32,i64,isize,bool,char,str,String,Vec,Option,
    Result,Box,Some,None,Ok,Err},
  sensitive=true,
  morecomment=[l]{//}, morecomment=[s]{/*}{*/},
  morestring=[b]", }
\lstset{
  basicstyle=\ttfamily\fontsize{7.2pt}{8.6pt}\selectfont\color{izink},
  keywordstyle=\color{izaccent}\bfseries,
  keywordstyle=[2]\color{izwarm},
  commentstyle=\color{izgrey}\itshape,
  stringstyle=\color{izgreen},
  numbers=left, numberstyle=\ttfamily\fontsize{5.6pt}{6pt}\selectfont\color{izrule},
  numbersep=7pt, stepnumber=1,
  breaklines=true, breakatwhitespace=false, postbreak=\mbox{\textcolor{izrule}{$\hookrightarrow$}\space},
  columns=fullflexible, keepspaces=true, showstringspaces=false, tabsize=4,
  frame=none, xleftmargin=16pt, aboveskip=4pt, belowskip=4pt,
  upquote=true, extendedchars=true, inputencoding=utf8,
  literate={–}{{\textendash}}1 {—}{{\textemdash}}1 {’}{{\textquoteright}}1 {‘}{{\textquoteleft}}1 {“}{{\textquotedblleft}}1 {”}{{\textquotedblright}}1
           {≤}{{$\le$}}1 {≥}{{$\ge$}}1 {×}{{$\times$}}1 {·}{{$\cdot$}}1 {→}{{$\to$}}1
           {−}{{-}}1 {∈}{{$\in$}}1 {≈}{{$\approx$}}1 {…}{{...}}1 {²}{{$^2$}}1 {√}{{$\surd$}}1
           {\\(}{{\\(}}2 {\\)}{{\\)}}2 {∑}{{$\sum$}}1 {∫}{{$\int$}}1 {π}{{$\pi$}}1 {ε}{{$\varepsilon$}}1
           {λ}{{$\lambda$}}1 {μ}{{$\mu$}}1 {σ}{{$\sigma$}}1 {α}{{$\alpha$}}1 {β}{{$\beta$}}1
           {≠}{{$\ne$}}1 {∞}{{$\infty$}}1 {⌊}{{$\lfloor$}}1 {⌋}{{$\rfloor$}}1 {±}{{$\pm$}}1
           {é}{{\'e}}1 {°}{{$^\circ$}}1 {∣}{{$\mid$}}1 {⇒}{{$\Rightarrow$}}1 {←}{{$\leftarrow$}}1}
\lstdefinestyle{prompt}{language={}, numbers=none, xleftmargin=0pt,
  basicstyle=\ttfamily\fontsize{6.9pt}{8.3pt}\selectfont\color{izink},
  keywordstyle={}, commentstyle={}, stringstyle={}}

% ---------------------------------------------------------------- references and links
\RequirePackage[numbers,sort&compress]{natbib}
\setlength\bibsep{2.2pt plus 1pt}
\renewcommand\bibfont{\small}
\RequirePackage[hyphens]{url}
\RequirePackage{xr-hyper}
\RequirePackage[pdfusetitle, colorlinks=true, linkcolor=izaccent, citecolor=izaccent,
  urlcolor=izaccent, bookmarksnumbered=true, bookmarksopen=true, pdfdisplaydoctitle=true,
  pdfstartview=FitH]{hyperref}
\RequirePackage[capitalise, noabbrev, nameinlink]{cleveref}
\crefname{izdefinition}{Definition}{Definitions}

% ---------------------------------------------------------------- numbered definitions
\newcounter{izdefinition}
\newenvironment{definition}[1]{\refstepcounter{izdefinition}%
  \begin{izdef}{Definition~\theizdefinition\quad\normalfont\sffamily\color{izink}#1}}{\end{izdef}}

\newcounter{izproposition}
\newenvironment{proposition}[1]{\refstepcounter{izproposition}%
  \begin{izdef}{Proposition~\theizproposition\quad\normalfont\sffamily\color{izink}#1}}{\end{izdef}}
\crefname{izproposition}{Proposition}{Propositions}

% ---------------------------------------------------------------- small helpers
\newcommand\IZ{InnovationZero}
\ExplSyntaxOn
\tl_new:N \l__iz_code_tl
\NewDocumentCommand\code{m}{\texttt{
  \tl_set:Nn \l__iz_code_tl {#1}
  \regex_replace_all:nnN { / } { /\c{allowbreak} } \l__iz_code_tl
  \regex_replace_all:nnN { \c{_} } { \c{_}\c{allowbreak} } \l__iz_code_tl
  \regex_replace_all:nnN { \- } { \-\c{allowbreak} } \l__iz_code_tl
  \regex_replace_all:nnN { \. } { \.\c{allowbreak} } \l__iz_code_tl
  \tl_use:N \l__iz_code_tl}}
\ExplSyntaxOff
\newcommand\kz{\ensuremath{k}}
\newcommand\TY{\mathrm{TY}}
\newcommand\eg{e.g.,\ }
\newcommand\ie{i.e.,\ }
\newcommand\marginnote[1]{}
\newcommand\sidenote[1]{\footnote{#1}}
\renewcommand\footnoterule{\kern-3pt{\color{izrule}\hrule width 1.4in height 0.4pt}\kern 2.6pt}
\setlength\footnotesep{8pt}

% ---------------------------------------------------------------- title block
\newcommand\IZTitle{}\newcommand\IZSubtitle{}\newcommand\IZAuthors{}\newcommand\IZDate{}\newcommand\IZStatus{}
\newcommand\izmaketitle{%
  \thispagestyle{plain}%
  \begingroup
  \vspace*{-0.35in}%
  {\sffamily\footnotesize\color{izaccent}\sbseries\IZStatus\par}\vspace{14pt}%
  {\IZdisplay\fontsize{30pt}{33pt}\selectfont\color{izink}\IZTitle\par}\vspace{9pt}%
  {\sffamily\large\color{izgrey}\IZSubtitle\par}\vspace{16pt}%
  {\sffamily\normalsize\color{izink}\IZAuthors\par}\vspace{3pt}%
  {\sffamily\footnotesize\color{izgrey}\IZDate\par}\vspace{14pt}%
  \noindent{\color{izrule}\rule{\linewidth}{0.5pt}}\par\vspace{6pt}%
  \endgroup}

\endinput
