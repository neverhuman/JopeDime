{
  "components": {
    "schemas": {
      "BestAlgorithm": {
        "properties": {
          "algorithm_id": {
            "type": "string"
          },
          "cv_value": {
            "format": "double",
            "type": "number"
          },
          "metric": {
            "type": "string"
          },
          "model_artifact": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "algorithm_id",
          "metric",
          "cv_value"
        ],
        "type": "object"
      },
      "Budget": {
        "properties": {
          "evaluations": {
            "type": [
              "string",
              "null"
            ]
          },
          "wall_seconds": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "BudgetTotal": {
        "properties": {
          "evaluations": {
            "type": "string"
          },
          "wall_seconds": {
            "type": "string"
          }
        },
        "required": [
          "evaluations",
          "wall_seconds"
        ],
        "type": "object"
      },
      "BudgetUsed": {
        "properties": {
          "evaluations": {
            "type": "string"
          },
          "wall_seconds": {
            "description": "Elapsed seconds may be fractional (the spec example is \"23.4\").",
            "type": "string"
          }
        },
        "required": [
          "evaluations",
          "wall_seconds"
        ],
        "type": "object"
      },
      "Capabilities": {
        "properties": {
          "devices": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array"
          },
          "learned_guidance": {
            "type": "boolean"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/Task"
            },
            "type": "array"
          }
        },
        "required": [
          "tasks",
          "languages",
          "devices",
          "learned_guidance"
        ],
        "type": "object"
      },
      "CompletionReason": {
        "enum": [
          "budget_evaluations",
          "budget_time",
          "converged",
          "effort_reduced"
        ],
        "type": "string"
      },
      "Direction": {
        "enum": [
          "minimize",
          "maximize"
        ],
        "type": "string"
      },
      "Effort": {
        "enum": [
          "fast",
          "medium",
          "high",
          "ultra"
        ],
        "type": "string"
      },
      "ErrorCode": {
        "description": "Every Appendix D code. There is no arbitrary-string/fallback variant.",
        "enum": [
          "INVALID_INPUT",
          "DATASET_INVALID",
          "TASK_AMBIGUOUS",
          "OBJECTIVE_INVALID",
          "OBJECTIVE_REQUIRES_ORDER",
          "LANGUAGE_INTERSECTION_EMPTY",
          "CAPABILITY_UNAVAILABLE",
          "NOT_FOUND",
          "IMMUTABLE_FIELD",
          "REVISION_CONFLICT",
          "IDEMPOTENCY_CONFLICT",
          "PLAN_CHANGED",
          "MODEL_INTEGRITY_FAILED",
          "BACKEND_UNAVAILABLE",
          "NO_VALID_MODEL",
          "NUMERICAL_FAILURE",
          "IO_FAILURE",
          "OUTPUT_EXISTS",
          "DISK_LOW",
          "UNAUTHORIZED",
          "ENGINE_UNREACHABLE",
          "ENGINE_BUSY",
          "FITNESS_UNDEFINED"
        ],
        "type": "string"
      },
      "ExportKind": {
        "enum": [
          "model",
          "source",
          "bundle"
        ],
        "type": "string"
      },
      "ExportManifest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "algorithm_id": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "emitter_version": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ExportKind"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/LanguageExport"
            },
            "type": "array"
          },
          "model_digest": {
            "type": "string"
          },
          "parity_receipt": {
            "type": [
              "string",
              "null"
            ]
          },
          "parity_status": {
            "$ref": "#/components/schemas/ParityStatus"
          },
          "qualified_set_id": {
            "type": "string"
          },
          "refit": {
            "$ref": "#/components/schemas/Refit"
          },
          "retains_training_data": {
            "type": "boolean"
          }
        },
        "required": [
          "artifact_id",
          "algorithm_id",
          "kind",
          "model_digest",
          "emitter_version",
          "qualified_set_id",
          "refit",
          "retains_training_data",
          "languages",
          "parity_status"
        ],
        "title": "ExportManifest",
        "type": "object"
      },
      "ExportRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Client output paths are deliberately absent: the engine writes only its store.",
        "properties": {
          "algorithm_id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ExportKind"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array"
          },
          "refit": {
            "$ref": "#/components/schemas/Refit"
          },
          "require_all_languages": {
            "type": "boolean"
          }
        },
        "required": [
          "algorithm_id",
          "kind",
          "languages",
          "require_all_languages",
          "refit"
        ],
        "title": "ExportRequest",
        "type": "object"
      },
      "Guidance": {
        "enum": [
          "auto",
          "learned",
          "heuristic"
        ],
        "type": "string"
      },
      "LandmarkMode": {
        "oneOf": [
          {
            "enum": [
              "full",
              "none"
            ],
            "type": "string"
          },
          {
            "const": "progressive",
            "description": "The plan handler refuses this with CAPABILITY_UNAVAILABLE in v1.",
            "type": "string"
          }
        ]
      },
      "Language": {
        "enum": [
          "python",
          "rust",
          "javascript",
          "typescript"
        ],
        "type": "string"
      },
      "LanguageExport": {
        "oneOf": [
          {
            "properties": {
              "language": {
                "$ref": "#/components/schemas/Language"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "const": "exported",
                "type": "string"
              }
            },
            "required": [
              "status",
              "language",
              "path"
            ],
            "type": "object"
          },
          {
            "properties": {
              "language": {
                "$ref": "#/components/schemas/Language"
              },
              "operations": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "status": {
                "const": "unsupported",
                "type": "string"
              }
            },
            "required": [
              "status",
              "language",
              "operations"
            ],
            "type": "object"
          }
        ]
      },
      "MetricSample": {
        "description": "Null is unavailable, never zero. Scope and availability are extensible strings\n(`device:<uuid>` and `unavailable:<reason>` respectively).",
        "properties": {
          "age_ms": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "availability": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MetricValue"
              },
              {
                "type": "null"
              }
            ]
          },
          "window_ms": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "name",
          "unit",
          "scope",
          "window_ms",
          "age_ms",
          "availability"
        ],
        "type": "object"
      },
      "MetricValue": {
        "anyOf": [
          {
            "format": "double",
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "description": "Exact byte counts follow §4.1 even above JavaScript's integer range.",
            "type": "string"
          }
        ],
        "description": "§9.1 includes both numeric measurements and the rust_timed_alone boolean."
      },
      "ObjectiveSpec": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "additionalProperties": true,
            "type": "object"
          }
        ],
        "description": "The objective grammar is owned by jope-runtime; the API transports it without\nimporting the evaluator. A string is a built-in name or name:param=value."
      },
      "ParityStatus": {
        "enum": [
          "passed",
          "failed",
          "unavailable"
        ],
        "type": "string"
      },
      "Placement": {
        "properties": {
          "dope": {
            "type": "string"
          },
          "evaluation": {
            "type": "string"
          },
          "ranker": {
            "type": "string"
          },
          "workers": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "dope",
          "ranker",
          "evaluation",
          "workers"
        ],
        "type": "object"
      },
      "Plan": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "effort": {
            "$ref": "#/components/schemas/ResolvedEffort"
          },
          "estimates": {
            "$ref": "#/components/schemas/ResourceEstimates"
          },
          "guidance": {
            "$ref": "#/components/schemas/ResolvedGuidance"
          },
          "landmarks": {
            "$ref": "#/components/schemas/ResolvedLandmarks"
          },
          "languages": {
            "$ref": "#/components/schemas/ResolvedLanguages"
          },
          "limits": {
            "$ref": "#/components/schemas/RunLimits"
          },
          "objective": {
            "$ref": "#/components/schemas/ResolvedObjective"
          },
          "placement": {
            "$ref": "#/components/schemas/Placement"
          },
          "plan_digest": {
            "type": "string"
          },
          "rows": {
            "$ref": "#/components/schemas/RowCounts"
          },
          "task": {
            "$ref": "#/components/schemas/ResolvedTask"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array"
          }
        },
        "required": [
          "plan_digest",
          "task",
          "objective",
          "rows",
          "effort",
          "guidance",
          "landmarks",
          "languages",
          "placement",
          "limits",
          "estimates",
          "warnings"
        ],
        "title": "Plan",
        "type": "object"
      },
      "PredictRequest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Registered input avoids exposing a client-side output path to the engine.",
        "properties": {
          "dataset": {
            "type": "string"
          },
          "model_artifact": {
            "type": "string"
          }
        },
        "required": [
          "model_artifact",
          "dataset"
        ],
        "title": "PredictRequest",
        "type": "object"
      },
      "Problem": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "JopeDime's [RFC 9457](https://www.rfc-editor.org/rfc/rfc9457.html) profile.\n\nSerialize with **`Content-Type: application/problem+json`**, not the success\nresponse media type. Set the actual HTTP response status to [`Self::status`].\nThe spec requires `type`, `title`, `status`, `detail` and the three required\nextensions; `instance` and `field` are optional and omitted when absent.\nUnknown extension members are ignored when reading the document.\n\n`retriable` describes this occurrence. For IO_FAILURE the producer decides it\nfrom the actual failure; for conditional policies it must also provide the\nrequired action through `remedy`. Catalog `maybe` is not silently made false.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "detail": {
            "type": "string"
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "remedy": {
            "type": "string"
          },
          "retriable": {
            "type": "boolean"
          },
          "status": {
            "format": "uint16",
            "maximum": 65535,
            "minimum": 0,
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "retriable",
          "remedy"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Refit": {
        "enum": [
          "fit",
          "fit_holdout"
        ],
        "type": "string"
      },
      "ResolvedEffort": {
        "properties": {
          "cv_folds": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "evaluations": {
            "type": "string"
          },
          "name": {
            "$ref": "#/components/schemas/Effort"
          },
          "rounds_in_flight": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "wall_seconds": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "evaluations",
          "wall_seconds",
          "cv_folds",
          "rounds_in_flight"
        ],
        "type": "object"
      },
      "ResolvedGuidance": {
        "properties": {
          "prior_only": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Guidance"
          }
        },
        "required": [
          "value",
          "prior_only",
          "reason"
        ],
        "type": "object"
      },
      "ResolvedLandmarks": {
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/LandmarkMode"
          },
          "sample_rows": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "mode",
          "sample_rows"
        ],
        "type": "object"
      },
      "ResolvedLanguages": {
        "properties": {
          "excluded_operations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "intersection_empty": {
            "type": "boolean"
          },
          "requested": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array"
          }
        },
        "required": [
          "requested",
          "excluded_operations",
          "intersection_empty"
        ],
        "type": "object"
      },
      "ResolvedObjective": {
        "properties": {
          "digest": {
            "type": "string"
          },
          "direction": {
            "$ref": "#/components/schemas/Direction"
          },
          "fitting": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "digest",
          "direction",
          "fitting"
        ],
        "type": "object"
      },
      "ResolvedTask": {
        "properties": {
          "inferred": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Task"
          }
        },
        "required": [
          "value",
          "inferred",
          "reason"
        ],
        "type": "object"
      },
      "ResourceEstimates": {
        "properties": {
          "disk_bytes": {
            "type": "string"
          },
          "peak_ram_bytes": {
            "type": "string"
          }
        },
        "required": [
          "peak_ram_bytes",
          "disk_bytes"
        ],
        "type": "object"
      },
      "RowCounts": {
        "properties": {
          "fit": {
            "type": "string"
          },
          "holdout": {
            "type": "string"
          },
          "test": {
            "type": [
              "string",
              "null"
            ]
          },
          "total": {
            "type": "string"
          }
        },
        "required": [
          "total",
          "fit",
          "holdout"
        ],
        "type": "object"
      },
      "RunLimits": {
        "properties": {
          "eval_timeout_s": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "worker_rss_bytes": {
            "type": "string"
          }
        },
        "required": [
          "eval_timeout_s",
          "worker_rss_bytes"
        ],
        "type": "object"
      },
      "RunPhase": {
        "enum": [
          "preparing",
          "encoding",
          "seeding",
          "searching",
          "finalizing"
        ],
        "type": "string"
      },
      "RunSnapshot": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "The watermark, rather than revision, is the long-poll/attach cursor (§4.4).",
        "properties": {
          "best": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BestAlgorithm"
              },
              {
                "type": "null"
              }
            ]
          },
          "budget_total": {
            "$ref": "#/components/schemas/BudgetTotal"
          },
          "budget_used": {
            "$ref": "#/components/schemas/BudgetUsed"
          },
          "completion_reason": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompletionReason"
              },
              {
                "type": "null"
              }
            ]
          },
          "effort": {
            "$ref": "#/components/schemas/Effort"
          },
          "event_watermark": {
            "type": "string"
          },
          "pending": {
            "type": [
              "string",
              "null"
            ]
          },
          "phase": {
            "$ref": "#/components/schemas/RunPhase"
          },
          "revision": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RunState"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array"
          }
        },
        "required": [
          "run_id",
          "revision",
          "state",
          "phase",
          "effort",
          "budget_used",
          "budget_total",
          "event_watermark",
          "warnings"
        ],
        "title": "RunSnapshot",
        "type": "object"
      },
      "RunSpec": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "description": "Operation 6 uses this same body for a dry-run plan and a real start.",
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/Budget"
          },
          "dataset": {
            "type": "string"
          },
          "device": {
            "description": "`auto`, `cpu`, or an explicit device such as `cuda:0`.",
            "type": "string"
          },
          "dry_run": {
            "type": "boolean"
          },
          "effort": {
            "$ref": "#/components/schemas/Effort"
          },
          "guidance": {
            "$ref": "#/components/schemas/Guidance"
          },
          "ignore_columns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "landmarks": {
            "$ref": "#/components/schemas/LandmarkMode"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "type": "array"
          },
          "objective": {
            "$ref": "#/components/schemas/ObjectiveSpec"
          },
          "plan_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "require_all_languages": {
            "type": "boolean"
          },
          "seed": {
            "type": "string"
          },
          "split": {
            "$ref": "#/components/schemas/SplitSpec"
          },
          "target": {
            "type": "string"
          },
          "task": {
            "$ref": "#/components/schemas/Task"
          },
          "test_dataset": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "dataset",
          "target",
          "task",
          "ignore_columns",
          "split",
          "objective",
          "effort",
          "budget",
          "landmarks",
          "guidance",
          "languages",
          "require_all_languages",
          "device",
          "seed",
          "dry_run"
        ],
        "title": "RunSpec",
        "type": "object"
      },
      "RunState": {
        "enum": [
          "running",
          "pausing",
          "paused",
          "completed",
          "cancelled",
          "failed"
        ],
        "type": "string"
      },
      "Severity": {
        "enum": [
          "info",
          "warn",
          "error"
        ],
        "type": "string"
      },
      "SplitKind": {
        "enum": [
          "random",
          "stratified",
          "grouped",
          "time_ordered"
        ],
        "type": "string"
      },
      "SplitSpec": {
        "properties": {
          "group_column": {
            "type": [
              "string",
              "null"
            ]
          },
          "holdout_fraction": {
            "format": "double",
            "type": "number"
          },
          "kind": {
            "$ref": "#/components/schemas/SplitKind"
          },
          "time_column": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "holdout_fraction"
        ],
        "type": "object"
      },
      "SystemInfo": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "api_version": {
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "health": {
            "type": "string"
          },
          "local_paths": {
            "type": "boolean"
          },
          "telemetry": {
            "items": {
              "$ref": "#/components/schemas/MetricSample"
            },
            "type": "array"
          },
          "version": {
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array"
          }
        },
        "required": [
          "version",
          "api_version",
          "health",
          "local_paths",
          "capabilities",
          "warnings",
          "telemetry"
        ],
        "title": "SystemInfo",
        "type": "object"
      },
      "Task": {
        "oneOf": [
          {
            "enum": [
              "auto",
              "regression",
              "binary"
            ],
            "type": "string"
          },
          {
