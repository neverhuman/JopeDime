{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/JopeDime/schemas/jope.appliance-fitted.v1.schema.json",
  "title": "model.jope header",
  "description": "The header of a jopedime fitted model file (crates/jope-runtime/src/fitted.rs): JOPEFIT1 | u32 format | u32 minimum reader | u64 header length | this header | u64 body length | body | sha256 of all preceding bytes. Each fitted section names its format, length and sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "minimum_reader_version", "product", "product_version", "runtime_abi", "method", "task", "metric", "class_order", "target", "input_schema", "preprocessing", "recipe_sha256", "required_asset_hashes", "fitted_sections", "training_procedure", "retained_training_context", "created_by"],
  "properties": {
    "schema": {"const": "jope.appliance-fitted/v1"},
    "minimum_reader_version": {"type": "integer", "minimum": 1},
    "product": {"const": "jopedime"},
    "product_version": {"type": "string"},
    "runtime_abi": {"const": "jope.appliance-runtime/v1"},
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "configuration", "recipe", "implementation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "family": {"type": "string", "minLength": 1},
        "configuration": {"type": "string", "minLength": 1},
        "recipe": {"type": "string", "minLength": 1},
        "implementation": {"type": "string", "minLength": 1}
      }
    },
    "task": {"enum": ["regression", "binary", "multiclass"]},
    "metric": {"type": "string", "minLength": 1, "maxLength": 64, "description": "Selection fitness name when selected automatically; canonical task metric for a named fit. The exact custom specification and identity are in training_procedure.selection."},
    "class_order": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "target": {"type": "string", "minLength": 1},
    "input_schema": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {"name": {"type": "string", "minLength": 1}, "kind": {"enum": ["numeric", "categorical"]}}
      }
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_cell_encoding", "input_policy"],
      "properties": {
        "raw_cell_encoding": {"const": "jope.raw-cell-encoding/v1"},
        "input_policy": {"const": "median-onehot256-indicator/v1"}
      }
    },
    "recipe_sha256": {"$ref": "#/$defs/sha256"},
    "required_asset_hashes": {"type": "array", "items": {"$ref": "#/$defs/sha256"}},
    "fitted_sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "format", "bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "training_procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows", "fitting_input_sha256", "training_file_sha256", "method_choice", "selection", "budget", "final_refit"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "fitting_input_sha256": {"$ref": "#/$defs/sha256"},
        "training_file_sha256": {"type": "string"},
        "method_choice": {"type": "string", "minLength": 1},
        "selection": {"type": ["object", "null"]},
        "budget": {"type": "object"},
        "final_refit": {"const": true}
      }
    },
    "retained_training_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["neural_support_rows", "note"],
      "properties": {"neural_support_rows": {"type": "integer", "minimum": 0}, "note": {"type": "string"}}
    },
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha40", "package_manifest_sha256", "package_profile"],
      "properties": {
        "source_sha40": {"type": "string"},
        "package_manifest_sha256": {"type": ["string", "null"]},
        "package_profile": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
