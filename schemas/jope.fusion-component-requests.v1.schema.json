{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/JopeDime/schemas/jope.fusion-component-requests.v1.schema.json",
  "title": "References resolved against separately configured controller authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "jope.fusion-component-requests/v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fit_scope_digest",
          "subject_sha256",
          "exposure_receipt_sha256",
          "episode"
        ],
        "properties": {
          "fit_scope_digest": {
            "$ref": "#/$defs/sha256"
          },
          "subject_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "exposure_receipt_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "episode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
