{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/JopeDime/schemas/jope.landmark-encoding.v1.schema.json",
  "title": "Dope landmark encoding snapshot receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "mask", "subsample_n", "source_digest", "conditioning_digest", "weights_sha256", "embedding_identity", "device", "version"],
  "properties": {
    "schema": {"const": "jope.landmark-encoding/v1"},
    "status": {"oneOf": [{"enum": ["none", "full"]}, {"type": "object", "additionalProperties": false, "required": ["partial"], "properties": {"partial": {"type": "integer", "minimum": 1, "maximum": 22}}}]},
    "mask": {"type": "array", "minItems": 23, "maxItems": 23, "items": {"type": "boolean"}},
    "subsample_n": {"type": ["integer", "null"], "minimum": 2},
    "source_digest": {"$ref": "#/$defs/sha256"},
    "conditioning_digest": {"$ref": "#/$defs/sha256"},
    "options_digest": {"$ref": "#/$defs/sha256"},
    "work_budget": {"type": "integer", "minimum": 0},
    "weights_sha256": {"$ref": "#/$defs/sha256"},
    "embedding_identity": {"const": "dope-mlcv3-high-f32-descriptor256-task128-dist128/v1"},
    "device": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 0},
    "embedding": {"type": "array", "minItems": 512, "maxItems": 512, "items": {"type": "number"}},
    "outcome": {"oneOf": [{"enum": ["running", "complete", "cancelled"]}, {"type": "object", "additionalProperties": false, "required": ["failed"], "properties": {"failed": {"type": "object", "additionalProperties": false, "required": ["message"], "properties": {"message": {"type": "string"}}}}}]}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
