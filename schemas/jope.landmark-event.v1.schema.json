{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/JopeDime/schemas/jope.landmark-event.v1.schema.json",
  "title": "Progressive landmark encoding event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt",
    "embedding"
  ],
  "properties": {
    "receipt": {
      "$ref": "#/$defs/landmarkReceipt"
    },
    "embedding": {
      "$ref": "#/$defs/embedding512"
    },
    "fusion": {
      "$ref": "#/$defs/fusion"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt",
        "embedding"
      ],
      "properties": {
        "receipt": {
          "$ref": "#/$defs/consumer"
        },
        "embedding": {
          "$ref": "#/$defs/embedding512"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "embedding512": {
      "type": "array",
      "minItems": 512,
      "maxItems": 512,
      "items": {
        "type": "number"
      }
    },
    "checkpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lineage"
          ],
          "properties": {
            "lineage": {
              "const": "released-v1"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lineage",
            "weights_sha256",
            "training_receipt_sha256"
          ],
          "properties": {
            "lineage": {
              "const": "unqualified-candidate-v1"
            },
            "weights_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "training_receipt_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "fitScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "preparation_source",
        "source_digest",
        "physical_rows_sha256",
        "rows",
        "columns",
        "task",
        "fold"
      ],
      "properties": {
        "schema": {
          "const": "jope.dope-fit-scope/v1"
        },
        "preparation_source": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "preparation_recipe": {
          "const": "jope.dope-product-preparation/lossless-v1"
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "physical_rows_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "task": {
          "type": "string",
          "pattern": "^(Regression|Binary|Multiclass\\([0-9]+\\))$"
        },
        "fold": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "parent_manifest_sha256",
        "projection_digest",
        "policy_sha256"
      ],
      "properties": {
        "schema": {
          "const": "jope.policy-assets-projection/v1"
        },
        "parent_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "projection_digest": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "subject_sha256",
        "exposure_receipt_sha256",
        "policy_sha256",
        "authority_sha256",
        "fit_scope_digest",
        "episode",
        "purpose"
      ],
      "properties": {
        "schema": {
          "const": "jope.component-admission/v1"
        },
        "subject_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "exposure_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "fit_scope_digest": {
          "$ref": "#/$defs/sha256"
        },
        "episode": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "const": "episode_fit"
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "recipe",
        "checkpoint_identity",
        "jope_weights_sha256",
        "components_digest",
        "source_digest",
        "input_conditioning_digest",
        "conditioning_digest"
      ],
      "properties": {
        "mode": {
          "enum": [
            "encoding-only",
            "jope-dl"
          ]
        },
        "recipe": {
          "enum": [
            "dope512-direct-consumer/v1",
            "dope512-foundation1024-target512-jope-dl512/v1",
            "dope512-foundation1024-target512-jope-dl512-cuda-f32/v1"
          ]
        },
        "checkpoint_identity": {
          "$ref": "#/$defs/checkpoint"
        },
        "jope_weights_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "components_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "input_conditioning_digest": {
          "$ref": "#/$defs/sha256"
        },
        "conditioning_digest": {
          "$ref": "#/$defs/sha256"
        },
        "projection_identity": {
          "$ref": "#/$defs/projection"
        },
        "component_admission": {
          "$ref": "#/$defs/admission"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "encoding-only"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "recipe": {
                "const": "dope512-direct-consumer/v1"
              },
              "jope_weights_sha256": {
                "type": "null"
              },
              "components_digest": {
                "type": "null"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "projection_identity"
                  ]
                },
                {
                  "required": [
                    "component_admission"
                  ]
                }
              ]
            }
          },
          "else": {
            "properties": {
              "recipe": {
                "enum": [
                  "dope512-foundation1024-target512-jope-dl512/v1",
                  "dope512-foundation1024-target512-jope-dl512-cuda-f32/v1"
                ]
              },
              "jope_weights_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "components_digest": {
                "$ref": "#/$defs/sha256"
              }
            },
            "required": [
              "projection_identity",
              "component_admission"
            ]
          }
        }
      ]
    },
    "landmarkReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "mask",
        "subsample_n",
        "source_digest",
        "conditioning_digest",
        "weights_sha256",
        "embedding_identity",
        "device",
        "version"
      ],
      "properties": {
        "schema": {
          "const": "jope.landmark-encoding/v1"
        },
        "status": {
          "oneOf": [
            {
              "enum": [
                "none",
                "full"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "partial"
              ],
              "properties": {
                "partial": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 22
                }
              }
            }
          ]
        },
        "mask": {
          "type": "array",
          "minItems": 23,
          "maxItems": 23,
          "items": {
            "type": "boolean"
          }
        },
        "subsample_n": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "conditioning_digest": {
          "$ref": "#/$defs/sha256"
        },
        "options_digest": {
          "$ref": "#/$defs/sha256"
        },
        "work_budget": {
          "type": "integer",
          "minimum": 0
        },
        "weights_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "embedding_identity": {
          "enum": [
            "dope-mlcv3-high-f32-descriptor256-task128-dist128/v1",
            "dope-mlcv3-unqualified-candidate-high-f32-descriptor256-task128-dist128/v1"
          ]
        },
        "device": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "embedding": {
          "type": "array",
          "minItems": 512,
          "maxItems": 512,
          "items": {
            "type": "number"
          }
        },
        "outcome": {
          "oneOf": [
            {
              "enum": [
                "running",
                "complete",
                "cancelled"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "failed"
              ],
              "properties": {
                "failed": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          ]
        },
        "training_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "consumer": {
          "$ref": "#/$defs/consumer"
        },
        "consumer_embedding": {
          "$ref": "#/$defs/embedding512"
        },
        "fit_scope": {
          "$ref": "#/$defs/fitScope"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "embedding_identity": {
                "const": "dope-mlcv3-unqualified-candidate-high-f32-descriptor256-task128-dist128/v1"
              }
            },
            "required": [
              "embedding_identity"
            ]
          },
          "then": {
            "required": [
              "training_receipt_sha256"
            ],
            "properties": {
              "weights_sha256": {
                "not": {
                  "const": "d0b6960328d1955386632ff78b512e3add53a9b0256db7bbf067e2e0be5f0c6c"
                }
              }
            }
          },
          "else": {
            "properties": {
              "weights_sha256": {
                "const": "d0b6960328d1955386632ff78b512e3add53a9b0256db7bbf067e2e0be5f0c6c"
              }
            },
            "not": {
              "required": [
                "training_receipt_sha256"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "consumer"
            ]
          },
          "then": {
            "required": [
              "fit_scope"
            ]
          }
        },
        {
          "if": {
            "required": [
              "consumer_embedding"
            ]
          },
          "then": {
            "required": [
              "consumer"
            ]
          }
        }
      ]
    },
    "fusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components_digest",
        "checkpoint_identity",
        "recipe",
        "component_recipe",
        "source_digest",
        "conditioning_digest",
        "dataset1536",
        "policy2048"
      ],
      "properties": {
        "components_digest": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_identity": {
          "$ref": "#/$defs/checkpoint"
        },
        "recipe": {
          "type": "string",
          "minLength": 1
        },
        "component_recipe": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "$ref": "#/$defs/sha256"
        },
        "conditioning_digest": {
          "$ref": "#/$defs/sha256"
        },
        "dataset1536": {
          "type": "array",
          "minItems": 1536,
          "maxItems": 1536,
          "items": {
            "type": "number"
          }
        },
        "policy2048": {
          "type": "array",
          "minItems": 2048,
          "maxItems": 2048,
          "items": {
            "type": "number"
          }
        }
      }
    }
  }
}
