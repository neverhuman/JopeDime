{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/veox-ai/JopeDime/schemas/jope.model-bundle.v2.schema.json",
  "title": "jope.model-bundle/v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "bundle_id",
    "files",
    "notices",
    "published_at",
    "bucket"
  ],
  "properties": {
    "schema": {
      "const": "jope.model-bundle/v2"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
    },
    "bucket": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes",
          "blob",
          "kind"
        ],
        "additionalProperties": true,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "blob": {
            "type": "string",
            "pattern": "^blobs/sha256/[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string"
          },
          "source_key": {
            "type": "string"
          },
          "license": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "schema",
              "spdx_expression",
              "license_class",
              "redistribution"
            ],
            "properties": {
              "schema": {
                "const": "jain.model-license/v1"
              },
              "spdx_expression": {
                "type": "string"
              },
              "license_class": {
                "enum": [
                  "open",
                  "internal",
                  "restricted",
                  "redistributable",
                  "eligible_non_open"
                ]
              },
              "redistribution": {
                "enum": [
                  "permitted",
                  "internal",
                  "prohibited",
                  "conditional"
                ]
              }
            }
          }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "text"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
