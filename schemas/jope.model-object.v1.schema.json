{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jopedime.org/schemas/jope.model-object.v1.schema.json",
  "title": "JopeDime fitted model object envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "minimum_reader_version", "format", "producer", "primary", "required_capabilities", "files", "metadata"],
  "properties": {
    "schema": {"const": "jope.model-object/v1"},
    "minimum_reader_version": {"const": 1},
    "format": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9.:_-]+(/[A-Za-z0-9.:_-]+)+$"},
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "language"],
      "properties": {"name": {"type":"string","minLength":1}, "version": {"type":"string","minLength":1}, "language": {"type":"string","minLength":1}}
    },
    "primary": {"$ref": "#/$defs/filename"},
    "required_capabilities": {"type":"array", "uniqueItems":true, "items":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[A-Za-z0-9./:_-]+$"}},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type":"object", "additionalProperties":false,
        "required":["path","media_type","bytes","sha256"],
        "properties": {
          "path":{"$ref":"#/$defs/filename"},
          "media_type":{"type":"string","minLength":1},
          "bytes":{"type":"integer","minimum":0,"maximum":2147483648},
          "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
        }
      }
    },
    "metadata": {}
  },
  "$defs": {"filename":{"type":"string","maxLength":128,"pattern":"^[A-Za-z0-9_-][A-Za-z0-9._-]*$","not":{"const":"manifest.json"}}}
}
