{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jopedime.org/schemas/jope.model-session.v1.schema.json",
  "title": "JopeDime append-only model session event v1",
  "$comment": "Reader additionally verifies contiguous version filenames, previous-event hashes, rollback model identity, portable session names, unique JSON keys and referenced model validity before append.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session", "version", "previous", "model_id", "selected_from", "label"],
  "properties": {
    "schema": {"const": "jope.model-session/v1"},
    "session": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$", "not": {"enum": ["con", "prn", "aux", "nul", "com1", "com2", "com3", "com4", "com5", "com6", "com7", "com8", "com9", "lpt1", "lpt2", "lpt3", "lpt4", "lpt5", "lpt6", "lpt7", "lpt8", "lpt9"]}},
    "version": {"type": "integer", "minimum": 1, "maximum": 10000},
    "previous": {"type": "string", "pattern": "^(empty|sha256-[0-9a-f]{64})$"},
    "model_id": {"type": "string", "pattern": "^sha256-[0-9a-f]{64}$"},
    "selected_from": {"type": ["integer", "null"], "minimum": 1, "maximum": 9999},
    "label": {"type": "string", "maxLength": 256, "$comment": "Runtime limit is 256 UTF-8 bytes, possibly smaller than 256 Unicode characters."}
  }
}
