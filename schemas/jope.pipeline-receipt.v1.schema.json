{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/veox-ai/JopeDime/schemas/jope.pipeline-receipt.v1.schema.json",
  "title": "jope.pipeline-receipt/v1",
  "description": "One run of the JOPE-Dime product pipeline: the dataset it resolved and verified, the fold partition it built, every stage it ran or deliberately skipped, the feat-math genetic-programming search per cut, the program it selected on measured held-out error and the standalone sources it emitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ok",
    "tool_version",
    "created_at",
    "policy",
    "dataset",
    "prepared",
    "stages",
    "search",
    "artifacts",
    "emit_exclusions",
    "observations_sha256"
  ],
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/Dataset"
    },
    "emit_exclusions": {
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "type": "array"
    },
    "git_sha": {
      "description": "The checkout this ran from, when it could be determined.",
      "type": [
        "string",
        "null"
      ]
    },
    "observations_sha256": {
      "description": "sha256 over every cut's `observations.json` digest, concatenated as hex\nin cut order: one value binding the run to all of its evidence.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "policy": {
      "description": "The `--policy` the run was given: `auto`, `skip` or `require`.",
      "type": "string",
      "enum": [
        "auto",
        "skip",
        "require"
      ]
    },
    "prepared": {
      "$ref": "#/$defs/Prepared"
    },
    "schema": {
      "type": "string",
      "const": "jope.pipeline-receipt/v1"
    },
    "search": {
      "$ref": "#/$defs/Search"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "type": "array"
    },
    "tool_version": {
      "type": "string"
    }
  },
  "$defs": {
    "Artifact": {
      "description": "One emitted source file.",
      "properties": {
        "build": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "language": {
          "type": "string"
        },
        "path": {
          "description": "Relative to the run's `emit/` directory. `cpp17` and `cpp20` share one\npath: there is a single C++ emitter and the standard is a compile flag.",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "language",
        "path",
        "sha256",
        "bytes"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Best": {
      "description": "The selected program and its measured evidence.",
      "properties": {
        "cuts_measured": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "genome": {
          "type": "string"
        },
        "program_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "seconds": {
          "description": "Fit-and-score seconds this program cost across those cuts.",
          "format": "double",
          "type": "number"
        },
        "train_r2": {
          "description": "Mean in-sample R^2, for the gap against `validation_r2`.",
          "format": "double",
          "type": "number"
        },
        "validation_r2": {
          "description": "Mean held-out R^2 over the same cuts \u2014 the fits never saw these rows.",
          "format": "double",
          "type": "number"
        },
        "validation_rmse": {
          "description": "Mean held-out RMSE over the cuts this program was measured on, in the\ndataset's own target units. There is no normalisation to undo: the search\nfits the committed rows as they are.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "genome",
        "program_sha256",
        "validation_rmse",
        "validation_r2",
        "train_r2",
        "seconds",
        "cuts_measured"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "CutSearch": {
      "description": "One cut's search, as its `search.json` published it.",
      "properties": {
        "best_program": {
          "type": [
            "string",
            "null"
          ]
        },
        "best_validation_r2": {
          "description": "That same candidate's held-out R^2.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "best_validation_rmse": {
          "description": "The best held-out RMSE measured on this cut, in the dataset's target units.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "completed_evaluations": {
          "description": "Fits attempted. One fit is one evaluation, whatever its outcome, so this\nis exactly `successful + failed`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "cut": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "failed_or_unavailable_measurements": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "generations": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hold_rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "observations_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "search_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "stopped_by": {
          "description": "Which budget bound ended this cut: `evaluations` or `seconds`.",
          "type": "string",
          "enum": [
            "evaluations",
            "seconds",
            "search_space_exhausted"
          ]
        },
        "successful_measurements": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "train_rows": {
          "description": "Rows the fits on this cut saw, and rows they were scored on. Disjoint.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "cut",
        "search_sha256",
        "observations_sha256",
        "train_rows",
        "hold_rows",
        "generations",
        "completed_evaluations",
        "successful_measurements",
        "failed_or_unavailable_measurements",
        "stopped_by"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Dataset": {
      "properties": {
        "columns": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dataset_hash": {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/DatasetFile"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "description": "Where the dataset was read from, as given on the command line.",
          "type": "string"
        },
        "rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "task": {
          "type": "string"
        },
        "training_rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "dataset_hash",
        "path",
        "task",
        "rows",
        "columns",
        "training_rows",
        "files"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "DatasetFile": {
      "description": "One file of the dataset, as hashed at resolution time.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Exclusion": {
      "description": "A requested language the selected genome is not covered for.",
      "properties": {
        "language": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "language",
        "reason"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Prepared": {
      "properties": {
        "cuts": {
          "description": "The cut indices that were built, in build order.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "folds": {
          "description": "The partition each cut holds one fold out of.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "seed",
        "rows",
        "folds",
        "cuts"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Search": {
      "properties": {
        "best": {
          "anyOf": [
            {
              "$ref": "#/$defs/Best"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent when no cut produced a successful measurement."
        },
        "bootstrap_genome": {
          "description": "The genome generation 0 always contains, so a measured champion is never\nworse than it.",
          "type": "string"
        },
        "cuts": {
          "items": {
            "$ref": "#/$defs/CutSearch"
          },
          "type": "array"
        },
        "engine": {
          "description": "The search implementation that produced these measurements.",
          "type": "string"
        },
        "evaluations": {
          "description": "The `--budget` bounds, per cut.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_transforms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "population": {
          "description": "Candidates alive per generation, and the transform depth they may reach.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rng_seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "selected_genome": {
          "description": "The genome handed to the emitters, always present.",
          "type": "string"
        },
        "selected_program_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "selection": {
          "description": "How the emitted program was chosen. `min_mean_validation_rmse` is the only\nrule applied here; no fold-pure lower-confidence-bound selector exists in\nthis workspace. `unmeasured_fallback_bootstrap_genome` means nothing was\nmeasured at all, which the search stage now refuses to return.",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "rng_seed",
        "evaluations",
        "seconds",
        "population",
        "max_transforms",
        "bootstrap_genome",
        "cuts",
        "selection",
        "selected_genome",
        "selected_program_sha256"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "Stage": {
      "description": "One pipeline stage.",
      "properties": {
        "name": {
          "type": "string"
        },
        "reason": {
          "description": "Why, for anything that is not a plain pass. A skip always carries one.",
          "type": [
            "string",
            "null"
          ]
        },
        "seconds": {
          "format": "double",
          "type": "number"
        },
        "status": {
          "description": "`passed`, `skipped` or `failed`.",
          "type": "string",
          "enum": [
            "passed",
            "skipped",
            "failed"
          ]
        }
      },
      "required": [
        "name",
        "status",
        "seconds"
      ],
      "type": "object",
      "additionalProperties": false
    }
  }
}
