{
  "$defs": {
    "ArchiveRecord": {
      "additionalProperties": false,
      "description": "The loss × cost front a run publishes.",
      "properties": {
        "cost_version": {
          "description": "The cost version of every member's complexity.",
          "type": "string"
        },
        "id": {
          "description": "The method id, `feat-math.front-loss-cost.v1`.",
          "type": "string"
        },
        "sha256": {
          "description": "The sha256 of `search/cut-0/archive.json`. Publication adds it, so a receipt's record\nalways has one; the selection's own record, before anything is published, has none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "cost_version"
      ],
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "description": "One emitted source file.",
      "properties": {
        "build": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "language": {
          "type": "string"
        },
        "path": {
          "description": "Relative to the run's `emit/` directory. `cpp17` and `cpp20` share one\npath: there is a single C++ emitter and the standard is a compile flag.",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "language",
        "path",
        "sha256",
        "bytes"
      ],
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dataset_hash": {
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/DatasetFile"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "path": {
          "description": "Where the dataset was read from, as given on the command line.",
          "type": "string"
        },
        "rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "task": {
          "type": "string"
        },
        "training_rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "dataset_hash",
        "path",
        "task",
        "rows",
        "columns",
        "training_rows",
        "files"
      ],
      "type": "object"
    },
    "DatasetFile": {
      "additionalProperties": false,
      "description": "One file of the dataset, as hashed at resolution time.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "sha256",
        "bytes"
      ],
      "type": "object"
    },
    "EngineRecord": {
      "additionalProperties": false,
      "description": "The opt-in engine methods a run selected. Absent from a receipt for the default selection.",
      "properties": {
        "archive": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArchiveRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "refine": {
          "anyOf": [
            {
              "$ref": "#/$defs/RefineRecord"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Exclusion": {
      "additionalProperties": false,
      "description": "A requested language the selected genome is not covered for.",
      "properties": {
        "language": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "language",
        "reason"
      ],
      "type": "object"
    },
    "Faults": {
      "additionalProperties": false,
      "properties": {
        "constant_passes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "domain_cells": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "evaluated_cells": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hard_classes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hard_rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "saturation_cells": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "evaluated_cells",
        "domain_cells",
        "saturation_cells",
        "constant_passes",
        "hard_rows",
        "hard_classes"
      ],
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "constant_output": {
          "type": "boolean"
        },
        "domain_fault_rate": {
          "format": "double",
          "type": "number"
        },
        "faulted_cells": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "faults": {
          "$ref": "#/$defs/Faults"
        },
        "observation": {
          "$ref": "#/$defs/ObservationRecord"
        },
        "saturation_fault_rate": {
          "format": "double",
          "type": "number"
        },
        "selection_score": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "observation",
        "faults",
        "domain_fault_rate",
        "saturation_fault_rate",
        "constant_output",
        "faulted_cells"
      ],
      "type": "object"
    },
    "ObservationRecord": {
      "additionalProperties": false,
      "description": "An [`Observation`] as `observations.json` publishes it, read back for re-derivation.",
      "properties": {
        "cut": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failure": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "generation": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "genome": {
          "type": "string"
        },
        "hold_r2": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "island": {
          "default": null,
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "origin": {
          "type": "string"
        },
        "program_sha256": {
          "type": "string"
        },
        "rmse": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "seconds": {
          "format": "double",
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "train_r2": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "genome",
        "program_sha256",
        "cut",
        "generation",
        "origin",
        "seconds",
        "status"
      ],
      "type": "object"
    },
    "PolicyRecord": {
      "description": "Validated policy parameters needed to replay kernel2 ranking.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reject_hard",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "penalize",
              "type": "string"
            },
            "lambda_domain": {
              "format": "double",
              "type": "number"
            },
            "lambda_saturation": {
              "format": "double",
              "type": "number"
            },
            "tie_break": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "lambda_domain",
            "lambda_saturation",
            "tie_break"
          ],
          "type": "object"
        }
      ]
    },
    "Prepared": {
      "additionalProperties": false,
      "properties": {
        "cuts": {
          "description": "The cut indices that were built, in build order.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "folds": {
          "description": "The partition each cut holds one fold out of.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "seed",
        "rows",
        "folds",
        "cuts"
      ],
      "type": "object"
    },
    "RefineRecord": {
      "additionalProperties": false,
      "description": "The constant refinement method, when it is not the coordinate search.",
      "properties": {
        "id": {
          "type": "string"
        },
        "jacobian": {
          "description": "What one Jacobian is charged: `sites` (one evaluation per literal site) or `one`.",
          "type": "string"
        },
        "tau": {
          "description": "The initial damping relative to the largest scaled curvature.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "id",
        "jacobian",
        "tau"
      ],
      "type": "object"
    },
    "Refinement": {
      "description": "Explicit training-refinement allowance; it shares the cut's total budget.",
      "properties": {
        "top_k": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "trials_per_program": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "top_k",
        "trials_per_program"
      ],
      "type": "object"
    },
    "Search": {
      "additionalProperties": false,
      "properties": {
        "active_seconds": {
          "format": "double",
          "type": "number"
        },
        "arm_counts": {
          "additionalProperties": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "best": {
          "$ref": "#/$defs/Measurement"
        },
        "candidate_measurements": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "completed_evaluations": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "cut": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "deadline_overrun": {
          "type": "boolean"
        },
        "engine": {
          "type": "string"
        },
        "engine_selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/EngineRecord"
            },
            {
              "type": "null"
            }
          ],
          "description": "Opt-in engine methods. Absent for the default selection, so its receipts keep their bytes."
        },
        "evaluations": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "fault_policy": {
          "$ref": "#/$defs/PolicyRecord"
        },
        "generations": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "hold_rows": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "objective_trials": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "observations_sha256": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        },
        "profile_sha256": {
          "type": "string"
        },
        "refinement": {
          "$ref": "#/$defs/Refinement"
        },
        "refinements_sha256": {
          "type": "string"
        },
        "rejected_trials": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "rng_seed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seeding": {
          "$ref": "#/$defs/Seeding"
        },
        "selection": {
          "type": "string"
        },
        "stopped_by": {
          "type": "string"
        },
        "successful_measurements": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "train_rows": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "engine",
        "profile_id",
        "profile_sha256",
        "fault_policy",
        "rng_seed",
        "evaluations",
        "seconds",
        "refinement",
        "cut",
        "train_rows",
        "hold_rows",
        "generations",
        "completed_evaluations",
        "candidate_measurements",
        "objective_trials",
        "rejected_trials",
        "successful_measurements",
        "stopped_by",
        "active_seconds",
        "deadline_overrun",
        "arm_counts",
        "seeding",
        "selection",
        "best",
        "observations_sha256",
        "refinements_sha256"
      ],
      "type": "object"
    },
    "Seed": {
      "additionalProperties": false,
      "description": "One genome generation 0 was seeded with.",
      "properties": {
        "genome": {
          "description": "Canonical pipeline DSL, exactly as it entered generation 0 with origin `incumbent`.",
          "type": "string"
        },
        "program_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source": {
          "description": "`incumbent` (the parent receipt's selected genome) or `seeds_file`.",
          "type": "string"
        }
      },
      "required": [
        "genome",
        "program_sha256",
        "source"
      ],
      "type": "object"
    },
    "Seeding": {
      "additionalProperties": false,
      "description": "v3: how generation 0 was seeded. Present, with an empty `seeds`, on an unseeded run.",
      "properties": {
        "offered": {
          "description": "Genomes offered by `--incumbent` and `--seed-genomes` before canonicalisation,\ndeduplication (including against the bootstrap) and the cap at the elite count.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parent_receipt_sha256": {
          "description": "sha256 of the `--incumbent` receipt's bytes, which verified with its on-disk evidence.",
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "seeds": {
          "description": "Admitted seeds, in the order they entered generation 0 after the bootstrap. Every one is\nre-measured on this run's cuts; no score is carried over from where it came from.",
          "items": {
            "$ref": "#/$defs/Seed"
          },
          "type": "array"
        },
        "seeds_file_sha256": {
          "description": "sha256 of the `--seed-genomes` file's bytes.",
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "offered",
        "seeds"
      ],
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "description": "One pipeline stage.",
      "properties": {
        "name": {
          "type": "string"
        },
        "reason": {
          "description": "Why, for anything that is not a plain pass. A skip always carries one.",
          "type": [
            "string",
            "null"
          ]
        },
        "seconds": {
          "format": "double",
          "type": "number"
        },
        "status": {
          "description": "`passed`, `skipped` or `failed`.",
          "enum": [
            "passed",
            "skipped",
            "failed"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "seconds"
      ],
      "type": "object"
    }
  },
  "$id": "https://github.com/neverhuman/JopeDime/schemas/jope.pipeline-receipt.v4.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/Dataset"
    },
    "emit_exclusions": {
      "items": {
        "$ref": "#/$defs/Exclusion"
      },
      "type": "array"
    },
    "emit_manifest_sha256": {
      "type": "string"
    },
    "git_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "policy": {
      "enum": [
        "auto",
        "skip"
      ],
      "type": "string"
    },
    "prepared": {
      "$ref": "#/$defs/Prepared"
    },
    "schema": {
      "const": "jope.pipeline-receipt/v4",
      "type": "string"
    },
    "search": {
      "$ref": "#/$defs/Search"
    },
    "search_sha256": {
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/Stage"
      },
      "type": "array"
    },
    "tool_version": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "ok",
    "tool_version",
    "created_at",
    "policy",
    "dataset",
    "prepared",
    "stages",
    "search",
    "artifacts",
    "emit_exclusions",
    "search_sha256",
    "emit_manifest_sha256"
  ],
  "title": "jope.pipeline-receipt/v4",
  "type": "object"
}
