{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jopedime.veox.ai/schemas/jope.pipeline-seeds.v2.schema.json",
  "title": "JOPE pipeline seed set v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_snapshot_sha256", "cap", "requested_by_source", "draws"],
  "properties": {
    "schema": {"const": "jope.pipeline-seeds/v2"},
    "source_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cap": {"type": "integer", "minimum": 1},
    "requested_by_source": {
      "type": "object",
      "propertyNames": {"enum": ["own_incumbent", "other_lineage_retrieval", "neural_proposal"]},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "draws": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["draw_id", "genome", "program_sha256", "source"],
        "properties": {
          "draw_id": {"type": "string", "minLength": 1},
          "genome": {"type": "string", "minLength": 1},
          "program_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source": {"enum": ["own_incumbent", "other_lineage_retrieval", "neural_proposal"]},
          "ancestry": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "parent_families": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "dataset_families": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "canonical_program_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
            }
          }
        }
      }
    }
  }
}
