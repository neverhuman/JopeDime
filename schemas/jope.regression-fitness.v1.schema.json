{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/neverhuman/JopeDime/schemas/jope.regression-fitness.v1.schema.json",
  "title": "Portable JopeDime regression objective v1",
  "description": "A built-in metric with explicit parameters, a custom row expression, a weighted objective or a composite. The runtime also bounds expression depth (16) and expression nodes (256 in one specification), composition depth (8) and nodes (64), columns (16) and specification size (32 KiB).",
  "$ref": "#/$defs/fitness",
  "$defs": {
    "fitness": {
      "oneOf": [
        {
          "type": "object",
          "description": "Root mean squared error. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "rmse"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean squared error. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "mse"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean absolute error. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "mae"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Median absolute error. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "median_absolute_error"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Largest absolute error. Minimize. Refuses row weights.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "max_error"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean absolute percentage error as a ratio. Minimize.",
          "required": [
            "metric",
            "epsilon"
          ],
          "properties": {
            "metric": {
              "const": "mape"
            },
            "epsilon": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Denominator floor for |y|."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Symmetric mean absolute percentage error (0..2). Minimize.",
          "required": [
            "metric",
            "epsilon"
          ],
          "properties": {
            "metric": {
              "const": "smape"
            },
            "epsilon": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Denominator floor."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Sum of absolute errors over sum of absolute targets. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "wape"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean squared log1p error; y, pred >= 0. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "msle"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Root mean squared log1p error; y, pred >= 0. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "rmsle"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Coefficient of determination. Maximize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "r2"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Explained variance. Maximize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "explained_variance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Pearson correlation. Maximize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "pearson"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Spearman rank correlation (information coefficient). Maximize. Refuses row weights.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "spearman"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Huber loss. Minimize.",
          "required": [
            "metric",
            "delta"
          ],
          "properties": {
            "metric": {
              "const": "huber"
            },
            "delta": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Quadratic-to-linear threshold in target units."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Smooth Huber loss. Minimize.",
          "required": [
            "metric",
            "delta"
          ],
          "properties": {
            "metric": {
              "const": "pseudo_huber"
            },
            "delta": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Scale in target units."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "log(cosh(y - pred)). Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "log_cosh"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Quantile (pinball) loss. Minimize.",
          "required": [
            "metric",
            "quantile"
          ],
          "properties": {
            "metric": {
              "const": "pinball"
            },
            "quantile": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "description": "Target quantile; 0.9 makes under-prediction 9x as costly as over-prediction."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Asymmetric squared error. Minimize.",
          "required": [
            "metric",
            "quantile"
          ],
          "properties": {
            "metric": {
              "const": "expectile"
            },
            "quantile": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "description": "Asymmetry of the squared error."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean Poisson deviance; y >= 0, pred > 0. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "poisson_deviance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean Gamma deviance; y > 0, pred > 0. Minimize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "gamma_deviance"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean Tweedie deviance; y >= 0, pred > 0. Minimize.",
          "required": [
            "metric",
            "power"
          ],
          "properties": {
            "metric": {
              "const": "tweedie_deviance"
            },
            "power": {
              "type": "number",
              "exclusiveMinimum": 1,
              "exclusiveMaximum": 2,
              "description": "Tweedie power in (1,2)."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "LinEx loss exp(a*e) - a*e - 1 with e = y - pred. Minimize.",
          "required": [
            "metric",
            "a"
          ],
          "properties": {
            "metric": {
              "const": "linex"
            },
            "a": {
              "type": "number",
              "not": {
                "const": 0
              },
              "description": "Asymmetry: a > 0 makes under-prediction exponentially costly, a < 0 over-prediction."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Newsvendor cost. Minimize.",
          "required": [
            "metric",
            "under_cost",
            "over_cost"
          ],
          "properties": {
            "metric": {
              "const": "asymmetric_absolute"
            },
            "under_cost": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Cost per unit the prediction falls short of y."
            },
            "over_cost": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Cost per unit the prediction exceeds y."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Asymmetric squared cost. Minimize.",
          "required": [
            "metric",
            "under_cost",
            "over_cost"
          ],
          "properties": {
            "metric": {
              "const": "asymmetric_squared"
            },
            "under_cost": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Weight of squared shortfall."
            },
            "over_cost": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Weight of squared excess."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Root mean squared percentage error as a ratio. Minimize.",
          "required": [
            "metric",
            "epsilon"
          ],
          "properties": {
            "metric": {
              "const": "rmspe"
            },
            "epsilon": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Denominator floor for |y|."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "MAE over the seasonal naive MAE on the same chronological rows. Minimize. Requires forward validation.",
          "required": [
            "metric",
            "season"
          ],
          "properties": {
            "metric": {
              "const": "mase"
            },
            "season": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "description": "Seasonal lag of the naive forecast."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean net strategy return; y is the realized return, pred the position. Maximize. Requires forward validation.",
          "required": [
            "metric",
            "max_position",
            "cost"
          ],
          "properties": {
            "metric": {
              "const": "mean_return"
            },
            "max_position": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Largest absolute position; prediction is clipped to [-max_position, max_position]."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Cost per unit of position turnover, in return units."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Annualized Sharpe ratio of net strategy returns. Maximize. Requires forward validation.",
          "required": [
            "metric",
            "max_position",
            "cost",
            "target",
            "periods_per_year"
          ],
          "properties": {
            "metric": {
              "const": "sharpe"
            },
            "max_position": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Largest absolute position; prediction is clipped to [-max_position, max_position]."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Cost per unit of position turnover, in return units."
            },
            "target": {
              "type": "number",
              "description": "Minimum acceptable return per interval."
            },
            "periods_per_year": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Intervals per year used to annualize."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Annualized Sortino ratio of net strategy returns. Maximize. Requires forward validation.",
          "required": [
            "metric",
            "max_position",
            "cost",
            "target",
            "periods_per_year"
          ],
          "properties": {
            "metric": {
              "const": "sortino"
            },
            "max_position": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Largest absolute position; prediction is clipped to [-max_position, max_position]."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Cost per unit of position turnover, in return units."
            },
            "target": {
              "type": "number",
              "description": "Minimum acceptable return per interval."
            },
            "periods_per_year": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Intervals per year used to annualize."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Largest peak-to-trough loss of compounded equity (0..1). Minimize. Requires forward validation.",
          "required": [
            "metric",
            "max_position",
            "cost"
          ],
          "properties": {
            "metric": {
              "const": "max_drawdown"
            },
            "max_position": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Largest absolute position; prediction is clipped to [-max_position, max_position]."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Cost per unit of position turnover, in return units."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Compound annual growth over maximum drawdown. Maximize. Requires forward validation.",
          "required": [
            "metric",
            "max_position",
            "cost",
            "periods_per_year"
          ],
          "properties": {
            "metric": {
              "const": "calmar"
            },
            "max_position": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Largest absolute position; prediction is clipped to [-max_position, max_position]."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Cost per unit of position turnover, in return units."
            },
            "periods_per_year": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Intervals per year used to annualize."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Gains above threshold over shortfalls below it. Maximize. Requires forward validation.",
          "required": [
            "metric",
            "max_position",
            "cost",
            "threshold"
          ],
          "properties": {
            "metric": {
              "const": "omega"
            },
            "max_position": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Largest absolute position; prediction is clipped to [-max_position, max_position]."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Cost per unit of position turnover, in return units."
            },
            "threshold": {
              "type": "number",
              "description": "Return threshold per interval."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mean loss of the worst alpha fraction of net returns (CVaR). Minimize. Requires forward validation.",
          "required": [
            "metric",
            "max_position",
            "cost",
            "alpha"
          ],
          "properties": {
            "metric": {
              "const": "expected_shortfall"
            },
            "max_position": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Largest absolute position; prediction is clipped to [-max_position, max_position]."
            },
            "cost": {
              "type": "number",
              "minimum": 0,
              "description": "Cost per unit of position turnover, in return units."
            },
            "alpha": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1,
              "description": "Tail fraction, e.g. 0.05."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Share of nonzero targets whose sign is predicted. Maximize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "hit_rate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Gini of targets ranked by prediction over the perfect Gini. Maximize.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "normalized_gini"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Kling-Gupta efficiency. Maximize. Refuses row weights.",
          "required": [
            "metric"
          ],
          "properties": {
            "metric": {
              "const": "kge"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Share of the target total captured by the top-ranked fraction. Maximize. Refuses row weights.",
          "required": [
            "metric",
            "fraction"
          ],
          "properties": {
            "metric": {
              "const": "capture_at"
            },
            "fraction": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1,
              "description": "Top fraction of rows by prediction."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A row expression over y, pred and numeric training columns, aggregated over scored rows.",
          "required": [
            "metric",
            "name",
            "direction",
            "expression",
            "aggregation"
          ],
          "properties": {
            "metric": {
              "const": "custom"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,64}$"
            },
            "direction": {
              "enum": [
                "minimize",
                "maximize"
              ]
            },
            "expression": {
              "$ref": "#/$defs/expression"
            },
            "aggregation": {
              "$ref": "#/$defs/aggregation"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Another objective with nonnegative per-row weights (an expression, usually a column such as exposure).",
          "required": [
            "metric",
            "weights",
            "fitness"
          ],
          "properties": {
            "metric": {
              "const": "weighted"
            },
            "weights": {
              "$ref": "#/$defs/expression"
            },
            "fitness": {
              "$ref": "#/$defs/fitness"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Positive weighted sum of minimization losses, each divided by its scale.",
          "required": [
            "metric",
            "terms"
          ],
          "properties": {
            "metric": {
              "const": "composite"
            },
            "terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": [
                  "weight",
                  "scale",
                  "fitness"
                ],
                "properties": {
                  "weight": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "fitness": {
                    "$ref": "#/$defs/fitness"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "description": "The target.",
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "y"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "The prediction.",
          "required": [
            "op"
          ],
          "properties": {
            "op": {
              "const": "pred"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A finite constant.",
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "const": "constant"
            },
            "value": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "A numeric training column, excluded from features.",
          "required": [
            "op",
            "name"
          ],
          "properties": {
            "op": {
              "const": "column"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "add(left, right).",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "add"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "sub(left, right).",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "sub"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "mul(left, right).",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "mul"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "div(left, right).",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "div"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "min(left, right).",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "min"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "max(left, right).",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "max"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "pow(left, right).",
          "required": [
            "op",
            "left",
            "right"
          ],
          "properties": {
            "op": {
              "const": "pow"
            },
            "left": {
              "$ref": "#/$defs/expression"
            },
            "right": {
              "$ref": "#/$defs/expression"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "abs(arg).",
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "abs"
            },
